GearAcrobaticBobber: {
	Title: "Acrobatic Bobber"
	Contents: "[c/6CC4E8:Accessory] Equip Acrobatic Bobber. Accessory. Provides a fishing minigame. Moving while fishing instead moves your bobbers. Rings appear over time above the water's surface. Touching a ring hooks an item onto the bobber. Bobbers will automatically reel in hooked items upon landing back in the water. How to get it: Craft at Anvil from 1 Fishing Bobber, 5 Aerialite Bar"
	Tooltip: "[c/6CC4E8:Accessory] Acrobatic Bobber: Accessory"
}

GearAlluringBait: {
	Title: "Alluring Bait"
	Contents: "[c/6CC4E8:Accessory] Equip Alluring Bait. Accessory. Increases fishing power by 10. Increases the yield of potion ingredient fish. How to get it: Caught while fishing"
	Tooltip: "[c/6CC4E8:Accessory] Alluring Bait: Accessory"
}

GearAmidiasPendant: {
	Title: "Amidias' Pendant"
	Contents: "[c/6CC4E8:Accessory] Equip Amidias' Pendant. Accessory. Periodically rains down prism shards that can briefly stun enemies. How to get it: Dropped by Giant Clam"
	Tooltip: "[c/6CC4E8:Accessory] Amidias' Pendant: Accessory"
}

GearAncientFossil: {
	Title: "Ancient Fossil"
	Contents: "[c/6CC4E8:Accessory] Equip Ancient Fossil. Accessory. Increases mining speed by 10%. Provides immunity to damage from falling blocks. How to get it: Craft at Furnace from 100 Any Silt Block"
	Tooltip: "[c/6CC4E8:Accessory] Ancient Fossil: Accessory"
}

GearAnechoicPlating: {
	Title: "Anechoic Plating"
	Contents: "[c/6CC4E8:Accessory] Equip Anechoic Plating. Accessory. Abyss creatures are less likely to see you. Mitigates the defense reduction from the abyss' pressure. How to get it: Caught while fishing; Found in Hydrothermal Crate; Found in Abyss chests"
	Tooltip: "[c/6CC4E8:Accessory] Anechoic Plating: Accessory"
}

GearArchaicPowder: {
	Title: "Archaic Powder"
	Contents: "[c/6CC4E8:Accessory] Equip Archaic Powder. Accessory. Increases mining speed by 25%. Provides immunity to damage from falling blocks and dart traps. 65% resistance to all damage from traps. Does not stack with downgrades. How to get it: Craft at Anvil from 1 Ancient Fossil, 1 Ancient Chisel, 3 Ancient Bone Dust, 10 Scorched Bone, 15 Bone"
	Tooltip: "[c/6CC4E8:Accessory] Archaic Powder: Accessory"
}

GearBatholithBangle: {
	Title: "Batholith Bangle"
	Contents: "[c/6CC4E8:Accessory] Equip Batholith Bangle. Accessory. Magic enemy hits create a powerful granite flash that always critically strikes. This effect has a 10 second cooldown. Visual and audio effects are reduced if visibility is disabled. 'The solid granite radiates energy throughout your body'. How to get it: Craft at Anvil from 1 Black Glass Band, 15 Any Boss 2 Material, 45 Granite, 3 Amber, 5 Fallen Star"
	Tooltip: "[c/6CC4E8:Accessory] Batholith Bangle: Accessory"
}

GearBlackGlassBand: {
	Title: "Black Glass Band"
	Contents: "[c/6CC4E8:Accessory] Equip Black Glass Band. Accessory. Enemy hits create an obsidian flash that always critically strikes. This effect has a 5 second cooldown, but is halved if the flash kills an enemy. Visual and audio effects are reduced if visibility is disabled. 'A shining band with boundless potential'. How to get it: Craft at Anvil from 8 Any Gold Bar, 3 Diamond, 35 Obsidian"
	Tooltip: "[c/6CC4E8:Accessory] Black Glass Band: Accessory"
}

GearBloodstainedGlove: {
	Title: "Bloodstained Glove"
	Contents: "[c/6CC4E8:Accessory] Equip Bloodstained Glove. Accessory. Stealth strikes have +8 armor penetration and heal for 5 HP. How to get it: Found in Treasure Bag (The Perforators); Dropped by The Perforator Hive"
	Tooltip: "[c/6CC4E8:Accessory] Bloodstained Glove: Accessory"
}

GearBloodyWormTooth: {
	Title: "Bloody Worm Tooth"
	Contents: "[c/6CC4E8:Accessory] Equip Bloody Worm Tooth. Accessory, 2 defense. 10% increased melee damage. How to get it: Craft at Tinkerer's Workshop from 1 Rotten Brain; Found in Treasure Bag (The Perforators)"
	Tooltip: "[c/6CC4E8:Accessory] Bloody Worm Tooth: Accessory, 2 defense"
}

GearCleansingJelly: {
	Title: "Cleansing Jelly"
	Contents: "[c/6CC4E8:Accessory] Equip Cleansing Jelly. Accessory. Using a healing potion spawns a blue aura that lasts for 30 seconds. Walking into the aura removes all debuffs one time. How to get it: Dropped by Mirage Jelly; Dropped by Blue Jellyfish"
	Tooltip: "[c/6CC4E8:Accessory] Cleansing Jelly: Accessory"
}

GearCoinofDeceit: {
	Title: "Coin of Deceit"
	Contents: "[c/6CC4E8:Accessory] Equip Coin of Deceit. Accessory. Stealth strikes only expend 90% of your max stealth. 6% increased rogue crit chance. How to get it: Craft at Anvil from 12 Any Copper Bar, 8 Any Evil Bar"
	Tooltip: "[c/6CC4E8:Accessory] Coin of Deceit: Accessory"
}

GearCounterScarf: {
	Title: "Counter Scarf"
	Contents: "[c/6CC4E8:Accessory] Equip Counter Scarf. Accessory. Grants the ability to dash; dashing into an attack will cause you to dodge it. After a successful dodge you must wait 30 seconds before you can dodge again. How to get it: Sold by Clothier"
	Tooltip: "[c/6CC4E8:Accessory] Counter Scarf: Accessory"
}

GearCrawCarapace: {
	Title: "Craw Carapace"
	Contents: "[c/6CC4E8:Accessory] Equip Craw Carapace. Accessory. 7% increased damage. Attackers take damage and are inflicted with Crumbling. How to get it: Dropped by Crawdad 2"
	Tooltip: "[c/6CC4E8:Accessory] Craw Carapace: Accessory"
}

GearCrownJewel: {
	Title: "Crown Jewel"
	Contents: "[c/6CC4E8:Accessory] Equip Crown Jewel. Accessory. +0.5 HP/s life regen. Reduces damage over time taken by 2 HP/s. How to get it: Found in Treasure Bag (King Slime); Dropped by King Slime"
	Tooltip: "[c/6CC4E8:Accessory] Crown Jewel: Accessory"
}

GearDepthCharm: {
	Title: "Depths Charm"
	Contents: "[c/6CC4E8:Accessory] Equip Depths Charm. Accessory. Reduces the damage caused by drowning in the abyss. Removes the increased breath loss of Crush Depth. How to get it: Caught while fishing; Found in Hydrothermal Crate; Found in Abyss chests"
	Tooltip: "[c/6CC4E8:Accessory] Depths Charm: Accessory"
}

GearEnchantedPearl: {
	Title: "Enchanted Pearl"
	Contents: "[c/6CC4E8:Accessory] Equip Enchanted Pearl. Accessory. Increases fishing power by 10. Increases chance to catch crates and loot-containing fish by 15%. Crate catches are 25% more likely to be higher quality, accompanied by visual pearls. How to get it: Craft at Anvil from 1 White Pearl, 10 Sea Prism, 3 Sea Remains"
	Tooltip: "[c/6CC4E8:Accessory] Enchanted Pearl: Accessory"
}

GearFeatherCrown: {
	Title: "Feather Crown"
	Contents: "[c/6CC4E8:Accessory] Equip Feather Crown. Accessory. Summons a Skyline Feather every 2 seconds, up to a maximum of 5. Each Skyline Feather increases magic damage by 2% and decreases mana cost by 1%. With 5 feathers, increases magic critical strike chance by 5% and all magic attacks inflict Static Discharge. Running out of mana or drinking a mana po... How to get it: Craft at Anvil from 1 Any Gold Crown, 8 Aerialite Bar, 8 Feather"
	Tooltip: "[c/6CC4E8:Accessory] Feather Crown: Accessory"
}

GearFilthyGlove: {
	Title: "Filthy Glove"
	Contents: "[c/6CC4E8:Accessory] Equip Filthy Glove. Accessory. Stealth strikes have +8 armor penetration and deal 8% more damage. How to get it: Found in Treasure Bag (The Hive Mind); Dropped by The Hive Mind"
	Tooltip: "[c/6CC4E8:Accessory] Filthy Glove: Accessory"
}

GearFishStocks: {
	Title: "Fish Stocks"
	Contents: "[c/6CC4E8:Accessory] Equip Fish Stocks. Accessory. Pulls up a view of the fish stocks. Provides stats that are multiplied by the state of fish stocks. When unequipped, the effects will only be disabled once stocks are even or higher. How to get it: Sold by Shady Salesman"
	Tooltip: "[c/6CC4E8:Accessory] Fish Stocks: Accessory"
}

GearFrozenCube: {
	Title: "Frozen Cube"
	Contents: "[c/6CC4E8:Accessory] Equip Frozen Cube. Accessory. A frozen block of ice with something inside. Summons an Elumphant to sit atop your head and protect you. The Elumphant will cycle between shooting cold air that inflicts Wind Chilled, and headbutting enemies. Elumphant's headbutts only target enemies inflicted with Wind Chilled. Reduces your defe... How to get it: Sold by Shady Salesman; Found in Underground Shrines chests"
	Tooltip: "[c/6CC4E8:Accessory] Frozen Cube: Accessory"
}

GearFungalClump: {
	Title: "Fungal Clump"
	Contents: "[c/6CC4E8:Accessory] Equip Fungal Clump. Accessory. Summons a fungal clump to fight for you. The clump latches onto enemies and steals their life for you. How to get it: Found in Treasure Bag (Crabulon)"
	Tooltip: "[c/6CC4E8:Accessory] Fungal Clump: Accessory"
}

GearFungalSymbiote: {
	Title: "Fungal Symbiote"
	Contents: "[c/6CC4E8:Accessory] Equip Fungal Symbiote. Accessory. You grow mushrooms on the grass beneath you. Consuming mushrooms provides Mushy, granting 3 defense and +1 HP/s life regen. 10% increased damage while you have Mushy. How to get it: Sold by Shady Salesman; Found in Underground Shrines chests"
	Tooltip: "[c/6CC4E8:Accessory] Fungal Symbiote: Accessory"
}

GearGiantPearl: {
	Title: "Giant Pearl"
	Contents: "[c/6CC4E8:Accessory] Equip Giant Pearl. Accessory. You have a light aura around you. Enemies within the aura are slowed down. Increases visibility range in the abyss. How to get it: Dropped by Giant Clam"
	Tooltip: "[c/6CC4E8:Accessory] Giant Pearl: Accessory"
}

GearGiantShell: {
	Title: "Giant Shell"
	Contents: "[c/6CC4E8:Accessory] Equip Giant Shell. Accessory, 4 defense. 10% reduced dash velocity. Taking a hit restores dash velocity and reduces defense for 3 seconds. How to get it: Dropped by Giant Shelly 2"
	Tooltip: "[c/6CC4E8:Accessory] Giant Shell: Accessory, 4 defense"
}

GearGladiatorsLocket: {
	Title: "Gladiator's Locket"
	Contents: "[c/6CC4E8:Accessory] Equip Gladiator's Locket. Accessory. Enemies drop a healing orb on kill. Gain an increase to your damage and movement speed the lower your health is, up to 20% at 50% life or below. How to get it: Sold by Shady Salesman; Found in Underground Shrines chests"
	Tooltip: "[c/6CC4E8:Accessory] Gladiator's Locket: Accessory"
}

GearHarpyRing: {
	Title: "Harpy Ring"
	Contents: "[c/6CC4E8:Accessory] Equip Harpy Ring. Accessory. 20% increased movement speed and flight time. How to get it: Craft at Anvil from 5 Aerialite Bar, 5 Feather"
	Tooltip: "[c/6CC4E8:Accessory] Harpy Ring: Accessory"
}

GearHeartofDarkness: {
	Title: "Heart of Darkness"
	Contents: "[c/6CC4E8:Accessory] Equip Heart of Darkness. Accessory. You constantly gain rage over time, and rage does not fade away when out of combat. How to get it: Sold by Shady Salesman; Found in Underground Shrines chests"
	Tooltip: "[c/6CC4E8:Accessory] Heart of Darkness: Accessory"
}

GearHoneyDew: {
	Title: "Honey Dew"
	Contents: "[c/6CC4E8:Accessory] Equip Honey Dew. Accessory. Natural life regen is X% more potent. How to get it: Craft at Anvil from 10 Bottled Honey, 3 Bee Wax, 6 Jungle Spores"
	Tooltip: "[c/6CC4E8:Accessory] Honey Dew: Accessory"
}

GearIVDripOnTheRocks: {
	Title: "IV Drip on the Rocks"
	Contents: "[c/6CC4E8:Accessory] Equip IV Drip on the Rocks. Accessory. Inserted alcohols contribute toward alcohol poisoning. Drinking more than 3 different alcohols might not end well with your liver. Shift-Right Click this item in your inventory to empty its contents. '(drunken mumbling)'. How to get it: Sold by Bandit"
	Tooltip: "[c/6CC4E8:Accessory] IV Drip on the Rocks: Accessory"
}

GearIlmerisSpark: {
	Title: "Ilmeris' Spark"
	Contents: "[c/6CC4E8:Accessory] Equip Ilmeris' Spark. Accessory. Taking damage releases a blast of sparks. How to get it: Dropped by Cnidrion"
	Tooltip: "[c/6CC4E8:Accessory] Ilmeris' Spark: Accessory"
}

GearInkBomb: {
	Title: "Ink Bomb"
	Contents: "[c/6CC4E8:Accessory] Equip Ink Bomb. Accessory. Stealth generates 7% faster. Throws several ink bombs when hit that explode into ink and confuse enemies. Gain a lot of stealth when struck. This effect has a 20 second cooldown before it can occur again. How to get it: Dropped by Colossal Squid; Dropped by Cuttlefish; Dropped by Giant Squid; and 1 more sources"
	Tooltip: "[c/6CC4E8:Accessory] Ink Bomb: Accessory"
}

GearIronBoots: {
	Title: "Iron Boots"
	Contents: "[c/6CC4E8:Accessory] Equip Iron Boots. Accessory. Hold to increase your maximum fall speed, even in water. Upon hitting the ground, a shockwave is created at your feet. The shockwave scales in both damage and size the longer you fall for. Negates fall damage. How to get it: Caught while fishing; Found in Hydrothermal Crate; Found in Abyss chests"
	Tooltip: "[c/6CC4E8:Accessory] Iron Boots: Accessory"
}

GearLaudanum: {
	Title: "Laudanum"
	Contents: "[c/6CC4E8:Accessory] Equip Laudanum. Accessory. Converts certain debuffs into buffs and extends their durations. This also removes immunities to these debuffs if you have them. How to get it: Dropped by Horrible Hog; Found in Underground Shrines chests"
	Tooltip: "[c/6CC4E8:Accessory] Laudanum: Accessory"
}

GearLifeJelly: {
	Title: "Life Jelly"
	Contents: "[c/6CC4E8:Accessory] Equip Life Jelly. Accessory. Using a healing potion spawns a pink aura that lasts for 30 seconds. The aura grants +2 HP/s life regen. How to get it: Dropped by Mirage Jelly; Dropped by Pink Jellyfish"
	Tooltip: "[c/6CC4E8:Accessory] Life Jelly: Accessory"
}

GearLuxorsGift: {
	Title: "Luxor's Gift"
	Contents: "[c/6CC4E8:Accessory] Equip Luxor's Gift. Accessory. Summons a scarab launcher that follows you closely. The scarab fires different projectiles at enemies depending on what class the held weapon belongs to. Held item class is not updated when holding a tool. When not in use, the scarab will condense itself into a small orb of light. How to get it: Sold by Shady Salesman; Found in Underground Shrines chests"
	Tooltip: "[c/6CC4E8:Accessory] Luxor's Gift: Accessory"
}

GearMarniteRepulsionShield: {
	Title: "Marnite Repulsion Shield"
	Contents: "[c/6CC4E8:Accessory] Equip Marnite Repulsion Shield. Accessory, 2 defense. Enemies behind you are struck by high-knockback hardlight quills. Backstabbers Beware! How to get it: Craft at Anvil from 5 Any Gold Bar, 15 Granite, 15 Marble"
	Tooltip: "[c/6CC4E8:Accessory] Marnite Repulsion Shield: Accessory, 2 defense"
}

GearMirageMirror: {
	Title: "Mirage Mirror"
	Contents: "[c/6CC4E8:Accessory] Equip Mirage Mirror. Accessory. Reduces enemy aggression outside of the abyss. Stealth generates 25% faster when standing still and 12% faster while moving. 'Bend light around you'. How to get it: Craft at Tinkerer's Workshop from 1 Magic Mirror, 1 Black Lens, 50 Bone (+1 alternative recipe)"
	Tooltip: "[c/6CC4E8:Accessory] Mirage Mirror: Accessory"
}

GearOceanCrest: {
	Title: "Ocean Crest"
	Contents: "[c/6CC4E8:Accessory] Equip Ocean Crest. Accessory. You recover air while standing still underwater. 15% increased mining speed while wet. How to get it: Found in Treasure Bag (Desert Scourge)"
	Tooltip: "[c/6CC4E8:Accessory] Ocean Crest: Accessory"
}

GearOldDie: {
	Title: "Old Die"
	Contents: "[c/6CC4E8:Accessory] Equip Old Die. Accessory. Increases luck by 20%. 'Lucky for you, the curse doesn't affect you. Mostly'. How to get it: Dropped by Duke Fishron; Sold by Bandit"
	Tooltip: "[c/6CC4E8:Accessory] Old Die: Accessory"
}

GearProtolithBangle: {
	Title: "Protolith Bangle"
	Contents: "[c/6CC4E8:Accessory] Equip Protolith Bangle. Accessory. Ranged enemy hits create a marble flash that always critically strikes and can hit multiple enemies. This effect has a 7 second cooldown. Visual and audio effects are reduced if visibility is disabled. 'The cold marble against your wrist puts your mind at ease'. How to get it: Craft at Anvil from 1 Black Glass Band, 15 Any Boss 2 Material, 45 Marble, 3 Ruby, 5 Lens"
	Tooltip: "[c/6CC4E8:Accessory] Protolith Bangle: Accessory"
}

GearRaidersTalisman: {
	Title: "Raider's Talisman"
	Contents: "[c/6CC4E8:Accessory] Equip Raider's Talisman. Accessory. Stealth strikes grant 15% critical strike chance to non-stealth strikes for 10 seconds. How to get it: Craft at Anvil from 5 Leather, 5 Flinx Fur, 20 Obsidian"
	Tooltip: "[c/6CC4E8:Accessory] Raider's Talisman: Accessory"
}

GearRottenBrain: {
	Title: "Rotten Brain"
	Contents: "[c/6CC4E8:Accessory] Equip Rotten Brain. Accessory. Taking damage spawns a dank creeper. The dank creeper flies above you, exploding into several shaderain clouds. How to get it: Craft at Tinkerer's Workshop from 1 Bloody Worm Tooth; Found in Treasure Bag (The Hive Mind)"
	Tooltip: "[c/6CC4E8:Accessory] Rotten Brain: Accessory"
}

GearRottenDogtooth: {
	Title: "Rotten Dogtooth"
	Contents: "[c/6CC4E8:Accessory] Equip Rotten Dogtooth. Accessory. Stealth strikes inflict Crumbling and deal 8% more damage. How to get it: Dropped by Rotdog"
	Tooltip: "[c/6CC4E8:Accessory] Rotten Dogtooth: Accessory"
}

GearRoverDrive: {
	Title: "Rover Drive"
	Contents: "[c/6CC4E8:Accessory] Equip Rover Drive. Accessory. Gain a barrier with 20 health. The barrier will regenerate 10 seconds after being hit, taking 5 seconds to completely regenerate. Getting hit resets the timer. Can also be scrapped at an extractinator. How to get it: Caught while fishing; Dropped by Wulfrum Rover"
	Tooltip: "[c/6CC4E8:Accessory] Rover Drive: Accessory"
}

GearSandCloak: {
	Title: "Sand Cloak"
	Contents: "[c/6CC4E8:Accessory] Equip Sand Cloak. Accessory. Dashing creates a large protective sand veil which damages enemies inside it. The sand veil lasts 15 seconds, but dissipates early if you dash again. The veil slowly follows you, and any player inside it gains 3 defense and 75% acceleration. After dissipating, the sand veil has a 15 second cooldo... How to get it: Found in Treasure Bag (Desert Scourge); Dropped by Desert Scourge"
	Tooltip: "[c/6CC4E8:Accessory] Sand Cloak: Accessory"
}

GearScionsCurio: {
	Title: "Scions Curio"
	Contents: "[c/6CC4E8:Accessory] Equip Scions Curio. Accessory. Ranged hits increase the effectiveness of Irradiated. Irradiated damage over time scales off of your ranged damage and crit chance. On kill, enemies burst, spreading Irradiated. Taking damage causes the curio to explode in retaliation. Current Irradiated damage:. How to get it: Found in Hydrothermal Crate; Found in Sulphurous Crate; Found in Sulphurous Sea chests"
	Tooltip: "[c/6CC4E8:Accessory] Scions Curio: Accessory"
}

GearScuttlersJewel: {
	Title: "Scuttler's Jewel"
	Contents: "[c/6CC4E8:Accessory] Equip Scuttler's Jewel. Accessory. Stealth strike projectiles spawn a jewel spike on hit or when destroyed. Can also be broken down at an extractinator. How to get it: Dropped by Amber Crawler; Dropped by Amethyst Crawler; Dropped by Crystal Crawler; and 5 more sources"
	Tooltip: "[c/6CC4E8:Accessory] Scuttler's Jewel: Accessory"
}

GearSeaSpiritAmulet: {
	Title: "Sea Spirit Amulet"
	Contents: "[c/6CC4E8:Accessory] Equip Sea Spirit Amulet. Accessory. Slowly accumulate up to eight spirit orbs that follow you. Spirits disperse when dashing. If below 50% life, they will heal you, otherwise they will attack nearby enemies. 35% increased Water debuff damage. Spirit orbs are transparent and silent if visibility is disabled. How to get it: Caught while fishing"
	Tooltip: "[c/6CC4E8:Accessory] Sea Spirit Amulet: Accessory"
}

GearShieldoftheOcean: {
	Title: "Shield of the Ocean"
	Contents: "[c/6CC4E8:Accessory] Equip Shield of the Ocean. Accessory, 2 defense. Increased defense by 5 when submerged in liquid. 10% increased movement speed and +1 HP/s life regen while wearing Victide armor. How to get it: Craft at Anvil from 5 Sea Remains, 5 Starfish"
	Tooltip: "[c/6CC4E8:Accessory] Shield of the Ocean: Accessory, 2 defense"
}

GearSilencingSheath: {
	Title: "Silencing Sheath"
	Contents: "[c/6CC4E8:Accessory] Equip Silencing Sheath. Accessory. +10 maximum stealth, and stealth generates 4% faster. How to get it: Craft at Tinkerer's Workshop from 8 Any Evil Bar, 10 Silk, 3 Any Boss 2 Material"
	Tooltip: "[c/6CC4E8:Accessory] Silencing Sheath: Accessory"
}

GearSkylineWings: {
	Title: "Skyline Wings"
	Contents: "[c/6CC4E8:Accessory] Equip Skyline Wings. Accessory. Allows flight and slow fall. How to get it: Craft at Anvil from 10 Aerialite Bar, 5 Feather"
	Tooltip: "[c/6CC4E8:Accessory] Skyline Wings: Accessory"
}

GearSpiritGlyph: {
	Title: "Spirit Glyph"
	Contents: "[c/6CC4E8:Accessory] Equip Spirit Glyph. Accessory. Minion attacks provide various buffs. How to get it: Craft at Anvil from 5 Diamond, 15 Obsidian"
	Tooltip: "[c/6CC4E8:Accessory] Spirit Glyph: Accessory"
}

GearSpringStool: {
	Title: "Spring Stool"
	Contents: "[c/6CC4E8:Accessory] Equip Spring Stool. Accessory. Hold to reach higher. Press the bound key to jump super high. Super jumps can only be performed once every 20 seconds and after landing. +5% critical strike chance when striking enemies below you. How to get it: Craft at Anvil from 1 Portable Stool, 3 Any Copper Bar"
	Tooltip: "[c/6CC4E8:Accessory] Spring Stool: Accessory"
}

GearStressPills: {
	Title: "Stress Pills"
	Contents: "[c/6CC4E8:Accessory] Equip Stress Pills. Accessory. Adrenaline charges 20% faster. Increases your max movement speed and acceleration by 5%. How to get it: Sold by Shady Salesman; Found in Underground Shrines chests"
	Tooltip: "[c/6CC4E8:Accessory] Stress Pills: Accessory"
}

GearSunkenSinker: {
	Title: "Sunken Sinker"
	Contents: "[c/6CC4E8:Accessory] Equip Sunken Sinker. Accessory. Provides a fishing minigame. The bobber will float at your height underwater, allowing underwater fishing. Move in the indicated direction while fishing to catch items. How to get it: Craft at Anvil from 1 Fishing Bobber, 1 Pearl Shard, 5 Navystone"
	Tooltip: "[c/6CC4E8:Accessory] Sunken Sinker: Accessory"
}

GearTeslasAmulet: {
	Title: "Tesla's Amulet"
	Contents: "[c/6CC4E8:Accessory] Equip Tesla's Amulet. Accessory. Generates an electrifying field around you. The field inflicts Static Discharge and Galvanic Corrosion. The field has reduced opacity if visibility is disabled. Reduces the duration of Static Discharge. How to get it: Craft at Anvil from 8 Aerialite Bar, 8 Sea Prism, 4 Stormlion Mandible"
	Tooltip: "[c/6CC4E8:Accessory] Tesla's Amulet: Accessory"
}

GearTheBee: {
	Title: "The Bee"
	Contents: "[c/6CC4E8:Accessory] Equip The Bee. Accessory. When at full HP, your damage is increased based on your damage reduction. Damage taken at full HP is halved. Any energy shields must be fully charged for this effect to apply. This has a 6 second cooldown. How to get it: Found in Treasure Bag (Queen Bee); Dropped by Queen Bee"
	Tooltip: "[c/6CC4E8:Accessory] The Bee: Accessory"
}

GearThePointer: {
	Title: "The Pointer"
	Contents: "[c/6CC4E8:Accessory] Equip The Pointer. Accessory. Allows automatic targeting of enemies. Press the bound key to cycle through targets near your mouse. After cycling through all close enemies, the next press will disable it. 'Great for cats!'. How to get it: Craft at Work Bench from 1 Glass, 2 Any Copper Bar, 3 Any Iron Bar, 1 Mana Crystal"
	Tooltip: "[c/6CC4E8:Accessory] The Pointer: Accessory"
}

GearTrinketofChi: {
	Title: "Trinket of Chi"
	Contents: "[c/6CC4E8:Accessory] Equip Trinket of Chi. Accessory. Increases damage reduction by 20% if you avoid taking damage for 10 seconds. This buff expires on hit. +0.5 HP/s life regen for you and your teammates. How to get it: Sold by Shady Salesman; Found in Underground Shrines chests"
	Tooltip: "[c/6CC4E8:Accessory] Trinket of Chi: Accessory"
}

GearUnholyTonic: {
	Title: "Unholy Tonic"
	Contents: "[c/6CC4E8:Accessory] Equip Unholy Tonic. Accessory. Increases defense by 3 while in the corruption. Grants immunity to Brain Rot. How to get it: Craft at Anvil from 15 Vile Powder, 10 Rotten Chunk"
	Tooltip: "[c/6CC4E8:Accessory] Unholy Tonic: Accessory"
}

GearUnstableGraniteCore: {
	Title: "Unstable Granite Core"
	Contents: "[c/6CC4E8:Accessory] Equip Unstable Granite Core. Accessory. Gain an energy field that periodically zaps enemies with arcing energy. The arcing energy ignores a substantial amount of enemy defense. How to get it: Sold by Shady Salesman; Found in Underground Shrines chests"
	Tooltip: "[c/6CC4E8:Accessory] Unstable Granite Core: Accessory"
}

GearViciousTonic: {
	Title: "Vicious Tonic"
	Contents: "[c/6CC4E8:Accessory] Equip Vicious Tonic. Accessory. Increases defense by 3 while in the crimson. Grants immunity to Burning Blood. How to get it: Craft at Anvil from 15 Vicious Powder, 10 Vertebrae"
	Tooltip: "[c/6CC4E8:Accessory] Vicious Tonic: Accessory"
}

GearVitalJelly: {
	Title: "Vital Jelly"
	Contents: "[c/6CC4E8:Accessory] Equip Vital Jelly. Accessory. 12% increased movement and jump speed. How to get it: Dropped by Mirage Jelly; Dropped by Green Jellyfish"
	Tooltip: "[c/6CC4E8:Accessory] Vital Jelly: Accessory"
}

GearVoltaicJelly: {
	Title: "Voltaic Jelly"
	Contents: "[c/6CC4E8:Accessory] Equip Voltaic Jelly. Accessory. Increases your max number of minions by 1. Minion attacks inflict Static Discharge. How to get it: Dropped by Ghost Bell"
	Tooltip: "[c/6CC4E8:Accessory] Voltaic Jelly: Accessory"
}

GearWulfrumAcrobaticsPack: {
	Title: "Wulfrum Acrobatics Pack"
	Contents: "[c/6CC4E8:Accessory] Equip Wulfrum Acrobatics Pack. Accessory. Provides a wulfrum slingshot grappling hook. This slingshot's stats scale with your equipped hook. If the hook has special effects, the slingshot also benefits from them. The slingshot allows for advanced rope-swinging physics. Hold or to retract or extend the slingshot's rope. Automatically grap... How to get it: Craft at Anvil from 10 Wulfrum Metal Scrap, 1 Energy Core, 3 Chain"
	Tooltip: "[c/6CC4E8:Accessory] Wulfrum Acrobatics Pack: Accessory"
}

GearWulfrumBattery: {
	Title: "Wulfrum Battery"
	Contents: "[c/6CC4E8:Accessory] Equip Wulfrum Battery. Accessory. Your summons emit light if visibility is on. 7% increased summon damage. Wulfrum enemies drop additional scrap. Can also be scrapped at an extractinator. How to get it: Caught while fishing; Dropped by Wulfrum Amplifier; Dropped by Wulfrum Drone; and 3 more sources"
	Tooltip: "[c/6CC4E8:Accessory] Wulfrum Battery: Accessory"
}

GearWulfrumBobber: {
	Title: "Wulfrum Bobber"
	Contents: "[c/6CC4E8:Accessory] Equip Wulfrum Bobber. Accessory. Provides a fishing minigame. Hold movement inputs in the indicated directions while fishing to catch items. The rod empowers the longer you go without a mistake, speeding it up. 'There's supposed to be a fish finder installed, but it only beeps when you point it at yourself...'. How to get it: Craft at Anvil from 5 Wulfrum Metal Scrap"
	Tooltip: "[c/6CC4E8:Accessory] Wulfrum Bobber: Accessory"
}

GearAbaddon: {
	Title: "Abaddon"
	Contents: "[c/6CC4E8:Accessory] Equip Abaddon. Accessory. Critical strikes curse enemies with Bane that scales off of your critical strike chance. When critically hit, enemies spread all debuffs they are afflicted with that are weaker than your Bane to nearby enemies. How to get it: Dropped by Red Devil"
	Tooltip: "[c/6CC4E8:Accessory] Abaddon: Accessory"
}

GearAeroStone: {
	Title: "Aero Stone"
	Contents: "[c/6CC4E8:Accessory] Equip Aero Stone. Accessory. Grants 0.83 additional seconds of flight time. You slowly recover flight time while in the air while not flying or gliding. 'One of the ancient relics'. How to get it: Dropped by Wyvern Head"
	Tooltip: "[c/6CC4E8:Accessory] Aero Stone: Accessory"
}

GearAmalgamatedBrain: {
	Title: "Amalgamated Brain"
	Contents: "[c/6CC4E8:Accessory] Equip Amalgamated Brain. Accessory. Taking damage confuses nearby enemies and spawns a dank creeper. The dank creeper flies above you, exploding into several shaderain clouds. Grants or improves the ability to dodge attacks. After dodging, summon damage and crit chance are boosted by 10%. How to get it: Craft at Anvil from 1 Rotten Brain, 1 Brain Of Confusion, 3 Soul of Night"
	Tooltip: "[c/6CC4E8:Accessory] Amalgamated Brain: Accessory"
}

GearAngelTreads: {
	Title: "Angel Treads"
	Contents: "[c/6CC4E8:Accessory] Equip Angel Treads. Accessory. Allows flight, super fast running, and extra mobility on ice. 12% increased movement speed and 10% increased flight time. Provides the ability to walk on water, honey & lava. Grants immunity to fire blocks and 7 seconds of immunity to lava. Reduces damage from touching lava. 'Extreme speed!'. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Terraspark Boots, 1 Harpy Ring, 5 Essence of Sunlight, 1 Soul of Fright, 1 Soul of Might, 1 Soul of Sight"
	Tooltip: "[c/6CC4E8:Accessory] Angel Treads: Accessory"
}

GearAquaticEmblem: {
	Title: "Aquatic Emblem"
	Contents: "[c/6CC4E8:Accessory] Equip Aquatic Emblem. Accessory. Most ocean enemies become friendly and allows breathing underwater. Being underwater gradually increases defense but slows movement speed over 10 seconds. This effect slowly vanishes outside of water and resets while mounted. Maximum defense boost is 15 and movement speed reduction is 10%. Provid... How to get it: Found in Treasure Bag (Aquatic Scourge)"
	Tooltip: "[c/6CC4E8:Accessory] Aquatic Emblem: Accessory"
}

GearAquaticHeart: {
	Title: "Aquatic Heart"
	Contents: "[c/6CC4E8:Accessory] Equip Aquatic Heart. Accessory. Transforms the holder into a light-emitting water elemental. How to get it: Dropped by ???"
	Tooltip: "[c/6CC4E8:Accessory] Aquatic Heart: Accessory"
}

GearBloodyWormScarf: {
	Title: "Bloody Worm Scarf"
	Contents: "[c/6CC4E8:Accessory] Equip Bloody Worm Scarf. Accessory, 2 defense. 10% increased damage reduction and melee damage. How to get it: Craft at Anvil from 1 Bloody Worm Tooth, 1 Worm Scarf, 3 Soul of Night"
	Tooltip: "[c/6CC4E8:Accessory] Bloody Worm Scarf: Accessory, 2 defense"
}

GearCorrosiveSpine: {
	Title: "Corrosive Spine"
	Contents: "[c/6CC4E8:Accessory] Equip Corrosive Spine. Accessory. 5% increased movement speed. 50% increased Sickness and Water debuff damage. All attacks inflict Irradiated and reduces the severity of the sulphuric waters. You burst into radioactive clouds when struck. How to get it: Found in Treasure Bag (Aquatic Scourge); Dropped by Aquatic Scourge"
	Tooltip: "[c/6CC4E8:Accessory] Corrosive Spine: Accessory"
}

GearCryoStone: {
	Title: "Cryo Stone"
	Contents: "[c/6CC4E8:Accessory] Equip Cryo Stone. Accessory. 50% increased Cold debuff damage. Creates a rotating ice shield around you that damages and slows down enemies on contact. 'One of the ancient relics'. How to get it: Found in Treasure Bag (Cryogen); Dropped by Cryogen"
	Tooltip: "[c/6CC4E8:Accessory] Cryo Stone: Accessory"
}

GearDeepDiver: {
	Title: "Deep Diver"
	Contents: "[c/6CC4E8:Accessory] Equip Deep Diver. Accessory. Allows the ability to dash with a shorter cooldown. This dash can ram through enemies without taking damage. Provides greatly improved water mobility. How to get it: Craft at Anvil from 25 Sea Prism, 5 Mollusk Husk, 10 Any Cobalt Bar"
	Tooltip: "[c/6CC4E8:Accessory] Deep Diver: Accessory"
}

GearElectriciansGlove: {
	Title: "Electrician's Glove"
	Contents: "[c/6CC4E8:Accessory] Equip Electrician's Glove. Accessory. Stealth strikes summon sparks on enemy hits and heal you for 10 HP. Stealth strikes also have +8 armor penetration and deal 8% more damage. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Filthy Glove, 100 Wire, 5 Any Mythril Bar (+1 alternative recipe)"
	Tooltip: "[c/6CC4E8:Accessory] Electrician's Glove: Accessory"
}

GearElementalinaBottle: {
	Title: "Elemental in a Bottle"
	Contents: "[c/6CC4E8:Accessory] Equip Elemental in a Bottle. Accessory. Summons a sand elemental to fight for you. The elemental has reduced opacity if visibility is disabled. How to get it: Dropped by Sand Elemental"
	Tooltip: "[c/6CC4E8:Accessory] Elemental in a Bottle: Accessory"
}

GearEvasionScarf: {
	Title: "Evasion Scarf"
	Contents: "[c/6CC4E8:Accessory] Equip Evasion Scarf. Accessory. Grants the ability to dash; dashing into an attack will cause you to dodge it. After a successful dodge you must wait 30 seconds before you can dodge again. Has a shorter dash cooldown than most dashes. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Counter Scarf, 5 Soul of Light, 5 Soul of Night, 15 Silk"
	Tooltip: "[c/6CC4E8:Accessory] Evasion Scarf: Accessory"
}

GearEyeoftheStorm: {
	Title: "Eye of the Storm"
	Contents: "[c/6CC4E8:Accessory] Equip Eye of the Storm. Accessory. Summons a Cloud Elemental to fight for you. The elemental has reduced opacity if visibility is disabled. How to get it: Dropped by Cloud Elemental"
	Tooltip: "[c/6CC4E8:Accessory] Eye of the Storm: Accessory"
}

GearFlameLickedShell: {
	Title: "Flame-Licked Shell"
	Contents: "[c/6CC4E8:Accessory] Equip Flame-Licked Shell. Accessory. Grants immunity to knockback. Pressing the bound key will activate a parry, encasing you in rocks. Being hit shortly after encasement will implode the rocks. Upon implosion, a ring of brimstone hellfire is launched outwards and you receive 90% DR for that hit. After imploding, this damage reducti... How to get it: Found in Treasure Bag (Brimstone Elemental)"
	Tooltip: "[c/6CC4E8:Accessory] Flame-Licked Shell: Accessory"
}

GearFrostBarrier: {
	Title: "Frost Barrier"
	Contents: "[c/6CC4E8:Accessory] Equip Frost Barrier. Accessory, 10 defense. You will freeze nearby enemies when you are struck. Grants immunity to Chilled and Frostburn. How to get it: Dropped by Ice Clasper"
	Tooltip: "[c/6CC4E8:Accessory] Frost Barrier: Accessory, 10 defense"
}

GearFrostFlare: {
	Title: "Frost Flare"
	Contents: "[c/6CC4E8:Accessory] Equip Frost Flare. Accessory. All attacks and projectiles inflict Frostburn 2. Being above 50% life grants 10% increased damage. Being below 50% life grants 10 defense and 15% increased max movement speed and acceleration. Grants resistance against cold attacks, Frostburn, Chilled and Frozen. How to get it: Found in Treasure Bag (Cryogen); Dropped by Cryogen"
	Tooltip: "[c/6CC4E8:Accessory] Frost Flare: Accessory"
}

GearGiantTortoiseShell: {
	Title: "Giant Tortoise Shell"
	Contents: "[c/6CC4E8:Accessory] Equip Giant Tortoise Shell. Accessory, 6 defense. Grants immunity to knockback. 10% increased damage reduction and 10% reduced dash velocity. Taking a hit restores dash velocity and reduces defense and damage reduction for 3 seconds. How to get it: Craft at Anvil from 1 Giant Shell, 1 Turtle Shell"
	Tooltip: "[c/6CC4E8:Accessory] Giant Tortoise Shell: Accessory, 6 defense"
}

GearGrandGelatin: {
	Title: "Grand Gelatin"
	Contents: "[c/6CC4E8:Accessory] Equip Grand Gelatin. Accessory. 12% increased movement speed and jump speed. Using a healing potion creates a cleansing aura which lasts for 30 seconds. Entering the aura removes all debuffs one time and grants +2 HP/s life regen. How to get it: Craft at Anvil from 1 Cleansing Jelly, 1 Life Jelly, 1 Vital Jelly, 2 Soul of Light, 2 Soul of Night"
	Tooltip: "[c/6CC4E8:Accessory] Grand Gelatin: Accessory"
}

GearHallowedRune: {
	Title: "Hallowed Rune"
	Contents: "[c/6CC4E8:Accessory] Equip Hallowed Rune. Accessory. Minion attacks provide various buffs. Does not stack with downgrades. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Spirit Glyph, 18 Hallowed Bar, 5 Soul of Fright, 5 Soul of Might, 5 Soul of Sight"
	Tooltip: "[c/6CC4E8:Accessory] Hallowed Rune: Accessory"
}

GearHowlsHeart: {
	Title: "Howl's Heart"
	Contents: "[c/6CC4E8:Accessory] Equip Howl's Heart. Accessory. Summons Howl to fight for you, Calcifer to light your way, and Turnip-Head to follow you around. Placing this accessory in vanity slots will summon the trio without the combat or exploration utilities. How to get it: Sold by Wizard"
	Tooltip: "[c/6CC4E8:Accessory] Howl's Heart: Accessory"
}

GearJellyChargedBattery: {
	Title: "Jelly-Charged Battery"
	Contents: "[c/6CC4E8:Accessory] Equip Jelly-Charged Battery. Accessory. Increases your max number of minions by 1, and summon damage by 7%. Minion attacks create charged orbs. How to get it: Craft at Anvil from 1 Wulfrum Battery, 1 Voltaic Jelly, 10 Purified Gel, 2 Stormlion Mandible"
	Tooltip: "[c/6CC4E8:Accessory] Jelly-Charged Battery: Accessory"
}

GearMOAB: {
	Title: "MOAB"
	Contents: "[c/6CC4E8:Accessory] Equip MOAB. Accessory. Allows flight and slow fall. Hold UP to boost faster. 32% increased jump speed and allows auto-jump. Grants the player cloud, blizzard, and sandstorm mid-air jumps. Shift-Right Click this item in your inventory to toggle the jetpack. 'The Mother Of All Balloons'. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Frog Leg, 1 Horseshoe Bundle, 1 Jetpack, 1 Soul of Fright, 1 Soul of Might, 1 Soul of Sight"
	Tooltip: "[c/6CC4E8:Accessory] MOAB: Accessory"
}

GearManaPolarizer: {
	Title: "Mana Polarizer"
	Contents: "[c/6CC4E8:Accessory] Equip Mana Polarizer. Accessory. Increases maximum mana by 40. Provides life regeneration and magic damage that scales based on how much mana you have. Lower mana means more life regeneration, but less magic damage. These scale from -2 to +2 HP/s, and 15% to 5% damage. The provided regeneration is halved when under Mana Sickness... How to get it: Found in Treasure Bag (The Slime God)"
	Tooltip: "[c/6CC4E8:Accessory] Mana Polarizer: Accessory"
}

GearNuclearFuelRod: {
	Title: "Nuclear Fuel Rod"
	Contents: "[c/6CC4E8:Accessory] Equip Nuclear Fuel Rod. Accessory. Increases your max number of minions by 1. Minions release an Irradiated aura on enemy hits. Grants immunity to Irradiated. How to get it: Dropped by Cragmaw Mire"
	Tooltip: "[c/6CC4E8:Accessory] Nuclear Fuel Rod: Accessory"
}

GearOasisElementalinaBottle: {
	Title: "Oasis Elemental in a Bottle"
	Contents: "[c/6CC4E8:Accessory] Equip Oasis Elemental in a Bottle. Accessory. Summons an oasis elemental to assist you. The elemental fires healing orbs that restore 10 health while you are damaged. The elemental has reduced opacity if visibility is disabled. How to get it: Dropped by Sand Elemental"
	Tooltip: "[c/6CC4E8:Accessory] Oasis Elemental in a Bottle: Accessory"
}

GearOrnateShield: {
	Title: "Ornate Shield"
	Contents: "[c/6CC4E8:Accessory] Equip Ornate Shield. Accessory, 2 defense. Allows the ability to dash. This dash can ram through enemies without taking damage. How to get it: Craft at Mythril/Orichalcum Anvil from 12 Cryonic Bar, 20 Crystal Shard, 6 Fragment of Permafrost"
	Tooltip: "[c/6CC4E8:Accessory] Ornate Shield: Accessory, 2 defense"
}

GearPermafrostsConcoction: {
	Title: "Permafrost's Concoction"
	Contents: "[c/6CC4E8:Accessory] Equip Permafrost's Concoction. Accessory. Increases maximum mana by 40 and reduces mana cost by 15%. +0.5 HP/s life regen below half health, +1 HP/s when below 25% health and +2 HP/s when below 10% health. +3 HP/s life regen while afflicted with any fire debuff. You will survive fatal damage and revive with 30% life on a 3 minute cooldow... How to get it: Sold by Archmage"
	Tooltip: "[c/6CC4E8:Accessory] Permafrost's Concoction: Accessory"
}

GearRadiantOoze: {
	Title: "Radiant Ooze"
	Contents: "[c/6CC4E8:Accessory] Equip Radiant Ooze. Accessory. +X to +X HP/s life regen based on missing health. You emit yellow light if visibility is enabled. (Current regen: +[REGEN HP/s)]. How to get it: Craft at Anvil from 45 Blighted Gel, 15 Purified Gel"
	Tooltip: "[c/6CC4E8:Accessory] Radiant Ooze: Accessory"
}

GearRogueEmblem: {
	Title: "Rogue Emblem"
	Contents: "[c/6CC4E8:Accessory] Equip Rogue Emblem. Accessory. 15% increased rogue damage. How to get it: Found in Treasure Bag (Wall Of Flesh); Dropped by Wall of Flesh"
	Tooltip: "[c/6CC4E8:Accessory] Rogue Emblem: Accessory"
}

GearRoseStone: {
	Title: "Rose Stone"
	Contents: "[c/6CC4E8:Accessory] Equip Rose Stone. Accessory. Summons a Brimstone Elemental to fight for you. The elemental has reduced opacity if visibility is disabled. How to get it: Found in Treasure Bag (Brimstone Elemental); Dropped by Brimstone Elemental"
	Tooltip: "[c/6CC4E8:Accessory] Rose Stone: Accessory"
}

GearRuinMedallion: {
	Title: "Ruin Medallion"
	Contents: "[c/6CC4E8:Accessory] Equip Ruin Medallion. Accessory. Stealth strikes only expend 75% of your max stealth. 6% increased rogue damage and rogue crit chance. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Coin of Deceit, 4 Unholy Core, 2 Essence of Havoc"
	Tooltip: "[c/6CC4E8:Accessory] Ruin Medallion: Accessory"
}

GearSlagsplitterPauldron: {
	Title: "Slagsplitter Pauldron"
	Contents: "[c/6CC4E8:Accessory] Equip Slagsplitter Pauldron. Accessory. Your dashes become empowered by On Fire 3, erupting on contact with enemies. Grants immunity to knockback and 10% damage reduction while dashing. Enemies hit by your dashes are afflicted with Armor Crunch. Visual effects are reduced if visibility is disabled. How to get it: Craft at Anvil from 12 Scorched Bone, 4 Ancient Bone Dust, 8 Essence of Havoc"
	Tooltip: "[c/6CC4E8:Accessory] Slagsplitter Pauldron: Accessory"
}

GearSoulofCryogen: {
	Title: "Soul of Cryogen"
	Contents: "[c/6CC4E8:Accessory] Equip Soul of Cryogen. Accessory. Allows flight and slow fall. Icicles rain down as you fly. How to get it: Found in Treasure Bag (Cryogen)"
	Tooltip: "[c/6CC4E8:Accessory] Soul of Cryogen: Accessory"
}

GearSpelunkersAmulet: {
	Title: "Spelunker's Amulet"
	Contents: "[c/6CC4E8:Accessory] Equip Spelunker's Amulet. Accessory. Spelunker effect and 10% increased mining speed. How to get it: Craft at Anvil from 7 Gold Dust, 7 Spelunker Potion; Found in Underground Shrines chests"
	Tooltip: "[c/6CC4E8:Accessory] Spelunker's Amulet: Accessory"
}

GearStarlightWings: {
	Title: "Starlight Wings"
	Contents: "[c/6CC4E8:Accessory] Equip Starlight Wings. Accessory. Allows flight and slow fall. Wings of the Nightingale. How to get it: Craft at Mythril/Orichalcum Anvil from 20 Soul of Flight, 10 Cryonic Bar"
	Tooltip: "[c/6CC4E8:Accessory] Starlight Wings: Accessory"
}

GearSupremeBaitTackleBoxFishingStation: {
	Title: "Supreme Bait Tackle Box Fishing Station"
	Contents: "[c/6CC4E8:Accessory] Equip Supreme Bait Tackle Box Fishing Station. Accessory. Increases fishing power by 50. Fishing line will never break and decreases chance of bait consumption. Allows fishing in lava. How to get it: Craft at Anvil from 1 Lavapro of Tackle Bag, 5 Master Bait, 5 Mollusk Husk"
	Tooltip: "[c/6CC4E8:Accessory] Supreme Bait Tackle Box Fishing Station: Accessory"
}

GearTheFirstShadowflame: {
	Title: "The First Shadowflame"
	Contents: "[c/6CC4E8:Accessory] Equip The First Shadowflame. Accessory. Increases your max number of minions by 1. Minion attacks inflict Shadowflame, and grants immunity to Shadowflame. How to get it: Dropped by Goblin Summoner"
	Tooltip: "[c/6CC4E8:Accessory] The First Shadowflame: Accessory"
}

GearThePact: {
	Title: "The Pact"
	Contents: "[c/6CC4E8:Accessory] Equip The Pact. Accessory. Increases your max health by Xx. Causes X% of hits you take to critically strike you. These crits deal Xx damage and infict Fulfilled Contract. How to get it: Sold by Shady Salesman"
	Tooltip: "[c/6CC4E8:Accessory] The Pact: Accessory"
}

GearTheTransformer: {
	Title: "The Transformer"
	Contents: "[c/6CC4E8:Accessory] Equip The Transformer. Accessory. How to get it: Craft at Mythril/Orichalcum Anvil from 10 Sea Prism, 5 Any Mythril Bar, 2 Essence of Sunlight, 2 Essence of Havoc, 2 Essence of Eleum, 3 Soul of Light, 3 Soul of Night"
	Tooltip: "[c/6CC4E8:Accessory] The Transformer: Accessory"
}

GearUrsaSergeant: {
	Title: "Ursa Sergeant"
	Contents: "[c/6CC4E8:Accessory] Equip Ursa Sergeant. Accessory. Attacks maul enemies with astral claw swipes that inflict Astral Infection. Taking damage reduces the cooldown, but inflicts you with Astral Infection. Enemy kills also reduce the cooldown. Swipes will be translucent and silent if visibility is disabled. How to get it: Caught while fishing"
	Tooltip: "[c/6CC4E8:Accessory] Ursa Sergeant: Accessory"
}

GearV8Engine: {
	Title: "V8 Engine"
	Contents: "[c/6CC4E8:Accessory] Equip V8 Engine. Accessory. Grants a short dash with a long cooldown that works while mounted. How to get it: Craft at Mythril/Orichalcum Anvil from 5 Any Adamantite Bar, 4 Unholy Core"
	Tooltip: "[c/6CC4E8:Accessory] V8 Engine: Accessory"
}

GearAbyssalDivingGear: {
	Title: "Abyssal Diving Gear"
	Contents: "[c/6CC4E8:Accessory] Equip Abyssal Diving Gear. Accessory. Reduces the damage caused by the pressure of the abyss while out of breath. Grants the ability to swim and greatly extends underwater breathing. Provides light underwater and extra mobility on ice. Provides a moderate amount of light and reduces breath loss in the abyss. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Arctic Diving Gear, 1 Depths Charm, 20 Depth Cells, 15 Lumenyl"
	Tooltip: "[c/6CC4E8:Accessory] Abyssal Diving Gear: Accessory"
}

GearAbyssalMirror: {
	Title: "Abyssal Mirror"
	Contents: "[c/6CC4E8:Accessory] Equip Abyssal Mirror. Accessory. Enemies are less likely to target you, even in the abyss. Generate stealth 25% faster when standing still and 12% faster while moving. Grants or improves the ability to dodge attacks. Dodging an attack restores stealth and releases a cloud that damages and stuns nearby enemies. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Mirage Mirror, 1 Ink Bomb, 20 Depth Cells, 15 Lumenyl"
	Tooltip: "[c/6CC4E8:Accessory] Abyssal Mirror: Accessory"
}

GearAlchemicalDecanter: {
	Title: "Alchemical Decanter"
	Contents: "[c/6CC4E8:Accessory] Equip Alchemical Decanter. Accessory. All attacks inflict the Plague and reduces damage taken from the Plague by 50%. Projectiles spawn plague seekers on enemy hits. Releases plague bees and douses you in Honey when damaged. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Bottled Water, 1 Honey Comb, 8 Bee Wax, 15 Plague Cell Canister; Dropped by Queen Bee"
	Tooltip: "[c/6CC4E8:Accessory] Alchemical Decanter: Accessory"
}

GearApollyon: {
	Title: "Apollyon"
	Contents: "[c/6CC4E8:Accessory] Equip Apollyon. Accessory. Critical strikes curse enemies with Bane that greatly scales off of your critical strike chance. When critically hit, enemies spread all debuffs they are afflicted with that are weaker than your Bane to nearby enemies. Critical strikes deal an additional 3% damage per debuff on the enemy. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Abaddon, 1 Eyeofthe Golem, 4 Unholy Core, 2 Core of Calamity"
	Tooltip: "[c/6CC4E8:Accessory] Apollyon: Accessory"
}

GearAsgardsValor: {
	Title: "Asgard's Valor"
	Contents: "[c/6CC4E8:Accessory] Equip Asgard's Valor. Accessory, 4 defense. Grants immunity to knockback. Allows the ability to ram dash. This dash can ram through enemies without taking damage. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Ornate Shield, 5 Hallowed Bar, 1 Core of Calamity, 4 Absolute Alloy"
	Tooltip: "[c/6CC4E8:Accessory] Asgard's Valor: Accessory, 4 defense"
}

GearAureateBooster: {
	Title: "Aureate Booster"
	Contents: "[c/6CC4E8:Accessory] Equip Aureate Booster. Accessory. Allows flight and slow fall. Hold UP to boost faster. 'Mach speed with style!'. How to get it: Craft at Mythril/Orichalcum Anvil from 20 Soul of Flight, 10 Perennial Bar"
	Tooltip: "[c/6CC4E8:Accessory] Aureate Booster: Accessory"
}

GearBaroclaw: {
	Title: "Baroclaw"
	Contents: "[c/6CC4E8:Accessory] Equip Baroclaw. Accessory. 10% increased damage and 5% increased damage reduction. Attackers take high damage and are inflicted with Armor Crunch and Crush Depth. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Craw Carapace, 20 Depth Cells"
	Tooltip: "[c/6CC4E8:Accessory] Baroclaw: Accessory"
}

GearBloodPact: {
	Title: "Blood Pact"
	Contents: "[c/6CC4E8:Accessory] Equip Blood Pact. Accessory. Increases max HP by 25%. Healing Potions are 33% more effective. Grants immunity to Bleeding, Burning Blood and Heavy Bleeding. How to get it: Found in Treasure Bag (Ravager)"
	Tooltip: "[c/6CC4E8:Accessory] Blood Pact: Accessory"
}

GearBloomStone: {
	Title: "Bloom Stone"
	Contents: "[c/6CC4E8:Accessory] Equip Bloom Stone. Accessory. Healing Potions are 50% more effective, but provide their healing over time. Grappling hooks retract and pull the player 30 mph faster, and grow a flower at hookpoints. Touching a flower makes it burst into pollen which gives a temporary boost to potion healing over time. Potion healing slows dra... How to get it: Found in Treasure Bag (Plantera); Dropped by Plantera"
	Tooltip: "[c/6CC4E8:Accessory] Bloom Stone: Accessory"
}

GearChaosStone: {
	Title: "Chaos Stone"
	Contents: "[c/6CC4E8:Accessory] Equip Chaos Stone. Accessory. Disables automatic potion consumption. Items that consume mana can be used even without the required mana amount. Mana usage can overflow into negative mana, causing you to both receive and inflict Mana Burn. The lower your mana, the more intense the manafire burns. Negative Mana is capped at you... How to get it: Found in Treasure Bag (Calamitas Clone); Dropped by Calamitas Clone"
	Tooltip: "[c/6CC4E8:Accessory] Chaos Stone: Accessory"
}

GearDeadshotBrooch: {
	Title: "Deadshot Brooch"
	Contents: "[c/6CC4E8:Accessory] Equip Deadshot Brooch. Accessory. 12% increased ranged damage, 7% increased ranged critical strike chance and 20% reduced ammo usage. Pressing the bound key will automatically swap the order of ammos in your ammo slots. The ammo type swapped depends on the ammo of the weapon you are holding. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Ranger Emblem, 2 Core of Calamity"
	Tooltip: "[c/6CC4E8:Accessory] Deadshot Brooch: Accessory"
}

GearDeificAmulet: {
	Title: "Deific Amulet"
	Contents: "[c/6CC4E8:Accessory] Equip Deific Amulet. Accessory. Releases a burst of homing star-bees and drenches you in Honey after taking damage. Increases the length of invincibility, with it increasing even more when at low health. Shift-Right Click this item in your inventory to toggle Panic Necklace's effect. How to get it: Craft at Tinkerer's Workshop from 1 Star Veil, 1 Sweetheart Necklace, 10 Astral Bar (+1 alternative recipe)"
	Tooltip: "[c/6CC4E8:Accessory] Deific Amulet: Accessory"
}

GearDiamondOfTheDeep: {
	Title: "Diamond of the Deep"
	Contents: "[c/6CC4E8:Accessory] Equip Diamond of the Deep. Accessory. 60% increased Water debuff damage. Slowly accrue up to three different abyssal spirits. Dash to disperse the spirits and have them attack enemies. When dispersed below 50% life, the spirits support you instead. The spirits appear in order and have different effects based on color: Explodes on imp... How to get it: Craft at Mythril/Orichalcum Anvil from 1 Sea Spirit Amulet, 5 Scoria Bar, 20 Abyss Gravel, 20 Pyre Mantle, 20 Voidstone, 20 Depth Cells, 15 Lumenyl"
	Tooltip: "[c/6CC4E8:Accessory] Diamond of the Deep: Accessory"
}

GearEtherealExtorter: {
	Title: "Ethereal Extorter"
	Contents: "[c/6CC4E8:Accessory] Equip Ethereal Extorter. Accessory. Rogue projectiles explode into homing souls on hit. 8% increased rogue damage and +5 maximum stealth. How to get it: Sold by Bandit"
	Tooltip: "[c/6CC4E8:Accessory] Ethereal Extorter: Accessory"
}

GearFeralBobber: {
	Title: "Feral Bobber"
	Contents: "[c/6CC4E8:Accessory] Equip Feral Bobber. Accessory. Gains fishing power the more life you have lost. Provides a fishing minigame. Hold Right Click while catching fish to drain life and speed up catches. Bobbers can hook onto enemies, dealing damage when life is drained. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Fishing Bobber, 5 Perennial Bar"
	Tooltip: "[c/6CC4E8:Accessory] Feral Bobber: Accessory"
}

GearFleshTotem: {
	Title: "Flesh Totem"
	Contents: "[c/6CC4E8:Accessory] Equip Flesh Totem. Accessory. 5% increased magic critical strike chance. Increases maximum mana by 20. Summons an effigy above your head that stores mana as you use it, up to 600 mana. The effigy occasionally pulses, restoring 25 mana. Pulses appear more frequently the more mana is stored. Upon being struck, the effigy unleas... How to get it: Found in Treasure Bag (Ravager); Dropped by Ravager"
	Tooltip: "[c/6CC4E8:Accessory] Flesh Totem: Accessory"
}

GearGloveOfPrecision: {
	Title: "Glove of Precision"
	Contents: "[c/6CC4E8:Accessory] Equip Glove of Precision. Accessory. Decreases rogue attack speed by 15%. Increases rogue damage and critical strike chance by 10%, and velocity by 15%. How to get it: Sold by Bandit"
	Tooltip: "[c/6CC4E8:Accessory] Glove of Precision: Accessory"
}

GearGloveOfRecklessness: {
	Title: "Glove of Recklessness"
	Contents: "[c/6CC4E8:Accessory] Equip Glove of Recklessness. Accessory. Increases rogue attack speed by 15%, but decreases damage by 10% and crit by 5%. 15% increased stealth regeneration. Makes rogue weapons slightly inaccurate. How to get it: Sold by Bandit"
	Tooltip: "[c/6CC4E8:Accessory] Glove of Recklessness: Accessory"
}

GearHadalMantle: {
	Title: "Hadal Mantle"
	Contents: "[c/6CC4E8:Accessory] Equip Hadal Mantle. Accessory. Allows flight and slow fall. Fueled by the fury of the depths. How to get it: Craft at Mythril/Orichalcum Anvil from 20 Soul of Flight, 10 Scoria Bar"
	Tooltip: "[c/6CC4E8:Accessory] Hadal Mantle: Accessory"
}

GearHadarianWings: {
	Title: "Hadarian Wings"
	Contents: "[c/6CC4E8:Accessory] Equip Hadarian Wings. Accessory. Allows flight and slow fall. Press DOWN to toggle hover. Powered by the Astral Infection. How to get it: Dropped by Hadarian"
	Tooltip: "[c/6CC4E8:Accessory] Hadarian Wings: Accessory"
}

GearHideofAstrumDeus: {
	Title: "Hide of Astrum Deus"
	Contents: "[c/6CC4E8:Accessory] Equip Hide of Astrum Deus. Accessory. True melee strikes drops astral stars from the sky. Releases an explosion and temporarily increases true melee damage by 30% when damaged. Boost duration scales with the amount of damage you took, up to 10 seconds. Nullifies the Astral Infection. How to get it: Found in Treasure Bag (Astrum Deus)"
	Tooltip: "[c/6CC4E8:Accessory] Hide of Astrum Deus: Accessory"
}

GearInfectedJewel: {
	Title: "Infected Jewel"
	Contents: "[c/6CC4E8:Accessory] Equip Infected Jewel. Accessory. +1 HP/s life regen. Reduces damage over time taken by 6 HP/s. Jump-starts regeneration after a damaging debuff ends. 'A beautiful gemstone tarnished by spaceborne rot'. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Crown Jewel, 10 Aureus Cell, 25 Starblight Soot"
	Tooltip: "[c/6CC4E8:Accessory] Infected Jewel: Accessory"
}

GearInterstellarStompers: {
	Title: "Interstellar Stompers"
	Contents: "[c/6CC4E8:Accessory] Equip Interstellar Stompers. Accessory. 6% increased movement speed, 20% increased jump speed, and negates fall damage. Hold to increase your maximum fall speed. Pressing the bound key while midair charges up a superspeed slam over 0.33 seconds. While falling, you ram through enemies and don't take contact damage. Once you hit the grou... How to get it: Found in Treasure Bag (Astrum Aureus)"
	Tooltip: "[c/6CC4E8:Accessory] Interstellar Stompers: Accessory"
}

GearLeviathanAmbergris: {
	Title: "Leviathan Ambergris"
	Contents: "[c/6CC4E8:Accessory] Equip Leviathan Ambergris. Accessory. 100% increased initial dash velocity, 33% faster dash cooldown, and greatly increased dash deceleration. Your dashes are empowered by water, knocking back and damaging enemies with vicious currents. Visual effects are reduced if visibility is disabled. How to get it: Found in Treasure Bag (Leviathan and Anahita)"
	Tooltip: "[c/6CC4E8:Accessory] Leviathan Ambergris: Accessory"
}

GearLivingDew: {
	Title: "Living Dew"
	Contents: "[c/6CC4E8:Accessory] Equip Living Dew. Accessory. Natural life regen is X% more potent and returns X% faster. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Honey Dew, 6 Living Shard, 5 Essence of Sunlight"
	Tooltip: "[c/6CC4E8:Accessory] Living Dew: Accessory"
}

GearNecklaceofVexation: {
	Title: "Necklace of Vexation"
	Contents: "[c/6CC4E8:Accessory] Equip Necklace of Vexation. Accessory. Up to 30% increased damage the lower your life is. Current boost: %. All attacks inflict Venom. Revenge. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Avenger Emblem, 10 Perennial Bar"
	Tooltip: "[c/6CC4E8:Accessory] Necklace of Vexation: Accessory"
}

GearPearlofEnthrallment: {
	Title: "Pearl of Enthrallment"
	Contents: "[c/6CC4E8:Accessory] Equip Pearl of Enthrallment. Accessory. Summons a water elemental to fight for you. The elemental stays above you, shooting water spears, ice mist, and treble clefs at nearby enemies. The elemental has reduced opacity if visibility is disabled. How to get it: Found in Treasure Bag (Leviathan and Anahita); Dropped by The Leviathan"
	Tooltip: "[c/6CC4E8:Accessory] Pearl of Enthrallment: Accessory"
}

GearPlaguedFuelPack: {
	Title: "Plagued Fuel Pack"
	Contents: "[c/6CC4E8:Accessory] Equip Plagued Fuel Pack. Accessory. 8% increased rogue damage and 15% increased rogue projectile velocity. Stealth generates 10% faster. Press the bound key to consume 25% of your maximum stealth to perform a swift upwards diagonal dash. The dash leaves a lingering trail of Plague clouds. This effect has a 1 second cooldown before... How to get it: Dropped by Plaguebringer"
	Tooltip: "[c/6CC4E8:Accessory] Plagued Fuel Pack: Accessory"
}

GearRegenerator: {
	Title: "Regenerator"
	Contents: "[c/6CC4E8:Accessory] Equip Regenerator. Accessory. Your health cannot exceed 50% of its maximum. Increases length of invincibility after taking damage. Provides powerful special life regen to heal you for 7.5 HP/s. All normal life regen is negated and converted into damage. Current damage boost: %. How to get it: Found in Treasure Bag (Calamitas Clone); Dropped by Calamitas Clone"
	Tooltip: "[c/6CC4E8:Accessory] Regenerator: Accessory"
}

GearSandSharkToothNecklace: {
	Title: "Sand Shark Tooth Necklace"
	Contents: "[c/6CC4E8:Accessory] Equip Sand Shark Tooth Necklace. Accessory. Increases armor penetration by 10. 10% increased damage. How to get it: Craft at Tinkerer's Workshop from 1 Shark Tooth Necklace, 1 Avenger Emblem, 1 Grand Scale"
	Tooltip: "[c/6CC4E8:Accessory] Sand Shark Tooth Necklace: Accessory"
}

GearShieldoftheHighRuler: {
	Title: "Shield of the High Ruler"
	Contents: "[c/6CC4E8:Accessory] Equip Shield of the High Ruler. Accessory, 4 defense. +10 max life. Grants immunity to knockback and most debuffs. Grants an improved Shield of Cthulhu dash. Bonking an enemy halves dash cooldown time. Facing a projectile when it hits you reduces its damage by 15%. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Eo C Shield, 1 Cobalt Shield, 4 Life Alloy"
	Tooltip: "[c/6CC4E8:Accessory] Shield of the High Ruler: Accessory, 4 defense"
}

GearSigilofCalamitas: {
	Title: "Sigil of Calamitas"
	Contents: "[c/6CC4E8:Accessory] Equip Sigil of Calamitas. Accessory. Increases maximum mana by 60. 15% increased magic damage. Increases pickup range for mana stars. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Celestial Emblem, 8 Scoria Bar, 15 Ashes of Calamity"
	Tooltip: "[c/6CC4E8:Accessory] Sigil of Calamitas: Accessory"
}

GearStarTaintedGenerator: {
	Title: "Star-Tainted Generator"
	Contents: "[c/6CC4E8:Accessory] Equip Star-Tainted Generator. Accessory. Increases your max number of minions by 2, and summon damage by 7%. Minion attacks spawn astral explosions and inflict several debuffs. Grants immunity to Irradiated. Does not stack with downgrades. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Jelly-Charged Battery, 1 Nuclear Fuel Rod, 1 Starbuster Core, 3 Life Alloy"
	Tooltip: "[c/6CC4E8:Accessory] Star-Tainted Generator: Accessory"
}

GearStarbusterCore: {
	Title: "Starbuster Core"
	Contents: "[c/6CC4E8:Accessory] Equip Starbuster Core. Accessory. Increases your max number of minions by 1. Summons release an astral explosion on enemy hits. How to get it: Dropped by Stellar Culex"
	Tooltip: "[c/6CC4E8:Accessory] Starbuster Core: Accessory"
}

GearStatisBlessing: {
	Title: "Statis' Blessing"
	Contents: "[c/6CC4E8:Accessory] Equip Statis' Blessing. Accessory. Increases your max number of minions by 2, and summon damage by 12%. Increased minion knockback. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Papyrus Scarab, 1 Pygmy Necklace, 1 Summoner Emblem, 30 Holy Water, 5 Essence of Sunlight"
	Tooltip: "[c/6CC4E8:Accessory] Statis' Blessing: Accessory"
}

GearTheCamper: {
	Title: "The Camper"
	Contents: "[c/6CC4E8:Accessory] Equip The Camper. Accessory, 10 defense. You deal 50% less damage unless stationary. Standing still grants buffs depending on held item, and creates a damaging aura around you. While moving, you regenerate health as if standing still. Increases visibility range in the abyss when standing still. 'In rest may we find victory'. How to get it: Craft at Tinkerer's Workshop from 1 Shiny Stone, 10 Campfire, 5 Heart Lantern, 1 Sharpening Station, 1 Crystal Ball, 1 Ammo Box, 1 Bewitching Table, 50 Any Food"
	Tooltip: "[c/6CC4E8:Accessory] The Camper: Accessory, 10 defense"
}

GearTheCommunity: {
	Title: "The Community"
	Contents: "[c/6CC4E8:Accessory] Equip The Community. Accessory. 'The heart of (most of) the Terraria community'. Thank you to all of our supporters who made this mod a reality! How to get it: Found in Treasure Bag (Leviathan and Anahita); Dropped by The Leviathan"
	Tooltip: "[c/6CC4E8:Accessory] The Community: Accessory"
}

GearToxicHeart: {
	Title: "Toxic Heart"
	Contents: "[c/6CC4E8:Accessory] Equip Toxic Heart. Accessory. Your heart beats with the Plague, pulsing outside of your body. Pulse frequency scale with regen, and pulses that kill enemies pulse again to heal you. 50% increased Sickness debuff damage. Effects are transparent and silent if visibility is disabled. How to get it: Found in Treasure Bag (The Plaguebringer Goliath)"
	Tooltip: "[c/6CC4E8:Accessory] Toxic Heart: Accessory"
}

GearVampiricTalisman: {
	Title: "Vampiric Talisman"
	Contents: "[c/6CC4E8:Accessory] Equip Vampiric Talisman. Accessory. Rogue critical strikes steal enemy life. Stealth strikes grant 15% critical strike chance and increased lifesteal to non-stealth strikes for 10 seconds. Stealth strikes inflict Heavy Bleeding and Armor Crunch, and deal 8% more damage. 'Possessing the talisman makes you yearn for blood'. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Raider's Talisman, 1 Rotten Dogtooth, 10 Solar Veil, 1 Broken Bat Wing"
	Tooltip: "[c/6CC4E8:Accessory] Vampiric Talisman: Accessory"
}

GearVoidofCalamity: {
	Title: "Void of Calamity"
	Contents: "[c/6CC4E8:Accessory] Equip Void of Calamity. Accessory. 12% increased damage. Calamitous flames rain down while invincible. How to get it: Found in Treasure Bag (Calamitas Clone)"
	Tooltip: "[c/6CC4E8:Accessory] Void of Calamity: Accessory"
}

GearVolcanicSinker: {
	Title: "Volcanic Sinker"
	Contents: "[c/6CC4E8:Accessory] Equip Volcanic Sinker. Accessory. Allows fishing in lava. Provides a fishing minigame. Moving while fishing instead moves your bobbers. Rifts appear over time in liquids, containing an item. When bobbers touch a rift, they automatically reel in the item within. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Fishing Bobber, 5 Scoria Bar"
	Tooltip: "[c/6CC4E8:Accessory] Volcanic Sinker: Accessory"
}

GearAbyssalDivingSuit: {
	Title: "Abyssal Diving Suit"
	Contents: "[c/6CC4E8:Accessory] Equip Abyssal Diving Suit. Accessory. Transforms the holder into an armored diver: Increases max movement speed and acceleration while underwater, but reduces it outside of water. Grants the ability to swim, extends underwater breathing, emits light underwater, and improves mobility on ice. Provides a moderate amount of light, reduce... How to get it: Craft at Mythril/Orichalcum Anvil from 1 Abyssal Diving Gear, 1 Anechoic Plating, 5 Luminite Bar, 15 Mollusk Husk"
	Tooltip: "[c/6CC4E8:Accessory] Abyssal Diving Suit: Accessory"
}

GearAffliction: {
	Title: "Affliction"
	Contents: "[c/6CC4E8:Accessory] Equip Affliction. Accessory. Gives all teammates +0.5 HP/s life regen, +10% max life, 7% damage reduction, 9 defense and 10% increased damage. How to get it: Found in Treasure Bag (Polterghast)"
	Tooltip: "[c/6CC4E8:Accessory] Affliction: Accessory"
}

GearAmbrosialAmpoule: {
	Title: "Ambrosial Ampoule"
	Contents: "[c/6CC4E8:Accessory] Equip Ambrosial Ampoule. Accessory. +X to +X HP/s life regen based on missing health (Current: +[REGEN HP/s)]. Natural life regen is X% more potent and returns X% faster. You emit yellow light if visibility is enabled. How to get it: Craft at Ancient Manipulator from 1 Living Dew, 1 Radiant Ooze, 3 Life Alloy, 6 Solar Fragment"
	Tooltip: "[c/6CC4E8:Accessory] Ambrosial Ampoule: Accessory"
}

GearArcFlashRing: {
	Title: "Arc Flash Ring"
	Contents: "[c/6CC4E8:Accessory] Equip Arc Flash Ring. Accessory. Attacks have a 5% chance to call down a lightning bolt for 3x damage. The chance is reduced for each enemy an attack hits. The bolt's damage is based on non-crit damage, but can itself crit. Bolts are transparent and silent if visibility is disabled. How to get it: Found in Treasure Bag (Storm Weaver)"
	Tooltip: "[c/6CC4E8:Accessory] Arc Flash Ring: Accessory"
}

GearAscendantInsignia: {
	Title: "Ascendant Insignia"
	Contents: "[c/6CC4E8:Accessory] Equip Ascendant Insignia. Accessory. Grants 4 additional seconds of flight time. Increases movement speed by 15%, jump speed by X%, and acceleration by 1.5x. Pressing the bound key fully restores flight time and prevents it from decreasing for 4 seconds. This ability has a 40 second cooldown. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Empress Flight Booster, 5 Effulgent Feather, 5 Divine Geode, 10 Soul of Flight"
	Tooltip: "[c/6CC4E8:Accessory] Ascendant Insignia: Accessory"
}

GearBadgeofBravery: {
	Title: "Badge of Bravery"
	Contents: "[c/6CC4E8:Accessory] Equip Badge of Bravery. Accessory. Increases melee damage and critical strike chance by 10%. Increases melee armor penetration by 5. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Warrior Emblem, 12 Uelibloom Bar"
	Tooltip: "[c/6CC4E8:Accessory] Badge of Bravery: Accessory"
}

GearBloodflareCore: {
	Title: "Bloodflare Core"
	Contents: "[c/6CC4E8:Accessory] Equip Bloodflare Core. Accessory. Grants immunity to knockback. Recovering defense damage heals you, each defense recovered gives 1 HP. Taking damage converts at least half of your total defense in defense damage. How to get it: Found in Treasure Bag (Ravager); Dropped by Ravager"
	Tooltip: "[c/6CC4E8:Accessory] Bloodflare Core: Accessory"
}

GearBlunderBooster: {
	Title: "Blunder Booster"
	Contents: "[c/6CC4E8:Accessory] Equip Blunder Booster. Accessory. 12% increased rogue damage and 15% increased rogue projectile velocity. Stealth generates 10% faster. Summons a red lightning aura around the player that electrifies nearby enemies with Vermillion Flux. The aura has reduced opacity if visibility is disabled. Press the bound key to consume 25% of... How to get it: Craft at Mythril/Orichalcum Anvil from 1 Plagued Fuel Pack, 8 Effulgent Feather"
	Tooltip: "[c/6CC4E8:Accessory] Blunder Booster: Accessory"
}

GearDaawnlightSpiritOrigin: {
	Title: "Daawnlight Spirit Origin"
	Contents: "[c/6CC4E8:Accessory] Equip Daawnlight Spirit Origin. Accessory. All ranged weapons can supercrit when critical strike chance is over 100%. Marks enemies and bosses with bullseyes which boost critical strike chance when hit. Extra critical strike chance quickly fades over time. Summons a heroic spirit from another world if visibility is on or in vanity slots. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Deadshot Brooch, 15 Mysterious Circuitry, 15 Dubious Plating, 10 Luminite Bar, 5 Vortex Fragment"
	Tooltip: "[c/6CC4E8:Accessory] Daawnlight Spirit Origin: Accessory"
}

GearDarkMatterSheath: {
	Title: "Dark Matter Sheath"
	Contents: "[c/6CC4E8:Accessory] Equip Dark Matter Sheath. Accessory. +10 maximum stealth. Stealth generation is boosted while moving if not attacking. Stealth strikes only expend 50% of your max stealth. 6% increased rogue damage and rogue crit chance. How to get it: Craft at Ancient Manipulator from 1 Silencing Sheath, 1 Ruin Medallion, 14 Meld Blob"
	Tooltip: "[c/6CC4E8:Accessory] Dark Matter Sheath: Accessory"
}

GearDivineProvidence: {
	Title: "Divine Providence"
	Contents: "[c/6CC4E8:Accessory] Equip Divine Providence. Accessory. Grants immunity to knockback. Pressing the bound key will activate a parry, encasing you in luminous profaned crystal. Being hit shortly after encasement will shatter the crystal. Upon shattering, holy stars spiral outwards and damage taken is negated. After shattering, this damage reduction effe... How to get it: Found in Treasure Bag (Providence, the Profaned Goddess)"
	Tooltip: "[c/6CC4E8:Accessory] Divine Providence: Accessory"
}

GearDynamoStemCells: {
	Title: "Dynamo Stem Cells"
	Contents: "[c/6CC4E8:Accessory] Equip Dynamo Stem Cells. Accessory. 10% increased ranged damage and movement speed. Ranged weapons fire a powerful mini swarmer every 3 seconds. Reduces damage taken from Dragonfire. How to get it: Found in Treasure Bag (The Dragonfolly)"
	Tooltip: "[c/6CC4E8:Accessory] Dynamo Stem Cells: Accessory"
}

GearElysianAegis: {
	Title: "Elysian Aegis"
	Contents: "[c/6CC4E8:Accessory] Equip Elysian Aegis. Accessory, 5 defense. Grants immunity to knockback. Allows the ability to dash, empowered by holy fire. This dash can ram through enemies without taking damage. 'Blessed by the Profaned Flame'. How to get it: Dropped by Providence, the Profaned Goddess"
	Tooltip: "[c/6CC4E8:Accessory] Elysian Aegis: Accessory, 5 defense"
}

GearElysianWings: {
	Title: "Elysian Wings"
	Contents: "[c/6CC4E8:Accessory] Equip Elysian Wings. Accessory. Allows flight and slow fall. Blessed by the Profaned Flame. How to get it: Dropped by Providence, the Profaned Goddess"
	Tooltip: "[c/6CC4E8:Accessory] Elysian Wings: Accessory"
}

GearExodusWings: {
	Title: "Exodus Wings"
	Contents: "[c/6CC4E8:Accessory] Equip Exodus Wings. Accessory. Allows flight and slow fall. Grants permanent Empyrean Wrath while wearing the Empyrean armor. Pulsing with an alien heartbeat. How to get it: Craft at Ancient Manipulator from 20 Soul of Flight, 14 Meld Blob, 10 Luminite Bar"
	Tooltip: "[c/6CC4E8:Accessory] Exodus Wings: Accessory"
}

GearFragmentsOfAnotherWorld: {
	Title: "Fragments of Another World"
	Contents: "[c/6CC4E8:Accessory] Equip Fragments of Another World. Accessory. Grants immunity to Whispering Death. X% increased melee speed. Xx specialist ranged damage. X% reduced mana usage. +X maximum sentries. X% increased rogue attack speed. 'Don't speak of your desires to the shadows, they listen.'. How to get it: Craft at Mythril/Orichalcum Anvil from 5 Necroplasm, 25 Navyplate, 25 Exodium Cluster"
	Tooltip: "[c/6CC4E8:Accessory] Fragments of Another World: Accessory"
}

GearHeartoftheElements: {
	Title: "Heart of the Elements"
	Contents: "[c/6CC4E8:Accessory] Equip Heart of the Elements. Accessory. Summons all elementals to protect you. The elementals have reduced opacity if visibility is disabled. 'The heart of the world'. How to get it: Craft at Ancient Manipulator from 1 Elemental in a Bottle, 1 Oasis Elemental in a Bottle, 1 Pearl of Enthrallment, 1 Eye of the Storm, 1 Rose Stone, 6 Stardust Fragment"
	Tooltip: "[c/6CC4E8:Accessory] Heart of the Elements: Accessory"
}

GearMoonWalkers: {
	Title: "Moon Walkers"
	Contents: "[c/6CC4E8:Accessory] Equip Moon Walkers. Accessory. Allows flight and slow fall. 24% increased running acceleration. Provides the effects of Angel Treads. Provides immunity to lava. Shift-Right Click this item in your inventory to toggle the wings. 'Hee hee!'. How to get it: Craft at Ancient Manipulator from 1 Angel Treads, 20 Soul of Flight, 10 Luminite Bar"
	Tooltip: "[c/6CC4E8:Accessory] Moon Walkers: Accessory"
}

GearMoonstoneCrown: {
	Title: "Moonstone Crown"
	Contents: "[c/6CC4E8:Accessory] Equip Moonstone Crown. Accessory. Increases maximum mana by 40. Summons a Lunar Sigil every 2 seconds, up to a maximum of 10. Each Lunar Sigil increases magic damage by 2% and reduces mana cost by 1%. With 5 sigils, increases mana regeneration by +5 MP/s. With 10 sigils, increases magic critical strike chance by 10% and all magic... How to get it: Craft at Ancient Manipulator from 1 Feather Crown, 5 Luminite Bar, 5 Nebula Fragment, 2 Core of Calamity"
	Tooltip: "[c/6CC4E8:Accessory] Moonstone Crown: Accessory"
}

GearOccultSkullCrown: {
	Title: "Occult Skull Crown"
	Contents: "[c/6CC4E8:Accessory] Equip Occult Skull Crown. Accessory, 5 defense. You constantly gain rage over time, and rage does not fade when out of combat. Converts certain debuffs into buffs and extends their durations. This also removes immunities to these debuffs if you have them. Adrenaline charges 20% faster. Increases your max movement speed and acceleration by 5%. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Heart of Darkness, 1 Laudanum, 1 Stress Pills, 3 Twisting Nether; Dropped by Brain of Cthulhu"
	Tooltip: "[c/6CC4E8:Accessory] Occult Skull Crown: Accessory, 5 defense"
}

GearOldDukeScales: {
	Title: "Old Duke's Scales"
	Contents: "[c/6CC4E8:Accessory] Equip Old Duke's Scales. Accessory. Grants immunity to knockback. 10% increased damage reduction, max movement speed, and acceleration. 25% increased dash velocity and length. Adds a stamina tracker to the cooldown rack. How to get it: Found in Treasure Bag (The Old Duke)"
	Tooltip: "[c/6CC4E8:Accessory] Old Duke's Scales: Accessory"
}

GearPhantomicArtifact: {
	Title: "Phantomic Artifact"
	Contents: "[c/6CC4E8:Accessory] Equip Phantomic Artifact. Accessory. Minion attacks provide various buffs. Does not stack with downgrades. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Hallowed Rune, 5 Ruinous Soul, 25 Onyxplate, 20 Exodium Cluster"
	Tooltip: "[c/6CC4E8:Accessory] Phantomic Artifact: Accessory"
}

GearProfanedSoulArtifact: {
	Title: "Profaned Soul Artifact"
	Contents: "[c/6CC4E8:Accessory] Equip Profaned Soul Artifact. Accessory. Summons your own personal Guardians to fight alongside you. The offensive guardian grants an additional minion slot and fires a ring of spears while attacking. The defensive guardian creates a weak barrier of profaned rock. Once depleted, the rocks are flung outward and will regenerate 5 seconds... How to get it: Craft at Mythril/Orichalcum Anvil from 5 Divine Geode, 25 Havocplate, 25 Exodium Cluster"
	Tooltip: "[c/6CC4E8:Accessory] Profaned Soul Artifact: Accessory"
}

GearQuiverofNihility: {
	Title: "Quiver of Nihility"
	Contents: "[c/6CC4E8:Accessory] Equip Quiver of Nihility. Accessory. 5% increased ranged critical strike chance. Summons a ring of four void fields to orbit you. Arrows that pass through these fields gain a 75% damage boost and double speed. 'Filled with a substance darker than the night sky'. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Any Quiver, 5 Vortex Fragment, 3 Dark Plasma"
	Tooltip: "[c/6CC4E8:Accessory] Quiver of Nihility: Accessory"
}

GearReaperToothNecklace: {
	Title: "Reaper Tooth Necklace"
	Contents: "[c/6CC4E8:Accessory] Equip Reaper Tooth Necklace. Accessory. 20% increased damage. Increases armor penetration by 30. 'A grisly trophy from the ultimate predator'. How to get it: Craft at Tinkerer's Workshop from 1 Sand Shark Tooth Necklace, 6 Reaper Tooth, 20 Depth Cells"
	Tooltip: "[c/6CC4E8:Accessory] Reaper Tooth Necklace: Accessory"
}

GearSpectralVeil: {
	Title: "Spectral Veil"
	Contents: "[c/6CC4E8:Accessory] Equip Spectral Veil. Accessory. Pressing the bound key consumes 25% of your maximum stealth to teleport, rendering you invulnerable. If you dodge something while invulnerable, you instantly gain full stealth. Teleportation is disabled while Chaos State is active. Stealth generates 15% faster. 'The inside of the cloak is full of... How to get it: Found in Treasure Bag (Signus)"
	Tooltip: "[c/6CC4E8:Accessory] Spectral Veil: Accessory"
}

GearStatisCurse: {
	Title: "Statis' Curse"
	Contents: "[c/6CC4E8:Accessory] Equip Statis' Curse. Accessory. Increases your max number of minions by 3, and summon damage by 12%. Increased minion knockback. Minion attacks inflict Shadowflame, and grants immunity to Shadowflame. Does not stack with downgrades. How to get it: Craft at Ancient Manipulator from 1 Statis' Blessing, 1 The First Shadowflame, 6 Stardust Fragment"
	Tooltip: "[c/6CC4E8:Accessory] Statis' Curse: Accessory"
}

GearStatisNinjaBelt: {
	Title: "Statis' Ninja Belt"
	Contents: "[c/6CC4E8:Accessory] Equip Statis' Ninja Belt. Accessory. Provides a high-speed dash. 10% increased movement speed, 32% increased jump speed and negates fall damage. Increases movement acceleration and deceleration by 1.6x. Allows the user to swim and auto jump. Grants or improves the ability to dodge attacks. Shift-Right Click this item in your invento... How to get it: Craft at Mythril/Orichalcum Anvil from 1 Master Ninja Gear, 1 Frog Flipper, 25 Purified Gel, 5 Necroplasm (+1 alternative recipe)"
	Tooltip: "[c/6CC4E8:Accessory] Statis' Ninja Belt: Accessory"
}

GearTarragonWings: {
	Title: "Tarragon Wings"
	Contents: "[c/6CC4E8:Accessory] Equip Tarragon Wings. Accessory. Allows flight and slow fall. 'Born of the jungle'. How to get it: Craft at Mythril/Orichalcum Anvil from 20 Soul of Flight, 10 Uelibloom Bar"
	Tooltip: "[c/6CC4E8:Accessory] Tarragon Wings: Accessory"
}

GearTheAbsorber: {
	Title: "The Absorber"
	Contents: "[c/6CC4E8:Accessory] Equip The Absorber. Accessory, 6 defense. Grants immunity to knockback. 12% increased movement and jump speed. Attackers take immense damage and are afflicted with Absorber Affliction. Using a healing potion will spawn a green aura that lasts for 30 seconds. Walking into the aura removes all debuffs once and grants 2 HP/s regen, 8% damag... How to get it: Craft at Ancient Manipulator from 1 Grand Gelatin, 1 Baroclaw, 1 Giant Tortoise Shell, 5 Mollusk Husk, 14 Meld Blob"
	Tooltip: "[c/6CC4E8:Accessory] The Absorber: Accessory, 6 defense"
}

GearTheEvolution: {
	Title: "The Evolution"
	Contents: "[c/6CC4E8:Accessory] Equip The Evolution. Accessory. Allows you to dodge projectiles, reflecting highly damaging mirror shards back at enemies. Attacks that deal less than 5% of your max life in damage will not be dodged. This dodge has a maximum cooldown of 90 seconds, shortened depending on the dodged attack's damage. Equipping multiple accessori... How to get it: Found in Treasure Bag (Ceaseless Void)"
	Tooltip: "[c/6CC4E8:Accessory] The Evolution: Accessory"
}

GearV8000Engine: {
	Title: "V8000 Engine"
	Contents: "[c/6CC4E8:Accessory] Equip V8000 Engine. Accessory. Grants a dash with a long cooldown that works while mounted. This dash can ram through enemies without taking damage. 'Are soul-powered engines eco-friendly?'. How to get it: Craft at Mythril/Orichalcum Anvil from 1 V8 Engine, 5 Ruinous Soul, 200 Nanites"
	Tooltip: "[c/6CC4E8:Accessory] V8000 Engine: Accessory"
}

GearVoidStriders: {
	Title: "Void Striders"
	Contents: "[c/6CC4E8:Accessory] Equip Void Striders. Accessory. Allows flight and slow fall. 36% increased running acceleration. Provides the effects of Angel Treads. Provides immunity to lava. Shift-Right Click this item in your inventory to toggle the wings. 'Ludicrous speed!'. How to get it: Craft at Ancient Manipulator from 1 Moon Walkers, 3 Armored Shell, 3 Twisting Nether, 3 Dark Plasma"
	Tooltip: "[c/6CC4E8:Accessory] Void Striders: Accessory"
}

GearWarbanneroftheRighteous: {
	Title: "Warbanner of the Righteous"
	Contents: "[c/6CC4E8:Accessory] Equip Warbanner of the Righteous. Accessory. Multiplies all damage based on how close you are to enemies. Maximum damage boost is 1.15x, minimum damage boost is 0.85x. Emit a blazing aura that burns and repels nearby enemies with Holy Flames. Enemies take increasing damage the closer they are to you and the longer they are near you. Effects... How to get it: Dropped by Guardian Commander"
	Tooltip: "[c/6CC4E8:Accessory] Warbanner of the Righteous: Accessory"
}

GearAsgardianAegis: {
	Title: "Asgardian Aegis"
	Contents: "[c/6CC4E8:Accessory] Equip Asgardian Aegis. Accessory, 6 defense. Grants immunity to knockback. Allows the ability to ram dash, empowered by a cosmic inferno. This dash can ram through enemies without taking damage. How to get it: Craft at Cosmic Anvil from 1 Asgard's Valor, 1 Elysian Aegis, 10 Cosmilite Bar, 4 Ascendant Spirit Essence"
	Tooltip: "[c/6CC4E8:Accessory] Asgardian Aegis: Accessory, 6 defense"
}

GearCalamity: {
	Title: "Calamity"
	Contents: "[c/6CC4E8:Accessory] Equip Calamity. Accessory. Lights your cursor ablaze with the Witch's flames, engulfing it in a blazing aura. Enemies touching the blaze take immense damage and are inflicted with Vulnerability Hex. Focusing an enemy for 2.5 seconds curses them, ascending Vulnerability Hex to its True form. Foes afflicted with True Vulnera... How to get it: Found in Treasure Coffer (Calamitas)"
	Tooltip: "[c/6CC4E8:Accessory] Calamity: Accessory"
}

GearChaliceOfTheBloodGod: {
	Title: "Chalice of the Blood God"
	Contents: "[c/6CC4E8:Accessory] Equip Chalice of the Blood God. Accessory. Increases max HP by 25%. +2 HP/s life regen and reduces the cooldown of healing potions by 25%. Taking more than 5 damage converts the hit into a damage over time bleed effect. This bleeding does not interfere with life regeneration. Drinking a healing potion removes some of the remaining bleed,... How to get it: Craft at Cosmic Anvil from 1 Blood Pact, 1 Charm of Myths, 12 Bloodstone, 5 Blood Orb, 4 Ascendant Spirit Essence"
	Tooltip: "[c/6CC4E8:Accessory] Chalice of the Blood God: Accessory"
}

GearCrushingEgo: {
	Title: "Crushing Ego"
	Contents: "[c/6CC4E8:Accessory] Equip Crushing Ego. Accessory. Multiplies all damage by 1.3x, but at the cost of taking 20% increased damage. 'Don the mask of arrogance, and dance by your lonesome. Once the ball has gone quiet, you'll be the last man standing.'. How to get it: Craft at Cosmic Anvil from 10 Cosmilite Bar, 25 Elumplate, 25 Exodium Cluster"
	Tooltip: "[c/6CC4E8:Accessory] Crushing Ego: Accessory"
}

GearDarkSunRing: {
	Title: "Dark Sun Ring"
	Contents: "[c/6CC4E8:Accessory] Equip Dark Sun Ring. Accessory, 4 defense. Grants immunity to knockback. 12% increased damage. +0.5 HP/s life regen and +2 max minions. Increased minion knockback. Grants various buffs as the day goes on. How to get it: Craft at Cosmic Anvil from 10 Uelibloom Bar, 20 Darksun Fragment"
	Tooltip: "[c/6CC4E8:Accessory] Dark Sun Ring: Accessory, 4 defense"
}

GearDraedonsHeart: {
	Title: "Draedon's Heart"
	Contents: "[c/6CC4E8:Accessory] Equip Draedon's Heart. Accessory, 20 defense. Grants immunity to knockback. X% reduced contact damage from enemies. With full Nanomachines, press the bound key to heal 180 health over 2 seconds. While healing, you take % less damage. 'Nanomachines, son'. How to get it: Found in Treasure Box (Exo Mechs)"
	Tooltip: "[c/6CC4E8:Accessory] Draedon's Heart: Accessory, 20 defense"
}

GearDragonScales: {
	Title: "Dragon Scales"
	Contents: "[c/6CC4E8:Accessory] Equip Dragon Scales. Accessory. Rogue projectiles spawn slow fireballs as they travel. Stealth strikes create infernados where they hit. +10% max run speed and acceleration. Grants immunity to Dragonfire. 'Only a living dragon holds true treasure'. How to get it: Sold by Bandit"
	Tooltip: "[c/6CC4E8:Accessory] Dragon Scales: Accessory"
}

GearEclipseMirror: {
	Title: "Eclipse Mirror"
	Contents: "[c/6CC4E8:Accessory] Equip Eclipse Mirror. Accessory. +10 maximum stealth. 6% increased rogue damage and rogue crit chance. Enemies are less likely to target you, even in the abyss. Stealth generates 25% faster when standing still and is boosted while moving if not attacking. Stealth strikes only expend 50% of your max stealth. Grants or improves th... How to get it: Craft at Cosmic Anvil from 1 Abyssal Mirror, 1 Dark Matter Sheath, 20 Darksun Fragment"
	Tooltip: "[c/6CC4E8:Accessory] Eclipse Mirror: Accessory"
}

GearElementalGauntlet: {
	Title: "Elemental Gauntlet"
	Contents: "[c/6CC4E8:Accessory] Equip Elemental Gauntlet. Accessory. Melee attacks and projectiles inflict Elemental Mix. 15% increased melee damage and melee speed. 5% increased melee critical strike chance. 20% increased true melee damage and increased melee knockback. Enables auto swing for melee weapons and increases their size. Does not stack with downgrades. How to get it: Craft at Cosmic Anvil from 1 Fire Gauntlet, 4 Ascendant Spirit Essence, 6 Sanguite Scales"
	Tooltip: "[c/6CC4E8:Accessory] Elemental Gauntlet: Accessory"
}

GearEtherealTalisman: {
	Title: "Ethereal Talisman"
	Contents: "[c/6CC4E8:Accessory] Equip Ethereal Talisman. Accessory. Increases maximum mana by 60 and 8% reduced mana cost. 15% increased magic damage and 5% increased magic critical strike chance. Increases pickup range for mana stars. You automatically use mana potions when needed. Shift-Right Click in your inventory to toggle Mana Flower's effect. How to get it: Craft at Cosmic Anvil from 1 Sigil of Calamitas, 1 Any Mana Flower, 4 Ascendant Spirit Essence"
	Tooltip: "[c/6CC4E8:Accessory] Ethereal Talisman: Accessory"
}

GearFadedIdolatry: {
	Title: "Faded Idolatry"
	Contents: "[c/6CC4E8:Accessory] Equip Faded Idolatry. Accessory. Summoned Fiery Draconids cost one less minion slot. 'Once everything has crumbled to dust, what will be left of the world you created?'. How to get it: Craft at Cosmic Anvil from 5 Yharon Soul Fragment, 25 Plagueplate, 25 Exodium Cluster"
	Tooltip: "[c/6CC4E8:Accessory] Faded Idolatry: Accessory"
}

GearNanotech: {
	Title: "Nanotech"
	Contents: "[c/6CC4E8:Accessory] Equip Nanotech. Accessory. Rogue projectiles create nanoblades as they travel. Stealth strikes summon nanobeams and sparks on enemy hits. Stealth strikes have lifesteal, +15 armor penetration, deal 5% more damage. 15% increased rogue damage and 15% increased rogue velocity. Stealth strikes grant lifesteal and 10% critical... How to get it: Craft at Cosmic Anvil from 1 Rogue Emblem, 1 Vampiric Talisman, 1 Electrician's Glove, 8 Luminite Bar, 4 Ascendant Spirit Essence"
	Tooltip: "[c/6CC4E8:Accessory] Nanotech: Accessory"
}

GearNebulousCore: {
	Title: "Nebulous Core"
	Contents: "[c/6CC4E8:Accessory] Equip Nebulous Core. Accessory. X% increased damage. Summons floating nebula stars to protect you. Taking a fatal hit revives you to X HP. This effect has a X second cooldown. How to get it: Found in Treasure Bag (The Devourer of Gods)"
	Tooltip: "[c/6CC4E8:Accessory] Nebulous Core: Accessory"
}

GearNucleogenesis: {
	Title: "Nucleogenesis"
	Contents: "[c/6CC4E8:Accessory] Equip Nucleogenesis. Accessory. Increases your max number of minions by 4. Grants immunity to Shadowflame and Irradiated. 15% increased summon damage, and increased minion knockback. Minions inflict a variety of debuffs. Minions spawn damaging sparks on enemy hits. Does not stack with downgrades. How to get it: Craft at Cosmic Anvil from 1 Star-Tainted Generator, 1 Statis' Curse, 4 Ascendant Spirit Essence"
	Tooltip: "[c/6CC4E8:Accessory] Nucleogenesis: Accessory"
}

GearPlanebreakersPouch: {
	Title: "Planebreaker's Pouch"
	Contents: "[c/6CC4E8:Accessory] Equip Planebreaker's Pouch. Accessory. 15% increased ranged damage, 7% increased ranged critical strike chance and 20% reduced ammo usage. Grants a 20% chance to not consume arrows. Pressing the bound key will automatically swap the ammos in your ammo slots. The ammo type swapped depends on the ammo of the weapon you are holding. How to get it: Craft at Cosmic Anvil from 1 Any Quiver, 1 Deadshot Brooch, 4 Ascendant Spirit Essence"
	Tooltip: "[c/6CC4E8:Accessory] Planebreaker's Pouch: Accessory"
}

GearRadiance: {
	Title: "Radiance"
	Contents: "[c/6CC4E8:Accessory] Equip Radiance. Accessory. +X to +X HP/s life regen based on missing health (Current: +[REGEN HP/s)]. Reduces damage over time taken by X HP/s and jump-starts regeneration after a damaging debuff ends. Natural life regen is X% more potent and returns X% faster. You emit shining blue light if visibility is enabled. 'A once... How to get it: Craft at Cosmic Anvil from 1 Ambrosial Ampoule, 1 Infected Jewel, 5 Auric Bar, 4 Ascendant Spirit Essence"
	Tooltip: "[c/6CC4E8:Accessory] Radiance: Accessory"
}

GearRampartofDeities: {
	Title: "Rampart of Deities"
	Contents: "[c/6CC4E8:Accessory] Equip Rampart of Deities. Accessory, 8 defense. Grants immunity to knockback. Releases a blast of homing star-bees and drenches you in Honey after taking damage. Increases the length of invincibility, with it increasing even more when at low health or taking high damage attacks. Reduces damage taken by 25% when below 50% life. Absorbs 25% of d... How to get it: Craft at Cosmic Anvil from 1 Frozen Shield, 1 Deific Amulet, 5 Auric Bar, 4 Ascendant Spirit Essence"
	Tooltip: "[c/6CC4E8:Accessory] Rampart of Deities: Accessory, 8 defense"
}

GearSeraphTracers: {
	Title: "Seraph Tracers"
	Contents: "[c/6CC4E8:Accessory] Equip Seraph Tracers. Accessory. Allows flight and slow fall. 50% increased running acceleration. Provides the effects of Angel Treads. Provides immunity to lava and damaging tiles, including Auric Ore. Shift-Right Click this item in your inventory to toggle the wings. 'Taking speed EVEN FURTHER BEYOND!'. How to get it: Craft at Cosmic Anvil from 1 Void Striders, 5 Auric Bar, 3 Ascendant Spirit Essence"
	Tooltip: "[c/6CC4E8:Accessory] Seraph Tracers: Accessory"
}

GearSilvaWings: {
	Title: "Silva Wings"
	Contents: "[c/6CC4E8:Accessory] Equip Silva Wings. Accessory. Allows flight and slow fall. 'The purest of nature'. How to get it: Craft at Cosmic Anvil from 20 Soul of Flight, 45 Planty Mush, 10 Effulgent Feather, 3 Ascendant Spirit Essence"
	Tooltip: "[c/6CC4E8:Accessory] Silva Wings: Accessory"
}

GearStatisVoidSash: {
	Title: "Statis' Void Sash"
	Contents: "[c/6CC4E8:Accessory] Equip Statis' Void Sash. Accessory. Provides a high-speed dash. 20% increased movement speed, 32% increased jump speed, and negates fall damage. Increases movement acceleration and deceleration by 1.85x. Allows the user to swim and auto jump. Grants or improves the ability to dodge attacks. Shift-Right Click this item in your inven... How to get it: Craft at Cosmic Anvil from 1 Statis' Ninja Belt, 10 Twisting Nether, 20 Nightmare Fuel"
	Tooltip: "[c/6CC4E8:Accessory] Statis' Void Sash: Accessory"
}

GearTheAmalgam: {
	Title: "The Amalgam"
	Contents: "[c/6CC4E8:Accessory] Equip The Amalgam. Accessory. All attacks inflict a variety of debuffs, 200% increased elemental debuff damage. Most buffs last twice as long, and persist after dying. Taking damage confuses nearby enemies and spawns a dank creeper. The dank creeper flies above you, exploding into several shaderain clouds. Grants or improves... How to get it: Craft at Cosmic Anvil from 1 Amalgamated Brain, 4 Ascendant Spirit Essence, 12 Ashes of Calamity, 15 Essence of Eleum, 15 Plague Cell Canister, 20 Depth Cells, 4 Armored Shell"
	Tooltip: "[c/6CC4E8:Accessory] The Amalgam: Accessory"
}

GearTheSponge: {
	Title: "The Sponge"
	Contents: "[c/6CC4E8:Accessory] Equip The Sponge. Accessory. Grants immunity to knockback. Gain a barrier with 120 health. The barrier grants 10% damage reduction while active. The barrier will regenerate 8 seconds after being hit, taking 10 seconds to completely regenerate. Getting hit resets the timer. How to get it: Craft at Cosmic Anvil from 1 Rover Drive, 10 Mysterious Circuitry, 20 Dubious Plating, 5 Cosmilite Bar, 4 Ascendant Spirit Essence"
	Tooltip: "[c/6CC4E8:Accessory] The Sponge: Accessory"
}

GearVeneratedLocket: {
	Title: "Venerated Locket"
	Contents: "[c/6CC4E8:Accessory] Equip Venerated Locket. Accessory. 10% increased rogue damage. Rogue projectiles summon a clone from above the cursor. Stealth strikes unleash a ring of seeking cosmilite knives. 'You'll never be alone, no matter where you go'. How to get it: Sold by Bandit"
	Tooltip: "[c/6CC4E8:Accessory] Venerated Locket: Accessory"
}

GearWingsofRebirth: {
	Title: "Wings of Rebirth"
	Contents: "[c/6CC4E8:Accessory] Equip Wings of Rebirth. Accessory. Allows flight and slow fall. 'Resplendent to the very end'. How to get it: Found in Treasure Cache (Yharon); Dropped by Yharon, Dragon of Rebirth"
	Tooltip: "[c/6CC4E8:Accessory] Wings of Rebirth: Accessory"
}

GearYharimsGift: {
	Title: "Yharim's Gift"
	Contents: "[c/6CC4E8:Accessory] Equip Yharim's Gift. Accessory, 10 defense. Grants immunity to knockback. Increases damage by 10% and movement speed by 20%. All attacks inflict Auric Rebuke. Flaming meteors rain down while invincible. 'The power to kill a god pulses from within this artifact'. How to get it: Found in Treasure Cache (Yharon)"
	Tooltip: "[c/6CC4E8:Accessory] Yharim's Gift: Accessory, 10 defense"
}

GearBaconOil: {
	Title: "Bacon Oil"
	Contents: "[c/79BD84:Potion] Obtain Bacon Oil. Buff: Bacon Oil, 6 min. Provides \"good\" mobility that scales with your damage stat boosts. Counts as 3 alcohols for Alcohol Poisoning. Drinking more than 3 different alcohols might not end well with your liver. How to get it: Sold by Shady Salesman"
	Tooltip: "[c/79BD84:Potion] Bacon Oil: Buff: Bacon Oil, 6 min"
}

GearBloodyMary: {
	Title: "Bloody Mary"
	Contents: "[c/79BD84:Potion] Obtain Bloody Mary. Buff: Bloody Mary, 6 min. Increases enemy spawn rates by 7x. Greatly reduces piercing weapon effectiveness. Drinking more than 3 different alcohols might not end well with your liver. How to get it: Craft at Keg from 10 Bottle, 1 Blood Moon Starter; Found in Underground Shrines chests"
	Tooltip: "[c/79BD84:Potion] Bloody Mary: Buff: Bloody Mary, 6 min"
}

GearBoundingPotion: {
	Title: "Bounding Potion"
	Contents: "[c/79BD84:Potion] Obtain Bounding Potion. Buff: Bounding, 8 min. X% increased jump speed and 20% increased jump height. How to get it: Craft at Placed Bottle from 1 Bottled Water, 1 Pink Gel, 1 Moonglow (+1 alternative recipe)"
	Tooltip: "[c/79BD84:Potion] Bounding Potion: Buff: Bounding, 8 min"
}

GearCalciumPotion: {
	Title: "Calcium Potion"
	Contents: "[c/79BD84:Potion] Obtain Calcium Potion. Buff: Calcium, 20 min. Grants 50% knockback resistance. How to get it: Craft at Placed Bottle from 1 Bottled Water, 1 Ancient Bone Dust (+1 alternative recipe); Sold by Skeleton Merchant"
	Tooltip: "[c/79BD84:Potion] Calcium Potion: Buff: Calcium, 20 min"
}

GearOldFashioned: {
	Title: "Old Fashioned"
	Contents: "[c/79BD84:Potion] Obtain Old Fashioned. Buff: Old Fashioned, 6 min. Multiplies most non-weapon, non-debuff damage by Xx. Multiplies all weapon damage by Xx. Drinking more than 3 different alcohols might not end well with your liver. How to get it: Craft at Keg from 10 Bottle, 1 Grapefruit"
	Tooltip: "[c/79BD84:Potion] Old Fashioned: Buff: Old Fashioned, 6 min"
}

GearPotionofOmniscience: {
	Title: "Potion of Omniscience"
	Contents: "[c/79BD84:Potion] Obtain Potion of Omniscience. Buff: Omniscience, 15 min. Highlights nearby creatures, enemy projectiles, danger sources, and treasure. How to get it: Craft at Alchemy Table from 1 Hunter Potion, 1 Spelunker Potion, 1 Trapsight Potion (+1 alternative recipe); Dropped by Golem"
	Tooltip: "[c/79BD84:Potion] Potion of Omniscience: Buff: Omniscience, 15 min"
}

GearPurpleHaze: {
	Title: "Purple Haze"
	Contents: "[c/79BD84:Potion] Obtain Purple Haze. Buff: Purple Haze, 6 min. For 5 seconds after a stealth strike, all damage increased by 25%, but stealth strike damage reduced by 25%. Drinking more than 3 different alcohols might not end well with your liver. How to get it: Craft at Keg from 10 Bottle, 1 Plum; Dropped by Hallow Boss"
	Tooltip: "[c/79BD84:Potion] Purple Haze: Buff: Purple Haze, 6 min"
}

GearScrewdriver: {
	Title: "Screwdriver"
	Contents: "[c/79BD84:Potion] Obtain Screwdriver. Buff: Screwdriver, 6 min. Greatly increases tile and wall placement range and speed. Greatly reduces damage dealt. Drinking more than 3 different alcohols might not end well with your liver. How to get it: Craft at Keg from 10 Bottle, 1 Diamond"
	Tooltip: "[c/79BD84:Potion] Screwdriver: Buff: Screwdriver, 6 min"
}

GearShadowPotion: {
	Title: "Shadow Potion"
	Contents: "[c/79BD84:Potion] Obtain Shadow Potion. Buff: Shadow, 8 min. 8% increased stealth generation. Turns the player into a shadow with glowing eyes. Visual effects can be disabled with the Stealth Invisibility config. How to get it: Craft at Placed Bottle from 1 Bottled Water, 1 Shadowfish, 1 Blinkroot (+1 alternative recipe)"
	Tooltip: "[c/79BD84:Potion] Shadow Potion: Buff: Shadow, 8 min"
}

GearSulphurskinPotion: {
	Title: "Sulphurskin Potion"
	Contents: "[c/79BD84:Potion] Obtain Sulphurskin Potion. Buff: Sulphurskin, 4 min. Reduces the effects of the sulphuric waters. How to get it: Craft at Placed Bottle from 1 Bottled Water, 1 Sulphurous Sand, 1 Waterleaf (+1 alternative recipe); Found in Misc Worldgen Routines chests"
	Tooltip: "[c/79BD84:Potion] Sulphurskin Potion: Buff: Sulphurskin, 4 min"
}

GearWhiskey: {
	Title: "Whiskey"
	Contents: "[c/79BD84:Potion] Obtain Whiskey. Buff: Whiskey, 6 min. Provides between -15% and 15% damage to the held weapon's class. Each class tracks this boost individually. This boost lowers the longer you hold weapons of the same class, taking X seconds to fully decay. This boost recharges when holding weapons of a different class, taking X seconds to fully r... How to get it: Craft at Keg from 10 Bottle, 1 Spicy Pepper"
	Tooltip: "[c/79BD84:Potion] Whiskey: Buff: Whiskey, 6 min"
}

GearCaribbeanRum: {
	Title: "Caribbean Rum"
	Contents: "[c/79BD84:Potion] Obtain Caribbean Rum. Buff: Caribbean Rum, 6 min. Increases move speed by 25%. Reduces your gravity by 50%. Drinking more than 3 different alcohols might not end well with your liver. How to get it: Craft at Keg from 20 Bottle, 1 Ice Feather"
	Tooltip: "[c/79BD84:Potion] Caribbean Rum: Buff: Caribbean Rum, 6 min"
}

GearEverclear: {
	Title: "Everclear"
	Contents: "[c/79BD84:Potion] Obtain Everclear. Buff: Everclear, 6 min. 25% increased damage. Reduces life regen by 5 HP/s and defense by 30%. Counts as 2 alcohols for Alcohol Poisoning. Drinking more than 3 different alcohols might not end well with your liver. How to get it: Craft at Keg from 20 Bottle, 1 Black Lens, 10 Soul of Night"
	Tooltip: "[c/79BD84:Potion] Everclear: Buff: Everclear, 6 min"
}

GearEvergreenGin: {
	Title: "Evergreen Gin"
	Contents: "[c/79BD84:Potion] Obtain Evergreen Gin. Buff: Evergreen Gin, 6 min. 50% increased Water and Sickness debuff damage. 50% decreased Electric and Heat debuff damage. Drinking more than 3 different alcohols might not end well with your liver. How to get it: Craft at Keg from 10 Bottle, 3 Vine, 10 Starblight Soot"
	Tooltip: "[c/79BD84:Potion] Evergreen Gin: Buff: Evergreen Gin, 6 min"
}

GearFireball: {
	Title: "Fireball"
	Contents: "[c/79BD84:Potion] Obtain Fireball. Buff: Fireball, 6 min. 50% increased Heat debuff damage. 50% decreased Sickness debuff damage. Drinking more than 3 different alcohols might not end well with your liver. How to get it: Craft at Keg from 10 Bottle, 50 Living Fire Block, 10 Starblight Soot"
	Tooltip: "[c/79BD84:Potion] Fireball: Buff: Fireball, 6 min"
}

GearFlaskOfBrimstone: {
	Title: "Flask of Brimstone"
	Contents: "[c/79BD84:Potion] Obtain Flask of Brimstone. Buff: Weapon Imbue: Brimstone, 20 min. Melee, Whip, and Rogue attacks inflict Brimstone Flames. How to get it: Craft at Imbuing Station from 1 Bottled Water, 1 Ashes of Calamity"
	Tooltip: "[c/79BD84:Potion] Flask of Brimstone: Buff: Weapon Imbue: Brimstone, 20 min"
}

GearFlaskOfCrumbling: {
	Title: "Flask of Crumbling"
	Contents: "[c/79BD84:Potion] Obtain Flask of Crumbling. Buff: Weapon Imbue: Crumbling, 20 min. Melee, Whip, and Rogue attacks inflict Crumbling. How to get it: Craft at Imbuing Station from 1 Bottled Water, 2 Essence of Sunlight"
	Tooltip: "[c/79BD84:Potion] Flask of Crumbling: Buff: Weapon Imbue: Crumbling, 20 min"
}

GearGrapeBeer: {
	Title: "Grape Beer"
	Contents: "[c/79BD84:Potion] Obtain Grape Beer. Buff: Grape Beer, 6 min. Bullets, Arrows, Darts, and Rockets gain homing. Projectiles deal less damage the further the enemy is. This reaches a minimum of 0.25x damage at 75 tiles away. Drinking more than 3 different alcohols might not end well with your liver. How to get it: Craft at Keg from 10 Bottle, 1 Grapes"
	Tooltip: "[c/79BD84:Potion] Grape Beer: Buff: Grape Beer, 6 min"
}

GearManhattan: {
	Title: "Manhattan"
	Contents: "[c/79BD84:Potion] Obtain Manhattan. Buff: Manhattan, 6 min. 50% increased Cold debuff damage. 50% decreased Water debuff damage. Drinking more than 3 different alcohols might not end well with your liver. How to get it: Craft at Keg from 10 Bottle, 1 Frost Core, 10 Starblight Soot"
	Tooltip: "[c/79BD84:Potion] Manhattan: Buff: Manhattan, 6 min"
}

GearMargarita: {
	Title: "Margarita"
	Contents: "[c/79BD84:Potion] Obtain Margarita. Buff: Margarita, 6 min. Halves duration of harmful debuffs you receive. Reduces damage of debuffs you inflict by 50%. Drinking more than 3 different alcohols might not end well with your liver. How to get it: Craft at Keg from 10 Bottle, 1 Dark Shard, 10 Starblight Soot"
	Tooltip: "[c/79BD84:Potion] Margarita: Buff: Margarita, 6 min"
}

GearMoscowMule: {
	Title: "Moscow Mule"
	Contents: "[c/79BD84:Potion] Obtain Moscow Mule. Buff: Moscow Mule, 6 min. 50% increased knockback, all attacks inflict heavy knockback. Reduces the effectiveness of piercing weapons. Drinking more than 3 different alcohols might not end well with your liver. How to get it: Craft at Keg from 10 Bottle, 1 Titan Heart"
	Tooltip: "[c/79BD84:Potion] Moscow Mule: Buff: Moscow Mule, 6 min"
}

GearPhotosynthesisPotion: {
	Title: "Photosynthesis Potion"
	Contents: "[c/79BD84:Potion] Obtain Photosynthesis Potion. Buff: Photosynthesis, 8 min. Dropped hearts heal 5 more HP. How to get it: Craft at Alchemy Table from 1 Bottled Water, 3 Daybloom, 1 Essence of Sunlight (+1 alternative recipe); Found in Giant Hive chests"
	Tooltip: "[c/79BD84:Potion] Photosynthesis Potion: Buff: Photosynthesis, 8 min"
}

GearRedWine: {
	Title: "Red Wine"
	Contents: "[c/79BD84:Potion] Obtain Red Wine. Buff: Red Wine, 6 min. 10% increased vertical speed. 25% reduced flight time. Drinking more than 3 different alcohols might not end well with your liver. How to get it: Craft at Keg from 20 Bottle, 1 Fire Feather"
	Tooltip: "[c/79BD84:Potion] Red Wine: Buff: Red Wine, 6 min"
}

GearRum: {
	Title: "Rum"
	Contents: "[c/79BD84:Potion] Obtain Rum. Buff: Rum, 6 min. 15% increased non-minion summon damage. 15% decreased minion damage. Drinking more than 3 different alcohols might not end well with your liver. How to get it: Craft at Keg from 10 Bottle, 3 Spider Fang"
	Tooltip: "[c/79BD84:Potion] Rum: Buff: Rum, 6 min"
}

GearSoaringPotion: {
	Title: "Soaring Potion"
	Contents: "[c/79BD84:Potion] Obtain Soaring Potion. Buff: Soaring, 8 min. 10% increased flight time. How to get it: Craft at Alchemy Table from 1 Bottled Water, 1 Sunken Sailfish, 1 Soul of Flight (+1 alternative recipe)"
	Tooltip: "[c/79BD84:Potion] Soaring Potion: Buff: Soaring, 8 min"
}

GearStarBeamRye: {
	Title: "Star Beam Rye"
	Contents: "[c/79BD84:Potion] Obtain Star Beam Rye. Buff: Star Beam Rye, 6 min. Increases Mana regeneration, even while using an item. Magic weapons deal 0.9x damage. Drinking more than 3 different alcohols might not end well with your liver. How to get it: Craft at Keg from 10 Bottle, 1 Starfruit"
	Tooltip: "[c/79BD84:Potion] Star Beam Rye: Buff: Star Beam Rye, 6 min"
}

GearTequila: {
	Title: "Tequila"
	Contents: "[c/79BD84:Potion] Obtain Tequila. Buff: Tequila, 6 min. 50% increased Electric debuff damage. 50% decreased Cold debuff damage. Drinking more than 3 different alcohols might not end well with your liver. How to get it: Craft at Keg from 10 Bottle, 3 Stormlion Mandible, 10 Starblight Soot"
	Tooltip: "[c/79BD84:Potion] Tequila: Buff: Tequila, 6 min"
}

GearTequilaSunrise: {
	Title: "Tequila Sunrise"
	Contents: "[c/79BD84:Potion] Obtain Tequila Sunrise. Buff: Tequila Sunrise, 6 min. Greatly increases natural life regeneration after suffering a damaging debuff. 50% increased damage taken from debuffs. Drinking more than 3 different alcohols might not end well with your liver. How to get it: Craft at Keg from 10 Bottle, 1 Light Shard, 10 Starblight Soot"
	Tooltip: "[c/79BD84:Potion] Tequila Sunrise: Buff: Tequila Sunrise, 6 min"
}

GearVodka: {
	Title: "Vodka"
	Contents: "[c/79BD84:Potion] Obtain Vodka. Buff: Vodka, 6 min. 25% increased Typeless debuff damage. 50% decreased elemental debuff damage. Drinking more than 3 different alcohols might not end well with your liver. How to get it: Craft at Keg from 10 Bottle, 10 Purified Gel, 10 Starblight Soot"
	Tooltip: "[c/79BD84:Potion] Vodka: Buff: Vodka, 6 min"
}

GearWhiteWine: {
	Title: "White Wine"
	Contents: "[c/79BD84:Potion] Obtain White Wine. Buff: White Wine, 6 min. You regain flight time the closer you are to an enemy. 50% reduced flight time. Drinking more than 3 different alcohols might not end well with your liver. How to get it: Craft at Keg from 20 Bottle, 1 Giant Harpy Feather"
	Tooltip: "[c/79BD84:Potion] White Wine: Buff: White Wine, 6 min"
}

GearZenPotion: {
	Title: "Zen Potion"
	Contents: "[c/79BD84:Potion] Obtain Zen Potion. Buff: Zen, 12 min. Vastly decreases enemy spawn rate. How to get it: Craft at Alchemy Table from 1 Bottled Water, 2 Purified Gel, 3 Daybloom (+1 alternative recipe); Found in Misc Worldgen Routines chests"
	Tooltip: "[c/79BD84:Potion] Zen Potion: Buff: Zen, 12 min"
}

GearZergPotion: {
	Title: "Zerg Potion"
	Contents: "[c/79BD84:Potion] Obtain Zerg Potion. Buff: Zerg, 7 min. Vastly increases enemy spawn rate. How to get it: Craft at Alchemy Table from 1 Bottled Water, 2 Purified Gel, 2 Fireblossom (+1 alternative recipe); Found in Misc Worldgen Routines chests"
	Tooltip: "[c/79BD84:Potion] Zerg Potion: Buff: Zerg, 7 min"
}

GearAstralInjection: {
	Title: "Astral Injection"
	Contents: "[c/79BD84:Potion] Obtain Astral Injection. Buff: Astral Injection, 6 s. Restores 60 mana per second. Inflicts Mana Sickness when used. How to get it: Craft at Placed Bottle from 15 Super Mana Potion, 1 Aureus Cell, 4 Starblight Soot"
	Tooltip: "[c/79BD84:Potion] Astral Injection: Buff: Astral Injection, 6 s"
}

GearCinnamonRoll: {
	Title: "Cinnamon Roll"
	Contents: "[c/79BD84:Potion] Obtain Cinnamon Roll. Buff: Cinnamon Roll, 6 min. Greatly increases dash speed. Greatly reduces dash distance. Drinking more than 3 different alcohols might not end well with your liver. How to get it: Craft at Keg from 10 Bottle, 1 Turtle Shell"
	Tooltip: "[c/79BD84:Potion] Cinnamon Roll: Buff: Cinnamon Roll, 6 min"
}

GearGravityNormalizerPotion: {
	Title: "Gravity Normalizer Potion"
	Contents: "[c/79BD84:Potion] Obtain Gravity Normalizer Potion. Buff: Gravity Normalizer, 8 min. Disables the low gravity of space and grants immunity to the debuff. How to get it: Craft at Alchemy Table from 1 Bottled Water, 1 Aldebaran Alewife, 1 Aureus Cell (+1 alternative recipe)"
	Tooltip: "[c/79BD84:Potion] Gravity Normalizer Potion: Buff: Gravity Normalizer, 8 min"
}

GearMoonshine: {
	Title: "Moonshine"
	Contents: "[c/79BD84:Potion] Obtain Moonshine. Buff: Moonshine, 6 min. Increases maximum health by 25%. Attacks always take at least half your defense worth of defense damage. Defense damage takes three times as long to recover. Drinking more than 3 different alcohols might not end well with your liver. How to get it: Craft at Keg from 10 Bottle, 1 Life Fruit, 5 Ancient Bone Dust"
	Tooltip: "[c/79BD84:Potion] Moonshine: Buff: Moonshine, 6 min"
}

GearCeaselessHungerPotion: {
	Title: "Ceaseless Hunger Potion"
	Contents: "[c/79BD84:Potion] Obtain Ceaseless Hunger Potion. Buff: Ceaseless Hunger, 20 s. Causes you to suck up all items in the world. How to get it: Craft at Alchemy Table from 4 Bottled Water, 1 Dark Plasma (+1 alternative recipe)"
	Tooltip: "[c/79BD84:Potion] Ceaseless Hunger Potion: Buff: Ceaseless Hunger, 20 s"
}

GearFlaskOfHolyFlames: {
	Title: "Flask of Holy Flames"
	Contents: "[c/79BD84:Potion] Obtain Flask of Holy Flames. Buff: Weapon Imbue: Holy Flames, 20 min. Melee, Whip, and Rogue attacks inflict Holy Flames. How to get it: Craft at Imbuing Station from 1 Bottled Water, 1 Unholy Essence"
	Tooltip: "[c/79BD84:Potion] Flask of Holy Flames: Buff: Weapon Imbue: Holy Flames, 20 min"
}

GearAbyssShocker: {
	Title: "Abyss Shocker"
	Contents: "[c/E2735C:Weapon] Obtain Abyss Shocker. 30 magic damage, use time 19, 14 mana. Fires an erratic lightning bolt that arcs and bounces between enemies. How to get it: Dropped by Box Jellyfish; Dropped by Mirage Jelly; Found in Underground Shrines chests"
	Tooltip: "[c/E2735C:Weapon] Abyss Shocker: 30 magic damage, use time 19, 14 mana"
}

GearAcidGun: {
	Title: "Acid Gun"
	Contents: "[c/E2735C:Weapon] Obtain Acid Gun. 18 magic damage, use time 20, 12 mana. Releases three streams of irradiated acid. How to get it: Craft at Anvil from 15 Acidwood, 12 Sulphuric Scale"
	Tooltip: "[c/E2735C:Weapon] Acid Gun: 18 magic damage, use time 20, 12 mana"
}

GearAestheticus: {
	Title: "Aestheticus"
	Contents: "[c/E2735C:Weapon] Obtain Aestheticus. 11 damage, use time 25. Fires crystals that explode and inflict Vaporfied. This weapon scales with the average of all your damage stats. How to get it: Craft at Anvil from 5 Aerialite Bar, 10 Sea Prism, 5 Fallen Star"
	Tooltip: "[c/E2735C:Weapon] Aestheticus: 11 damage, use time 25"
}

GearAirSpinner: {
	Title: "Air Spinner"
	Contents: "[c/E2735C:Weapon] Obtain Air Spinner. 29 melee damage, use time 22. Reach: X tiles. Speed: 32. Duration: 30 seconds. Fires feathers when enemies are near. How to get it: Craft at Anvil from 10 Aerialite Bar"
	Tooltip: "[c/E2735C:Weapon] Air Spinner: 29 melee damage, use time 22"
}

GearAmidiasTrident: {
	Title: "Amidias' Trident"
	Contents: "[c/E2735C:Weapon] Obtain Amidias' Trident. 12 melee damage, use time 17. Shoots homing whirlpools. How to get it: Sold by Sea King"
	Tooltip: "[c/E2735C:Weapon] Amidias' Trident: 12 melee damage, use time 17"
}

GearAntlionSkewer: {
	Title: "Antlion Skewer"
	Contents: "[c/E2735C:Weapon] Obtain Antlion Skewer. 19 rogue damage, use time 28. Throws living, skewered Antlions that fire sand blasts. Stealth strikes spew a mess of sand balls and gust. Sand clouds temporarily lower enemy contact damage. How to get it: Dropped by Antlion"
	Tooltip: "[c/E2735C:Weapon] Antlion Skewer: 19 rogue damage, use time 28"
}

GearAorta: {
	Title: "Aorta"
	Contents: "[c/E2735C:Weapon] Obtain Aorta. 31 melee damage, use time 22. Reach: X tiles. Speed: 25. Duration: 24 seconds. Fires homing blood when enemies are near. How to get it: Found in Treasure Bag (The Perforators); Dropped by The Perforator Hive"
	Tooltip: "[c/E2735C:Weapon] Aorta: 31 melee damage, use time 22"
}

GearAquamarineStaff: {
	Title: "Aquamarine Staff"
	Contents: "[c/E2735C:Weapon] Obtain Aquamarine Staff. 17 magic damage, use time 22, 10 mana. Shoots two blue bolts. How to get it: Craft at Anvil from 1 Amethyst Staff, 3 Pearl Shard, 5 Sea Prism, 25 Navystone (+1 alternative recipe)"
	Tooltip: "[c/E2735C:Weapon] Aquamarine Staff: 17 magic damage, use time 22, 10 mana"
}

GearAquashardShotgun: {
	Title: "Aquashard Shotgun"
	Contents: "[c/E2735C:Weapon] Obtain Aquashard Shotgun. 12 ranged damage, use time 30. Converts musket balls into aquashards that split upon hitting an enemy. How to get it: Craft at Anvil from 1 Boomstick, 2 Aerialite Bar, 10 Sea Prism"
	Tooltip: "[c/E2735C:Weapon] Aquashard Shotgun: 12 ranged damage, use time 30"
}

GearArcherfish: {
	Title: "Archerfish"
	Contents: "[c/E2735C:Weapon] Obtain Archerfish. 16 ranged damage, use time 11. Converts musket balls into streams of water. 33% chance to not consume ammo. How to get it: Caught while fishing; Found in Hydrothermal Crate; Found in Abyss chests"
	Tooltip: "[c/E2735C:Weapon] Archerfish: 16 ranged damage, use time 11"
}

GearAshenStalactite: {
	Title: "Ashen Stalactite"
	Contents: "[c/E2735C:Weapon] Obtain Ashen Stalactite. 37 rogue damage, use time 20. Throws a small stalactite that crumbles to dust after travelling a short distance. Stealth strikes cause a larger, more damaging stalagmite to be thrown which travels slower and further before crumbling to damaging dust. How to get it: Dropped by Fire Imp"
	Tooltip: "[c/E2735C:Weapon] Ashen Stalactite: 37 rogue damage, use time 20"
}

GearBallOFugu: {
	Title: "Ball O' Fugu"
	Contents: "[c/E2735C:Weapon] Obtain Ball O' Fugu. 25 melee damage, use time 20. Throws a flailing abyssal pufferfish. Builds up poisonous spikes as it spins. Spikes blow out of the fish as it retracts. How to get it: Caught while fishing; Found in Hydrothermal Crate; Found in Abyss chests"
	Tooltip: "[c/E2735C:Weapon] Ball O' Fugu: 25 melee damage, use time 20"
}

GearBarinade: {
	Title: "Barinade"
	Contents: "[c/E2735C:Weapon] Obtain Barinade. 5 ranged damage, use time 24. Fires two converging high-velocity fin arrows that easily soar through the air. How to get it: Found in Treasure Bag (Desert Scourge); Dropped by Desert Scourge"
	Tooltip: "[c/E2735C:Weapon] Barinade: 5 ranged damage, use time 24"
}

GearBasher: {
	Title: "Basher"
	Contents: "[c/E2735C:Weapon] Obtain Basher. 65 melee damage, use time 30. Swings a rotten club while knocking you back in the process. How to get it: Craft at Anvil from 15 Acidwood, 12 Sulphuric Scale"
	Tooltip: "[c/E2735C:Weapon] Basher: 65 melee damage, use time 30"
}

GearBelladonnaSpiritStaff: {
	Title: "Belladonna Spirit Staff"
	Contents: "[c/E2735C:Weapon] Obtain Belladonna Spirit Staff. 22 summon damage, use time 36, 10 mana. Summons a cute forest spirit that flings magical petals. How to get it: Craft at Anvil from 4 Vine, 5 Jungle Spores, 8 Stinger, 25 Rich Mahogany; Found in Vernal Pass chests"
	Tooltip: "[c/E2735C:Weapon] Belladonna Spirit Staff: 22 summon damage, use time 36, 10 mana"
}

GearBlackAnurian: {
	Title: "Black Anurian"
	Contents: "[c/E2735C:Weapon] Obtain Black Anurian. 24 magic damage, use time 18, 13 mana. Spews bubbles and homing plankton. How to get it: Caught while fishing; Found in Hydrothermal Crate; Found in Abyss chests"
	Tooltip: "[c/E2735C:Weapon] Black Anurian: 24 magic damage, use time 18, 13 mana"
}

GearBladecrestOathsword: {
	Title: "Bladecrest Oathsword"
	Contents: "[c/E2735C:Weapon] Obtain Bladecrest Oathsword. 35 melee damage, use time 53. Throw a sharp blade that impales and slows enemies. Up to three blades can impale an enemy at a time. Consecutive hits past the first three will launch out the previous impaled blades. How to get it: Dropped by Voodoo Demon"
	Tooltip: "[c/E2735C:Weapon] Bladecrest Oathsword: 35 melee damage, use time 53"
}

GearBloodBath: {
	Title: "Blood Bath"
	Contents: "[c/E2735C:Weapon] Obtain Blood Bath. 24 magic damage, use time 15, 12 mana. Drenches your foes in blood. How to get it: Found in Treasure Bag (The Perforators); Dropped by The Perforator Hive"
	Tooltip: "[c/E2735C:Weapon] Blood Bath: 24 magic damage, use time 15, 12 mana"
}

GearBouncingEyeball: {
	Title: "Bouncing Eyeball"
	Contents: "[c/E2735C:Weapon] Obtain Bouncing Eyeball. 16 rogue damage, use time 23. Throws an eyeball that bounces off of surfaces. Stealth strikes cause the eyeballs to move much faster and bounce more energetically. Knockback is much stronger during a blood moon. How to get it: Dropped by Zombie Merman"
	Tooltip: "[c/E2735C:Weapon] Bouncing Eyeball: 16 rogue damage, use time 23"
}

GearBrittleStarStaff: {
	Title: "Brittle Star Staff"
	Contents: "[c/E2735C:Weapon] Obtain Brittle Star Staff. 10 summon damage, use time 36, 10 mana. Summons a small brittle starfish that will dash through enemies until it shatters. Starfish will quickly regenerate after shattering. Holding Right Click will swap starfish between dashing and circling you. When the starfish are circling, each one provides you with 3 defense. How to get it: Found in Treasure Bag (Desert Scourge); Dropped by Desert Scourge"
	Tooltip: "[c/E2735C:Weapon] Brittle Star Staff: 10 summon damage, use time 36, 10 mana"
}

GearBrokenBiomeBlade: {
	Title: "Broken Biome Blade"
	Contents: "[c/E2735C:Weapon] Obtain Broken Biome Blade. 38 melee damage, use time 30. Hold down Right Click while standing still on flat ground to attune the weapon to the powers of the surrounding biome. Pressing Right Click otherwise switches between the current attunement and an extra stored one. Main Attunement : [ATT1]. Secondary Attunement : [ATT2]. How to get it: Craft at Anvil from 1 Any Wooden Sword, 10 Aerialite Bar, 10 Hellstone Bar, 50 Dirt Block, 50 Any Stone Block"
	Tooltip: "[c/E2735C:Weapon] Broken Biome Blade: 38 melee damage, use time 30"
}

GearBulletFilledShotgun: {
	Title: "Bullet-Filled Shotgun"
	Contents: "[c/E2735C:Weapon] Obtain Bullet-Filled Shotgun. 1 ranged damage, use time 75. Fires a massive spread of bouncing bullets. Bullets attempt to bounce towards enemies after bouncing twice. Consumes five bullets per-use. 'Aim? What's that?'. How to get it: Craft at Anvil from 100 Musket Ball, 7 Any Iron Bar, 3 Aerialite Bar"
	Tooltip: "[c/E2735C:Weapon] Bullet-Filled Shotgun: 1 ranged damage, use time 75"
}

GearBurntSienna: {
	Title: "Burnt Sienna"
	Contents: "[c/E2735C:Weapon] Obtain Burnt Sienna. 32 melee damage, use time 24. Causes enemies to erupt into healing projectiles on death. How to get it: Dropped by Tomb Crawler Head"
	Tooltip: "[c/E2735C:Weapon] Burnt Sienna: 32 melee damage, use time 24"
}

GearCausticCroakerStaff: {
	Title: "Caustic Croaker Staff"
	Contents: "[c/E2735C:Weapon] Obtain Caustic Croaker Staff. 8 summon damage, use time 30, 10 mana. Summons a sentry. Summons a toad that explodes if enemies are nearby. How to get it: Dropped by Nuclear Toad"
	Tooltip: "[c/E2735C:Weapon] Caustic Croaker Staff: 8 summon damage, use time 30, 10 mana"
}

GearCinderBlossomStaff: {
	Title: "Cinder Blossom Staff"
	Contents: "[c/E2735C:Weapon] Obtain Cinder Blossom Staff. 16 summon damage, use time 36, 10 mana. Summons scorching flower over your head. There can only be one flower. How to get it: Craft at Anvil from 10 Hellstone Bar, 10 Ash Wood, 5 Fireblossom"
	Tooltip: "[c/E2735C:Weapon] Cinder Blossom Staff: 16 summon damage, use time 36, 10 mana"
}

GearCinquedea: {
	Title: "Cinquedea"
	Contents: "[c/E2735C:Weapon] Obtain Cinquedea. 35 rogue damage, use time 20. Stealth strikes stick into enemies before launching forward, slicing everything. How to get it: Sold by Bandit"
	Tooltip: "[c/E2735C:Weapon] Cinquedea: 35 rogue damage, use time 20"
}

GearCnidarian: {
	Title: "Cnidarian"
	Contents: "[c/E2735C:Weapon] Obtain Cnidarian. 8 summon damage, use time 25. Fishes up an electric jellyfish. Periodically sends out sparks to electrocute nearby enemies. 'From looking at their less sapient brethren, the Old Kingdom's inhabitants adapted tools and weapons designed for underwater efficiency. The electric properties of ghost bells remain useful even after d... How to get it: Craft at Anvil from 2 Sea Remains"
	Tooltip: "[c/E2735C:Weapon] Cnidarian: 8 summon damage, use time 25"
}

GearContaminatedBile: {
	Title: "Contaminated Bile"
	Contents: "[c/E2735C:Weapon] Obtain Contaminated Bile. 16 rogue damage, use time 40. Throws a flask of Irradiated bile which shatters and lingers in a cloud. Stealth strikes cause sulphuric bubbles to quickly rise from the cloud. How to get it: Dropped by Gnasher"
	Tooltip: "[c/E2735C:Weapon] Contaminated Bile: 16 rogue damage, use time 40"
}

GearCoralSpout: {
	Title: "Coral Spout"
	Contents: "[c/E2735C:Weapon] Obtain Coral Spout. 9 magic damage, use time 26, 30 mana. Casts a shotgun-like blast of coral shards. Keep the attack button held down to narrow the spread. Coral shards ignore 5 points of enemy defense. Fully charging the attack releases a single, bigger chunk of coral that sticks to enemies. Grabbing the chunk of coral after it falls from the enemy re... How to get it: Craft at Bookcase from 2 Sea Remains, 5 Coral"
	Tooltip: "[c/E2735C:Weapon] Coral Spout: 9 magic damage, use time 26, 30 mana"
}

GearCrackshotColt: {
	Title: "Crackshot Colt"
	Contents: "[c/E2735C:Weapon] Obtain Crackshot Colt. 18 ranged damage, use time 35. Press Right Click to toss a Copper Coin in the air. Striking a coin with a bullet causes it to ricochet into the nearest enemy. Up to 4 coins can be tossed simultaneously, and shots will ricochet off multiple coins if possible. Coins guarantee a critical strike after a short delay. How to get it: Craft at Anvil from 8 Any Gold Bar, 1 Stormlion Mandible, 1 Blood Orb, 4 Copper Coin"
	Tooltip: "[c/E2735C:Weapon] Crackshot Colt: 18 ranged damage, use time 35"
}

GearCrystalline: {
	Title: "Crystalline"
	Contents: "[c/E2735C:Weapon] Obtain Crystalline. 16 rogue damage, use time 18. Splits into several projectiles as it travels. Stealth strikes make the blade split more and create crystals when destroyed. How to get it: Craft at Anvil from 1 Wulfrum Knife, 3 Diamond, 3 Fallen Star"
	Tooltip: "[c/E2735C:Weapon] Crystalline: 16 rogue damage, use time 18"
}

GearDankStaff: {
	Title: "Dank Staff"
	Contents: "[c/E2735C:Weapon] Obtain Dank Staff. 10 summon damage, use time 36, 10 mana. Summons a dank creeper to fight for you. How to get it: Found in Treasure Bag (The Hive Mind); Dropped by The Hive Mind"
	Tooltip: "[c/E2735C:Weapon] Dank Staff: 10 summon damage, use time 36, 10 mana"
}

GearDeathstareRod: {
	Title: "Deathstare Rod"
	Contents: "[c/E2735C:Weapon] Obtain Deathstare Rod. 20 summon damage, use time 36, 10 mana. Summons an eye above your head that watches you and shoots at enemies. There can only be one eye at a time. How to get it: Found in Treasure Bag (Eye Of Cthulhu); Dropped by Eye of Cthulhu"
	Tooltip: "[c/E2735C:Weapon] Deathstare Rod: 20 summon damage, use time 36, 10 mana"
}

GearDepthCrusher: {
	Title: "Depth Crusher"
	Contents: "[c/E2735C:Weapon] Obtain Depth Crusher. 48 melee damage, use time 65. Tosses a heavy abyssal crusher that releases water energy upon hitting a tile. The crusher will ricochet off of tiles and enemies. How to get it: Dropped by Viperfish; Found in Underground Shrines chests"
	Tooltip: "[c/E2735C:Weapon] Depth Crusher: 48 melee damage, use time 65"
}

GearDragoonDrizzlefish: {
	Title: "Dragoon Drizzlefish"
	Contents: "[c/E2735C:Weapon] Obtain Dragoon Drizzlefish. 18 ranged damage, use time 20. How to get it: Caught while fishing"
	Tooltip: "[c/E2735C:Weapon] Dragoon Drizzlefish: 18 ranged damage, use time 20"
}

GearEnchantedAxe: {
	Title: "Enchanted Axe"
	Contents: "[c/E2735C:Weapon] Obtain Enchanted Axe. 19 rogue damage, use time 19. Throws a high velocity axe that returns to you after travelling a short distance or hitting a wall. At the furthest point from the player, a magical axe that travels through walls will be cast towards the nearest enemy. Stealth strikes make the axe fly further, casting additional homing magical axes. How to get it: Craft at Anvil from 1 Iron Francisca, 5 Fallen Star, 10 Pearl Shard, 30 Bone (+1 alternative recipe)"
	Tooltip: "[c/E2735C:Weapon] Enchanted Axe: 19 rogue damage, use time 19"
}

GearEnchantedConch: {
	Title: "Enchanted Conch"
	Contents: "[c/E2735C:Weapon] Obtain Enchanted Conch. 20 summon damage, use time 36, 10 mana. Summons a hermit crab to fight for you. How to get it: Sold by Sea King"
	Tooltip: "[c/E2735C:Weapon] Enchanted Conch: 20 summon damage, use time 36, 10 mana"
}

GearEnchantedKnifeStaff: {
	Title: "Enchanted Knife Staff"
	Contents: "[c/E2735C:Weapon] Obtain Enchanted Knife Staff. 10 summon damage, use time 15, 10 mana. Summons an Enchanted Knife to fight for you. How to get it: Found in Worldgen chests"
	Tooltip: "[c/E2735C:Weapon] Enchanted Knife Staff: 10 summon damage, use time 15, 10 mana"
}

GearEviscerator: {
	Title: "Eviscerator"
	Contents: "[c/E2735C:Weapon] Obtain Eviscerator. 60 ranged damage, use time 60. Converts musket balls into fast-moving blood clots. How to get it: Found in Treasure Bag (The Perforators); Dropped by The Perforator Hive"
	Tooltip: "[c/E2735C:Weapon] Eviscerator: 60 ranged damage, use time 60"
}

GearEyeOfNight: {
	Title: "Eye of Night"
	Contents: "[c/E2735C:Weapon] Obtain Eye of Night. 24 summon damage, use time 36, 10 mana. Summons a diseased eyeball that fires cells which attach to enemies. How to get it: Craft at Demon/Crimson Altar from 1 Vile Feeder, 1 Staff of Necrosteocytes, 1 Belladonna Spirit Staff, 1 Imp Staff, 10 Purified Gel (+1 alternative recipe)"
	Tooltip: "[c/E2735C:Weapon] Eye of Night: 24 summon damage, use time 36, 10 mana"
}

GearFeatherKnife: {
	Title: "Feather Knife"
	Contents: "[c/E2735C:Weapon] Obtain Feather Knife. 22 rogue damage, use time 30. Throws a knife which summons homing feathers. Stealth strikes throw a volley of knives. How to get it: Craft at Anvil from 10 Aerialite Bar"
	Tooltip: "[c/E2735C:Weapon] Feather Knife: 22 rogue damage, use time 30"
}

GearFirestormCannon: {
	Title: "Firestorm Cannon"
	Contents: "[c/E2735C:Weapon] Obtain Firestorm Cannon. 15 ranged damage, use time 11. Fires a rapid barrage of flares that builds up a searing heat in the weapon. Firing for too long overheats the weapon, leaving it unusable for a short period and setting you On Fire. Press Right Click to put away the weapon, which preserves its heat. 33% chance to not consume ammo. 'What could go... How to get it: Craft at Anvil from 1 Flare Gun, 10 Hellstone Bar, 1 Illegal Gun Parts; Sold by a town NPC"
	Tooltip: "[c/E2735C:Weapon] Firestorm Cannon: 15 ranged damage, use time 11"
}

GearFishboneBoomerang: {
	Title: "Fishbone Boomerang"
	Contents: "[c/E2735C:Weapon] Obtain Fishbone Boomerang. 27 rogue damage, use time 30. Ricochets between up to three enemies. Stealth strikes release rotting bone shards with every ricochet. Though the evaporating Sea Kingdom fought a losing battle, its proud inhabitants did not go down easily. As a last resort, they had to fashion weapons from the skeletons of dead animals. How to get it: Craft at Anvil from 2 Sea Remains; Dropped by Duke Fishron"
	Tooltip: "[c/E2735C:Weapon] Fishbone Boomerang: 27 rogue damage, use time 30"
}

GearFlareBolt: {
	Title: "Flare Bolt"
	Contents: "[c/E2735C:Weapon] Obtain Flare Bolt. 40 magic damage, use time 80, 40 mana. Casts a ball of flame. Balls of flame collapse into a swirling backdraft which pulls in enemies. How to get it: Craft at Bookcase from 10 Hellstone Bar, 5 Fireblossom, 1 Ruby"
	Tooltip: "[c/E2735C:Weapon] Flare Bolt: 40 magic damage, use time 80, 40 mana"
}

GearFleshOfInfidelity: {
	Title: "Flesh of Infidelity"
	Contents: "[c/E2735C:Weapon] Obtain Flesh of Infidelity. 14 summon damage, use time 36, 10 mana. Summons a tentacled ball of flesh that splashes blood onto enemies. How to get it: Found in Treasure Bag (The Perforators); Dropped by The Perforator Hive"
	Tooltip: "[c/E2735C:Weapon] Flesh of Infidelity: 14 summon damage, use time 36, 10 mana"
}

GearFlurrystormCannon: {
	Title: "Flurrystorm Cannon"
	Contents: "[c/E2735C:Weapon] Obtain Flurrystorm Cannon. 10 ranged damage, use time 16. Fires a chain of snowballs that become faster over time. Has a chance to also fire an ice chunk that shatters into shards. 50% chance to not consume ammo. How to get it: Craft at Anvil from 1 Snowball Cannon, 1 Illegal Gun Parts, 10 Aerialite Bar, 10 Bone, 10 Pearl Shard (+1 alternative recipe)"
	Tooltip: "[c/E2735C:Weapon] Flurrystorm Cannon: 10 ranged damage, use time 16"
}

GearFrostBlossomStaff: {
	Title: "Frost Blossom Staff"
	Contents: "[c/E2735C:Weapon] Obtain Frost Blossom Staff. 15 summon damage, use time 36, 10 mana. Summons a frozen flower over your head. There can only be one flower at a time. How to get it: Craft at Anvil from 50 Any Ice Block, 10 Boreal Wood, 5 Shiverthorn"
	Tooltip: "[c/E2735C:Weapon] Frost Blossom Staff: 15 summon damage, use time 36, 10 mana"
}

GearFrostBolt: {
	Title: "Frost Bolt"
	Contents: "[c/E2735C:Weapon] Obtain Frost Bolt. 25 magic damage, use time 30, 8 mana. Casts a ball of frost that bounces off tiles. When hitting a tile, a small frost burst is produced. Frost projectiles will fall to the ground after enough time has passed. How to get it: Craft at Bookcase from 20 Any Ice Block, 10 Any Snow Block, 2 Shiverthorn, 1 Sapphire"
	Tooltip: "[c/E2735C:Weapon] Frost Bolt: 25 magic damage, use time 30, 8 mana"
}

GearFungicide: {
	Title: "Fungicide"
	Contents: "[c/E2735C:Weapon] Obtain Fungicide. 19 ranged damage, use time 22. Converts musket balls into fungal rounds that split upon impact. How to get it: Found in Treasure Bag (Crabulon); Dropped by Crabulon"
	Tooltip: "[c/E2735C:Weapon] Fungicide: 19 ranged damage, use time 22"
}

GearGaleforce: {
	Title: "Galeforce"
	Contents: "[c/E2735C:Weapon] Obtain Galeforce. 13 ranged damage, use time 20. Fires a spread of low-damage feathers. How to get it: Craft at Anvil from 10 Aerialite Bar"
	Tooltip: "[c/E2735C:Weapon] Galeforce: 13 ranged damage, use time 20"
}

GearGildedDagger: {
	Title: "Gilded Dagger"
	Contents: "[c/E2735C:Weapon] Obtain Gilded Dagger. 14 rogue damage, use time 18. Throws a shiny blade that ricochets towards another enemy on hit. Stealth strikes cause the blade to home in after ricocheting, with each ricochet dealing 5% more damage. Stealth strikes also have increased piercing. How to get it: Craft at Anvil from 12 Gold Bar"
	Tooltip: "[c/E2735C:Weapon] Gilded Dagger: 14 rogue damage, use time 18"
}

GearGlaive: {
	Title: "Glaive"
	Contents: "[c/E2735C:Weapon] Obtain Glaive. 19 rogue damage, use time 22. Tosses a ricocheting glaive. Stealth strikes shred the first enemy they hit and provide a ring of high-knockback orbiting glaives. How to get it: Sold by Bandit"
	Tooltip: "[c/E2735C:Weapon] Glaive: 19 rogue damage, use time 22"
}

GearGleamingDagger: {
	Title: "Gleaming Dagger"
	Contents: "[c/E2735C:Weapon] Obtain Gleaming Dagger. 14 rogue damage, use time 18. Throws a shiny blade that ricochets towards another enemy on hit. Stealth strikes cause the blade to home in after ricocheting, with each ricochet dealing 5% more damage. Stealth strikes also have increased piercing. How to get it: Craft at Anvil from 12 Platinum Bar"
	Tooltip: "[c/E2735C:Weapon] Gleaming Dagger: 14 rogue damage, use time 18"
}

GearGoldplumeSpear: {
	Title: "Goldplume Spear"
	Contents: "[c/E2735C:Weapon] Obtain Goldplume Spear. 26 melee damage, use time 25. Shoots falling feathers. How to get it: Craft at Anvil from 10 Aerialite Bar"
	Tooltip: "[c/E2735C:Weapon] Goldplume Spear: 26 melee damage, use time 25"
}

GearHardenedHoneycomb: {
	Title: "Hardened Honeycomb"
	Contents: "[c/E2735C:Weapon] Obtain Hardened Honeycomb. 19 rogue damage, use time 18. Fires a honeycomb that shatters into fragments. Stealth strikes grant the Honey buff on hit and spawn bees. How to get it: Found in Treasure Bag (Queen Bee); Dropped by Queen Bee"
	Tooltip: "[c/E2735C:Weapon] Hardened Honeycomb: 19 rogue damage, use time 18"
}

GearHarvestStaff: {
	Title: "Harvest Staff"
	Contents: "[c/E2735C:Weapon] Obtain Harvest Staff. 27 summon damage, use time 30, 10 mana. Summons a sentry. Grows a pumpkin patch that sprouts pumpkins nearby. Pumpkins will hop out when approached by nearby creatures or players. Once out, they will aggressively tackle enemies, exploding on hit. 'No thoughts behind those eyes'. How to get it: Craft at Anvil from 20 Any Wood, 20 Pumpkin, 5 Pumpkin Seed"
	Tooltip: "[c/E2735C:Weapon] Harvest Staff: 27 summon damage, use time 30, 10 mana"
}

GearHellwingStaff: {
	Title: "Hellwing Staff"
	Contents: "[c/E2735C:Weapon] Obtain Hellwing Staff. 21 magic damage, use time 30, 18 mana. Casts flaming bats. How to get it: Craft at Anvil from 10 Hellstone Bar, 10 Ash Wood"
	Tooltip: "[c/E2735C:Weapon] Hellwing Staff: 21 magic damage, use time 30, 18 mana"
}

GearHerringStaff: {
	Title: "Herring Staff"
	Contents: "[c/E2735C:Weapon] Obtain Herring Staff. 15 summon damage, use time 36, 10 mana. Summons a school of herrings to fight for you. How to get it: Caught while fishing; Found in Hydrothermal Crate; Found in Abyss chests"
	Tooltip: "[c/E2735C:Weapon] Herring Staff: 15 summon damage, use time 36, 10 mana"
}

GearHyphaeRod: {
	Title: "Hyphae Rod"
	Contents: "[c/E2735C:Weapon] Obtain Hyphae Rod. 22 magic damage, use time 24, 10 mana. Creates mushroom spores near the player. How to get it: Found in Treasure Bag (Crabulon); Dropped by Crabulon"
	Tooltip: "[c/E2735C:Weapon] Hyphae Rod: 22 magic damage, use time 24, 10 mana"
}

GearIcicleStaff: {
	Title: "Icicle Staff"
	Contents: "[c/E2735C:Weapon] Obtain Icicle Staff. 10 magic damage, use time 7, 6 mana. Casts icicles from the sky. How to get it: Craft at Anvil from 25 Any Ice Block, 3 Shiverthorn"
	Tooltip: "[c/E2735C:Weapon] Icicle Staff: 10 magic damage, use time 7, 6 mana"
}

GearInfernalKris: {
	Title: "Infernal Kris"
	Contents: "[c/E2735C:Weapon] Obtain Infernal Kris. 21 rogue damage, use time 18. Rapidly throws burning daggers. Stealth strikes engulf the dagger in flames, exploding when hitting walls and enemies. How to get it: Craft at Anvil from 10 Hellstone Bar, 10 Ash Wood"
	Tooltip: "[c/E2735C:Weapon] Infernal Kris: 21 rogue damage, use time 18"
}

GearInfestedClawmerang: {
	Title: "Infested Clawmerang"
	Contents: "[c/E2735C:Weapon] Obtain Infested Clawmerang. 18 rogue damage, use time 20. Fires a slow, long-ranged boomerang. Stealth strikes grant the Mushy buff to the user on enemy hits and summon homing spores. How to get it: Found in Treasure Bag (Crabulon); Dropped by Crabulon"
	Tooltip: "[c/E2735C:Weapon] Infested Clawmerang: 18 rogue damage, use time 20"
}

GearIronFrancisca: {
	Title: "Iron Francisca"
	Contents: "[c/E2735C:Weapon] Obtain Iron Francisca. 9 rogue damage, use time 20. The franciscas do more damage for a short time when initially thrown. Stealth strikes pierce up to 6 times. How to get it: Craft at Anvil from 7 Iron Bar"
	Tooltip: "[c/E2735C:Weapon] Iron Francisca: 9 rogue damage, use time 20"
}

GearKylie: {
	Title: "Kylie"
	Contents: "[c/E2735C:Weapon] Obtain Kylie. 12 rogue damage, use time 25. Stealth strikes throw a kylie that weakly seeks out your cursor. 'Also known as Dowak'. How to get it: Found in Wooden Crate (Hardmode); Found in Worldgen chests"
	Tooltip: "[c/E2735C:Weapon] Kylie: 12 rogue damage, use time 25"
}

GearLeadTomahawk: {
	Title: "Lead Tomahawk"
	Contents: "[c/E2735C:Weapon] Obtain Lead Tomahawk. 9 rogue damage, use time 20. The tomahawks have more damage for a short time when initially thrown. Stealth strikes pierce up to 6 times. How to get it: Craft at Anvil from 7 Lead Bar"
	Tooltip: "[c/E2735C:Weapon] Lead Tomahawk: 9 rogue damage, use time 20"
}

GearLemonNade: {
	Title: "Lemon 'nade"
	Contents: "[c/E2735C:Weapon] Obtain Lemon 'nade. 33 rogue damage, use time 30. Disables normal stealth generation. Hold Left Click to pull the pin and generate stealth, and release to throw. The longer it is held, the shorter the fuse once the 'nade is thrown. Will explode in your hand if the fuse is held too long. Stealth strikes explode into exploding lemon seeds. 'Burn t... How to get it: Craft at Tinkerer's Workshop from 1 Lemon, 99 Bouncy Grenade"
	Tooltip: "[c/E2735C:Weapon] Lemon 'nade: 33 rogue damage, use time 30"
}

GearLionfish: {
	Title: "Lionfish"
	Contents: "[c/E2735C:Weapon] Obtain Lionfish. 33 rogue damage, use time 26. Sticks to enemies and injects a potent Venom. The Venom can stack when more lionfish are stuck in an enemy. Stealth strikes spawn homing urchin spikes as they travel. How to get it: Caught while fishing; Found in Hydrothermal Crate; Found in Abyss chests"
	Tooltip: "[c/E2735C:Weapon] Lionfish: 33 rogue damage, use time 26"
}

GearM1Garand: {
	Title: "M1 Garand"
	Contents: "[c/E2735C:Weapon] Obtain M1 Garand. 75 ranged damage, use time 40. Converts bullets into .30-06 rounds which inherit the damage of the converted bullet. Fires 8 bullets before ejecting the rifle's cartridge. Bullets which ricochet off coins can ricochet off cartridges too. 'Mind your thumb'. How to get it: Sold by Arms Dealer"
	Tooltip: "[c/E2735C:Weapon] M1 Garand: 75 ranged damage, use time 40"
}

GearMagnaCannon: {
	Title: "Magna Cannon"
	Contents: "[c/E2735C:Weapon] Obtain Magna Cannon. 25 ranged damage, use time 30. Charges up a rapid fire burst of crystal bolts. Charging for longer increases the number of bolts fired. Fully charged shots fire an even longer and more rapid burst. How to get it: Craft at Anvil from 25 Granite, 12 Meteorite Bar, 3 Diamond, 5 Sapphire"
	Tooltip: "[c/E2735C:Weapon] Magna Cannon: 25 ranged damage, use time 30"
}

GearManaRose: {
	Title: "Mana Rose"
	Contents: "[c/E2735C:Weapon] Obtain Mana Rose. 20 magic damage, use time 38, 15 mana. Casts a mana flower that explodes into petals. How to get it: Craft at Anvil from 1 Natures Gift, 1 Mana Crystal, 5 Moonglow (+1 alternative recipe)"
	Tooltip: "[c/E2735C:Weapon] Mana Rose: 20 magic damage, use time 38, 15 mana"
}

GearMetalMonstrosity: {
	Title: "Metal Monstrosity"
	Contents: "[c/E2735C:Weapon] Obtain Metal Monstrosity. 28 rogue damage, use time 45. Hurls a heavy metal ball that shatters into shards and spiky balls on impact. Stealth strikes cause the ball to impale hit enemies, piercing them with extra shards when it breaks. 'This has to hurt'. How to get it: Craft at Anvil from 500 Spiky Ball, 80 Spike"
	Tooltip: "[c/E2735C:Weapon] Metal Monstrosity: 28 rogue damage, use time 45"
}

GearMeteorFist: {
	Title: "Meteor Fist"
	Contents: "[c/E2735C:Weapon] Obtain Meteor Fist. 31 rogue damage, use time 25. Fires a wired-guided rocket fist that seeks the cursor and accelerates over time. Stealth strikes immediately start accelerating and drop a meteorite on the struck enemy. How to get it: Craft at Anvil from 10 Meteorite Bar"
	Tooltip: "[c/E2735C:Weapon] Meteor Fist: 31 rogue damage, use time 25"
}

GearMonstrousKnives: {
	Title: "Monstrous Knives"
	Contents: "[c/E2735C:Weapon] Obtain Monstrous Knives. 8 melee damage, use time 21. Throws a spread of short-range knives that heal the user. How to get it: Craft at Anvil from 50 Throwing Knife, 1 Life Crystal, 5 Lesser Healing Potion"
	Tooltip: "[c/E2735C:Weapon] Monstrous Knives: 8 melee damage, use time 21"
}

GearMycelialClaws: {
	Title: "Mycelial Claws"
	Contents: "[c/E2735C:Weapon] Obtain Mycelial Claws. 28 melee damage, use time 7. Grants the Mushy buff for 6 seconds on enemy hits. How to get it: Found in Treasure Bag (Crabulon); Dropped by Crabulon"
	Tooltip: "[c/E2735C:Weapon] Mycelial Claws: 28 melee damage, use time 7"
}

GearMycoroot: {
	Title: "Mycoroot"
	Contents: "[c/E2735C:Weapon] Obtain Mycoroot. 12 rogue damage, use time 6. Fires a stream of short-range fungal roots. Stealth strikes spawn an explosion of fungi spores. This grants you and nearby players on your team the Mushy buff for 15 seconds. How to get it: Found in Treasure Bag (Crabulon); Dropped by Crabulon"
	Tooltip: "[c/E2735C:Weapon] Mycoroot: 12 rogue damage, use time 6"
}

GearNastyCholla: {
	Title: "Nasty Cholla"
	Contents: "[c/E2735C:Weapon] Obtain Nasty Cholla. 10 rogue damage, use time 20. Throws a spiky ball that sticks to everything. Explodes into cactus spikes after roughly 3 seconds. Can hurt town NPCs. Stealth strikes throw four at once. How to get it: Craft at Work Bench from 8 Cactus"
	Tooltip: "[c/E2735C:Weapon] Nasty Cholla: 10 rogue damage, use time 20"
}

GearOldLordClaymore: {
	Title: "Old Lord Claymore"
	Contents: "[c/E2735C:Weapon] Obtain Old Lord Claymore. 100 melee damage, use time 90. A slow but powerful blade that sets enemies ablaze and has substantial knockback. How to get it: Dropped by Bone Serpent Head"
	Tooltip: "[c/E2735C:Weapon] Old Lord Claymore: 100 melee damage, use time 90"
}

GearOpalStriker: {
	Title: "Opal Striker"
	Contents: "[c/E2735C:Weapon] Obtain Opal Striker. 30 ranged damage, use time 17. Fires a chargeable heated energy bolt that pierces. Fully charged shots deal extra damage, move faster and inflict On Fire 3. How to get it: Craft at Anvil from 25 Marble, 10 Meteorite Bar, 3 Diamond, 3 Amber"
	Tooltip: "[c/E2735C:Weapon] Opal Striker: 30 ranged damage, use time 17"
}

GearAuger: {
	Title: "P-GSS: Auger"
	Contents: "[c/E2735C:Weapon] Obtain P-GSS: Auger. 55 melee damage, use time 12. A wrist-mounted device which emits a magnetic energy blade. Right Click to create a brief magnetic pull at your cursor and amplify your next slash. 'Initially manufactured to serrate and separate chunks of raw material for transport. Keeping both hands free without compromising on power made it e... How to get it: Craft at Anvil from 5 Mysterious Circuitry, 7 Dubious Plating, 4 Aerialite Bar, 7 Sea Prism"
	Tooltip: "[c/E2735C:Weapon] P-GSS: Auger: 55 melee damage, use time 12"
}

GearAerialTracker: {
	Title: "P-LSR: Aerial Tracker"
	Contents: "[c/E2735C:Weapon] Obtain P-LSR: Aerial Tracker. 16 rogue damage, use time 40. Releases a flying disk that fires lasers at nearby enemies. Lasers do not directly damage enemies, but instead apply a stacking laser burn effect. Once hit by enough lasers or sufficient time has passed, laser burn will deal direct damage. The disk gains acceleration as it returns to the player.... How to get it: Craft at Anvil from 5 Mysterious Circuitry, 7 Dubious Plating, 4 Aerialite Bar, 7 Sea Prism"
	Tooltip: "[c/E2735C:Weapon] P-LSR: Aerial Tracker: 16 rogue damage, use time 40"
}

GearPulsePistol: {
	Title: "P-PLS: Pulse Pistol"
	Contents: "[c/E2735C:Weapon] Obtain P-PLS: Pulse Pistol. 42 magic damage, use time 64, 25 mana. Fires a pulse orb that tracks nearby targets. After hitting an enemy, the pulse orb will split in two. Pulse orb pierce will increase when killing enemies. How to get it: Craft at Anvil from 5 Mysterious Circuitry, 7 Dubious Plating, 4 Aerialite Bar, 7 Sea Prism"
	Tooltip: "[c/E2735C:Weapon] P-PLS: Pulse Pistol: 42 magic damage, use time 64, 25 mana"
}

GearAqueousHunterDrone: {
	Title: "P-PMA: Aqueous Hunter Drone"
	Contents: "[c/E2735C:Weapon] Obtain P-PMA: Aqueous Hunter Drone. 18 summon damage, use time 36, 10 mana. Summons a shrimp drone that fires bursts of homing plasma missiles. Right Click while holding any summon weapon to command the shrimp to launch a vertical missile barrage. Vertical missiles aim towards your cursor and leave a lingering blast if they hit solid ground. Each shrimp uses 4 minion slo... How to get it: Craft at Anvil from 8 Mysterious Circuitry, 4 Dubious Plating, 4 Aerialite Bar, 7 Sea Prism"
	Tooltip: "[c/E2735C:Weapon] P-PMA: Aqueous Hunter Drone: 18 summon damage, use time 36, 10 mana"
}

GearShortCircuit: {
	Title: "P-TSL: Short Circuit"
	Contents: "[c/E2735C:Weapon] Obtain P-TSL: Short Circuit. 11 ranged damage, use time 8. Press Left Click to rapidly fire stunning bolts with high knockback. Press Right Click to shoot a hook that attaches to enemies and rapidly electrocutes them. After electrocuting an enemy enough, the hook will create a shock explosion before returning to you. Successful hook attacks have a short... How to get it: Craft at Anvil from 7 Mysterious Circuitry, 5 Dubious Plating, 4 Aerialite Bar, 7 Sea Prism"
	Tooltip: "[c/E2735C:Weapon] P-TSL: Short Circuit: 11 ranged damage, use time 8"
}

GearParasiticSceptor: {
	Title: "Parasitic Scepter"
	Contents: "[c/E2735C:Weapon] Obtain Parasitic Scepter. 12 magic damage, use time 35, 12 mana. Fires a spread of radioactive water leeches that latch onto enemies. Deals stacking Irradiated damage over time per leech. How to get it: Craft at Anvil from 15 Acidwood, 12 Sulphuric Scale"
	Tooltip: "[c/E2735C:Weapon] Parasitic Scepter: 12 magic damage, use time 35, 12 mana"
}

GearPerfectDark: {
	Title: "Perfect Dark"
	Contents: "[c/E2735C:Weapon] Obtain Perfect Dark. 24 melee damage, use time 24. Fires a vile ball that sticks to tiles and explodes. How to get it: Found in Treasure Bag (The Hive Mind); Dropped by The Hive Mind"
	Tooltip: "[c/E2735C:Weapon] Perfect Dark: 24 melee damage, use time 24"
}

GearPlasmaRod: {
	Title: "Plasma Rod"
	Contents: "[c/E2735C:Weapon] Obtain Plasma Rod. 8 magic damage, use time 20, 10 mana. Casts a low-damage plasma bolt. Shooting a tile will cause several bolts with increased damage to fire. Shooting an enemy will inflict Shadowflame. How to get it: Dropped by Tim; Dropped by Goblin Sorcerer"
	Tooltip: "[c/E2735C:Weapon] Plasma Rod: 8 magic damage, use time 20, 10 mana"
}

GearPolypLauncher: {
	Title: "Polyp Launcher"
	Contents: "[c/E2735C:Weapon] Obtain Polyp Launcher. 12 summon damage, use time 30, 10 mana. Summons a sentry. Summons a polyp bunch that launches coral chunks at nearby enemies. How to get it: Sold by Sea King"
	Tooltip: "[c/E2735C:Weapon] Polyp Launcher: 12 summon damage, use time 30, 10 mana"
}

GearPuffShroom: {
	Title: "Puff Shroom"
	Contents: "[c/E2735C:Weapon] Obtain Puff Shroom. 14 summon damage, use time 36, 10 mana. Summons a cute mushroom warrior to fight for you. How to get it: Found in Treasure Bag (Crabulon); Dropped by Crabulon"
	Tooltip: "[c/E2735C:Weapon] Puff Shroom: 14 summon damage, use time 36, 10 mana"
}

GearPumpkaboom: {
	Title: "Pumpkaboom"
	Contents: "[c/E2735C:Weapon] Obtain Pumpkaboom. 17 rogue damage, use time 70. Throws a pumpkin which sticks to enemies and explodes after a delay. Stealth strikes throw larger pumpkins which pull enemies in before releasing a larger explosion. How to get it: Craft at Anvil from 15 Grenade, 30 Pumpkin, 5 Pumpkin Seed"
	Tooltip: "[c/E2735C:Weapon] Pumpkaboom: 17 rogue damage, use time 70"
}

GearPumpler: {
	Title: "Pumpler"
	Contents: "[c/E2735C:Weapon] Obtain Pumpler. 26 ranged damage, use time 30. Hold Left Click to load up to five pumpkin grenades at once. How to get it: Craft at Anvil from 1 Illegal Gun Parts, 30 Pumpkin, 5 Pumpkin Seed"
	Tooltip: "[c/E2735C:Weapon] Pumpler: 26 ranged damage, use time 30"
}

GearReedBlowgun: {
	Title: "Reed Blowgun"
	Contents: "[c/E2735C:Weapon] Obtain Reed Blowgun. 25 ranged damage, use time 32. Fires a high-pressure stream of bubbles. 'The Old Sea Kingdom never truly sought to expand beyond its initial borders. However, they had a perfect track record of repelling any invasions, thanks to their insurmountable advantage in the water.'. How to get it: Craft at Anvil from 2 Sea Remains"
	Tooltip: "[c/E2735C:Weapon] Reed Blowgun: 25 ranged damage, use time 32"
}

GearRiptide: {
	Title: "Riptide"
	Contents: "[c/E2735C:Weapon] Obtain Riptide. 12 melee damage, use time 25. Reach: X tiles. Speed: 25. Duration: 18 seconds. Sprays a spiral of aqua streams. How to get it: Craft at Anvil from 3 Pearl Shard, 7 Sea Prism, 10 Navystone"
	Tooltip: "[c/E2735C:Weapon] Riptide: 12 melee damage, use time 25"
}

GearRotBall: {
	Title: "Rot Ball"
	Contents: "[c/E2735C:Weapon] Obtain Rot Ball. 16 rogue damage, use time 16. Stealth strikes spawn rain clouds on enemy hits. How to get it: Found in Treasure Bag (The Hive Mind); Dropped by The Hive Mind"
	Tooltip: "[c/E2735C:Weapon] Rot Ball: 16 rogue damage, use time 16"
}

GearRustyBeaconPrototype: {
	Title: "Rusty Beacon Prototype"
	Contents: "[c/E2735C:Weapon] Obtain Rusty Beacon Prototype. 7 summon damage, use time 30, 10 mana. Summons a sentry. Summons a long-abandoned drone that passively emits Irradiated waves. How to get it: Found in Hydrothermal Crate; Found in Sulphurous Crate; Found in Sulphurous Sea chests"
	Tooltip: "[c/E2735C:Weapon] Rusty Beacon Prototype: 7 summon damage, use time 30, 10 mana"
}

GearSaharaSlicers: {
	Title: "Sahara Slicers"
	Contents: "[c/E2735C:Weapon] Obtain Sahara Slicers. 20 melee damage, use time 12. A pair of dual daggers with short range. Hitting enemies with the daggers will give you two bolts for each hit, up to 10. Pressing Right Click will allow you to toss collected bolts at enemies. How to get it: Found in Treasure Bag (Desert Scourge); Dropped by Desert Scourge"
	Tooltip: "[c/E2735C:Weapon] Sahara Slicers: 20 melee damage, use time 12"
}

GearSandDollar: {
	Title: "Sand Dollar"
	Contents: "[c/E2735C:Weapon] Obtain Sand Dollar. 26 rogue damage, use time 15. Throws up to 2 returning sand dollars. Stealth strikes throw 2 long ranged sand dollars that explode into coral shards on enemy hits. How to get it: Sold by Sea King"
	Tooltip: "[c/E2735C:Weapon] Sand Dollar: 26 rogue damage, use time 15"
}

GearSandstreamScepter: {
	Title: "Sandstream Scepter"
	Contents: "[c/E2735C:Weapon] Obtain Sandstream Scepter. 16 magic damage, use time 20, 7 mana. Fires an explosive stream of sand that falls after hitting an enemy. The explosion only occurs when the projectile expires. How to get it: Found in Treasure Bag (Desert Scourge); Dropped by Desert Scourge"
	Tooltip: "[c/E2735C:Weapon] Sandstream Scepter: 16 magic damage, use time 20, 7 mana"
}

GearSausageMaker: {
	Title: "Sausage Maker"
	Contents: "[c/E2735C:Weapon] Obtain Sausage Maker. 27 melee damage, use time 20. Sprays homing blood on hit. How to get it: Found in Treasure Bag (The Perforators); Dropped by The Perforator Hive"
	Tooltip: "[c/E2735C:Weapon] Sausage Maker: 27 melee damage, use time 20"
}

GearScabRipper: {
	Title: "Scab Ripper"
	Contents: "[c/E2735C:Weapon] Obtain Scab Ripper. 10 summon damage, use time 36, 10 mana. Summons a baby blood crawler to protect you. How to get it: Craft at Anvil from 5 Crimtane Bar, 9 Tissue Sample, 20 Shadewood"
	Tooltip: "[c/E2735C:Weapon] Scab Ripper: 10 summon damage, use time 36, 10 mana"
}

GearScourgeoftheDesert: {
	Title: "Scourge of the Desert"
	Contents: "[c/E2735C:Weapon] Obtain Scourge of the Desert. 12 rogue damage, use time 24. A javelin that will burrow through the ground and launch itself at enemies. Stealth strikes throw three javelins that will burrow multiple times. How to get it: Found in Treasure Bag (Desert Scourge); Dropped by Desert Scourge"
	Tooltip: "[c/E2735C:Weapon] Scourge of the Desert: 12 rogue damage, use time 24"
}

GearSeafoamBomb: {
	Title: "Seafoam Bomb"
	Contents: "[c/E2735C:Weapon] Obtain Seafoam Bomb. 12 rogue damage, use time 25. Throws a bomb that explodes into a bubble which deals extra damage to enemies. Stealth strikes are faster and explode into 5 bubbles. How to get it: Craft at Anvil from 25 Bomb, 10 Sea Prism, 1 Pearl Shard"
	Tooltip: "[c/E2735C:Weapon] Seafoam Bomb: 12 rogue damage, use time 25"
}

GearSeashineSword: {
	Title: "Seashine Sword"
	Contents: "[c/E2735C:Weapon] Obtain Seashine Sword. 22 melee damage, use time 40. Shoots an aqua sword beam. How to get it: Craft at Anvil from 3 Pearl Shard, 7 Sea Prism, 10 Navystone"
	Tooltip: "[c/E2735C:Weapon] Seashine Sword: 22 melee damage, use time 40"
}

GearShaderainStaff: {
	Title: "Shaderain Staff"
	Contents: "[c/E2735C:Weapon] Obtain Shaderain Staff. 19 magic damage, use time 34, 14 mana. Fires a spray of evil clouds and rain. How to get it: Found in Treasure Bag (The Hive Mind); Dropped by The Hive Mind"
	Tooltip: "[c/E2735C:Weapon] Shaderain Staff: 19 magic damage, use time 34, 14 mana"
}

GearShadethrower: {
	Title: "Shadethrower"
	Contents: "[c/E2735C:Weapon] Obtain Shadethrower. 21 ranged damage, use time 10. Spits clouds of shade which afflict enemies with Brain Rot. Uses gel for ammo. How to get it: Found in Treasure Bag (The Hive Mind); Dropped by The Hive Mind"
	Tooltip: "[c/E2735C:Weapon] Shadethrower: 21 ranged damage, use time 10"
}

GearShellshooter: {
	Title: "Shellshooter"
	Contents: "[c/E2735C:Weapon] Obtain Shellshooter. 40 ranged damage, use time 70. Fires slow but powerful arrows. Converts wooden arrows into heavy piercing seashells. How to get it: Sold by Sea King"
	Tooltip: "[c/E2735C:Weapon] Shellshooter: 40 ranged damage, use time 70"
}

GearShinobiBlade: {
	Title: "Shinobi Blade"
	Contents: "[c/E2735C:Weapon] Obtain Shinobi Blade. 24 rogue damage, use time 10. Throws a fast blade that spawns healing orbs when it kills an enemy. Stealth strikes repeatedly stab the struck enemy from random directions. How to get it: Dropped by Dark Caster"
	Tooltip: "[c/E2735C:Weapon] Shinobi Blade: 24 rogue damage, use time 10"
}

GearSkyGlaze: {
	Title: "Sky Glaze"
	Contents: "[c/E2735C:Weapon] Obtain Sky Glaze. 10 magic damage, use time 25, 9 mana. Fires feathers from the sky that stick to enemies and tiles and explode. How to get it: Dropped by Harpy"
	Tooltip: "[c/E2735C:Weapon] Sky Glaze: 10 magic damage, use time 25, 9 mana"
}

GearSlagfireDouser: {
	Title: "Slagfire Douser"
	Contents: "[c/E2735C:Weapon] Obtain Slagfire Douser. 5 ranged damage, use time 30. Sprays bursts of molten pollen. Molten pollen ignores 10 points of enemy defense and covers your enemies in Searing Lava. Capable of dousing townsfolk in lava too... How to get it: Found in Brimstone Crate; Found in Slag Crate; Found in Brimstone Crag chests"
	Tooltip: "[c/E2735C:Weapon] Slagfire Douser: 5 ranged damage, use time 30"
}

GearSludgeSplotch: {
	Title: "Sludge Splotch"
	Contents: "[c/E2735C:Weapon] Obtain Sludge Splotch. 30 rogue damage, use time 18. Stealth strikes cause the main ball of sludge to split on hit, inflicting more damage. How to get it: Craft by hand from 50 Blighted Gel, 8 Any Boss 2 Material"
	Tooltip: "[c/E2735C:Weapon] Sludge Splotch: 30 rogue damage, use time 18"
}

GearSmokingComet: {
	Title: "Smoking Comet"
	Contents: "[c/E2735C:Weapon] Obtain Smoking Comet. 17 melee damage, use time 25. Reach: X tiles. Speed: 20. Duration: 21 seconds. Rains stars from the sky. How to get it: Craft at Anvil from 5 Diamond, 5 Amethyst, 10 Pink Gel, 15 Fallen Star, 10 Meteorite Bar"
	Tooltip: "[c/E2735C:Weapon] Smoking Comet: 17 melee damage, use time 25"
}

GearSnapClam: {
	Title: "Snap Clam"
	Contents: "[c/E2735C:Weapon] Obtain Snap Clam. 14 rogue damage, use time 25. Can latch on enemies and inflict Clammed. Stealth strikes throw five clams at once. How to get it: Sold by Sea King"
	Tooltip: "[c/E2735C:Weapon] Snap Clam: 14 rogue damage, use time 25"
}

GearSpadefish: {
	Title: "Spadefish"
	Contents: "[c/E2735C:Weapon] Obtain Spadefish. 30 rogue damage, use time 40. Throws a spadefish at enemies. Stealth Strikes cause you to spin the spade before throwing, damaging nearby enemies. Shift-Right Click this item in your inventory to [TOGGLE breaking tiles]. 'How can a fish be used to dig through the ground? Some questions are best left unanswered...'. How to get it: Caught while fishing"
	Tooltip: "[c/E2735C:Weapon] Spadefish: 30 rogue damage, use time 40"
}

GearSparkSpreader: {
	Title: "Spark Spreader"
	Contents: "[c/E2735C:Weapon] Obtain Spark Spreader. 16 ranged damage, use time 12. Ignites your foe with flaming sparks. Uses gel for ammo. How to get it: Craft at Anvil from 10 Any Gold Bar, 1 Ruby, 12 Gel"
	Tooltip: "[c/E2735C:Weapon] Spark Spreader: 16 ranged damage, use time 12"
}

GearSparklingEmpress: {
	Title: "Sparkling Empress"
	Contents: "[c/E2735C:Weapon] Obtain Sparkling Empress. 10 magic damage, use time 20, 5 mana. Fires a concentrated laser to annihilate your foes. Defeated enemies explode into prism shards. How to get it: Caught while fishing"
	Tooltip: "[c/E2735C:Weapon] Sparkling Empress: 10 magic damage, use time 20, 5 mana"
}

GearSporeKnife: {
	Title: "Spore Knife"
	Contents: "[c/E2735C:Weapon] Obtain Spore Knife. 18 rogue damage, use time 20. Throws an overgrown dagger that bursts into a cloud of poisonous spores. Stealth strikes erupt into hungry homing buds that stick to enemies and gnaw them. How to get it: Craft at Anvil from 12 Jungle Spores, 8 Stinger"
	Tooltip: "[c/E2735C:Weapon] Spore Knife: 18 rogue damage, use time 20"
}

GearSquirrelSquireStaff: {
	Title: "Squirrel Squire Staff"
	Contents: "[c/E2735C:Weapon] Obtain Squirrel Squire Staff. 8 summon damage, use time 30, 10 mana. Summons a sentry. Summons a squirrel to throw acorns at your enemies. How to get it: Craft at Work Bench from 10 Any Wood, 1 Acorn; Found in Starter Bag"
	Tooltip: "[c/E2735C:Weapon] Squirrel Squire Staff: 8 summon damage, use time 30, 10 mana"
}

GearStaffOfNecrosteocytes: {
	Title: "Staff of Necrosteocytes"
	Contents: "[c/E2735C:Weapon] Obtain Staff of Necrosteocytes. 25 summon damage, use time 36, 10 mana. Summons small skeletons to fight for you. How to get it: Dropped by Dark Caster"
	Tooltip: "[c/E2735C:Weapon] Staff of Necrosteocytes: 25 summon damage, use time 36, 10 mana"
}

GearStormSurge: {
	Title: "Storm Surge"
	Contents: "[c/E2735C:Weapon] Obtain Storm Surge. 18 ranged damage, use time 18. Fires a blue shockwave that passes through blocks. Does not consume ammo. 'Fear the storm'. How to get it: Craft at Anvil from 1 Stormlion Mandible, 3 Pearl Shard, 7 Sea Prism, 10 Navystone"
	Tooltip: "[c/E2735C:Weapon] Storm Surge: 18 ranged damage, use time 18"
}

GearStormjawStaff: {
	Title: "Stormjaw Staff"
	Contents: "[c/E2735C:Weapon] Obtain Stormjaw Staff. 11 summon damage, use time 36, 10 mana. Summons a baby stormlion to fight for you. How to get it: Dropped by Stormlion"
	Tooltip: "[c/E2735C:Weapon] Stormjaw Staff: 11 summon damage, use time 36, 10 mana"
}

GearSunSpiritStaff: {
	Title: "Sun Spirit Staff"
	Contents: "[c/E2735C:Weapon] Obtain Sun Spirit Staff. 22 summon damage, use time 36, 10 mana. Summons a solar spirit to protect you. Repeated summons increase its power. How to get it: Craft at Anvil from 5 Amber, 3 Antlion Mandible, 10 Palm Wood"
	Tooltip: "[c/E2735C:Weapon] Sun Spirit Staff: 22 summon damage, use time 36, 10 mana"
}

GearTaintedBlade: {
	Title: "Tainted Blade"
	Contents: "[c/E2735C:Weapon] Obtain Tainted Blade. 48 melee damage, use time 27. Inflicts Poisoned on enemy hits. How to get it: Craft at Anvil from 10 Acidwood, 8 Any Boss 2 Material, 2 Deathweed"
	Tooltip: "[c/E2735C:Weapon] Tainted Blade: 48 melee damage, use time 27"
}

GearTeardropCleaver: {
	Title: "Teardrop Cleaver"
	Contents: "[c/E2735C:Weapon] Obtain Teardrop Cleaver. 33 melee damage, use time 24. Makes your enemies cry. How to get it: Found in Treasure Bag (Eye Of Cthulhu); Dropped by Eye of Cthulhu"
	Tooltip: "[c/E2735C:Weapon] Teardrop Cleaver: 33 melee damage, use time 24"
}

GearTheCauldron: {
	Title: "The Cauldron"
	Contents: "[c/E2735C:Weapon] Obtain The Cauldron. 56 magic damage, use time 60, 30 mana. Launches lava bombs which explode into more lava bombs. 80% reduced mana usage while submerged in lava or while in the underworld. 'Believe it or not, its original wielder was only a few centimeters tall!'. How to get it: Craft at Anvil from 1 Lava Bucket, 8 Hellstone Bar, 20 Obsidian, 20 Ash Block"
	Tooltip: "[c/E2735C:Weapon] The Cauldron: 56 magic damage, use time 60, 30 mana"
}

GearThrowingBrick: {
	Title: "Throwing Brick"
	Contents: "[c/E2735C:Weapon] Obtain Throwing Brick. 14 rogue damage, use time 25. Stealth strikes cause the brick to shatter. 'Prove its resistance by throwing it upwards and catching it with your face'. How to get it: Craft at Work Bench from 1 Red Brick; Found in Starter Bag"
	Tooltip: "[c/E2735C:Weapon] Throwing Brick: 14 rogue damage, use time 25"
}

GearToothBall: {
	Title: "Tooth Ball"
	Contents: "[c/E2735C:Weapon] Obtain Tooth Ball. 16 rogue damage, use time 16. Stealth strikes spawn rain clouds on enemy hits. How to get it: Found in Treasure Bag (The Perforators); Dropped by The Perforator Hive"
	Tooltip: "[c/E2735C:Weapon] Tooth Ball: 16 rogue damage, use time 16"
}

GearToxibow: {
	Title: "Toxibow"
	Contents: "[c/E2735C:Weapon] Obtain Toxibow. 15 ranged damage, use time 28. Converts wooden arrows into slow arrows that inflict Irradiated. How to get it: Craft at Anvil from 15 Acidwood, 12 Sulphuric Scale"
	Tooltip: "[c/E2735C:Weapon] Toxibow: 15 ranged damage, use time 28"
}

GearTradewinds: {
	Title: "Tradewinds"
	Contents: "[c/E2735C:Weapon] Obtain Tradewinds. 23 magic damage, use time 15, 6 mana. Casts fast moving sunlight feathers. How to get it: Craft at Bookcase from 10 Aerialite Bar"
	Tooltip: "[c/E2735C:Weapon] Tradewinds: 23 magic damage, use time 15, 6 mana"
}

GearTurbulance: {
	Title: "Turbulance"
	Contents: "[c/E2735C:Weapon] Obtain Turbulance. 20 rogue damage, use time 18. Fires a cloudy javelin that bursts into wind slashes on hit. Wind slashes occasionally home, and always home if the javelin crits. Stealth strikes are trailed by homing wind slashes. How to get it: Craft at Anvil from 10 Aerialite Bar"
	Tooltip: "[c/E2735C:Weapon] Turbulance: 20 rogue damage, use time 18"
}

GearUrchinMace: {
	Title: "Urchin Mace"
	Contents: "[c/E2735C:Weapon] Obtain Urchin Mace. 15 melee damage, use time 19. Throws out a whirlpool when released. 'The people of the sea were adept hunters, but they abhorred unnecessary violence. Unfortunately, neighboring nations were brutish, so they fashioned their tools for war.'. How to get it: Craft at Anvil from 3 Sea Remains"
	Tooltip: "[c/E2735C:Weapon] Urchin Mace: 15 melee damage, use time 19"
}

GearUrchinStinger: {
	Title: "Urchin Stinger"
	Contents: "[c/E2735C:Weapon] Obtain Urchin Stinger. 13 rogue damage, use time 17. Sticks into enemies and injects an extremely potent poison. Stealth strikes stick into and make enemies Poisoned for longer. Sticking seven stingers in an enemy with a stealth strike stuck in it spawns an irradiated blast. How to get it: Dropped by Aquatic Urchin"
	Tooltip: "[c/E2735C:Weapon] Urchin Stinger: 13 rogue damage, use time 17"
}

GearVeeringWind: {
	Title: "Veering Wind"
	Contents: "[c/E2735C:Weapon] Obtain Veering Wind. 16 magic damage, use time 36, 14 mana. Casts a circular spread of wind waves with high knockback. Press Right Click to cast a circular spread of frost waves. How to get it: Craft at Bookcase from 30 Any Ice Block, 3 Feather, 5 Fallen Star, 10 Cloud"
	Tooltip: "[c/E2735C:Weapon] Veering Wind: 16 magic damage, use time 36, 14 mana"
}

GearVeinBurster: {
	Title: "Vein Burster"
	Contents: "[c/E2735C:Weapon] Obtain Vein Burster. 38 melee damage, use time 41. Fires a blood ball that sticks to tiles and explodes. How to get it: Found in Treasure Bag (The Perforators); Dropped by The Perforator Hive"
	Tooltip: "[c/E2735C:Weapon] Vein Burster: 38 melee damage, use time 41"
}

GearVileFeeder: {
	Title: "Vile Feeder"
	Contents: "[c/E2735C:Weapon] Obtain Vile Feeder. 10 summon damage, use time 36, 10 mana. Summons a baby eater of souls to protect you. How to get it: Craft at Anvil from 5 Demonite Bar, 9 Shadow Scale, 20 Ebonwood"
	Tooltip: "[c/E2735C:Weapon] Vile Feeder: 10 summon damage, use time 36, 10 mana"
}

GearWalkingCane: {
	Title: "Walking Cane"
	Contents: "[c/E2735C:Weapon] Obtain Walking Cane. 40 rogue damage, use time 16. Swipes a pointed walking cane. Stealth strikes drain the sanity of foes, causing shadow hands to be summoned when attacked. While held, increases movement speed by 20%. 'Is it walking me, or am I walking it?'. How to get it: Found in Treasure Bag (Deerclops); Dropped by Deerclops"
	Tooltip: "[c/E2735C:Weapon] Walking Cane: 40 rogue damage, use time 16"
}

GearWaywasher: {
	Title: "Waywasher"
	Contents: "[c/E2735C:Weapon] Obtain Waywasher. 16 magic damage, use time 15, 4 mana. Casts a deluge of inaccurate water bolts. How to get it: Sold by Sea King"
	Tooltip: "[c/E2735C:Weapon] Waywasher: 16 magic damage, use time 15, 4 mana"
}

GearWebBall: {
	Title: "Web Ball"
	Contents: "[c/E2735C:Weapon] Obtain Web Ball. 11 rogue damage, use time 20. Throws a web-covered ball that gets enemies Webbed and slows them down. Stealth strikes slow enemies down longer. How to get it: Craft by hand from 30 Cobweb"
	Tooltip: "[c/E2735C:Weapon] Web Ball: 11 rogue damage, use time 20"
}

GearWindBlade: {
	Title: "Wind Blade"
	Contents: "[c/E2735C:Weapon] Obtain Wind Blade. 30 melee damage, use time 22. Fires cyclones that suck enemies in. How to get it: Craft at Anvil from 10 Aerialite Bar"
	Tooltip: "[c/E2735C:Weapon] Wind Blade: 30 melee damage, use time 22"
}

GearWulfrumBlunderbuss: {
	Title: "Wulfrum Blunderbuss"
	Contents: "[c/E2735C:Weapon] Obtain Wulfrum Blunderbuss. 11 ranged damage, use time 55. Consumes wulfrum scrap or silver coins to fire. The shot's spread can be diminished by aiming further away, at the cost of less damage. Ignores 3 points of enemy Defense. 'The good thing about Wulfrum is that while it breaks fast, it can be reused even faster. In fact, it is quite common for a ro... How to get it: Craft at Anvil from 10 Wulfrum Metal Scrap"
	Tooltip: "[c/E2735C:Weapon] Wulfrum Blunderbuss: 11 ranged damage, use time 55"
}

GearWulfrumController: {
	Title: "Wulfrum Controller"
	Contents: "[c/E2735C:Weapon] Obtain Wulfrum Controller. 19 summon damage, use time 36, 10 mana. Summons a wulfrum droid to fight for you. Hold Right Click while holding the remote to switch all of your drones between regular and supercharge mode. Supercharged droids will stop attacking and focus wulfrum energy onto you. Supercharged droids provide +0.25 HP/s life regen and 2 defense per dro... How to get it: Craft at Anvil from 10 Wulfrum Metal Scrap"
	Tooltip: "[c/E2735C:Weapon] Wulfrum Controller: 19 summon damage, use time 36, 10 mana"
}

GearWulfrumKnife: {
	Title: "Wulfrum Knife"
	Contents: "[c/E2735C:Weapon] Obtain Wulfrum Knife. 11 rogue damage, use time 4. Fires wulfrum knives in bursts of 3 that stick in enemies. Stealth strikes make the knife fly further and hit several times at once. Right Click to magnetize all stuck knives back to you, restoring stealth. Returning knives also temporarily allows using stealth strikes without rogue armor. How to get it: Craft at Anvil from 10 Wulfrum Metal Scrap"
	Tooltip: "[c/E2735C:Weapon] Wulfrum Knife: 11 rogue damage, use time 4"
}

GearWulfrumProsthesis: {
	Title: "Wulfrum Prosthesis"
	Contents: "[c/E2735C:Weapon] Obtain Wulfrum Prosthesis. 18 magic damage, use time 24, 10 mana. Casts a wulfrum bolt. Press Right Click to drain mana from creatures in front of you. 'Technology and magic have been forever locked in an arms race of imitation and retaliation. At times they work in tandem, as seen in certain prosthetic limbs.'. How to get it: Craft at Anvil from 10 Wulfrum Metal Scrap"
	Tooltip: "[c/E2735C:Weapon] Wulfrum Prosthesis: 18 magic damage, use time 24, 10 mana"
}

GearWulfrumScrewdriver: {
	Title: "Wulfrum Screwdriver"
	Contents: "[c/E2735C:Weapon] Obtain Wulfrum Screwdriver. 12 melee damage, use time 24. Can be used to rapidly and royally screw over foes. Striking an enemy sometimes gives you a wulfrum screw that you can throw with Right Click. Hit a thrown screw with the screwdriver to launch it forward at high speed. 'Who makes flatheads this large?? The hell am I supposed to use it for?! This... How to get it: Craft at Anvil from 10 Wulfrum Metal Scrap"
	Tooltip: "[c/E2735C:Weapon] Wulfrum Screwdriver: 12 melee damage, use time 24"
}

GearYateveoBloom: {
	Title: "Yateveo Bloom"
	Contents: "[c/E2735C:Weapon] Obtain Yateveo Bloom. 30 melee damage, use time 22. A synthesis of jungle flora. Throws a powerful rose flail. Press Right Click to stab with a flower spear. How to get it: Craft at Anvil from 1 Jungle Rose, 15 Rich Mahogany, 12 Jungle Spores, 4 Stinger, 2 Vine"
	Tooltip: "[c/E2735C:Weapon] Yateveo Bloom: 30 melee damage, use time 22"
}

GearAbyssalTome: {
	Title: "Abyssal Tome"
	Contents: "[c/E2735C:Weapon] Obtain Abyssal Tome. 22 magic damage, use time 25, 15 mana. Casts a slow-moving ball of dark energy. How to get it: Found in Treasure Bag (The Slime God); Dropped by The Slime God"
	Tooltip: "[c/E2735C:Weapon] Abyssal Tome: 22 magic damage, use time 25, 15 mana"
}

GearAdamantiteParticleAccelerator: {
	Title: "Adamantite Particle Accelerator"
	Contents: "[c/E2735C:Weapon] Obtain Adamantite Particle Accelerator. 65 ranged damage, use time 44. Charges and fires 2 beams of opposite polarities. Hitting with the opposite polarity increases the damage. How to get it: Craft at Mythril/Orichalcum Anvil from 10 Adamantite Bar, 3 Soul of Light, 3 Soul of Night"
	Tooltip: "[c/E2735C:Weapon] Adamantite Particle Accelerator: 65 ranged damage, use time 44"
}

GearAdamantiteThrowingAxe: {
	Title: "Adamantite Throwing Axe"
	Contents: "[c/E2735C:Weapon] Obtain Adamantite Throwing Axe. 61 rogue damage, use time 14. Stealth strikes ignore gravity and rain down lightning on enemy hits. How to get it: Craft at Mythril/Orichalcum Anvil from 10 Adamantite Bar"
	Tooltip: "[c/E2735C:Weapon] Adamantite Throwing Axe: 61 rogue damage, use time 14"
}

GearAncientIceChunk: {
	Title: "Ancient Ice Chunk"
	Contents: "[c/E2735C:Weapon] Obtain Ancient Ice Chunk. 25 summon damage, use time 36, 10 mana. Summons an ice clasper to fight for you. The clasper fires ice shards at distant enemies. While you are close to enemies, it will aggressively bash them with frozen fury. How to get it: Dropped by Ice Clasper"
	Tooltip: "[c/E2735C:Weapon] Ancient Ice Chunk: 25 summon damage, use time 36, 10 mana"
}

GearArbalest: {
	Title: "Arbalest"
	Contents: "[c/E2735C:Weapon] Obtain Arbalest. 28 ranged damage, use time 7. Fires a volley of 6 high-speed arrows. Arrows start off small and grow in size with continuous fire. Arrow damage, spread and knockback scale with arrow size. How to get it: Craft at Mythril/Orichalcum Anvil from 10 Any Mythril Bar, 15 Cog, 10 Soul of Sight"
	Tooltip: "[c/E2735C:Weapon] Arbalest: 28 ranged damage, use time 7"
}

GearArcticBearPaw: {
	Title: "Arctic Bear Paw"
	Contents: "[c/E2735C:Weapon] Obtain Arctic Bear Paw. 80 magic damage, use time 28, 18 mana. Fires spiritual claws that ignore walls. 'The savage mauling that fits in your pocket'. How to get it: Sold by Archmage"
	Tooltip: "[c/E2735C:Weapon] Arctic Bear Paw: 80 magic damage, use time 28, 18 mana"
}

GearAvalanche: {
	Title: "Avalanche"
	Contents: "[c/E2735C:Weapon] Obtain Avalanche. 75 melee damage, use time 35. Hitting enemies spawns orbiting ice bombs. After 2 seconds, ice bombs explode into gravity-affected ice shards. How to get it: Found in Treasure Bag (Cryogen); Dropped by Cryogen"
	Tooltip: "[c/E2735C:Weapon] Avalanche: 75 melee damage, use time 35"
}

GearBarinautical: {
	Title: "Barinautical"
	Contents: "[c/E2735C:Weapon] Obtain Barinautical. 32 ranged damage, use time 4. Converts wooden arrows into strings of 3 electric bolt arrows that explode. How to get it: Found in Treasure Bag (Aquatic Scourge); Dropped by Aquatic Scourge"
	Tooltip: "[c/E2735C:Weapon] Barinautical: 32 ranged damage, use time 4"
}

GearBelchingSaxophone: {
	Title: "Belching Saxophone"
	Contents: "[c/E2735C:Weapon] Obtain Belching Saxophone. 32 magic damage, use time 12, 16 mana. Fires an array of dirty reeds, music notes, and sulphuric bubbles. Doot. How to get it: Dropped by Belching Coral"
	Tooltip: "[c/E2735C:Weapon] Belching Saxophone: 32 magic damage, use time 12, 16 mana"
}

GearTrueBiomeBlade: {
	Title: "Biome Blade"
	Contents: "[c/E2735C:Weapon] Obtain Biome Blade. 115 melee damage, use time 21. Hold down Right Click while standing still on flat ground to attune the weapon to the powers of the surrounding biome. Pressing Right Click otherwise switches between the current attunement and an extra stored one. Main Attunement : [ATT1]. Secondary Attunement : [ATT2]. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Broken Biome Blade, 1 Soul of Fright, 1 Soul of Might, 1 Soul of Sight, 2 Pixie Dust, 10 Starblight Soot"
	Tooltip: "[c/E2735C:Weapon] Biome Blade: 115 melee damage, use time 21"
}

GearBlackHawkRemote: {
	Title: "Black Hawk Remote"
	Contents: "[c/E2735C:Weapon] Obtain Black Hawk Remote. 25 summon damage, use time 36, 10 mana. Summons a Black Hawk jet to fight for you. Jets will fire bullets from your inventory. 50% chance to save ammo. How to get it: Found in Treasure Bag (Wall Of Flesh); Dropped by Wall of Flesh"
	Tooltip: "[c/E2735C:Weapon] Black Hawk Remote: 25 summon damage, use time 36, 10 mana"
}

GearBlastBarrel: {
	Title: "Blast Barrel"
	Contents: "[c/E2735C:Weapon] Obtain Blast Barrel. 32 rogue damage, use time 22. Throws a rolling barrel that explodes on wall collision. Stealth strikes make the barrel bounce twice before disappearing with varied effects after each bounce. 'Some people used to jump over these'. How to get it: Found in Treasure Bag (Wall Of Flesh); Dropped by Wall of Flesh"
	Tooltip: "[c/E2735C:Weapon] Blast Barrel: 32 rogue damage, use time 22"
}

GearBlazingStar: {
	Title: "Blazing Star"
	Contents: "[c/E2735C:Weapon] Obtain Blazing Star. 75 rogue damage, use time 15. Tosses a red-hot ricocheting glaive. After bouncing off of tiles, the glaive can re-hit the same enemy. Stealth strikes shred the first enemy they hit and provide rings of high-knockback orbiting glaives. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Glaive, 5 Hellstone Bar, 10 Essence of Havoc"
	Tooltip: "[c/E2735C:Weapon] Blazing Star: 75 rogue damage, use time 15"
}

GearBlightedSlimeStaff: {
	Title: "Blighted Slime Staff"
	Contents: "[c/E2735C:Weapon] Obtain Blighted Slime Staff. 18 summon damage, use time 36, 10 mana. Summons a blighted slime to fight for you. How to get it: Found in Treasure Bag (The Slime God); Dropped by The Slime God"
	Tooltip: "[c/E2735C:Weapon] Blighted Slime Staff: 18 summon damage, use time 36, 10 mana"
}

GearBonebreaker: {
	Title: "Bonebreaker"
	Contents: "[c/E2735C:Weapon] Obtain Bonebreaker. 55 melee damage, use time 23. Fires javelins that stick to enemies before bursting into shrapnel. Stuck javelins inflict several debuffs. How to get it: Craft at Anvil from 150 Bone Javelin, 15 Corroded Fossil"
	Tooltip: "[c/E2735C:Weapon] Bonebreaker: 55 melee damage, use time 23"
}

GearBrimblade: {
	Title: "Brimblade"
	Contents: "[c/E2735C:Weapon] Obtain Brimblade. 28 rogue damage, use time 18. Throws a blade that splits on enemy hits. Stealth strikes split further and cause the player to launch a barrage of brimstone darts. How to get it: Craft at Mythril/Orichalcum Anvil from 8 Unholy Core"
	Tooltip: "[c/E2735C:Weapon] Brimblade: 28 rogue damage, use time 18"
}

GearBrimlance: {
	Title: "Brimlance"
	Contents: "[c/E2735C:Weapon] Obtain Brimlance. 50 melee damage, use time 19. Creates an explosion of Brimstone Flames on enemy hits. How to get it: Found in Treasure Bag (Brimstone Elemental); Dropped by Brimstone Elemental"
	Tooltip: "[c/E2735C:Weapon] Brimlance: 50 melee damage, use time 19"
}

GearBrimroseStaff: {
	Title: "Brimrose Staff"
	Contents: "[c/E2735C:Weapon] Obtain Brimrose Staff. 45 magic damage, use time 16, 12 mana. Fires a spread of splitting brimstone beams. How to get it: Craft at Mythril/Orichalcum Anvil from 8 Unholy Core"
	Tooltip: "[c/E2735C:Weapon] Brimrose Staff: 45 magic damage, use time 16, 12 mana"
}

GearBrimstoneFury: {
	Title: "Brimstone Fury"
	Contents: "[c/E2735C:Weapon] Obtain Brimstone Fury. 21 ranged damage, use time 22. Converts wooden arrows into a spread of 3 brimstone bolts. How to get it: Craft at Mythril/Orichalcum Anvil from 8 Unholy Core"
	Tooltip: "[c/E2735C:Weapon] Brimstone Fury: 21 ranged damage, use time 22"
}

GearBrimstoneSword: {
	Title: "Brimstone Sword"
	Contents: "[c/E2735C:Weapon] Obtain Brimstone Sword. 70 melee damage, use time 28. Summons geysers of Brimstone Flames on hit. Press Right Click to throw the sword like a javelin that explodes on hit. How to get it: Craft at Mythril/Orichalcum Anvil from 8 Unholy Core"
	Tooltip: "[c/E2735C:Weapon] Brimstone Sword: 70 melee damage, use time 28"
}

GearBurningSea: {
	Title: "Burning Sea"
	Contents: "[c/E2735C:Weapon] Obtain Burning Sea. 56 magic damage, use time 20, 8 mana. Conjures a massive fireball that hovers near you and incinerates foes with Brimstone Flames. Holding the fireball for too long causes it to burn out. This sets you alight with Brimstone Flames and gives a long delay before another can be cast. How to get it: Craft at Bookcase from 1 Spell Tome, 8 Unholy Core"
	Tooltip: "[c/E2735C:Weapon] Burning Sea: 56 magic damage, use time 20, 8 mana"
}

GearBurningStrife: {
	Title: "Burning Strife"
	Contents: "[c/E2735C:Weapon] Obtain Burning Strife. 73 rogue damage, use time 25. Throws an enchanted spiky ball that explodes into Shadowflame. Stealth strikes make the ball erupt into tentacles on hit. 'Definitely not pocket safe'. How to get it: Dropped by Goblin Summoner"
	Tooltip: "[c/E2735C:Weapon] Burning Strife: 73 rogue damage, use time 25"
}

GearBuzzkill: {
	Title: "Buzzkill"
	Contents: "[c/E2735C:Weapon] Obtain Buzzkill. 56 ranged damage, use time 30. Hold Left Click to rev up a buzzsaw that deals close-range damage. Release to fire the buzzsaw, which bounces off tiles and shreds foes. Revving up the saws increases their damage and allows them to pierce more enemies. 'Not to be confused with the Sawed-On Shotgun'. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Illegal Gun Parts, 15 Cog, 10 Soul of Fright"
	Tooltip: "[c/E2735C:Weapon] Buzzkill: 56 ranged damage, use time 30"
}

GearCarnage: {
	Title: "Carnage"
	Contents: "[c/E2735C:Weapon] Obtain Carnage. 130 melee damage, use time 21. Enemies explode into homing blood on death. How to get it: Found in Treasure Bag (Wall Of Flesh); Dropped by Wall of Flesh"
	Tooltip: "[c/E2735C:Weapon] Carnage: 130 melee damage, use time 21"
}

GearTrueCausticEdge: {
	Title: "Caustic Edge"
	Contents: "[c/E2735C:Weapon] Obtain Caustic Edge. 100 melee damage, use time 28. Fires a bouncing caustic beam. Inflicts Venom and slows down on enemy hits. How to get it: Craft at Anvil from 1 Tainted Blade, 8 Any Cursed Flame Ichor, 8 Spider Fang"
	Tooltip: "[c/E2735C:Weapon] Caustic Edge: 100 melee damage, use time 28"
}

GearCausticStaff: {
	Title: "Caustic Staff"
	Contents: "[c/E2735C:Weapon] Obtain Caustic Staff. 18 summon damage, use time 36, 10 mana. Summons a mini dragon to fight for you. The dragon attacks faster and inflicts more debuffs the more are summoned. How to get it: Craft at Demon/Crimson Altar from 10 Any Evil Bar, 10 Any Cursed Flame Ichor, 10 Soul of Night"
	Tooltip: "[c/E2735C:Weapon] Caustic Staff: 18 summon damage, use time 36, 10 mana"
}

GearCelestialClaymore: {
	Title: "Celestial Claymore"
	Contents: "[c/E2735C:Weapon] Obtain Celestial Claymore. 50 melee damage, use time 24. Spawns cosmic energy stars near the cursor. How to get it: Dropped by Big Mimic Corruption; Dropped by Big Mimic Crimson; Dropped by Big Mimic Hallow; and 1 more sources"
	Tooltip: "[c/E2735C:Weapon] Celestial Claymore: 50 melee damage, use time 24"
}

GearClamCrusher: {
	Title: "Clam Crusher"
	Contents: "[c/E2735C:Weapon] Obtain Clam Crusher. 150 melee damage, use time 50. Launches a huge clam that inflicts Eutrophication, stunning enemies for a short amount of time. Starts being affected by gravity and does much more damage after being airborne for a while. How to get it: Dropped by Giant Clam"
	Tooltip: "[c/E2735C:Weapon] Clam Crusher: 150 melee damage, use time 50"
}

GearClamorRifle: {
	Title: "Clamor Rifle"
	Contents: "[c/E2735C:Weapon] Obtain Clamor Rifle. 36 ranged damage, use time 15. Converts musket balls into homing energy bolts. Energy bolts briefly stun enemies. How to get it: Dropped by Giant Clam"
	Tooltip: "[c/E2735C:Weapon] Clamor Rifle: 36 ranged damage, use time 15"
}

GearClothiersWrath: {
	Title: "Clothier's Wrath"
	Contents: "[c/E2735C:Weapon] Obtain Clothier's Wrath. 36 magic damage, use time 22, 15 mana. Shoots 3 shadowflame skulls. How to get it: Dropped by Clothier"
	Tooltip: "[c/E2735C:Weapon] Clothier's Wrath: 36 magic damage, use time 22, 15 mana"
}

GearCobaltKunai: {
	Title: "Cobalt Kunai"
	Contents: "[c/E2735C:Weapon] Obtain Cobalt Kunai. 49 rogue damage, use time 12. Stealth strikes fire four homing cobalt energy bolts. How to get it: Craft at Anvil from 10 Cobalt Bar"
	Tooltip: "[c/E2735C:Weapon] Cobalt Kunai: 49 rogue damage, use time 12"
}

GearCometQuasher: {
	Title: "Comet Quasher"
	Contents: "[c/E2735C:Weapon] Obtain Comet Quasher. 45 melee damage, use time 38. Summons a swarm of meteors from the sky on enemy hits. How to get it: Craft at Anvil from 20 Meteorite Bar, 4 Essence of Sunlight, 5 Fallen Star, 12 Starblight Soot"
	Tooltip: "[c/E2735C:Weapon] Comet Quasher: 45 melee damage, use time 38"
}

GearConsecratedWater: {
	Title: "Consecrated Water"
	Contents: "[c/E2735C:Weapon] Obtain Consecrated Water. 48 rogue damage, use time 29. Throws a holy flask of water that explodes into a sacred flame pillar. The pillar is destroyed if there's no tiles below it. Stealth strikes create three flame pillars instead of one on impact. The bottle is surprisingly dusty. How to get it: Craft at Mythril/Orichalcum Anvil from 100 Holy Water, 5 Any Adamantite Bar, 10 Crystal Shard, 7 Soul of Light"
	Tooltip: "[c/E2735C:Weapon] Consecrated Water: 48 rogue damage, use time 29"
}

GearCorrodedCaustibow: {
	Title: "Corroded Caustibow"
	Contents: "[c/E2735C:Weapon] Obtain Corroded Caustibow. 75 ranged damage, use time 45. Converts wooden arrows into slow, powerful shells that trail an irradiated aura. How to get it: Craft at Anvil from 1 Shellshooter, 1 Toxibow, 10 Corroded Fossil"
	Tooltip: "[c/E2735C:Weapon] Corroded Caustibow: 75 ranged damage, use time 45"
}

GearCryophobia: {
	Title: "Cryophobia"
	Contents: "[c/E2735C:Weapon] Obtain Cryophobia. 96 magic damage, use time 40, 22 mana. Fires an icy wave that splits multiple times and explodes into shards. 'Chill'. How to get it: Sold by Archmage"
	Tooltip: "[c/E2735C:Weapon] Cryophobia: 96 magic damage, use time 40, 22 mana"
}

GearCrystalPiercer: {
	Title: "Crystal Piercer"
	Contents: "[c/E2735C:Weapon] Obtain Crystal Piercer. 92 rogue damage, use time 22. Throws a crystal javelin that pierces infinitely. Stealth strikes travel through blocks, ignore gravity, and summon crystal shards as they fly. How to get it: Craft at Mythril/Orichalcum Anvil from 12 Cryonic Bar"
	Tooltip: "[c/E2735C:Weapon] Crystal Piercer: 92 rogue damage, use time 22"
}

GearCursedDagger: {
	Title: "Cursed Dagger"
	Contents: "[c/E2735C:Weapon] Obtain Cursed Dagger. 45 rogue damage, use time 18. Throws a fast cursed dagger and two inaccurate weaker daggers. Stealth strikes throw a single dagger that bursts into a Cursed Inferno vortex. How to get it: Dropped by Clinger"
	Tooltip: "[c/E2735C:Weapon] Cursed Dagger: 45 rogue damage, use time 18"
}

GearDaedalusGolemStaff: {
	Title: "Daedalus Golem Staff"
	Contents: "[c/E2735C:Weapon] Obtain Daedalus Golem Staff. 70 summon damage, use time 36, 10 mana. Summons a Daedalus Golem soldier that fires pellets and electricity. 'Shining god of greed'. How to get it: Craft at Mythril/Orichalcum Anvil from 12 Cryonic Bar"
	Tooltip: "[c/E2735C:Weapon] Daedalus Golem Staff: 70 summon damage, use time 36, 10 mana"
}

GearDarkechoGreatbow: {
	Title: "Darkecho Greatbow"
	Contents: "[c/E2735C:Weapon] Obtain Darkecho Greatbow. 45 ranged damage, use time 33. Fires two arrows at once. Fires an additional crystal dart. How to get it: Craft at Mythril/Orichalcum Anvil from 12 Cryonic Bar"
	Tooltip: "[c/E2735C:Weapon] Darkecho Greatbow: 45 ranged damage, use time 33"
}

GearDarklightGreatsword: {
	Title: "Darklight Greatsword"
	Contents: "[c/E2735C:Weapon] Obtain Darklight Greatsword. 60 melee damage, use time 30. Fires darklight blades that slice through enemies, creating additional slashes. How to get it: Craft at Mythril/Orichalcum Anvil from 12 Cryonic Bar, 1 Soul of Light, 1 Soul of Night"
	Tooltip: "[c/E2735C:Weapon] Darklight Greatsword: 60 melee damage, use time 30"
}

GearDeathValleyDuster: {
	Title: "Death Valley Duster"
	Contents: "[c/E2735C:Weapon] Obtain Death Valley Duster. 130 magic damage, use time 50, 38 mana. Casts an enchanted blast of sand that passes through enemies and tiles. Casting this spell at max mana while without mana sickness will cause it to give you and any player it hits the Sand's Wind buff. How to get it: Craft at Bookcase from 1 Spell Tome, 25 Fossil Ore, 2 Ancient Cloth"
	Tooltip: "[c/E2735C:Weapon] Death Valley Duster: 130 magic damage, use time 50, 38 mana"
}

GearDeepcoreGK2: {
	Title: "Deepcore GK2"
	Contents: "[c/E2735C:Weapon] Obtain Deepcore GK2. 45 ranged damage, use time 14. Bullets are twice as large and ignore 10 points of enemy defense. 'For rock and stone!'. How to get it: Sold by Demolitionist"
	Tooltip: "[c/E2735C:Weapon] Deepcore GK2: 45 ranged damage, use time 14"
}

GearDeepseaStaff: {
	Title: "Deepsea Staff"
	Contents: "[c/E2735C:Weapon] Obtain Deepsea Staff. 32 summon damage, use time 36, 10 mana. Summons an aquatic star to fight for you. How to get it: Found in Treasure Bag (Aquatic Scourge); Dropped by Aquatic Scourge"
	Tooltip: "[c/E2735C:Weapon] Deepsea Staff: 32 summon damage, use time 36, 10 mana"
}

GearDesecratedWater: {
	Title: "Desecrated Water"
	Contents: "[c/E2735C:Weapon] Obtain Desecrated Water. 55 rogue damage, use time 29. Throws an unholy flask of water that explodes into an explosion of evil bubbles. Stealth strikes spawn additional bubbles that inflict Ichor and Cursed Inferno. How to get it: Craft at Mythril/Orichalcum Anvil from 100 Any Evil Water, 5 Any Adamantite Bar, 5 Any Cursed Flame Ichor, 7 Soul of Night"
	Tooltip: "[c/E2735C:Weapon] Desecrated Water: 55 rogue damage, use time 29"
}

GearDormantBrimseeker: {
	Title: "Dormant Brimseeker"
	Contents: "[c/E2735C:Weapon] Obtain Dormant Brimseeker. 42 summon damage, use time 36, 10 mana. Summons a brimseeker to keep you company. Firing another brimseeker when all minion slots are filled summons a brimstone aura. The aura empowers your brimseeker summons and produces damaging Brimstone Flames fireballs. Only one aura can persist at a time. You could've sworn that they turned even... How to get it: Found in Treasure Bag (Brimstone Elemental); Dropped by Brimstone Elemental"
	Tooltip: "[c/E2735C:Weapon] Dormant Brimseeker: 42 summon damage, use time 36, 10 mana"
}

GearDownpour: {
	Title: "Downpour"
	Contents: "[c/E2735C:Weapon] Obtain Downpour. 50 magic damage, use time 15, 10 mana. Fires an explosive stream of sand that falls after hitting an enemy. The explosion only occurs when the projectile expires. How to get it: Found in Treasure Bag (Aquatic Scourge); Dropped by Aquatic Scourge"
	Tooltip: "[c/E2735C:Weapon] Downpour: 50 magic damage, use time 15, 10 mana"
}

GearEarthenPike: {
	Title: "Earthen Pike"
	Contents: "[c/E2735C:Weapon] Obtain Earthen Pike. 85 melee damage, use time 25. Sprays fossil shards on swing. How to get it: Dropped by Earth Elemental"
	Tooltip: "[c/E2735C:Weapon] Earthen Pike: 85 melee damage, use time 25"
}

GearEldritchTome: {
	Title: "Eldritch Tome"
	Contents: "[c/E2735C:Weapon] Obtain Eldritch Tome. 32 magic damage, use time 7, 13 mana. Casts eldritch tentacles to spear your enemies. How to get it: Found in Treasure Bag (The Slime God); Dropped by The Slime God"
	Tooltip: "[c/E2735C:Weapon] Eldritch Tome: 32 magic damage, use time 7, 13 mana"
}

GearElephantKiller: {
	Title: "Elephant Killer"
	Contents: "[c/E2735C:Weapon] Obtain Elephant Killer. 135 rogue damage, use time 38. Can be tossed to gain % of max stealth on hit. Right Click to spend % of max stealth and fire the gun with increased damage. All gun shots always critically strike, with critical strike chance increasing critical strike damage. Stealth strikes fire a Spectral Elephant from the gun. Any gun shots... How to get it: Dropped by Shady Salesman"
	Tooltip: "[c/E2735C:Weapon] Elephant Killer: 135 rogue damage, use time 38"
}

GearEquanimity: {
	Title: "Equanimity"
	Contents: "[c/E2735C:Weapon] Obtain Equanimity. 84 rogue damage, use time 46. Throws a boomerang that ricochets between enemies and makes them Confused. Enemy hits alternate summoning homing light shards or piercing dark shards. Stealth strikes cause an alternating explosion of light or dark on every ricochet, empowering the opposite color of shard. How to get it: Craft at Anvil from 1 Fishbone Boomerang, 1 Dark Shard, 1 Light Shard, 7 Soul of Light, 7 Soul of Night"
	Tooltip: "[c/E2735C:Weapon] Equanimity: 84 rogue damage, use time 46"
}

GearEvilSmasher: {
	Title: "Evil Smasher"
	Contents: "[c/E2735C:Weapon] Obtain Evil Smasher. 200 damage, use time 120. Channels a powerful hammer strike with the capability to crush all evil. Striking a tile with the hammer strike will cause an explosion and push you back. Striking enemies inflicts Smashed Evil on both the user and target. Charging strikes increases damage, explosion radius, and Smashed Evil dura... How to get it: Obtained in-world (source not found) [c/9AA0A6:(source unconfirmed)]"
	Tooltip: "[c/E2735C:Weapon] Evil Smasher: 200 damage, use time 120"
}

GearExorcism: {
	Title: "Exorcism"
	Contents: "[c/E2735C:Weapon] Obtain Exorcism. 222 rogue damage, use time 96. Throws a gigantic hallowed cross to the heavens, which will fall at your cursor a moment later. Enemies hit as it falls are impaled and repeatedly seared with holy light. Upon expiration a cross shaped explosion is created. Stealth strikes twirl and throw the cross, ending in a stronger explosion... How to get it: Craft at Mythril/Orichalcum Anvil from 20 Hallowed Bar, 3 Soul of Fright, 3 Soul of Might, 3 Soul of Sight"
	Tooltip: "[c/E2735C:Weapon] Exorcism: 222 rogue damage, use time 96"
}

GearFlakToxicannon: {
	Title: "Flak Toxicannon"
	Contents: "[c/E2735C:Weapon] Obtain Flak Toxicannon. 73 ranged damage, use time 44. Fires a toxic shell that explodes into a cone of radioactive sludge. Toxic shells burst when they reach the cursor's position. Direct hits with the toxic shell will reduce the damage dealt by the sludge. Uses rockets for ammo. How to get it: Dropped by Flak Crab"
	Tooltip: "[c/E2735C:Weapon] Flak Toxicannon: 73 ranged damage, use time 44"
}

GearFlarefrostBlade: {
	Title: "Flarefrost Blade"
	Contents: "[c/E2735C:Weapon] Obtain Flarefrost Blade. 125 melee damage, use time 29. Fires a homing flarefrost orb. How to get it: Craft at Mythril/Orichalcum Anvil from 10 Cryonic Bar, 10 Hellstone Bar, 10 Soul of Light"
	Tooltip: "[c/E2735C:Weapon] Flarefrost Blade: 125 melee damage, use time 29"
}

GearFlarewingBow: {
	Title: "Flarewing Bow"
	Contents: "[c/E2735C:Weapon] Obtain Flarewing Bow. 31 ranged damage, use time 35. Shoots a spread of 3 arrows. Wooden arrows are converted into obsidian bats which home in after piercing once. How to get it: Craft at Anvil from 1 Hellwing Bow, 5 Essence of Sunlight, 50 Living Fire Block, 10 Obsidian"
	Tooltip: "[c/E2735C:Weapon] Flarewing Bow: 31 ranged damage, use time 35"
}

GearForbiddenOathblade: {
	Title: "Forbidden Oathblade"
	Contents: "[c/E2735C:Weapon] Obtain Forbidden Oathblade. 58 melee damage, use time 50. Throw a sharp blade that impales, burns, and slows enemies. Up to three blades can impale an enemy at a time, with further hits launching the previous impaled blades. Press Right Click to enter a stance where you can use Left Click to perform a powerful slash. The powerful slash must recharge aft... How to get it: Craft at Mythril/Orichalcum Anvil from 1 Bladecrest Oathsword, 1 Old Lord Claymore, 8 Unholy Core, 8 Essence of Havoc"
	Tooltip: "[c/E2735C:Weapon] Forbidden Oathblade: 58 melee damage, use time 50"
}

GearForgottenApexWand: {
	Title: "Forgotten Apex Wand"
	Contents: "[c/E2735C:Weapon] Obtain Forgotten Apex Wand. 46 summon damage, use time 36, 10 mana. Summons ancient mineral sharks to take on your foes. 'Seems to have lost its jaw some time in the past'. How to get it: Craft at Mythril/Orichalcum Anvil from 5 Any Adamantite Bar, 2 Ancient Battle Armor Material, 4 Amethyst"
	Tooltip: "[c/E2735C:Weapon] Forgotten Apex Wand: 46 summon damage, use time 36, 10 mana"
}

GearForsakenSaber: {
	Title: "Forsaken Saber"
	Contents: "[c/E2735C:Weapon] Obtain Forsaken Saber. 80 melee damage, use time 15. Shoots two sand blades that alter their velocity as they travel. How to get it: Craft at Mythril/Orichalcum Anvil from 5 Any Adamantite Bar, 2 Ancient Battle Armor Material"
	Tooltip: "[c/E2735C:Weapon] Forsaken Saber: 80 melee damage, use time 15"
}

GearFracturedArk: {
	Title: "Fractured Ark"
	Contents: "[c/E2735C:Weapon] Obtain Fractured Ark. 41 melee damage, use time 22. A worn down and rusty blade once wielded against the evil of this world, ready to be of use once more. How to get it: Craft at Anvil from 1 Enchanted Sword, 10 Purified Gel, 10 Any Copper Bar (+1 alternative recipe)"
	Tooltip: "[c/E2735C:Weapon] Fractured Ark: 41 melee damage, use time 22"
}

GearFrigidflashBolt: {
	Title: "Frigidflash Bolt"
	Contents: "[c/E2735C:Weapon] Obtain Frigidflash Bolt. 95 magic damage, use time 20, 20 mana. Casts a fast ball of flash-freezing magma that bounces off tiles. When hitting a tile, a flarefrost burst is produced. Press Right Click to cast an empowered ball that creates a collapsing flarefrost vortex which explodes. How to get it: Craft at Bookcase from 1 Frost Bolt, 1 Flare Bolt, 5 Essence of Havoc, 5 Essence of Eleum"
	Tooltip: "[c/E2735C:Weapon] Frigidflash Bolt: 95 magic damage, use time 20, 20 mana"
}

GearFrostbiteBlaster: {
	Title: "Frostbite Blaster"
	Contents: "[c/E2735C:Weapon] Obtain Frostbite Blaster. 50 ranged damage, use time 7. Fires a spread of 6 bullets. Converts musket balls into icicles. How to get it: Sold by Archmage"
	Tooltip: "[c/E2735C:Weapon] Frostbite Blaster: 50 ranged damage, use time 7"
}

GearFrostyFlare: {
	Title: "Frosty Flare"
	Contents: "[c/E2735C:Weapon] Obtain Frosty Flare. 37 rogue damage, use time 13. Throw a flare that sticks to enemies and rains a hailstorm on them. Stealth strikes summon phantom copies instead of ice shards. 'Do not insert in flare gun'. How to get it: Sold by Archmage"
	Tooltip: "[c/E2735C:Weapon] Frosty Flare: 37 rogue damage, use time 13"
}

GearGacruxianMollusk: {
	Title: "Gacruxian Mollusk"
	Contents: "[c/E2735C:Weapon] Obtain Gacruxian Mollusk. 36 rogue damage, use time 26. Releases homing sparks while traveling. Stealth strikes release homing snails that create even more sparks. How to get it: Caught while fishing"
	Tooltip: "[c/E2735C:Weapon] Gacruxian Mollusk: 36 rogue damage, use time 26"
}

GearGelDart: {
	Title: "Gel Dart"
	Contents: "[c/E2735C:Weapon] Obtain Gel Dart. 21 rogue damage, use time 11. Throws bouncing gel darts that cover enemies in Slimed. Stealth strikes ignore gravity, bounce more vigorously, and constantly leak slime. How to get it: Craft at Solidifier from 14 Purified Gel, 14 Blighted Gel"
	Tooltip: "[c/E2735C:Weapon] Gel Dart: 21 rogue damage, use time 11"
}

GearGeliticBlade: {
	Title: "Gelitic Blade"
	Contents: "[c/E2735C:Weapon] Obtain Gelitic Blade. 38 melee damage, use time 30. Fires a fast gel wave that speeds up on enemy hits and covers them with Slimed. How to get it: Craft at Solidifier from 14 Purified Gel, 14 Blighted Gel"
	Tooltip: "[c/E2735C:Weapon] Gelitic Blade: 38 melee damage, use time 30"
}

GearGlacialEmbrace: {
	Title: "Glacial Embrace"
	Contents: "[c/E2735C:Weapon] Obtain Glacial Embrace. 48 summon damage, use time 36, 10 mana. Summons the power of the ancient ice castle. For each minion slot used, you will gain an additional orbiting shield spike. These spikes accelerate rapidly towards a nearby enemy to inflict heavy damage. They take some time to regenerate after launching themselves at the target, however. On Right... How to get it: Found in Treasure Bag (Cryogen); Dropped by Cryogen"
	Tooltip: "[c/E2735C:Weapon] Glacial Embrace: 48 summon damage, use time 36, 10 mana"
}

GearGleamingMagnolia: {
	Title: "Gleaming Magnolia"
	Contents: "[c/E2735C:Weapon] Obtain Gleaming Magnolia. 53 magic damage, use time 27, 15 mana. Casts a gleaming flower that explodes into petals. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Mana Rose, 5 Hallowed Bar"
	Tooltip: "[c/E2735C:Weapon] Gleaming Magnolia: 53 magic damage, use time 27, 15 mana"
}

GearGloriousEnd: {
	Title: "Glorious End"
	Contents: "[c/E2735C:Weapon] Obtain Glorious End. 60 magic damage, use time 30, 60 mana. Casts a meteor star for the player to ride in the direction of the cursor. The meteor star explodes after hitting an enemy, crashing into a wall, or after 6 seconds. This explosion hurts both enemies and the player. Releasing the cursor before the star explodes will cause it to explode prematurel... How to get it: Dropped by Nova"
	Tooltip: "[c/E2735C:Weapon] Glorious End: 60 magic damage, use time 30, 60 mana"
}

GearGoobow: {
	Title: "Goobow"
	Contents: "[c/E2735C:Weapon] Obtain Goobow. 33 ranged damage, use time 31. Addtionally fires two streams of damaging slime. How to get it: Craft at Solidifier from 14 Purified Gel, 14 Blighted Gel"
	Tooltip: "[c/E2735C:Weapon] Goobow: 33 ranged damage, use time 31"
}

GearGraveGrimreaver: {
	Title: "Grave Grimreaver"
	Contents: "[c/E2735C:Weapon] Obtain Grave Grimreaver. 84 rogue damage, use time 48. Hurls a cursed scythe which homes in. The scythe summons skulls as it flies and explodes into bats on hit. Stealth strikes spawn a flood of bats and falling skulls when destroyed. 'A dapper skeleton's weapon of choice'. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Sickle, 1 Any Tombstone, 50 Bone, 5 Cursed Flame, 10 Soul of Fright"
	Tooltip: "[c/E2735C:Weapon] Grave Grimreaver: 84 rogue damage, use time 48"
}

GearGunkShot: {
	Title: "Gunk Shot"
	Contents: "[c/E2735C:Weapon] Obtain Gunk Shot. 22 ranged damage, use time 35. Shoots a spread of bullets. How to get it: Craft at Solidifier from 14 Purified Gel, 14 Blighted Gel"
	Tooltip: "[c/E2735C:Weapon] Gunk Shot: 22 ranged damage, use time 35"
}

GearHauntedScroll: {
	Title: "Haunted Scroll"
	Contents: "[c/E2735C:Weapon] Obtain Haunted Scroll. 25 summon damage, use time 36, 10 mana. Summons a stack of haunted dishes to fight for you. How to get it: Craft at Anvil from 10 Any Wood, 5 Soul of Light, 5 Soul of Night, 3 Food Platter"
	Tooltip: "[c/E2735C:Weapon] Haunted Scroll: 25 summon damage, use time 36, 10 mana"
}

GearHellborn: {
	Title: "Hellborn"
	Contents: "[c/E2735C:Weapon] Obtain Hellborn. 300 ranged damage, use time 30. An ornate firearm created during the Draconic Era by Azafure's finest forgemaster. Hold Left Click to twirl the gun in your hand, rapidly hitting nearby enemies. Hits with the gun itself add rounds to the gun, up to a max of 12. At the cost of one round, hold Right Click to fire a giant energy sp... How to get it: Found in Treasure Bag (Brimstone Elemental); Dropped by Brimstone Elemental"
	Tooltip: "[c/E2735C:Weapon] Hellborn: 300 ranged damage, use time 30"
}

GearHoarfrostBow: {
	Title: "Hoarfrost Bow"
	Contents: "[c/E2735C:Weapon] Obtain Hoarfrost Bow. 36 ranged damage, use time 29. Fires two arrows at once. Converts wooden arrows into mist arrows that spread frost mist on collision. How to get it: Found in Treasure Bag (Cryogen); Dropped by Cryogen"
	Tooltip: "[c/E2735C:Weapon] Hoarfrost Bow: 36 ranged damage, use time 29"
}

GearHydraulicVoltCrasher: {
	Title: "Hydraulic Volt Crasher"
	Contents: "[c/E2735C:Weapon] Obtain Hydraulic Volt Crasher. 75 melee damage, use time 4. An electrically charged jackhammer which shocks all nearby foes on hit. Press Right Click to use without hammering down walls. 'A device made to electrically stamp metal plates, instantly fusing them. Naturally, it can also function as a devastating weapon.'. How to get it: Craft at Mythril/Orichalcum Anvil from 8 Mysterious Circuitry, 12 Dubious Plating, 10 Any Mythril Bar, 20 Soul of Sight"
	Tooltip: "[c/E2735C:Weapon] Hydraulic Volt Crasher: 75 melee damage, use time 4"
}

GearIceStar: {
	Title: "Ice Star"
	Contents: "[c/E2735C:Weapon] Obtain Ice Star. 35 rogue damage, use time 17. Throws fast but brittle homing ice stars. Stealth strikes last longer and spawn smaller homing stars on first hits. How to get it: Sold by Archmage"
	Tooltip: "[c/E2735C:Weapon] Ice Star: 35 rogue damage, use time 17"
}

GearIcebreaker: {
	Title: "Icebreaker"
	Contents: "[c/E2735C:Weapon] Obtain Icebreaker. 60 rogue damage, use time 14. Throws an icy hammer that magically returns to the player. Stealth strikes spawn a cosmic explosion and freeze nearby enemies on hit. How to get it: Found in Treasure Bag (Cryogen); Dropped by Cryogen"
	Tooltip: "[c/E2735C:Weapon] Icebreaker: 60 rogue damage, use time 14"
}

GearIchorSpear: {
	Title: "Ichor Spear"
	Contents: "[c/E2735C:Weapon] Obtain Ichor Spear. 120 rogue damage, use time 39. Throws a high-velocity Ichor tipped javelin that pierces through enemies. Stealth strikes impale enemies and deal repeated damage. How to get it: Dropped by Ichor Sticker"
	Tooltip: "[c/E2735C:Weapon] Ichor Spear: 120 rogue damage, use time 39"
}

GearIcicleTrident: {
	Title: "Icicle Trident"
	Contents: "[c/E2735C:Weapon] Obtain Icicle Trident. 69 magic damage, use time 25, 21 mana. Shoots piercing icicles. How to get it: Sold by Archmage"
	Tooltip: "[c/E2735C:Weapon] Icicle Trident: 69 magic damage, use time 25, 21 mana"
}

GearIgneousExaltation: {
	Title: "Igneous Exaltation"
	Contents: "[c/E2735C:Weapon] Obtain Igneous Exaltation. 30 summon damage, use time 36, 10 mana. Summons an Igneous blade that orbits around you. When your minion slots are full, Left Click again to launch all blades towards the cursor. This ability has a two-second cooldown that requires holding this item. Press the bound key while holding this item to change the rotation direction. How to get it: Craft at Mythril/Orichalcum Anvil from 8 Unholy Core, 8 Essence of Havoc"
	Tooltip: "[c/E2735C:Weapon] Igneous Exaltation: 30 summon damage, use time 36, 10 mana"
}

GearIonBlaster: {
	Title: "Ion Blaster"
	Contents: "[c/E2735C:Weapon] Obtain Ion Blaster. 24 magic damage, use time 7, 12 mana. Rapidly fires ion blasts with heavy armor penetration that accelerate and explode. Press Right Click to charge the blaster, restoring your mana until it reaches max. The more mana you restore, the stronger the burst is when you release it. Charging for 90% of your max mana or more will reach max... How to get it: Craft at Mythril/Orichalcum Anvil from 10 Any Adamantite Bar, 5 Soul of Light"
	Tooltip: "[c/E2735C:Weapon] Ion Blaster: 24 magic damage, use time 7, 12 mana"
}

GearKelvinCatalyst: {
	Title: "Kelvin Catalyst"
	Contents: "[c/E2735C:Weapon] Obtain Kelvin Catalyst. 50 rogue damage, use time 30. Throws an icy blade that splits into multiple ice stars on enemy hits. Stealth strikes will briefly gain sentience and ram nearby enemies before returning to the player. How to get it: Craft at Anvil from 1 Ice Star, 1 Avalanche, 1 Hoarfrost Bow, 1 Icebreaker, 1 Snowstorm Staff, 10 Essence of Eleum"
	Tooltip: "[c/E2735C:Weapon] Kelvin Catalyst: 50 rogue damage, use time 30"
}

GearLunarianBow: {
	Title: "Lunarian Bow"
	Contents: "[c/E2735C:Weapon] Obtain Lunarian Bow. 27 ranged damage, use time 22. Fires two arrows at once. Converts wooden arrows into sliding energy bolts. How to get it: Craft at Demon/Crimson Altar from 1 Demon Bow, 1 Bees Knees, 1 Molten Fury, 10 Purified Gel (+1 alternative recipe)"
	Tooltip: "[c/E2735C:Weapon] Lunarian Bow: 27 ranged damage, use time 22"
}

GearLunicEye: {
	Title: "Lunic Eye"
	Contents: "[c/E2735C:Weapon] Obtain Lunic Eye. 32 damage, use time 22. Fires seeking energy bolts that cause enemies to become Marked for Death. This weapon scales with the average of all your damage stats. How to get it: Craft at Anvil from 10 Any Cobalt Bar, 20 Starblight Soot"
	Tooltip: "[c/E2735C:Weapon] Lunic Eye: 32 damage, use time 22"
}

GearMajesticGuard: {
	Title: "Majestic Guard"
	Contents: "[c/E2735C:Weapon] Obtain Majestic Guard. 270 melee damage, use time 50. An intricate blade, heavy enough to crush anything it wouldn't cut. Strongly knocks back enemies and heals you slightly on hit. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Gold Broadsword, 15 Any Mythril Bar, 3 Essence of Sunlight, 3 Essence of Havoc, 3 Essence of Eleum (+1 alternative recipe)"
	Tooltip: "[c/E2735C:Weapon] Majestic Guard: 270 melee damage, use time 50"
}

GearMeowthrower: {
	Title: "Meowthrower"
	Contents: "[c/E2735C:Weapon] Obtain Meowthrower. 29 ranged damage, use time 8. Cooks your foes to purrfection with catty smoke. Occasionally launches homing feline entities. Uses gel for ammo. How to get it: Found in Treasure Bag (Wall Of Flesh); Dropped by Wall of Flesh"
	Tooltip: "[c/E2735C:Weapon] Meowthrower: 29 ranged damage, use time 8"
}

GearMiasma: {
	Title: "Miasma"
	Contents: "[c/E2735C:Weapon] Obtain Miasma. 40 magic damage, use time 27, 22 mana. Fires a spread of gas clouds that slow down after hitting an enemy. How to get it: Craft at Anvil from 1 Nimbus Rod, 1 Aquamarine Staff, 10 Corroded Fossil"
	Tooltip: "[c/E2735C:Weapon] Miasma: 40 magic damage, use time 27, 22 mana"
}

GearMidasPrime: {
	Title: "Midas Prime"
	Contents: "[c/E2735C:Weapon] Obtain Midas Prime. 81 ranged damage, use time 32. Press Right Click to toss a Gold Coin or Silver Coin in the air. Striking a coin with a bullet causes it to ricochet into the nearest enemy. Up to 4 coins can be tossed simultaneously, and shots will ricochet off multiple coins if possible. Coins guarantee a critical strike after a short delay an... How to get it: Dropped by Pirate Deadeye"
	Tooltip: "[c/E2735C:Weapon] Midas Prime: 81 ranged damage, use time 32"
}

GearMineralMortar: {
	Title: "Mineral Mortar"
	Contents: "[c/E2735C:Weapon] Obtain Mineral Mortar. 85 ranged damage, use time 60. Shoots an onyx bomb that explodes into huge area damage. Uses rockets for ammo. How to get it: Craft at Mythril/Orichalcum Anvil from 13 Any Adamantite Bar, 2 Ancient Battle Armor Material"
	Tooltip: "[c/E2735C:Weapon] Mineral Mortar: 85 ranged damage, use time 60"
}

GearMountedScanner: {
	Title: "Mounted Scanner"
	Contents: "[c/E2735C:Weapon] Obtain Mounted Scanner. 24 summon damage, use time 36, 10 mana. Summons a powerful scanner module above your head that fires lasers at nearby enemies. How to get it: Craft at Mythril/Orichalcum Anvil from 15 Mysterious Circuitry, 5 Dubious Plating, 10 Any Mythril Bar, 20 Soul of Fright"
	Tooltip: "[c/E2735C:Weapon] Mounted Scanner: 24 summon damage, use time 36, 10 mana"
}

GearMythrilKnife: {
	Title: "Mythril Knife"
	Contents: "[c/E2735C:Weapon] Obtain Mythril Knife. 66 rogue damage, use time 12. Stealth strikes are coated in deadly toxins, inflicting Irradiated, Poisoned, and Venom. How to get it: Craft at Mythril/Orichalcum Anvil from 10 Mythril Bar"
	Tooltip: "[c/E2735C:Weapon] Mythril Knife: 66 rogue damage, use time 12"
}

GearNeedler: {
	Title: "Needler"
	Contents: "[c/E2735C:Weapon] Obtain Needler. 52 ranged damage, use time 18. Converts musket balls into Venom infused needles that stick to enemies and explode. How to get it: Dropped by Moss Hornet"
	Tooltip: "[c/E2735C:Weapon] Needler: 52 ranged damage, use time 18"
}

GearNightsRay: {
	Title: "Night's Ray"
	Contents: "[c/E2735C:Weapon] Obtain Night's Ray. 20 magic damage, use time 20, 15 mana. Fires a ray of pure, concentrated darkness. When hitting enemies, they are hit by several new beams from their sides. How to get it: Craft at Demon/Crimson Altar from 1 Vilethorn, 1 Magic Missile, 1 Wand of Frosting, 1 Amber Staff, 10 Purified Gel (+3 alternative recipes)"
	Tooltip: "[c/E2735C:Weapon] Night's Ray: 20 magic damage, use time 20, 15 mana"
}

GearNitroExpressRifle: {
	Title: "Nitro Express Rifle"
	Contents: "[c/E2735C:Weapon] Obtain Nitro Express Rifle. 210 ranged damage, use time 70. 'The recoil feels strong enough to break your shoulder...'. How to get it: Craft at Anvil from 1 Musket, 3 Essence of Sunlight, 3 Essence of Havoc, 5 Explosive Powder (+1 alternative recipe)"
	Tooltip: "[c/E2735C:Weapon] Nitro Express Rifle: 210 ranged damage, use time 70"
}

GearOrichalcumSpikedGemstone: {
	Title: "Orichalcum Spiked Gemstone"
	Contents: "[c/E2735C:Weapon] Obtain Orichalcum Spiked Gemstone. 40 rogue damage, use time 13. Stealth strikes last longer and summon petals on enemy hits. How to get it: Craft at Mythril/Orichalcum Anvil from 10 Orichalcum Bar"
	Tooltip: "[c/E2735C:Weapon] Orichalcum Spiked Gemstone: 40 rogue damage, use time 13"
}

GearOrthoceraShell: {
	Title: "Orthocera Shell"
	Contents: "[c/E2735C:Weapon] Obtain Orthocera Shell. 42 summon damage, use time 30, 10 mana. Summons a sentry. Summons a flying orthocera to spit Irradiated and Venom streams at your enemies. How to get it: Dropped by Orthocera"
	Tooltip: "[c/E2735C:Weapon] Orthocera Shell: 42 summon damage, use time 30, 10 mana"
}

GearOverloadedBlaster: {
	Title: "Overloaded Blaster"
	Contents: "[c/E2735C:Weapon] Obtain Overloaded Blaster. 19 ranged damage, use time 28. Converts gel into a spread of energized slime pearls that overload when they come to a stop. Overloaded slime pearls deal 60% more damage but no longer pierce. Slime pearls bounce off of walls at very high speed. Uses gel for ammo. 25% chance to not consume ammo. How to get it: Found in Treasure Bag (The Slime God); Dropped by The Slime God"
	Tooltip: "[c/E2735C:Weapon] Overloaded Blaster: 19 ranged damage, use time 28"
}

GearP90: {
	Title: "P90"
	Contents: "[c/E2735C:Weapon] Obtain P90. 6 ranged damage, use time 2. Unleashes a stream of armor-piercing rounds at an incredible rate. Armor-piercing rounds ignore 30 defense. 50% chance to not consume ammo. 'It's a bullet hose'. How to get it: Sold by Arms Dealer"
	Tooltip: "[c/E2735C:Weapon] P90: 6 ranged damage, use time 2"
}

GearPalladiumJavelin: {
	Title: "Palladium Javelin"
	Contents: "[c/E2735C:Weapon] Obtain Palladium Javelin. 81 rogue damage, use time 24. Stealth strikes split into more javelins and boost natural life regeneration on hits. How to get it: Craft at Anvil from 10 Palladium Bar"
	Tooltip: "[c/E2735C:Weapon] Palladium Javelin: 81 rogue damage, use time 24"
}

GearPolarisParrotfish: {
	Title: "Polaris Parrotfish"
	Contents: "[c/E2735C:Weapon] Obtain Polaris Parrotfish. 35 ranged damage, use time 9. How to get it: Caught while fishing"
	Tooltip: "[c/E2735C:Weapon] Polaris Parrotfish: 35 ranged damage, use time 9"
}

GearPoseidon: {
	Title: "Poseidon"
	Contents: "[c/E2735C:Weapon] Obtain Poseidon. 52 magic damage, use time 49, 30 mana. Casts a poseidon typhoon. How to get it: Dropped by Giant Clam"
	Tooltip: "[c/E2735C:Weapon] Poseidon: 52 magic damage, use time 49, 30 mana"
}

GearPrismalline: {
	Title: "Prismalline"
	Contents: "[c/E2735C:Weapon] Obtain Prismalline. 36 rogue damage, use time 20. Throws daggers that split after a while. Stealth strikes additionally explode into prism shards and briefly stun enemies. How to get it: Craft at Anvil from 1 Crystalline, 5 Mollusk Husk, 5 Sea Prism"
	Tooltip: "[c/E2735C:Weapon] Prismalline: 36 rogue damage, use time 20"
}

GearPwnagehammer: {
	Title: "Pwnagehammer"
	Contents: "[c/E2735C:Weapon] Obtain Pwnagehammer. 140 melee damage, use time 50. Throws a heavy, gravity-affected hammer that creates a loud blast of hallowed energy when it hits something. After hitting four times, a spectral hammer will be summoned to strike the enemy. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Pwnhammer, 7 Hallowed Bar, 3 Soul of Fright, 3 Soul of Might, 3 Soul of Sight"
	Tooltip: "[c/E2735C:Weapon] Pwnagehammer: 140 melee damage, use time 50"
}

GearVulcan: {
	Title: "R-GSS: Vulcan"
	Contents: "[c/E2735C:Weapon] Obtain R-GSS: Vulcan. 42 magic damage, use time 11, 9 mana. A mana-fueled Gatling cannon that fires in bursts. Press Right Click to launch a magnetic harpoon which attracts your shots. Launching a harpoon makes burst fire mode last longer. When a harpoon expires, all magnetized shots launch at nearby enemies with increased damage. 'Originally a ceiling mo... How to get it: Craft at Mythril/Orichalcum Anvil from 12 Mysterious Circuitry, 8 Dubious Plating, 10 Any Mythril Bar, 20 Soul of Might"
	Tooltip: "[c/E2735C:Weapon] R-GSS: Vulcan: 42 magic damage, use time 11, 9 mana"
}

GearPulseGrenade: {
	Title: "R-PLS: Pulse Grenade"
	Contents: "[c/E2735C:Weapon] Obtain R-PLS: Pulse Grenade. 123 rogue damage, use time 75. A regenerating grenade that will track enemies and burst into 8 pulse orbs. Pulse orbs will return to you and reform the grenade, hitting anything in their path. Stealth strikes throw the grenade at high speeds and burst into twice as many orbs. How to get it: Craft at Mythril/Orichalcum Anvil from 8 Mysterious Circuitry, 12 Dubious Plating, 10 Any Mythril Bar, 20 Soul of Sight"
	Tooltip: "[c/E2735C:Weapon] R-PLS: Pulse Grenade: 123 rogue damage, use time 75"
}

GearHolofibreImmolator: {
	Title: "R-PMA: Holofibre Immolator"
	Contents: "[c/E2735C:Weapon] Obtain R-PMA: Holofibre Immolator. 30 ranged damage, use time 14. Fires three gravity-affected plasma drops which dissolve through foes. Holding Left Click quickly charges the bow, firing a high-speed plasma arrow. Plasma arrows will detonate after impact, creating stronger explosions if stuck into tiles. Holding Right Click will repeatedly fire uncharged shots... How to get it: Craft at Mythril/Orichalcum Anvil from 12 Mysterious Circuitry, 8 Dubious Plating, 10 Any Mythril Bar, 20 Soul of Fright"
	Tooltip: "[c/E2735C:Weapon] R-PMA: Holofibre Immolator: 30 ranged damage, use time 14"
}

GearRelicofRuin: {
	Title: "Relic of Ruin"
	Contents: "[c/E2735C:Weapon] Obtain Relic of Ruin. 21 magic damage, use time 35, 16 mana. Casts a spread of sand blades. How to get it: Craft at Bookcase from 1 Spell Tome, 5 Any Adamantite Bar, 2 Ancient Battle Armor Material"
	Tooltip: "[c/E2735C:Weapon] Relic of Ruin: 21 magic damage, use time 35, 16 mana"
}

GearRoxcalibur: {
	Title: "Roxcalibur"
	Contents: "[c/E2735C:Weapon] Obtain Roxcalibur. 180 melee damage, use time 40. Hold Left Click to charge up a strike. Release with the cursor above you to swing normally, releasing rock shards. Release with the cursor below you to dive downwards and bounce off enemies. Diving into blocks creates a shockwave. You couldn't get it out of the rock, so you just brought the rock... How to get it: Craft at Anvil from 25 Hellstone Bar, 10 Soul of Night, 5 Essence of Havoc, 10 Obsidian, 100 Any Stone Block, 2 Amethyst; Obtained by breaking Rox"
	Tooltip: "[c/E2735C:Weapon] Roxcalibur: 180 melee damage, use time 40"
}

GearSHPC: {
	Title: "SHPC"
	Contents: "[c/E2735C:Weapon] Obtain SHPC. 117 magic damage, use time 60, 30 mana. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Prototype Plasma Drive, 4 Suspicious Scrap, 10 Any Mythril Bar, 5 Soul of Fright, 5 Soul of Might, 5 Soul of Sight"
	Tooltip: "[c/E2735C:Weapon] SHPC: 117 magic damage, use time 60, 30 mana"
}

GearScourgeoftheSeas: {
	Title: "Scourge of the Seas"
	Contents: "[c/E2735C:Weapon] Obtain Scourge of the Seas. 50 rogue damage, use time 24. Snaps apart into Irradiated clouds upon striking an enemy. Stealth strikes cause a longer Irradiated and are additionally coated with Venom. How to get it: Found in Treasure Bag (Aquatic Scourge); Dropped by Aquatic Scourge"
	Tooltip: "[c/E2735C:Weapon] Scourge of the Seas: 50 rogue damage, use time 24"
}

GearSeasSearing: {
	Title: "Sea's Searing"
	Contents: "[c/E2735C:Weapon] Obtain Sea's Searing. 40 ranged damage, use time 5. Fires a string of bubbles summoning a shower of bubbles on hit. Press Right Click to fire a slower, larger water blast that summons a water spout. How to get it: Found in Treasure Bag (Aquatic Scourge); Dropped by Aquatic Scourge"
	Tooltip: "[c/E2735C:Weapon] Sea's Searing: 40 ranged damage, use time 5"
}

GearSeethingDischarge: {
	Title: "Seething Discharge"
	Contents: "[c/E2735C:Weapon] Obtain Seething Discharge. 40 magic damage, use time 60, 30 mana. Fires an accelerating arc of brimstone hellblasts. Every third attack spawns a brimstone dart ring which chases after foes. How to get it: Found in Treasure Bag (Brimstone Elemental); Dropped by Brimstone Elemental"
	Tooltip: "[c/E2735C:Weapon] Seething Discharge: 40 magic damage, use time 60, 30 mana"
}

GearSerpentine: {
	Title: "Serpentine"
	Contents: "[c/E2735C:Weapon] Obtain Serpentine. 10 magic damage, use time 35, 22 mana. Casts a serpent that follows the mouse cursor. Ignores 15 points of enemy Defense. How to get it: Dropped by Sea Serpent"
	Tooltip: "[c/E2735C:Weapon] Serpentine: 10 magic damage, use time 35, 22 mana"
}

GearShadecrystalBarrage: {
	Title: "Shadecrystal Barrage"
	Contents: "[c/E2735C:Weapon] Obtain Shadecrystal Barrage. 24 magic damage, use time 7, 40 mana. Summons bursts of shadecrystals that can home in on enemies. How to get it: Craft at Bookcase from 1 Crystal Storm, 12 Cryonic Bar"
	Tooltip: "[c/E2735C:Weapon] Shadecrystal Barrage: 24 magic damage, use time 7, 40 mana"
}

GearShellfishStaff: {
	Title: "Shellfish Staff"
	Contents: "[c/E2735C:Weapon] Obtain Shellfish Staff. 70 summon damage, use time 36, 10 mana. Summons a shellfish to latch onto enemies and inflict Shellfish Claps. How to get it: Dropped by Giant Clam"
	Tooltip: "[c/E2735C:Weapon] Shellfish Staff: 70 summon damage, use time 36, 10 mana"
}

GearShimmerspark: {
	Title: "Shimmerspark"
	Contents: "[c/E2735C:Weapon] Obtain Shimmerspark. 41 melee damage, use time 25. Reach: X tiles. Speed: 36. Infinite throw duration. Fires stars when enemies are near. How to get it: Craft at Mythril/Orichalcum Anvil from 12 Cryonic Bar"
	Tooltip: "[c/E2735C:Weapon] Shimmerspark: 41 melee damage, use time 25"
}

GearSkyfinBombers: {
	Title: "Skyfin Bombers"
	Contents: "[c/E2735C:Weapon] Obtain Skyfin Bombers. 46 rogue damage, use time 35. Launches a skyfin nuke that homes in on enemies below it. Stealth strikes rapidly home in regardless of enemy position. 'Fishy bombers inbound!'. How to get it: Craft at Anvil from 1 Contaminated Bile, 15 Corroded Fossil"
	Tooltip: "[c/E2735C:Weapon] Skyfin Bombers: 46 rogue damage, use time 35"
}

GearSlagMagnum: {
	Title: "Slag Magnum"
	Contents: "[c/E2735C:Weapon] Obtain Slag Magnum. 36 ranged damage, use time 15. Converts musket balls into fossil shards that inflict Armor Crunch and split into additional shards on impact. How to get it: Dropped by Earth Elemental"
	Tooltip: "[c/E2735C:Weapon] Slag Magnum: 36 ranged damage, use time 15"
}

GearSlimePuppetStaff: {
	Title: "Slime Puppet Staff"
	Contents: "[c/E2735C:Weapon] Obtain Slime Puppet Staff. 10 summon damage, use time 29, 10 mana. Summons a slime ball that follows you. The ball flies toward nearby enemies and explodes into slime on enemy hits. Does not consume minion slots. How to get it: Craft at Solidifier from 14 Purified Gel, 14 Blighted Gel"
	Tooltip: "[c/E2735C:Weapon] Slime Puppet Staff: 10 summon damage, use time 29, 10 mana"
}

GearSlitheringEels: {
	Title: "Slithering Eels"
	Contents: "[c/E2735C:Weapon] Obtain Slithering Eels. 50 magic damage, use time 40, 20 mana. Casts a magical acid eel that releases acid drops as it moves. How to get it: Dropped by Acid Eel"
	Tooltip: "[c/E2735C:Weapon] Slithering Eels: 50 magic damage, use time 40, 20 mana"
}

GearSnowstormStaff: {
	Title: "Snowstorm Staff"
	Contents: "[c/E2735C:Weapon] Obtain Snowstorm Staff. 39 magic damage, use time 70, 40 mana. Fires snowflakes that follows the mouse cursor. Snowflakes split into ice stars on enemy hits. How to get it: Found in Treasure Bag (Cryogen); Dropped by Cryogen"
	Tooltip: "[c/E2735C:Weapon] Snowstorm Staff: 39 magic damage, use time 70, 40 mana"
}

GearSpearofDestiny: {
	Title: "Spear of Destiny"
	Contents: "[c/E2735C:Weapon] Obtain Spear of Destiny. 70 rogue damage, use time 41. Cycles between throwing 3 small homing spears and throwing a single piercing lance. Stealth strikes throw a high-velocity holy lance that explodes on hit. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Cursed Dagger, 7 Hallowed Bar, 5 Soul of Fright, 5 Soul of Might, 5 Soul of Sight (+1 alternative recipe)"
	Tooltip: "[c/E2735C:Weapon] Spear of Destiny: 70 rogue damage, use time 41"
}

GearSpearofPaleolith: {
	Title: "Spear of Paleolith"
	Contents: "[c/E2735C:Weapon] Obtain Spear of Paleolith. 70 rogue damage, use time 27. Throws an ancient spear that shatters into fossil shards upon hitting an enemy. Stealth strikes remain impaled in the enemy for 10 seconds. While an enemy is impaled, all spears that strike them erupt into even more fossil shards. How to get it: Craft at Mythril/Orichalcum Anvil from 2 Ancient Battle Armor Material, 4 Any Adamantite Bar"
	Tooltip: "[c/E2735C:Weapon] Spear of Paleolith: 70 rogue damage, use time 27"
}

GearSpeedBlaster: {
	Title: "Speed Blaster"
	Contents: "[c/E2735C:Weapon] Obtain Speed Blaster. 40 ranged damage, use time 10. Rapidly fires phosphorescent paintball shots. Press Right Click to eject a powerful paint stream of a different color. Using this ability rapidly propels you in the direction you are moving. This ability has a 5 second cooldown. During this cooldown, you fire more rapidly with greater accuracy. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Painter Paintball Gun, 1 Illegal Gun Parts, 5 Any Mythril Bar"
	Tooltip: "[c/E2735C:Weapon] Speed Blaster: 40 ranged damage, use time 10"
}

GearSpentFuelContainer: {
	Title: "Spent Fuel Container"
	Contents: "[c/E2735C:Weapon] Obtain Spent Fuel Container. 80 rogue damage, use time 50. Throws a fuel container with trace amounts of plutonium that causes a nuclear explosion. The explosion does not occur if there are no tiles below it. Stealth strikes leave a lingering Irradiated zone after the explosion dissipates. 'War Never Changes'. How to get it: Dropped by Cragmaw Mire"
	Tooltip: "[c/E2735C:Weapon] Spent Fuel Container: 80 rogue damage, use time 50"
}

GearStarnightLance: {
	Title: "Starnight Lance"
	Contents: "[c/E2735C:Weapon] Obtain Starnight Lance. 80 melee damage, use time 23. Shoots a frigid starnight beam. How to get it: Craft at Mythril/Orichalcum Anvil from 12 Cryonic Bar"
	Tooltip: "[c/E2735C:Weapon] Starnight Lance: 80 melee damage, use time 23"
}

GearStormSaber: {
	Title: "Storm Saber"
	Contents: "[c/E2735C:Weapon] Obtain Storm Saber. 38 melee damage, use time 23. Fires two homing storm beams. One from blade and one from the sky. How to get it: Dropped by Cloud Elemental"
	Tooltip: "[c/E2735C:Weapon] Storm Saber: 38 melee damage, use time 23"
}

GearStormfrontRazor: {
	Title: "Stormfront Razor"
	Contents: "[c/E2735C:Weapon] Obtain Stormfront Razor. 38 rogue damage, use time 20. Throws a knife that summons lightning on hit. Stealth strikes cause the knife to be faster and summon multiple lightning bolts on hit. 'Strike and stem the flow'. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Cinquedea, 6 Any Mythril Bar, 4 Essence of Sunlight, 15 Sea Prism, 2 Stormlion Mandible"
	Tooltip: "[c/E2735C:Weapon] Stormfront Razor: 38 rogue damage, use time 20"
}

GearSubmarineShocker: {
	Title: "Submarine Shocker"
	Contents: "[c/E2735C:Weapon] Obtain Submarine Shocker. 90 melee damage, use time 16. Enemies release electric sparks on hit. How to get it: Found in Treasure Bag (Aquatic Scourge); Dropped by Aquatic Scourge"
	Tooltip: "[c/E2735C:Weapon] Submarine Shocker: 90 melee damage, use time 16"
}

GearSulphurousGrabber: {
	Title: "Sulphurous Grabber"
	Contents: "[c/E2735C:Weapon] Obtain Sulphurous Grabber. 40 melee damage, use time 25. Reach: X tiles. Speed: 32. Infinite throw duration. Occasionally releases a ring of colored bubbles. The yoyo powers up after touching a green bubble. How to get it: Dropped by Sulphurous Skater"
	Tooltip: "[c/E2735C:Weapon] Sulphurous Grabber: 40 melee damage, use time 25"
}

GearTheDarkMaster: {
	Title: "The Dark Master"
	Contents: "[c/E2735C:Weapon] Obtain The Dark Master. 50 melee damage, use time 26. Fires red echo slash projectiles when above 75% health. Projectile damage increases for every HP above 400. Press Right Click to spawn three shadow clones in a Delta formation. The clones will mirror your sword swings and release projectiles. Projectiles are fired regardless of your own HP, but d... How to get it: Craft at Anvil from 1 Beam Sword, 1 Lights Bane, 20 Soul of Night, 3 Essence of Havoc, 1 Ruby"
	Tooltip: "[c/E2735C:Weapon] The Dark Master: 50 melee damage, use time 26"
}

GearTheGodsGambit: {
	Title: "The God's Gambit"
	Contents: "[c/E2735C:Weapon] Obtain The God's Gambit. 28 melee damage, use time 21. Reach: X tiles. Speed: 32. Infinite throw duration. Fires a stream of damaging slime when enemies are near. How to get it: Craft at Solidifier from 14 Purified Gel, 14 Blighted Gel"
	Tooltip: "[c/E2735C:Weapon] The God's Gambit: 28 melee damage, use time 21"
}

GearThermoclineBlaster: {
	Title: "Thermocline Blaster"
	Contents: "[c/E2735C:Weapon] Obtain Thermocline Blaster. 45 ranged damage, use time 16. Alternates between firing bullets imbued with fire and ice. Any bullet type can be imbued when fired from this gun. How to get it: Craft at Anvil from 1 Phoenix Blaster, 5 Essence of Havoc, 5 Essence of Eleum"
	Tooltip: "[c/E2735C:Weapon] Thermocline Blaster: 45 ranged damage, use time 16"
}

GearTitaniumRailgun: {
	Title: "Titanium Railgun"
	Contents: "[c/E2735C:Weapon] Obtain Titanium Railgun. 370 ranged damage, use time 26. Hold down to charge up a decimating titanium blast. Longer hold time increases power, leading to more damage, size, and knockback. Power is capped when the cannon's sights have fully converged. How to get it: Craft at Mythril/Orichalcum Anvil from 10 Titanium Bar, 5 Crystal Shard"
	Tooltip: "[c/E2735C:Weapon] Titanium Railgun: 370 ranged damage, use time 26"
}

GearTitaniumShuriken: {
	Title: "Titanium Shuriken"
	Contents: "[c/E2735C:Weapon] Obtain Titanium Shuriken. 38 rogue damage, use time 9. Stealth strikes act like a boomerang that spawns clones on enemy hits. How to get it: Craft at Mythril/Orichalcum Anvil from 10 Titanium Bar"
	Tooltip: "[c/E2735C:Weapon] Titanium Shuriken: 38 rogue damage, use time 9"
}

GearTundraFlameBlossomsStaff: {
	Title: "Tundra Flame Blossoms Staff"
	Contents: "[c/E2735C:Weapon] Obtain Tundra Flame Blossoms Staff. 56 summon damage, use time 36, 10 mana. Summons three flarefrost orchids over your head. Each flower consumes one minion slot. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Cinder Blossom Staff, 1 Frost Blossom Staff, 5 Any Mythril Bar"
	Tooltip: "[c/E2735C:Weapon] Tundra Flame Blossoms Staff: 56 summon damage, use time 36, 10 mana"
}

GearValkyrieRay: {
	Title: "Valkyrie Ray"
	Contents: "[c/E2735C:Weapon] Obtain Valkyrie Ray. 90 magic damage, use time 36, 17 mana. Casts a devastating ray of holy power. How to get it: Craft at Mythril/Orichalcum Anvil from 12 Hallowed Bar, 6 Aerialite Bar, 1 Ruby, 1 Soul of Fright, 1 Soul of Might, 1 Soul of Sight"
	Tooltip: "[c/E2735C:Weapon] Valkyrie Ray: 90 magic damage, use time 36, 17 mana"
}

GearVengefulSunStaff: {
	Title: "Vengeful Sun Staff"
	Contents: "[c/E2735C:Weapon] Obtain Vengeful Sun Staff. 38 summon damage, use time 36, 10 mana. Summons a sun spirit to protect you. Repeated summons eclipse the spirit and increase its power. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Sun Spirit Staff, 1 Moon Stone, 3 Soul of Fright, 3 Soul of Might, 3 Soul of Sight"
	Tooltip: "[c/E2735C:Weapon] Vengeful Sun Staff: 38 summon damage, use time 36, 10 mana"
}

GearWaveSkipper: {
	Title: "Wave Skipper"
	Contents: "[c/E2735C:Weapon] Obtain Wave Skipper. 80 rogue damage, use time 22. Throws a spear that bounces a lot. Stealth strikes throw three high speed spears. How to get it: Craft at Anvil from 1 Scourge of the Desert, 5 Mollusk Husk, 15 Sea Prism, 20 Prism Shard"
	Tooltip: "[c/E2735C:Weapon] Wave Skipper: 80 rogue damage, use time 22"
}

GearWyvernsCall: {
	Title: "Wyvern's Call"
	Contents: "[c/E2735C:Weapon] Obtain Wyvern's Call. 65 magic damage, use time 23, 14 mana. Fires wyverns and colored feathers from the sky that stick to enemies and tiles and explode. 'I call upon the mythical Wyvern to shower the lands with its grace'. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Sky Glaze, 5 Any Mythril Bar, 15 Soul of Flight"
	Tooltip: "[c/E2735C:Weapon] Wyvern's Call: 65 magic damage, use time 23, 14 mana"
}

GearYinYo: {
	Title: "Yin-Yo"
	Contents: "[c/E2735C:Weapon] Obtain Yin-Yo. 44 melee damage, use time 25. Reach: X tiles. Speed: 32. Infinite throw duration. Fires light or dark shards when enemies are near. Shards fly back and forth. How to get it: Craft at Anvil from 1 Valor, 1 Dark Shard, 1 Light Shard, 7 Soul of Light, 7 Soul of Night"
	Tooltip: "[c/E2735C:Weapon] Yin-Yo: 44 melee damage, use time 25"
}

GearAbandonedSlimeStaff: {
	Title: "Abandoned Slime Staff"
	Contents: "[c/E2735C:Weapon] Obtain Abandoned Slime Staff. 56 summon damage, use time 36, 40 mana. Summons an astral slime that spreads the Astral Infection. Consumes all of the remaining minion slots on use. Must be used from the hotbar. Increased power and size based on the number of minion slots used. Holding this weapon grants 10% increased jump speed. Cast down from the heavens in disgust... How to get it: Dropped by Astral Slime"
	Tooltip: "[c/E2735C:Weapon] Abandoned Slime Staff: 56 summon damage, use time 36, 40 mana"
}

GearAbsoluteZero: {
	Title: "Absolute Zero"
	Contents: "[c/E2735C:Weapon] Obtain Absolute Zero. 75 melee damage, use time 20. Shoots dark ice crystals. The blade creates frost explosions on direct hits. Ancient blade imbued with the Archmage of Ice's magic. How to get it: Sold by Archmage"
	Tooltip: "[c/E2735C:Weapon] Absolute Zero: 75 melee damage, use time 20"
}

GearAbyssBlade: {
	Title: "Abyss Blade"
	Contents: "[c/E2735C:Weapon] Obtain Abyss Blade. 114 melee damage, use time 65. Tosses a spinning abyssal sword that slices through enemies and releases water energy upon hitting a tile. The sword will fly towards enemies after a ricochet, dealing 2x damage. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Depth Crusher, 20 Voidstone, 20 Depth Cells"
	Tooltip: "[c/E2735C:Weapon] Abyss Blade: 114 melee damage, use time 65"
}

GearAegisBlade: {
	Title: "Aegis Blade"
	Contents: "[c/E2735C:Weapon] Obtain Aegis Blade. 152 melee damage, use time 16. Striking an enemy with the blade causes an earthen eruption. Press Right Click to fire an aegis bolt. How to get it: Found in Treasure Bag (Golem); Dropped by Golem"
	Tooltip: "[c/E2735C:Weapon] Aegis Blade: 152 melee damage, use time 16"
}

GearAlulaAustralis: {
	Title: "Alula Australis"
	Contents: "[c/E2735C:Weapon] Obtain Alula Australis. 65 magic damage, use time 17, 15 mana. Fires a beautiful aurora that spreads the Astral Infection and is trailed by a star shower. How to get it: Found in Treasure Bag (Astrum Aureus); Dropped by Astrum Aureus"
	Tooltip: "[c/E2735C:Weapon] Alula Australis: 65 magic damage, use time 17, 15 mana"
}

GearAmphibiansGuitar: {
	Title: "Amphibian's Guitar"
	Contents: "[c/E2735C:Weapon] Obtain Amphibian's Guitar. 54 summon damage, use time 36, 10 mana. Summons up to 8 guitars that spin around you and shoot notes at the target, occasionally firing spread shots. If all 8 guitars are present, some notes become empowered, dealing extra damage. 'I'll show you suffering!'. How to get it: Craft at Mythril/Orichalcum Anvil from 1 The Axe, 1 Frog, 8 Living Shard, 3 Core of Calamity"
	Tooltip: "[c/E2735C:Weapon] Amphibian's Guitar: 54 summon damage, use time 36, 10 mana"
}

GearAnahitasArpeggio: {
	Title: "Anahita's Arpeggio"
	Contents: "[c/E2735C:Weapon] Obtain Anahita's Arpeggio. 60 magic damage, use time 22, 7 mana. How to get it: Found in Treasure Bag (Leviathan and Anahita); Dropped by The Leviathan"
	Tooltip: "[c/E2735C:Weapon] Anahita's Arpeggio: 60 magic damage, use time 22, 7 mana"
}

GearAnarchyBlade: {
	Title: "Anarchy Blade"
	Contents: "[c/E2735C:Weapon] Obtain Anarchy Blade. 120 melee damage, use time 19. The lower your life the more damage this blade does. Your hits will generate a large explosion. While below 50% life your hits have a chance to instantly kill regular enemies. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Breaker Blade, 8 Unholy Core, 1 Core of Calamity"
	Tooltip: "[c/E2735C:Weapon] Anarchy Blade: 120 melee damage, use time 19"
}

GearAnimosity: {
	Title: "Animosity"
	Contents: "[c/E2735C:Weapon] Obtain Animosity. 39 ranged damage, use time 31. How to get it: Found in Treasure Bag (Calamitas Clone); Dropped by Calamitas Clone"
	Tooltip: "[c/E2735C:Weapon] Animosity: 39 ranged damage, use time 31"
}

GearApoctolith: {
	Title: "Apoctolith"
	Contents: "[c/E2735C:Weapon] Obtain Apoctolith. 185 rogue damage, use time 26. Critical hits tear away enemy defense. Stealth strikes shatter and briefly stun enemies. 'Maybe catching bricks with your face isn't such a hot idea...'. How to get it: Craft at Mythril/Orichalcum Anvil from 100 Throwing Brick, 50 Voidstone, 20 Lumenyl"
	Tooltip: "[c/E2735C:Weapon] Apoctolith: 185 rogue damage, use time 26"
}

GearArcNovaDiffuser: {
	Title: "Arc Nova Diffuser"
	Contents: "[c/E2735C:Weapon] Obtain Arc Nova Diffuser. 125 ranged damage, use time 9. Charges and fires a rapid burst of nova bolts. The first charging stage increases the fire rate of the burst. The second charging stage replaces the rapid burst with a devastating nova blast that always crits. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Opal Striker, 1 Magna Cannon, 1 Core of Calamity"
	Tooltip: "[c/E2735C:Weapon] Arc Nova Diffuser: 125 ranged damage, use time 9"
}

GearArietes41: {
	Title: "Arietes 41"
	Contents: "[c/E2735C:Weapon] Obtain Arietes 41. 77 ranged damage, use time 13. Alternates between firing bullets imbued with lifesteal and Electrified. Electric imbued bullets create a small shockblast on impact, dealing additional damage to the enemy they hit. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Thermocline Blaster, 3 Shroomite Bar, 3 Fallen Star"
	Tooltip: "[c/E2735C:Weapon] Arietes 41: 77 ranged damage, use time 13"
}

GearTrueArkoftheAncients: {
	Title: "Ark of the Ancients"
	Contents: "[c/E2735C:Weapon] Obtain Ark of the Ancients. 100 melee damage, use time 25. A heavenly blade forged to vanquish all evil. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Fractured Ark, 1 Starfury, 1 Broken Hero Sword"
	Tooltip: "[c/E2735C:Weapon] Ark of the Ancients: 100 melee damage, use time 25"
}

GearArtAttack: {
	Title: "Art Attack"
	Contents: "[c/E2735C:Weapon] Obtain Art Attack. 120 magic damage, use time 24, 60 mana. Casts a star that follows the mouse that creates a rainbow trail as it moves. Once a full shape is created with the trail all enemies within it take damage proportional to how long it took to draw the shape. 'And the audience goes wild!'. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Rainbow Rod, 1 Large Ruby, 1 Crystal Shard, 5 Ashes of Calamity"
	Tooltip: "[c/E2735C:Weapon] Art Attack: 120 magic damage, use time 24, 60 mana"
}

GearAstralBlaster: {
	Title: "Astral Blaster"
	Contents: "[c/E2735C:Weapon] Obtain Astral Blaster. 150 ranged damage, use time 15. Converts musket balls into homing astral rounds that spread the Astral Infection. How to get it: Craft at Ancient Manipulator from 12 Astral Bar"
	Tooltip: "[c/E2735C:Weapon] Astral Blaster: 150 ranged damage, use time 15"
}

GearAstralPike: {
	Title: "Astral Pike"
	Contents: "[c/E2735C:Weapon] Obtain Astral Pike. 90 melee damage, use time 13. Summons astral star swarms on hit that spread the Astral Infection. How to get it: Craft at Ancient Manipulator from 12 Astral Bar"
	Tooltip: "[c/E2735C:Weapon] Astral Pike: 90 melee damage, use time 13"
}

GearAstralScythe: {
	Title: "Astral Scythe"
	Contents: "[c/E2735C:Weapon] Obtain Astral Scythe. 80 melee damage, use time 20. Shoots a scythe ring that accelerates over time and spreads the Astral Infection. How to get it: Dropped by Mantis"
	Tooltip: "[c/E2735C:Weapon] Astral Scythe: 80 melee damage, use time 20"
}

GearAstralStaff: {
	Title: "Astral Staff"
	Contents: "[c/E2735C:Weapon] Obtain Astral Staff. 245 magic damage, use time 18, 26 mana. Summons a large crystal from the sky that has a large area of effect on impact and spreads the Astral Infection. How to get it: Craft at Ancient Manipulator from 12 Astral Bar"
	Tooltip: "[c/E2735C:Weapon] Astral Staff: 245 magic damage, use time 18, 26 mana"
}

GearAstralachneaStaff: {
	Title: "Astralachnea Staff"
	Contents: "[c/E2735C:Weapon] Obtain Astralachnea Staff. 55 magic damage, use time 21, 16 mana. Fires a spread of homing astral spider fangs that spread the Astral Infection. How to get it: Dropped by Astralachnea Wall"
	Tooltip: "[c/E2735C:Weapon] Astralachnea Staff: 55 magic damage, use time 21, 16 mana"
}

GearAtlantis: {
	Title: "Atlantis"
	Contents: "[c/E2735C:Weapon] Obtain Atlantis. 81 magic damage, use time 25, 15 mana. Casts aquatic spears that split as they travel. How to get it: Found in Treasure Bag (Leviathan and Anahita); Dropped by The Leviathan"
	Tooltip: "[c/E2735C:Weapon] Atlantis: 81 magic damage, use time 25, 15 mana"
}

GearAuroraBlazer: {
	Title: "Aurora Blazer"
	Contents: "[c/E2735C:Weapon] Obtain Aurora Blazer. 69 ranged damage, use time 5. Spews a nebula stream which forms a star shaped pattern and spreads the Astral Infection. Uses gel for ammo. How to get it: Found in Treasure Bag (Astrum Aureus); Dropped by Astrum Aureus"
	Tooltip: "[c/E2735C:Weapon] Aurora Blazer: 69 ranged damage, use time 5"
}

GearAuroradicalThrow: {
	Title: "Auroradical Throw"
	Contents: "[c/E2735C:Weapon] Obtain Auroradical Throw. 48 rogue damage, use time 30. Launches a star that splits after a short period of time. Split stars home in on nearby enemies after a few seconds. Stealth strikes summon a meteor upon enemy impact. Spreads the Astral Infection. How to get it: Found in Treasure Bag (Astrum Aureus); Dropped by Astrum Aureus"
	Tooltip: "[c/E2735C:Weapon] Auroradical Throw: 48 rogue damage, use time 30"
}

GearNidhogg: {
	Title: "B-GSS: Nidhogg"
	Contents: "[c/E2735C:Weapon] Obtain B-GSS: Nidhogg. 69 ranged damage, use time 8. A magnet powered energy railgun that fires rapidly, creating lingering magnetic implosions that pull in weak enemies on hit. Only one implosion can exist at a time. Press Right Click to begin charging a devastating energy beam that always crits and will fire once ready. This charge attack can not... How to get it: Craft at Mythril/Orichalcum Anvil from 18 Mysterious Circuitry, 12 Dubious Plating, 5 Life Alloy, 10 Infected Armor Plating"
	Tooltip: "[c/E2735C:Weapon] B-GSS: Nidhogg: 69 ranged damage, use time 8"
}

GearCountermeasureMitt: {
	Title: "B-LSR: Countermeasure Mitt"
	Contents: "[c/E2735C:Weapon] Obtain B-LSR: Countermeasure Mitt. 45 magic damage, use time 11, 3 mana. A precision welding glove with laser emitters in each fingertip. Right Click to focus all emitters into a short range palm blast that always critically strikes. Palm blasts restore a large amount of mana on hit and have a cooldown which is significantly shorter if they miss. 'Most battalions pref... How to get it: Craft at Mythril/Orichalcum Anvil from 15 Mysterious Circuitry, 15 Dubious Plating, 5 Life Alloy, 10 Infected Armor Plating"
	Tooltip: "[c/E2735C:Weapon] B-LSR: Countermeasure Mitt: 45 magic damage, use time 11, 3 mana"
}

GearBallisticPoisonBomb: {
	Title: "Ballistic Poison Bomb"
	Contents: "[c/E2735C:Weapon] Obtain Ballistic Poison Bomb. 57 rogue damage, use time 26. Throws a sticky bomb that explodes into spikes and venomous clouds. Stealth strikes erupt into more clouds with a longer lasting Venom. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Seafoam Bomb, 10 Sulphurous Sand, 10 Voidstone, 20 Depth Cells"
	Tooltip: "[c/E2735C:Weapon] Ballistic Poison Bomb: 57 rogue damage, use time 26"
}

GearBladedgeRailbow: {
	Title: "Bladedge Railbow"
	Contents: "[c/E2735C:Weapon] Obtain Bladedge Railbow. 30 ranged damage, use time 28. How to get it: Craft at Mythril/Orichalcum Anvil from 10 Perennial Bar"
	Tooltip: "[c/E2735C:Weapon] Bladedge Railbow: 30 ranged damage, use time 28"
}

GearBlightSpewer: {
	Title: "Blight Spewer"
	Contents: "[c/E2735C:Weapon] Obtain Blight Spewer. 52 ranged damage, use time 19. Fires clouds of Plague nanomachines that stick to tiles. Nanomachines aggressively lock onto nearby enemies. 33% chance to not consume ammo. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Spark Spreader, 5 Infected Armor Plating, 10 Plague Cell Canister"
	Tooltip: "[c/E2735C:Weapon] Blight Spewer: 52 ranged damage, use time 19"
}

GearBlightedCleaver: {
	Title: "Blighted Cleaver"
	Contents: "[c/E2735C:Weapon] Obtain Blighted Cleaver. 52 melee damage, use time 28. Fires homing, blazing blades. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Caustic Edge, 1 Broken Hero Sword, 10 Chlorophyte Bar, 10 Vial of Venom"
	Tooltip: "[c/E2735C:Weapon] Blighted Cleaver: 52 melee damage, use time 28"
}

GearBlossomFlux: {
	Title: "Blossom Flux"
	Contents: "[c/E2735C:Weapon] Obtain Blossom Flux. 18 ranged damage, use time 4. Fires a stream of leaves. Press Right Click to fire a spore orb that explodes into a cloud of spore gas. How to get it: Found in Treasure Bag (Plantera); Dropped by Plantera"
	Tooltip: "[c/E2735C:Weapon] Blossom Flux: 18 ranged damage, use time 4"
}

GearBorealisBomber: {
	Title: "Borealis Bomber"
	Contents: "[c/E2735C:Weapon] Obtain Borealis Bomber. 34 summon damage, use time 20, 10 mana. Summons aureus bombers to chase down your enemies. Aureus bombers explode violently on enemy impact, spreading the Astral Infection. Does not consume minion slots. How to get it: Found in Treasure Bag (Astrum Aureus); Dropped by Astrum Aureus"
	Tooltip: "[c/E2735C:Weapon] Borealis Bomber: 34 summon damage, use time 20, 10 mana"
}

GearBotanicPiercer: {
	Title: "Botanic Piercer"
	Contents: "[c/E2735C:Weapon] Obtain Botanic Piercer. 80 melee damage, use time 17. Fires a botanic energy beam. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Chlorophyte Partisan, 1 Dark Lance, 1 Gungnir, 12 Living Shard"
	Tooltip: "[c/E2735C:Weapon] Botanic Piercer: 80 melee damage, use time 17"
}

GearBrimlash: {
	Title: "Brimlash"
	Contents: "[c/E2735C:Weapon] Obtain Brimlash. 60 melee damage, use time 30. Fires a brimstone bolt that explodes into more bolts on hit. How to get it: Craft at Mythril/Orichalcum Anvil from 8 Unholy Core, 8 Ashes of Calamity"
	Tooltip: "[c/E2735C:Weapon] Brimlash: 60 melee damage, use time 30"
}

GearBrinyBaron: {
	Title: "Briny Baron"
	Contents: "[c/E2735C:Weapon] Obtain Briny Baron. 182 melee damage, use time 20. Striking an enemy with the blade causes a briny typhoon to appear. Press Right Click to fire a razorwind aqua blade. How to get it: Found in Treasure Bag (Fishron); Dropped by Duke Fishron"
	Tooltip: "[c/E2735C:Weapon] Briny Baron: 182 melee damage, use time 20"
}

GearContinentalGreatbow: {
	Title: "Continental Greatbow"
	Contents: "[c/E2735C:Weapon] Obtain Continental Greatbow. 45 ranged damage, use time 24. Wooden arrows are set alight with fire. Fires 3 arrows at once. Fires 2 additional hellfire or ichor arrows. How to get it: Craft at Mythril/Orichalcum Anvil from 10 Scoria Bar"
	Tooltip: "[c/E2735C:Weapon] Continental Greatbow: 45 ranged damage, use time 24"
}

GearCorpusAvertor: {
	Title: "Corpus Avertor"
	Contents: "[c/E2735C:Weapon] Obtain Corpus Avertor. 98 rogue damage, use time 15. Throws a spinning dagger that spawns a rebounding clone. Deals more damage the lower your health, and grants lifesteal. Stealth strikes throw a piercing rainbow dagger which spawns an extra slash in its wake, with a blood cost. This dagger grants players on your team 10% damage and +2 HP/s life r... How to get it: Found in Treasure Bag (Ravager); Dropped by Ravager"
	Tooltip: "[c/E2735C:Weapon] Corpus Avertor: 98 rogue damage, use time 15"
}

GearCraniumSmasher: {
	Title: "Cranium Smasher"
	Contents: "[c/E2735C:Weapon] Obtain Cranium Smasher. 140 rogue damage, use time 20. Alternates between throwing piercing, rolling disks and explosive disks. Stealth strikes embed into the hit foe, exploding multiple times. How to get it: Found in Treasure Bag (Ravager); Dropped by Ravager"
	Tooltip: "[c/E2735C:Weapon] Cranium Smasher: 140 rogue damage, use time 20"
}

GearCrushsawCrasher: {
	Title: "Crushsaw Crasher"
	Contents: "[c/E2735C:Weapon] Obtain Crushsaw Crasher. 57 rogue damage, use time 18. Throws bouncing axes. Stealth strikes throw six at once. How to get it: Dropped by Catastrophic Construct"
	Tooltip: "[c/E2735C:Weapon] Crushsaw Crasher: 57 rogue damage, use time 18"
}

GearDeepWounder: {
	Title: "Deep Wounder"
	Contents: "[c/E2735C:Weapon] Obtain Deep Wounder. 132 rogue damage, use time 25. Throws an abyssal hatchet. Stealth strikes cause the hatchet to stick to struck enemies, releasing a barrage of water projectiles. Water projectiles launch at the closest enemy after a brief delay. How to get it: Sold by Bandit"
	Tooltip: "[c/E2735C:Weapon] Deep Wounder: 132 rogue damage, use time 25"
}

GearDefectiveSphere: {
	Title: "Defective Sphere"
	Contents: "[c/E2735C:Weapon] Obtain Defective Sphere. 85 rogue damage, use time 13. Fires a variety of deadly spheres with different effects. Up to five spheres can be thrown at a time. Stealth strikes launch all 4 sphere types at once. How to get it: Dropped by Deadly Sphere"
	Tooltip: "[c/E2735C:Weapon] Defective Sphere: 85 rogue damage, use time 13"
}

GearDoomsdayDevice: {
	Title: "Doomsday Device"
	Contents: "[c/E2735C:Weapon] Obtain Doomsday Device. 240 rogue damage, use time 55. Direct hits from the weapon grant stealth. Non-stealth strikes do not consume stealth when fully charged. Holding a stealth strike charge beyond its limit rapidly drains stealth. Stealth strikes ricochet between multiple enemies, ending in a strong impact. 'A high-tech explosive with devastating... How to get it: Dropped by Scutlix Rider; Dropped by Martian Officer"
	Tooltip: "[c/E2735C:Weapon] Doomsday Device: 240 rogue damage, use time 55"
}

GearDreadmineStaff: {
	Title: "Dreadmine Staff"
	Contents: "[c/E2735C:Weapon] Obtain Dreadmine Staff. 40 summon damage, use time 30, 10 mana. Summons a sentry. Summons a turret that swarms your enemies with sea mines. How to get it: Craft at Mythril/Orichalcum Anvil from 30 Voidstone, 30 Depth Cells"
	Tooltip: "[c/E2735C:Weapon] Dreadmine Staff: 40 summon damage, use time 30, 10 mana"
}

GearDukesDecapitator: {
	Title: "Duke's Decapitator"
	Contents: "[c/E2735C:Weapon] Obtain Duke's Decapitator. 90 rogue damage, use time 30. Throws a hydro axe which shreds enemies when it comes into contact with them. The faster the axe is spinning, the more times it hits before disappearing. Stealth strikes emit short-ranged bubbles. How to get it: Found in Treasure Bag (Fishron); Dropped by Duke Fishron"
	Tooltip: "[c/E2735C:Weapon] Duke's Decapitator: 90 rogue damage, use time 30"
}

GearDuststormInABottle: {
	Title: "Duststorm in a Bottle"
	Contents: "[c/E2735C:Weapon] Obtain Duststorm in a Bottle. 110 rogue damage, use time 28. Disables normal stealth generation. Throws a bottle filled with high-pressure dust that shatters on impact with a target or after a short delay. Hold Left Click to generate stealth, but cause the bottle to shatter sooner. Stealth strikes cause the bottle to leak dust clouds around it for a few se... How to get it: Craft at Mythril/Orichalcum Anvil from 1 Lemon 'nade, 2 Ancient Cloth, 1 Grand Scale"
	Tooltip: "[c/E2735C:Weapon] Duststorm in a Bottle: 110 rogue damage, use time 28"
}

GearEntropysVigil: {
	Title: "Entropy's Vigil"
	Contents: "[c/E2735C:Weapon] Obtain Entropy's Vigil. 38 summon damage, use time 36, 10 mana. Summons a mini Calamitas Clone and her brothers to protect you. How to get it: Found in Treasure Bag (Calamitas Clone); Dropped by Calamitas Clone"
	Tooltip: "[c/E2735C:Weapon] Entropy's Vigil: 38 summon damage, use time 36, 10 mana"
}

GearEpidemicShredder: {
	Title: "Epidemic Shredder"
	Contents: "[c/E2735C:Weapon] Obtain Epidemic Shredder. 80 rogue damage, use time 16. Throws an infected boomerang that releases Plague seekers when it hits tiles or enemies. Stealth strikes cause the boomerang to release Plague seekers constantly as it travels. Contrary to its name, it will probably cause an epidemic if used incorrectly. How to get it: Craft at Mythril/Orichalcum Anvil from 20 Chlorophyte Bar, 150 Nanites, 15 Plague Cell Canister"
	Tooltip: "[c/E2735C:Weapon] Epidemic Shredder: 80 rogue damage, use time 16"
}

GearEternalBlizzard: {
	Title: "Eternal Blizzard"
	Contents: "[c/E2735C:Weapon] Obtain Eternal Blizzard. 67 ranged damage, use time 18. Fires an additional icicle arrow that freezes into a falling icicle. How to get it: Sold by Archmage"
	Tooltip: "[c/E2735C:Weapon] Eternal Blizzard: 67 ranged damage, use time 18"
}

GearEvergladeSpray: {
	Title: "Everglade Spray"
	Contents: "[c/E2735C:Weapon] Obtain Everglade Spray. 65 magic damage, use time 6, 7 mana. Fires a stream of burning green ichor. How to get it: Craft at Bookcase from 1 Golden Shower, 10 Perennial Bar (+1 alternative recipe)"
	Tooltip: "[c/E2735C:Weapon] Everglade Spray: 65 magic damage, use time 6, 7 mana"
}

GearExaltedOathblade: {
	Title: "Exalted Oathblade"
	Contents: "[c/E2735C:Weapon] Obtain Exalted Oathblade. 90 melee damage, use time 45. Throw a twisted blade that impales, immolates, and slows enemies. Up to four blades can impale an enemy at a time, with further hits launching the previous impaled blades. Press Right Click to enter a stance where you can use Left Click to perform a devastating slash. While in the stance, you gai... How to get it: Craft at Mythril/Orichalcum Anvil from 1 Forbidden Oathblade, 1 Broken Hero Sword, 8 Scoria Bar"
	Tooltip: "[c/E2735C:Weapon] Exalted Oathblade: 90 melee damage, use time 45"
}

GearFallenPaladinsHammer: {
	Title: "Fallen Paladin's Hammer"
	Contents: "[c/E2735C:Weapon] Obtain Fallen Paladin's Hammer. 315 melee damage, use time 57. Throws a heavy, gravity-affected hammer that will explode and return to you after striking an enemy. After returning three times, a homing spectral hammer is summoned with devastating impact. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Paladins Hammer, 1 Pwnagehammer, 8 Scoria Bar, 8 Ashes of Calamity"
	Tooltip: "[c/E2735C:Weapon] Fallen Paladin's Hammer: 315 melee damage, use time 57"
}

GearFantasyTalisman: {
	Title: "Fantasy Talisman"
	Contents: "[c/E2735C:Weapon] Obtain Fantasy Talisman. 45 rogue damage, use time 25. Fires high velocity talismans that ignore gravity. Talismans attach to enemies, releasing vengeful souls that chase them down. Stealth strikes release more souls and erupt into lost souls on death. 'Good thing I didn't bet against you!'. How to get it: Craft at Mythril/Orichalcum Anvil from 10 Solar Veil, 10 Silk, 5 Ectoplasm"
	Tooltip: "[c/E2735C:Weapon] Fantasy Talisman: 45 rogue damage, use time 25"
}

GearFaultLine: {
	Title: "Fault Line"
	Contents: "[c/E2735C:Weapon] Obtain Fault Line. 75 melee damage, use time 22. Reach: X tiles. Speed: 40. Infinite throw duration. Explodes on enemy hits. How to get it: Craft at Mythril/Orichalcum Anvil from 10 Scoria Bar"
	Tooltip: "[c/E2735C:Weapon] Fault Line: 75 melee damage, use time 22"
}

GearFeralthornClaymore: {
	Title: "Feralthorn Claymore"
	Contents: "[c/E2735C:Weapon] Obtain Feralthorn Claymore. 109 melee damage, use time 13. Sprouts thorns from enemies on hit. How to get it: Craft at Mythril/Orichalcum Anvil from 10 Perennial Bar"
	Tooltip: "[c/E2735C:Weapon] Feralthorn Claymore: 109 melee damage, use time 13"
}

GearFlakKraken: {
	Title: "Flak Kraken"
	Contents: "[c/E2735C:Weapon] Obtain Flak Kraken. 78 ranged damage, use time 63. Fires pairs of abyssal flak shells that explode into wide cones of ink shrapnel. Abyssal flak shells burst when they reach the cursor's position. Direct hits with the flak shell will deal reduced shrapnel damage. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Flak Toxicannon, 20 Voidstone, 20 Depth Cells"
	Tooltip: "[c/E2735C:Weapon] Flak Kraken: 78 ranged damage, use time 63"
}

GearFloodtide: {
	Title: "Floodtide"
	Contents: "[c/E2735C:Weapon] Obtain Floodtide. 85 melee damage, use time 24. Launches sharks, because sharks are awesome! How to get it: Craft at Mythril/Orichalcum Anvil from 12 Sea Remains, 10 Depth Cells, 2 Shark Fin; Caught while fishing"
	Tooltip: "[c/E2735C:Weapon] Floodtide: 85 melee damage, use time 24"
}

GearForbiddenSun: {
	Title: "Forbidden Sun"
	Contents: "[c/E2735C:Weapon] Obtain Forbidden Sun. 80 magic damage, use time 30, 33 mana. Casts a fire orb that emits a gigantic explosion on hit. How to get it: Craft at Bookcase from 1 Spell Tome, 10 Scoria Bar"
	Tooltip: "[c/E2735C:Weapon] Forbidden Sun: 80 magic damage, use time 30, 33 mana"
}

GearFrostcrushValari: {
	Title: "Frostcrush Valari"
	Contents: "[c/E2735C:Weapon] Obtain Frostcrush Valari. 81 rogue damage, use time 19. Fires a long ranged frosty boomerang that chips off homing icicles on hit. Stealth strikes throw a boomerang which follows the cursor. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Kylie, 6 Cryonic Bar, 5 Ectoplasm"
	Tooltip: "[c/E2735C:Weapon] Frostcrush Valari: 81 rogue damage, use time 19"
}

GearFuelCellBundle: {
	Title: "Fuel Cell Bundle"
	Contents: "[c/E2735C:Weapon] Obtain Fuel Cell Bundle. 22 summon damage, use time 36, 10 mana. Releases a small, special variant of the plaguebringers. How to get it: Found in Treasure Bag (The Plaguebringer Goliath); Dropped by The Plaguebringer Goliath"
	Tooltip: "[c/E2735C:Weapon] Fuel Cell Bundle: 22 summon damage, use time 36, 10 mana"
}

GearGalvanizingGlaive: {
	Title: "Galvanizing Glaive"
	Contents: "[c/E2735C:Weapon] Obtain Galvanizing Glaive. 130 melee damage, use time 21. Swings a spear which envelops struck foes in an energy field. When finished, the spear discharges an extra pulse of energy. 'A tool which quickly and neatly cleaves one object into two. Its efficiency and reliability as a weapon is unmistakable.'. How to get it: Craft at Mythril/Orichalcum Anvil from 12 Mysterious Circuitry, 18 Dubious Plating, 5 Life Alloy, 10 Infected Armor Plating"
	Tooltip: "[c/E2735C:Weapon] Galvanizing Glaive: 130 melee damage, use time 21"
}

GearGastricBelcherStaff: {
	Title: "Gastric Belcher Staff"
	Contents: "[c/E2735C:Weapon] Obtain Gastric Belcher Staff. 50 summon damage, use time 36, 10 mana. Summons aquatic aberrations to protect you. Aberrations fire vomit at nearby enemies with every third attack firing bubbles. How to get it: Found in Treasure Bag (Leviathan and Anahita); Dropped by The Leviathan"
	Tooltip: "[c/E2735C:Weapon] Gastric Belcher Staff: 50 summon damage, use time 36, 10 mana"
}

GearGreentide: {
	Title: "Greentide"
	Contents: "[c/E2735C:Weapon] Obtain Greentide. 81 melee damage, use time 30. Launches a spread of four teeth with one stronger piercing tooth in the center. Hitting with the blade creates two jaws of teeth to chomp on the enemy closest to your cursor. How to get it: Found in Treasure Bag (Leviathan and Anahita); Dropped by The Leviathan"
	Tooltip: "[c/E2735C:Weapon] Greentide: 81 melee damage, use time 30"
}

GearHadalUrn: {
	Title: "Hadal Urn"
	Contents: "[c/E2735C:Weapon] Obtain Hadal Urn. 37 magic damage, use time 20, 10 mana. Fires a random assortment of ocean creatures. 'There's no telling how long it was down there... or what lurks inside'. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Black Anurian, 20 Voidstone, 15 Depth Cells, 10 Bone"
	Tooltip: "[c/E2735C:Weapon] Hadal Urn: 37 magic damage, use time 20, 10 mana"
}

GearHavocsBreath: {
	Title: "Havoc's Breath"
	Contents: "[c/E2735C:Weapon] Obtain Havoc's Breath. 62 ranged damage, use time 5. Projects cone-shaped blasts of scorching Brimstone Flames. Uses gel for ammo. How to get it: Dropped by Cataclysmic Construct"
	Tooltip: "[c/E2735C:Weapon] Havoc's Breath: 62 ranged damage, use time 5"
}

GearHeavenfallenStardisk: {
	Title: "Heavenfallen Stardisk"
	Contents: "[c/E2735C:Weapon] Obtain Heavenfallen Stardisk. 160 rogue damage, use time 40. Throws a stardisk upwards which then launches itself towards your mouse cursor. Explodes into a star of astral bolts which spread the Astral Infection. Stealth strikes rain astral energy bolts from the sky. How to get it: Found in Astral Chest chests"
	Tooltip: "[c/E2735C:Weapon] Heavenfallen Stardisk: 160 rogue damage, use time 40"
}

GearHellfireFlamberge: {
	Title: "Hellfire Flamberge"
	Contents: "[c/E2735C:Weapon] Obtain Hellfire Flamberge. 90 melee damage, use time 20. Fires a spread of volcanic fireballs. How to get it: Craft at Mythril/Orichalcum Anvil from 10 Scoria Bar"
	Tooltip: "[c/E2735C:Weapon] Hellfire Flamberge: 90 melee damage, use time 20"
}

GearHellionFlowerSpear: {
	Title: "Hellion Flower Spear"
	Contents: "[c/E2735C:Weapon] Obtain Hellion Flower Spear. 100 melee damage, use time 20. Shoots a flower spear tip. Summons petals from the sky on critical hits. How to get it: Craft at Mythril/Orichalcum Anvil from 10 Perennial Bar"
	Tooltip: "[c/E2735C:Weapon] Hellion Flower Spear: 100 melee damage, use time 20"
}

GearHellkite: {
	Title: "Hellkite"
	Contents: "[c/E2735C:Weapon] Obtain Hellkite. 570 melee damage, use time 71. How to get it: Dropped by Renegade Warlock"
	Tooltip: "[c/E2735C:Weapon] Hellkite: 570 melee damage, use time 71"
}

GearHelstorm: {
	Title: "Helstorm"
	Contents: "[c/E2735C:Weapon] Obtain Helstorm. 33 ranged damage, use time 9. Fires two bullets at once. The gun also deals damage to enemies that touch it. How to get it: Craft at Mythril/Orichalcum Anvil from 10 Scoria Bar"
	Tooltip: "[c/E2735C:Weapon] Helstorm: 33 ranged damage, use time 9"
}

GearHematemesis: {
	Title: "Hematemesis"
	Contents: "[c/E2735C:Weapon] Obtain Hematemesis. 75 magic damage, use time 22, 14 mana. Casts a barrage of blood geysers from below. How to get it: Found in Treasure Bag (Ravager); Dropped by Ravager"
	Tooltip: "[c/E2735C:Weapon] Hematemesis: 75 magic damage, use time 22, 14 mana"
}

GearHivePod: {
	Title: "Hive Pod"
	Contents: "[c/E2735C:Weapon] Obtain Hive Pod. 75 summon damage, use time 30, 10 mana. Summons a sentry. Summons an astraglomerate to spawn glomerings at your enemies. Glomerings spread the Astral Infection on impact. How to get it: Dropped by Astraglomerate"
	Tooltip: "[c/E2735C:Weapon] Hive Pod: 75 summon damage, use time 30, 10 mana"
}

GearHydra: {
	Title: "Hydra"
	Contents: "[c/E2735C:Weapon] Obtain Hydra. 44 ranged damage, use time 66. Fires a spread of 3 blood globs imbued with Venom. Grows a gun-head every 3 seconds, up to a maximum of 3 heads. Press Left Click to command any existing heads to fire. Press Right Click to launch the heads for powerful explosive damage. Fusion of heavy machinery and Lernaean blood. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Quad Barrel Shotgun, 25 Nanites, 25 Vial of Venom"
	Tooltip: "[c/E2735C:Weapon] Hydra: 44 ranged damage, use time 66"
}

GearInfectedRemote: {
	Title: "Infected Remote"
	Contents: "[c/E2735C:Weapon] Obtain Infected Remote. 50 summon damage, use time 36, 10 mana. Summons a humanoid-hybrid Plaguebringer, codenamed 'Virili', to aid you in battle. Virili can only be summoned once. Virili uses a variety of attacks which she cycles through on a timer. All attacks spread the Plague, as was her original design intention. 'There's a single label on the back: WARN... How to get it: Found in Treasure Bag (The Plaguebringer Goliath); Dropped by The Plaguebringer Goliath"
	Tooltip: "[c/E2735C:Weapon] Infected Remote: 50 summon damage, use time 36, 10 mana"
}

GearInfernalRift: {
	Title: "Infernal Rift"
	Contents: "[c/E2735C:Weapon] Obtain Infernal Rift. 50 magic damage, use time 2, 25 mana. Summons infernal blades that spawn additional blades on enemy hits. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Sky Fracture, 10 Scoria Bar"
	Tooltip: "[c/E2735C:Weapon] Infernal Rift: 50 magic damage, use time 2, 25 mana"
}

GearKeelhaul: {
	Title: "Keelhaul"
	Contents: "[c/E2735C:Weapon] Obtain Keelhaul. 55 magic damage, use time 30, 40 mana. Summons a lingering geyser upon hitting an enemy. Only one geyser can exist at a time. 'Crumple 'em like paper'. How to get it: Dropped by Giant Cursed Skull"
	Tooltip: "[c/E2735C:Weapon] Keelhaul: 55 magic damage, use time 30, 40 mana"
}

GearLashesofChaos: {
	Title: "Lashes of Chaos"
	Contents: "[c/E2735C:Weapon] Obtain Lashes of Chaos. 130 magic damage, use time 46, 28 mana. Alternates between exploding hellfire bursts and piercing brimstone darts. 'Watch the world burn...'. How to get it: Found in Treasure Bag (Calamitas Clone); Dropped by Calamitas Clone"
	Tooltip: "[c/E2735C:Weapon] Lashes of Chaos: 130 magic damage, use time 46, 28 mana"
}

GearLeonidProgenitor: {
	Title: "Leonid Progenitor"
	Contents: "[c/E2735C:Weapon] Obtain Leonid Progenitor. 57 rogue damage, use time 15. Throws a bombshell that explodes, summoning a meteor to impact the site and spread the Astral Infection. Press Right Click to throw a spread of gravity affected comets that explode, leaving behind a star. Stealth strikes lob a bombshell that additionally splits into comets on hit. How to get it: Found in Treasure Bag (Astrum Aureus); Dropped by Astrum Aureus"
	Tooltip: "[c/E2735C:Weapon] Leonid Progenitor: 57 rogue damage, use time 15"
}

GearLeviathanTeeth: {
	Title: "Leviathan Teeth"
	Contents: "[c/E2735C:Weapon] Obtain Leviathan Teeth. 43 rogue damage, use time 9. Rapidly throws a spread of teeth that stick into enemies. After sticking to an enemy, the teeth will gouge through them and shoot out the other side. Stealth strikes create a clamping jaw of teeth to maul your foes. How to get it: Found in Treasure Bag (Leviathan and Anahita); Dropped by The Leviathan"
	Tooltip: "[c/E2735C:Weapon] Leviathan Teeth: 43 rogue damage, use time 9"
}

GearLeviatitan: {
	Title: "Leviatitan"
	Contents: "[c/E2735C:Weapon] Obtain Leviatitan. 89 ranged damage, use time 18. Fires high velocity aqua blasts. Releases homing aberrations that shred enemy defense every six shots. Right Click to vomit a meteor that explodes on hit. 'The L in LMG stands for Leviathan'. How to get it: Found in Treasure Bag (Leviathan and Anahita); Dropped by The Leviathan"
	Tooltip: "[c/E2735C:Weapon] Leviatitan: 89 ranged damage, use time 18"
}

GearLucrecia: {
	Title: "Lucrecia"
	Contents: "[c/E2735C:Weapon] Obtain Lucrecia. 124 melee damage, use time 34. Fires a spiraling darklight shard when swung. Hits with the blade itself build Darklight Energy. Darklight Energy is lost over time if it has not been gained for a few seconds. Press Right Click with maximum energy to fire a double helix comet. How to get it: Craft at Mythril/Orichalcum Anvil from 5 Life Alloy, 10 Fallen Star, 5 Soul of Light, 5 Soul of Night"
	Tooltip: "[c/E2735C:Weapon] Lucrecia: 124 melee damage, use time 34"
}

GearMalachite: {
	Title: "Malachite"
	Contents: "[c/E2735C:Weapon] Obtain Malachite. 52 rogue damage, use time 14. Throws a stream of kunai that stick to enemies and explode. Press Right Click to throw a single kunai that pierces, after piercing an enemy it emits a massive explosion on the next enemy hit. Stealth strikes fire three kunai that home in, stick to enemies, and explode. How to get it: Found in Treasure Bag (The Plaguebringer Goliath); Dropped by The Plaguebringer Goliath"
	Tooltip: "[c/E2735C:Weapon] Malachite: 52 rogue damage, use time 14"
}

GearMalevolence: {
	Title: "Malevolence"
	Contents: "[c/E2735C:Weapon] Obtain Malevolence. 56 ranged damage, use time 18. Fires two arrows at once. Converts wooden arrows into Plague arrows that explode into bees. How to get it: Found in Treasure Bag (The Plaguebringer Goliath); Dropped by The Plaguebringer Goliath"
	Tooltip: "[c/E2735C:Weapon] Malevolence: 56 ranged damage, use time 18"
}

GearMangroveChakram: {
	Title: "Mangrove Chakram"
	Contents: "[c/E2735C:Weapon] Obtain Mangrove Chakram. 84 rogue damage, use time 14. Stealth strikes leave a trail of lingering flowers. How to get it: Craft at Mythril/Orichalcum Anvil from 10 Perennial Bar"
	Tooltip: "[c/E2735C:Weapon] Mangrove Chakram: 84 rogue damage, use time 14"
}

GearMantisClaws: {
	Title: "Mantis Claws"
	Contents: "[c/E2735C:Weapon] Obtain Mantis Claws. 75 melee damage, use time 25. Rapidly swing a mantis claw which slashes foes in short range. Press Right Click to form a pressurized bubble in front of you. Once fully formed, the bubble is instantly snapped down on, blasting foes with a water jet. 'It's just that shrimple'. How to get it: Dropped by Mantis Shrimp"
	Tooltip: "[c/E2735C:Weapon] Mantis Claws: 75 melee damage, use time 25"
}

GearMarksmanBow: {
	Title: "Marksman Bow"
	Contents: "[c/E2735C:Weapon] Obtain Marksman Bow. 39 ranged damage, use time 5. Fires three arrows at once. Wooden arrows are converted into Jester's arrows. How to get it: Craft at Mythril/Orichalcum Anvil from 13 Ectoplasm"
	Tooltip: "[c/E2735C:Weapon] Marksman Bow: 39 ranged damage, use time 5"
}

GearMegalodon: {
	Title: "Megalodon"
	Contents: "[c/E2735C:Weapon] Obtain Megalodon. 58 ranged damage, use time 4. Loads a 30 round magazine of bullets and pressurized water jets that are rapidly unleashed. After firing, the gun unleashes a powerful homing rocket before reloading. Rocket damage is based on how many shots hit. 50% chance to not consume ammo. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Megashark, 1 Archerfish, 15 Depth Cells, 10 Planty Mush"
	Tooltip: "[c/E2735C:Weapon] Megalodon: 58 ranged damage, use time 4"
}

GearNebulash: {
	Title: "Nebulash"
	Contents: "[c/E2735C:Weapon] Obtain Nebulash. 85 melee damage, use time 18. Fires a whip sword that emits particle explosions on hit and spreads the Astral Infection. How to get it: Found in Treasure Bag (Astrum Aureus); Dropped by Astrum Aureus"
	Tooltip: "[c/E2735C:Weapon] Nebulash: 85 melee damage, use time 18"
}

GearNullificationPistol: {
	Title: "Nullification Pistol"
	Contents: "[c/E2735C:Weapon] Obtain Nullification Pistol. 190 ranged damage, use time 18. Fires discrete bolts of polarized energy. Right Click to swap modes. Positive energy splits into three piercing beams. Negative energy shoots rapidly and homes in on enemies. All shots blow away enemies at close range. Each mode weakens with continuous use and resets to full power when swapped. '... How to get it: Dropped by Scutlix Rider; Dropped by Martian Walker"
	Tooltip: "[c/E2735C:Weapon] Nullification Pistol: 190 ranged damage, use time 18"
}

GearOblivion: {
	Title: "Oblivion"
	Contents: "[c/E2735C:Weapon] Obtain Oblivion. 35 melee damage, use time 22. Reach: X tiles. Speed: 36. Duration: X seconds. A hightly unstable yoyo that slowly releases homing brimstone hellblasts. Enemy hits with the yoyo charge its power, greatly increasing the fire rate of the hellblasts. At maximum charge, the yoyo bursts into brimstone darts and resets its flight du... How to get it: Found in Treasure Bag (Calamitas Clone); Dropped by Calamitas Clone"
	Tooltip: "[c/E2735C:Weapon] Oblivion: 35 melee damage, use time 22"
}

GearOmniblade: {
	Title: "Omniblade"
	Contents: "[c/E2735C:Weapon] Obtain Omniblade. 100 melee damage, use time 12. An ancient blade forged by the legendary Omnir. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Katana, 5 Life Alloy, 2 Core of Calamity"
	Tooltip: "[c/E2735C:Weapon] Omniblade: 100 melee damage, use time 12"
}

GearPandemic: {
	Title: "Pandemic"
	Contents: "[c/E2735C:Weapon] Obtain Pandemic. 125 melee damage, use time 22. Reach: X tiles. Speed: X. Duration: X seconds. Each unique enemy struck that is infected with Plague increases the yoyo's size, power, and airtime. Refreshes Plague duration if a target is already infected. Counterweights inflict Plague and move twice as fast. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Hive Five, 6 Infected Armor Plating, 10 Plague Cell Canister"
	Tooltip: "[c/E2735C:Weapon] Pandemic: 125 melee damage, use time 22"
}

GearPestilentDefiler: {
	Title: "Pestilent Defiler"
	Contents: "[c/E2735C:Weapon] Obtain Pestilent Defiler. 105 ranged damage, use time 37. Converts musket balls into Plague rounds that explode and split apart on hit. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Slag Magnum, 7 Infected Armor Plating, 12 Plague Cell Canister"
	Tooltip: "[c/E2735C:Weapon] Pestilent Defiler: 105 ranged damage, use time 37"
}

GearPhantasmalRuin: {
	Title: "Phantasmal Ruin"
	Contents: "[c/E2735C:Weapon] Obtain Phantasmal Ruin. 140 rogue damage, use time 30. Fires a large ghost lance that explodes into spirits on enemy hits. Stealth strikes pierce twice and summon many spirits from the depths on the first hit. How to get it: Craft at Mythril/Orichalcum Anvil from 15 Spectre Bar, 35 Bone"
	Tooltip: "[c/E2735C:Weapon] Phantasmal Ruin: 140 rogue damage, use time 30"
}

GearPhotosynthesis: {
	Title: "Photosynthesis"
	Contents: "[c/E2735C:Weapon] Obtain Photosynthesis. 74 magic damage, use time 21, 10 mana. Casts a brilliant ray that dissolves into energy on enemy hits. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Night's Ray, 1 Valkyrie Ray, 12 Living Shard"
	Tooltip: "[c/E2735C:Weapon] Photosynthesis: 74 magic damage, use time 21, 10 mana"
}

GearPlagueStaff: {
	Title: "Plague Staff"
	Contents: "[c/E2735C:Weapon] Obtain Plague Staff. 70 magic damage, use time 21, 22 mana. Fires a tight spread of 4 Plague fangs. How to get it: Found in Treasure Bag (The Plaguebringer Goliath); Dropped by The Plaguebringer Goliath"
	Tooltip: "[c/E2735C:Weapon] Plague Staff: 70 magic damage, use time 21, 22 mana"
}

GearPlagueTaintedSMG: {
	Title: "Plague Tainted SMG"
	Contents: "[c/E2735C:Weapon] Obtain Plague Tainted SMG. 78 ranged damage, use time 12. Shoots Plague bullets that spawn drones on critical hits. Bullets deal more damage and knockback the closer the enemy is. Drones have a much higher crit chance upon hitting an enemy inflicted with Plague. Press Right Click to fire a drone swarm. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Black Hawk Remote, 1 Uzi, 1 Helstorm, 5 Infected Armor Plating"
	Tooltip: "[c/E2735C:Weapon] Plague Tainted SMG: 78 ranged damage, use time 12"
}

GearPlaguenade: {
	Title: "Plaguenade"
	Contents: "[c/E2735C:Weapon] Obtain Plaguenade. 63 rogue damage, use time 15. Releases a swarm of angry Plague bees. Stealth strikes spawn more bees and generate a larger explosion. How to get it: Craft at Mythril/Orichalcum Anvil from 100 Beenade, 15 Plague Cell Canister"
	Tooltip: "[c/E2735C:Weapon] Plaguenade: 63 rogue damage, use time 15"
}

GearPlantationStaff: {
	Title: "Plantation Staff"
	Contents: "[c/E2735C:Weapon] Obtain Plantation Staff. 58 summon damage, use time 36, 10 mana. Summons a miniature Plantera to devastate enemies with floral fury. There can only be one Mini Plantera at a time. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Eye of Night, 12 Living Shard"
	Tooltip: "[c/E2735C:Weapon] Plantation Staff: 58 summon damage, use time 36, 10 mana"
}

GearPrimordialEarth: {
	Title: "Primordial Earth"
	Contents: "[c/E2735C:Weapon] Obtain Primordial Earth. 205 magic damage, use time 68, 48 mana. Casts two enchanted blasts of sand that converge with each other and explode. Casting this spell at max mana while without mana sickness will cause it to give you and any player it hits the Sand's Wind buff. How to get it: Craft at Bookcase from 1 Death Valley Duster, 5 Amber, 5 Ectoplasm"
	Tooltip: "[c/E2735C:Weapon] Primordial Earth: 205 magic damage, use time 68, 48 mana"
}

GearPulseTurretRemote: {
	Title: "Pulse Turret Remote"
	Contents: "[c/E2735C:Weapon] Obtain Pulse Turret Remote. 150 summon damage, use time 30, 10 mana. Summons a sentry. Summons a turret to fire explosive pulse blasts at your enemies. Only one pulse turret may exist at a time. How to get it: Craft at Mythril/Orichalcum Anvil from 12 Mysterious Circuitry, 18 Dubious Plating, 5 Life Alloy, 10 Infected Armor Plating"
	Tooltip: "[c/E2735C:Weapon] Pulse Turret Remote: 150 summon damage, use time 30, 10 mana"
}

GearQuagmire: {
	Title: "Quagmire"
	Contents: "[c/E2735C:Weapon] Obtain Quagmire. 54 melee damage, use time 22. Reach: X tiles. Speed: 36. Infinite throw duration. Fires spore clouds. How to get it: Craft at Mythril/Orichalcum Anvil from 10 Perennial Bar"
	Tooltip: "[c/E2735C:Weapon] Quagmire: 54 melee damage, use time 22"
}

GearRadiantStar: {
	Title: "Radiant Star"
	Contents: "[c/E2735C:Weapon] Obtain Radiant Star. 55 rogue damage, use time 12. Throws daggers that explode and split after a while and spread the Astral Infection. Stealth strikes split more with a devastating explosion that sucks enemies in. How to get it: Craft at Ancient Manipulator from 1 Prismalline, 12 Astral Bar, 10 Fallen Star, 15 Starblight Soot"
	Tooltip: "[c/E2735C:Weapon] Radiant Star: 55 rogue damage, use time 12"
}

GearRealmRavager: {
	Title: "Realm Ravager"
	Contents: "[c/E2735C:Weapon] Obtain Realm Ravager. 54 ranged damage, use time 22. Shoots a burst of 4 bullets. Converts musket balls into explosive bullets. How to get it: Found in Treasure Bag (Ravager); Dropped by Ravager"
	Tooltip: "[c/E2735C:Weapon] Realm Ravager: 54 ranged damage, use time 22"
}

GearRegulusRiot: {
	Title: "Regulus Riot"
	Contents: "[c/E2735C:Weapon] Obtain Regulus Riot. 100 rogue damage, use time 24. Fires a swift homing disk that spreads the Astral Infection. Stealth strikes explode into energy stars. How to get it: Found in Treasure Bag (Astrum Deus); Dropped by Astrum Deus"
	Tooltip: "[c/E2735C:Weapon] Regulus Riot: 100 rogue damage, use time 24"
}

GearResurrectionButterfly: {
	Title: "Resurrection Butterfly"
	Contents: "[c/E2735C:Weapon] Obtain Resurrection Butterfly. 66 summon damage, use time 36, 10 mana. Summons a pair of butterflies to fight for you. 'Remembering the melancholy of human existence. Even ghosts stray from the path of righteousness'. How to get it: Craft at Loom from 5 Life Alloy, 2 Butterfly Dust, 40 Silk, 5 Ectoplasm"
	Tooltip: "[c/E2735C:Weapon] Resurrection Butterfly: 66 summon damage, use time 36, 10 mana"
}

GearRubicoPrime: {
	Title: "Rubico Prime"
	Contents: "[c/E2735C:Weapon] Obtain Rubico Prime. 450 ranged damage, use time 50. A powerful sniper rifle that must reload after 5 shots. Fires impact rounds that deal increased critical damage. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Nitro Express Rifle, 1 Illegal Gun Parts, 8 Scoria Bar"
	Tooltip: "[c/E2735C:Weapon] Rubico Prime: 450 ranged damage, use time 50"
}

GearSamsaraSlicer: {
	Title: "Samsara Slicer"
	Contents: "[c/E2735C:Weapon] Obtain Samsara Slicer. 80 rogue damage, use time 30. Throws a disk that has a chance to generate several disks if enemies are near it. Stealth strikes shred enemies and are rapidly orbited by the smaller disks. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Equanimity, 1 Brimblade, 12 Living Shard"
	Tooltip: "[c/E2735C:Weapon] Samsara Slicer: 80 rogue damage, use time 30"
}

GearSandSharknadoStaff: {
	Title: "Sand Sharknado Staff"
	Contents: "[c/E2735C:Weapon] Obtain Sand Sharknado Staff. 60 summon damage, use time 36, 10 mana. Summons a sandnado to fight for you. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Forgotten Apex Wand, 2 Ancient Cloth, 1 Grand Scale"
	Tooltip: "[c/E2735C:Weapon] Sand Sharknado Staff: 60 summon damage, use time 36, 10 mana"
}

GearSandblaster: {
	Title: "Sandblaster"
	Contents: "[c/E2735C:Weapon] Obtain Sandblaster. 70 ranged damage, use time 18. Fires sand bullets that explode and slow enemies on hit. Uses sand as ammo. 50% chance to not consume ammo. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Sandgun, 2 Ancient Cloth, 1 Grand Scale"
	Tooltip: "[c/E2735C:Weapon] Sandblaster: 70 ranged damage, use time 18"
}

GearShiftingSands: {
	Title: "Shifting Sands"
	Contents: "[c/E2735C:Weapon] Obtain Shifting Sands. 81 magic damage, use time 30, 20 mana. Casts a sand shard that follows the mouse cursor. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Magic Missile, 2 Ancient Cloth, 1 Grand Scale"
	Tooltip: "[c/E2735C:Weapon] Shifting Sands: 81 magic damage, use time 30, 20 mana"
}

GearSoulHarvester: {
	Title: "Soul Harvester"
	Contents: "[c/E2735C:Weapon] Obtain Soul Harvester. 77 melee damage, use time 22. Shoots a soul scythe. Enemies explode when on low health, spreading the plague. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Death Sickle, 10 Plague Cell Canister, 20 Cursed Flame"
	Tooltip: "[c/E2735C:Weapon] Soul Harvester: 77 melee damage, use time 22"
}

GearSpikecragStaff: {
	Title: "Spikecrag Staff"
	Contents: "[c/E2735C:Weapon] Obtain Spikecrag Staff. 25 summon damage, use time 30, 10 mana. How to get it: Found in Treasure Bag (Ravager); Dropped by Ravager"
	Tooltip: "[c/E2735C:Weapon] Spikecrag Staff: 25 summon damage, use time 30, 10 mana"
}

GearStarShower: {
	Title: "Star Shower"
	Contents: "[c/E2735C:Weapon] Obtain Star Shower. 60 magic damage, use time 14, 15 mana. Casts a spread of astral stars from the sky that converge at the cursor and spread the Astral Infection. How to get it: Found in Treasure Bag (Astrum Deus); Dropped by Astrum Deus"
	Tooltip: "[c/E2735C:Weapon] Star Shower: 60 magic damage, use time 14, 15 mana"
}

GearStarSputter: {
	Title: "Star Sputter"
	Contents: "[c/E2735C:Weapon] Obtain Star Sputter. 138 ranged damage, use time 8. Fires a chain of comets that spread the Astral Infection. Fires a bigger, more powerful comet every four rounds. 'Look to the stars for a galaxy far, far away'. How to get it: Found in Treasure Bag (Astrum Deus); Dropped by Astrum Deus"
	Tooltip: "[c/E2735C:Weapon] Star Sputter: 138 ranged damage, use time 8"
}

GearStarspawnHelixStaff: {
	Title: "Starspawn Helix Staff"
	Contents: "[c/E2735C:Weapon] Obtain Starspawn Helix Staff. 103 summon damage, use time 36, 10 mana. Summons astral probes that spread the Astral Infection. How to get it: Found in Treasure Bag (Astrum Deus); Dropped by Astrum Deus"
	Tooltip: "[c/E2735C:Weapon] Starspawn Helix Staff: 103 summon damage, use time 36, 10 mana"
}

GearStellarCannon: {
	Title: "Stellar Cannon"
	Contents: "[c/E2735C:Weapon] Obtain Stellar Cannon. 180 ranged damage, use time 40. Launches an explosive astral crystal that spreads the Astral Infection. How to get it: Dropped by Nova"
	Tooltip: "[c/E2735C:Weapon] Stellar Cannon: 180 ranged damage, use time 40"
}

GearStellarKnife: {
	Title: "Stellar Knife"
	Contents: "[c/E2735C:Weapon] Obtain Stellar Knife. 69 rogue damage, use time 9. Throws knives that stop midair and then home into enemies, spreading the Astral Infection. Stealth strikes throw a volley of 10 knives in a spread. 'ZA WARUDO'. How to get it: Dropped by Aries"
	Tooltip: "[c/E2735C:Weapon] Stellar Knife: 69 rogue damage, use time 9"
}

GearStygianShield: {
	Title: "Stygian Shield"
	Contents: "[c/E2735C:Weapon] Obtain Stygian Shield. 180 melee damage, use time 40. Hold Left Click to charge an omni-directional dash which grants immunity to damage and can slam through enemies. Right Click to throw a buckler which bounces towards a nearby foe upon collision. Grants knockback immunity and 8 defense while held. However, dashes are disabled until you stop holdin... How to get it: Craft at Mythril/Orichalcum Anvil from 1 Ornate Shield, 6 Scoria Bar, 6 Hellstone Bar, 6 Living Shard"
	Tooltip: "[c/E2735C:Weapon] Stygian Shield: 180 melee damage, use time 40"
}

GearSubductionSlicer: {
	Title: "Subduction Slicer"
	Contents: "[c/E2735C:Weapon] Obtain Subduction Slicer. 95 rogue damage, use time 20. Throws a scythe that explodes on enemy hits. Stealth strikes also summon a pillar of fire on enemy hits. How to get it: Craft at Mythril/Orichalcum Anvil from 10 Scoria Bar"
	Tooltip: "[c/E2735C:Weapon] Subduction Slicer: 95 rogue damage, use time 20"
}

GearSystemBane: {
	Title: "System Bane"
	Contents: "[c/E2735C:Weapon] Obtain System Bane. 45 rogue damage, use time 15. Hurls an unstable device which sticks to the ground and shocks nearby enemies with lightning. Stealth strikes make the device emit a large, damaging electromagnetic field. How to get it: Craft at Mythril/Orichalcum Anvil from 20 Mysterious Circuitry, 10 Dubious Plating, 5 Life Alloy, 10 Infected Armor Plating"
	Tooltip: "[c/E2735C:Weapon] System Bane: 45 rogue damage, use time 15"
}

GearTearsofHeaven: {
	Title: "Tears of Heaven"
	Contents: "[c/E2735C:Weapon] Obtain Tears of Heaven. 43 magic damage, use time 20, 15 mana. Casts slow-moving homing balls of heavenly light. How to get it: Craft at Bookcase from 1 Frigidflash Bolt, 1 Water Bolt, 15 Sea Prism, 5 Ectoplasm"
	Tooltip: "[c/E2735C:Weapon] Tears of Heaven: 43 magic damage, use time 20, 15 mana"
}

GearTerrorTalons: {
	Title: "Terror Talons"
	Contents: "[c/E2735C:Weapon] Obtain Terror Talons. 47 rogue damage, use time 7. Fires small wavering claws. Stealth strikes launch a large, high speed claw which slashes multiple times. How to get it: Craft at Mythril/Orichalcum Anvil from 5 Chlorophyte Bar, 10 Leather"
	Tooltip: "[c/E2735C:Weapon] Terror Talons: 47 rogue damage, use time 7"
}

GearTheBallista: {
	Title: "The Ballista"
	Contents: "[c/E2735C:Weapon] Obtain The Ballista. 88 ranged damage, use time 28. Converts wooden arrows into greatarrows that cause Armor Crunch and break into shards. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Marrow, 1 Ancient Battle Armor Material, 5 Ectoplasm"
	Tooltip: "[c/E2735C:Weapon] The Ballista: 88 ranged damage, use time 28"
}

GearTheHive: {
	Title: "The Hive"
	Contents: "[c/E2735C:Weapon] Obtain The Hive. 92 ranged damage, use time 34. Launches a wide spread of 4 missiles that explode on contact with enemies and tiles. Charging the launcher decreases the spread and increases the velocity of the missile barrage. Fully charging the launcher will cause it to fire a Plague nuke to decimate a massive area on impact. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Mineral Mortar, 7 Infected Armor Plating, 12 Plague Cell Canister"
	Tooltip: "[c/E2735C:Weapon] The Hive: 92 ranged damage, use time 34"
}

GearTheMicrowave: {
	Title: "The Microwave"
	Contents: "[c/E2735C:Weapon] Obtain The Microwave. 111 melee damage, use time 22. Reach: X tiles. Speed: 54. Infinite throw duration. Fries nearby enemies with radiation and spreads the Astral Infection. 'Cooking, Astral Infection style'. How to get it: Found in Treasure Bag (Astrum Deus); Dropped by Astrum Deus"
	Tooltip: "[c/E2735C:Weapon] The Microwave: 111 melee damage, use time 22"
}

GearOmniGun: {
	Title: "The Omnigun"
	Contents: "[c/E2735C:Weapon] Obtain The Omnigun. 57 ranged damage, use time 6. A multipurpose weapon with several modes which are used in sequence. The first shot is a sniper round which gains damage over time and always critically strikes. The second shot is a burst of 10 standard bullets. The third shot is a devastating point blank spread. The fourth shot is a dangerous b... How to get it: Sold by Shady Salesman"
	Tooltip: "[c/E2735C:Weapon] The Omnigun: 57 ranged damage, use time 6"
}

GearTheSyringe: {
	Title: "The Syringe"
	Contents: "[c/E2735C:Weapon] Obtain The Syringe. 60 rogue damage, use time 15. Throws a high velocity syringe that increases damage as it travels. Shatters into glass and cinders on impact. Stealth strikes also shatter into Plague bees. 'I'm pretty sure this isn't healthy'. How to get it: Found in Treasure Bag (The Plaguebringer Goliath); Dropped by The Plaguebringer Goliath"
	Tooltip: "[c/E2735C:Weapon] The Syringe: 60 rogue damage, use time 15"
}

GearTitanArm: {
	Title: "Titan Arm"
	Contents: "[c/E2735C:Weapon] Obtain Titan Arm. 200 melee damage, use time 20. Sends enemies straight to the stars at the speed of light. Slap Hand but better. How to get it: Dropped by Atlas"
	Tooltip: "[c/E2735C:Weapon] Titan Arm: 200 melee damage, use time 20"
}

GearTotalityBreakers: {
	Title: "Totality Breakers"
	Contents: "[c/E2735C:Weapon] Obtain Totality Breakers. 64 rogue damage, use time 28. Explodes into highly flammable black tar. Black tar makes enemies Oiled and sets them alight. Stealth strikes leak black tar as they fly. 'I need a bigger breaker'. How to get it: Craft at Mythril/Orichalcum Anvil from 50 Molotov Cocktail, 10 Solar Veil"
	Tooltip: "[c/E2735C:Weapon] Totality Breakers: 64 rogue damage, use time 28"
}

GearOmegaBiomeBlade: {
	Title: "True Biome Blade"
	Contents: "[c/E2735C:Weapon] Obtain True Biome Blade. 150 melee damage, use time 18. Holding down Right Click for 2 seconds attunes the weapon to the powers of the surrounding biome. Pressing Right Click for a shorter period of time switches your active and passive attunements around. Active Attunement : [ATT1]. Passive Attunement : [ATT2]. How to get it: Craft at Ancient Manipulator from 1 Biome Blade, 18 Astral Bar, 6 Life Alloy, 3 Core of Calamity"
	Tooltip: "[c/E2735C:Weapon] True Biome Blade: 150 melee damage, use time 18"
}

GearTumbleweed: {
	Title: "Tumbleweed"
	Contents: "[c/E2735C:Weapon] Obtain Tumbleweed. 78 melee damage, use time 20. Throws a tumbleweed flail. Spinning tumbleweeds brew a localized dust storm. Launched tumbleweeds detach from their chain upon striking an enemy and roll forwards. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Sunfury, 2 Ancient Cloth, 1 Grand Scale"
	Tooltip: "[c/E2735C:Weapon] Tumbleweed: 78 melee damage, use time 20"
}

GearTyphonsGreed: {
	Title: "Typhon's Greed"
	Contents: "[c/E2735C:Weapon] Obtain Typhon's Greed. 60 melee damage, use time 30. Summons water spirits while in use. These water spirits will home in on enemies after traveling towards the player. How to get it: Craft at Mythril/Orichalcum Anvil from 30 Voidstone, 30 Depth Cells"
	Tooltip: "[c/E2735C:Weapon] Typhon's Greed: 60 melee damage, use time 30"
}

GearUltimusCleaver: {
	Title: "Ultimus Cleaver"
	Contents: "[c/E2735C:Weapon] Obtain Ultimus Cleaver. 130 melee damage, use time 20. Launches damaging homing sparks and explodes on enemy hits. How to get it: Found in Treasure Bag (Ravager); Dropped by Ravager"
	Tooltip: "[c/E2735C:Weapon] Ultimus Cleaver: 130 melee damage, use time 20"
}

GearUndinesRetribution: {
	Title: "Undine's Retribution"
	Contents: "[c/E2735C:Weapon] Obtain Undine's Retribution. 44 magic damage, use time 18, 15 mana. Casts a swarm of homing spears. How to get it: Craft at Mythril/Orichalcum Anvil from 30 Voidstone, 30 Depth Cells"
	Tooltip: "[c/E2735C:Weapon] Undine's Retribution: 44 magic damage, use time 18, 15 mana"
}

GearVernalBolter: {
	Title: "Vernal Bolter"
	Contents: "[c/E2735C:Weapon] Obtain Vernal Bolter. 35 ranged damage, use time 20. Fires a tight column of three arrows. Converts wooden arrows into sliding energy bolts. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Lunarian Bow, 1 Hallowed Repeater, 12 Living Shard"
	Tooltip: "[c/E2735C:Weapon] Vernal Bolter: 35 ranged damage, use time 20"
}

GearVesuvius: {
	Title: "Vesuvius"
	Contents: "[c/E2735C:Weapon] Obtain Vesuvius. 55 magic damage, use time 15, 8 mana. Calls down a swarm of molten asteroids. Press Right Click to fire a spread of molten asteroids from the staff. How to get it: Found in Treasure Bag (Ravager); Dropped by Ravager"
	Tooltip: "[c/E2735C:Weapon] Vesuvius: 55 magic damage, use time 15, 8 mana"
}

GearViralSprout: {
	Title: "Viral Sprout"
	Contents: "[c/E2735C:Weapon] Obtain Viral Sprout. 24 summon damage, use time 36, 10 mana. Summons a sage spirit to fight for you. Inflicts Sage Poison, a debuff that becomes stronger the more spirits you own. How to get it: Craft at Mythril/Orichalcum Anvil from 10 Perennial Bar"
	Tooltip: "[c/E2735C:Weapon] Viral Sprout: 24 summon damage, use time 36, 10 mana"
}

GearVirulence: {
	Title: "Virulence"
	Contents: "[c/E2735C:Weapon] Obtain Virulence. 100 melee damage, use time 15. Fires a Plague cloud. How to get it: Found in Treasure Bag (The Plaguebringer Goliath); Dropped by The Plaguebringer Goliath"
	Tooltip: "[c/E2735C:Weapon] Virulence: 100 melee damage, use time 15"
}

GearVulcaniteLance: {
	Title: "Vulcanite Lance"
	Contents: "[c/E2735C:Weapon] Obtain Vulcanite Lance. 90 melee damage, use time 22. Explodes on enemy hits and summons homing flares on critical hits. How to get it: Craft at Mythril/Orichalcum Anvil from 10 Scoria Bar"
	Tooltip: "[c/E2735C:Weapon] Vulcanite Lance: 90 melee damage, use time 22"
}

GearWhitewater: {
	Title: "Whitewater"
	Contents: "[c/E2735C:Weapon] Obtain Whitewater. 80 rogue damage, use time 34. Throws a flask of magic white water at the cursor that glows after a short while. Flasks that hit enemies while glowing release four water spears that converge back on the flask's position. If the flask hits an enemy or gets too far, it will return to the owner. Stealth strikes create six water s... How to get it: Found in Treasure Bag (Leviathan and Anahita); Dropped by The Leviathan"
	Tooltip: "[c/E2735C:Weapon] Whitewater: 80 rogue damage, use time 34"
}

GearWildfireBloom: {
	Title: "Wildfire Bloom"
	Contents: "[c/E2735C:Weapon] Obtain Wildfire Bloom. 62 ranged damage, use time 8. Charges up to emit a stream of energized flames and pairs of homing wildfire flares. Uses gel for ammo. 50% chance to not consume ammo. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Flamethrower, 1 Meowthrower, 12 Living Shard"
	Tooltip: "[c/E2735C:Weapon] Wildfire Bloom: 62 ranged damage, use time 8"
}

GearWingman: {
	Title: "Wingman"
	Contents: "[c/E2735C:Weapon] Obtain Wingman. 82 magic damage, use time 15, 8 mana. Spawns two Wingmen which orbit you and fire lasers at your cursor. Press Right Click while firing to order the Wingmen to launch grenades. Grenades have a cooldown which is shortened if the Wingmen are fully revved up. How to get it: Dropped by Scutlix Rider; Dropped by Martian Engineer"
	Tooltip: "[c/E2735C:Weapon] Wingman: 82 magic damage, use time 15, 8 mana"
}

GearWintersFury: {
	Title: "Winter's Fury"
	Contents: "[c/E2735C:Weapon] Obtain Winter's Fury. 65 magic damage, use time 12, 7 mana. Fires a stream of ice orbs and a barrage of ice shards towards the cursor. 'The pages are freezing to the touch'. How to get it: Sold by Archmage"
	Tooltip: "[c/E2735C:Weapon] Winter's Fury: 65 magic damage, use time 12, 7 mana"
}

GearWitherBlossomsStaff: {
	Title: "Wither Blossoms Staff"
	Contents: "[c/E2735C:Weapon] Obtain Wither Blossoms Staff. 50 summon damage, use time 36, 10 mana. Summons four decaying Plague flowers over your head. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Tundra Flame Blossoms Staff, 15 Plague Cell Canister"
	Tooltip: "[c/E2735C:Weapon] Wither Blossoms Staff: 50 summon damage, use time 36, 10 mana"
}

GearAethersWhisper: {
	Title: "Aether's Whisper"
	Contents: "[c/E2735C:Weapon] Obtain Aether's Whisper. 600 magic damage, use time 24, 30 mana. Fires void beams that gain damage as they travel and split on tile hits. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Plasma Rod, 3 Twisting Nether"
	Tooltip: "[c/E2735C:Weapon] Aether's Whisper: 600 magic damage, use time 24, 30 mana"
}

GearAlphaDraconis: {
	Title: "Alpha Draconis"
	Contents: "[c/E2735C:Weapon] Obtain Alpha Draconis. 150 magic damage, use time 12, 16 mana. Calls down a meteor shower towards the cursor. Successful hits sometimes create Starbursts that can be picked up. Right Click with enough Starbursts to summon Draco to protect you. Draco burns Starbursts over time, and can be disspelled with Right Click. Draco inflicts Voidfrost. 'An imitation of... How to get it: Craft at Mythril/Orichalcum Anvil from 1 Wyvern's Call, 8 Lumenyl, 4 Ruinous Soul, 20 Exodium Cluster"
	Tooltip: "[c/E2735C:Weapon] Alpha Draconis: 150 magic damage, use time 12, 16 mana"
}

GearAngelicShotgun: {
	Title: "Angelic Shotgun"
	Contents: "[c/E2735C:Weapon] Obtain Angelic Shotgun. 92 ranged damage, use time 26. Each shot casts a radiant beam of Holy Flames from the sky. Musket balls convert into hallow-point rounds which also empower the beam. 'Fighting 'til the war's won'. How to get it: Craft at Mythril/Orichalcum Anvil from 75 Sunplate Block, 15 Divine Geode, 7 Essence of Sunlight"
	Tooltip: "[c/E2735C:Weapon] Angelic Shotgun: 92 ranged damage, use time 26"
}

GearApathanull: {
	Title: "Apathanull"
	Contents: "[c/E2735C:Weapon] Obtain Apathanull. 63 magic damage, use time 8, 26 mana. Casts a spread of dark cosmic tentacles to skewer your enemies. Tentacles will aim at your cursor and lash out three times before disappearing. How to get it: Craft at Bookcase from 1 Spell Tome, 18 Meld Blob"
	Tooltip: "[c/E2735C:Weapon] Apathanull: 63 magic damage, use time 8, 26 mana"
}

GearApoctosisArray: {
	Title: "Apoctosis Array"
	Contents: "[c/E2735C:Weapon] Obtain Apoctosis Array. 40 magic damage, use time 5, 14 mana. Rapidly fires an array of ion blasts with heavy armor penetration that accelerate and explode. Press Right Click to charge the blaster, restoring your mana until it reaches max. The more mana you restore, the stronger the arrow is when you release it. Charging for 90% of your max mana or more wil... How to get it: Craft at Ancient Manipulator from 1 Ion Blaster, 12 Solar Fragment"
	Tooltip: "[c/E2735C:Weapon] Apoctosis Array: 40 magic damage, use time 5, 14 mana"
}

GearArchAmaryllis: {
	Title: "Arch Amaryllis"
	Contents: "[c/E2735C:Weapon] Obtain Arch Amaryllis. 58 magic damage, use time 23, 23 mana. Casts a beaming flower that explodes into homing petals. How to get it: Craft at Ancient Manipulator from 1 Gleaming Magnolia, 12 Nebula Fragment"
	Tooltip: "[c/E2735C:Weapon] Arch Amaryllis: 58 magic damage, use time 23, 23 mana"
}

GearArkoftheElements: {
	Title: "Ark of the Elements"
	Contents: "[c/E2735C:Weapon] Obtain Ark of the Elements. 444 melee damage, use time 20. A heavenly pair of blades infused with the essence of Terraria, powerful enough to cut through the fabric of reality. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Ark of the Ancients, 5 Luminite Bar, 5 Life Alloy, 5 Solar Fragment"
	Tooltip: "[c/E2735C:Weapon] Ark of the Elements: 444 melee damage, use time 20"
}

GearArterialAssault: {
	Title: "Arterial Assault"
	Contents: "[c/E2735C:Weapon] Obtain Arterial Assault. 256 ranged damage, use time 6. Fires a group of 5 homing blood arrows. These blood arrows burst into blood orbs upon striking an enemy. Picking up these blood orbs reduces the duration of Potion Sickness. How to get it: Craft at Mythril/Orichalcum Anvil from 25 Bloodstone, 10 Blood Orb"
	Tooltip: "[c/E2735C:Weapon] Arterial Assault: 256 ranged damage, use time 6"
}

GearAstrealDefeat: {
	Title: "Astreal Defeat"
	Contents: "[c/E2735C:Weapon] Obtain Astreal Defeat. 160 ranged damage, use time 4. All arrows are converted to Astreal Arrows that emit flames as they travel. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Spirit Flame, 1 Shadow Flame Bow, 5 Luminite Bar, 5 Ashes of Calamity"
	Tooltip: "[c/E2735C:Weapon] Astreal Defeat: 160 ranged damage, use time 4"
}

GearAuguroftheVoid: {
	Title: "Augur of the Void"
	Contents: "[c/E2735C:Weapon] Obtain Augur of the Void. 131 magic damage, use time 2, 14 mana. Casts a burst of elemental tentacles to spear your enemies. How to get it: Craft at Bookcase from 1 Shadow Flame Hex Doll, 1 Eldritch Tome, 5 Luminite Bar, 5 Life Alloy, 5 Nebula Fragment"
	Tooltip: "[c/E2735C:Weapon] Augur of the Void: 131 magic damage, use time 2, 14 mana"
}

GearAuralis: {
	Title: "Auralis"
	Contents: "[c/E2735C:Weapon] Obtain Auralis. 695 ranged damage, use time 30. Fires a high speed glowing bullet that causes enemies to become Marked for Death. Press Right Click to zoom out. Standing still provides increasing damage bonuses up to 25%. Standing still for 5 or more seconds while using the scope ability will summon an aurora. The aurora reduces the damage of... How to get it: Craft at Mythril/Orichalcum Anvil from 1 Sniper Rifle, 10 Uelibloom Bar, 5 Aureus Cell, 50 Starblight Soot"
	Tooltip: "[c/E2735C:Weapon] Auralis: 695 ranged damage, use time 30"
}

GearBalefulHarvester: {
	Title: "Baleful Harvester"
	Contents: "[c/E2735C:Weapon] Obtain Baleful Harvester. 150 melee damage, use time 90. A flaming scythe which is rapidly swung around three times in succession. Enemy hits summon flaming skulls that split into homing fire orbs. How to get it: Craft at Ancient Manipulator from 1 The Horsemans Blade, 12 Stardust Fragment"
	Tooltip: "[c/E2735C:Weapon] Baleful Harvester: 150 melee damage, use time 90"
}

GearBansheeHook: {
	Title: "Banshee Hook"
	Contents: "[c/E2735C:Weapon] Obtain Banshee Hook. 250 melee damage, use time 21. Swings a banshee hook that fires blades and explodes on hit. How to get it: Found in Treasure Bag (Polterghast); Dropped by Polterghast"
	Tooltip: "[c/E2735C:Weapon] Banshee Hook: 250 melee damage, use time 21"
}

GearBarracudaGun: {
	Title: "Barracuda Gun"
	Contents: "[c/E2735C:Weapon] Obtain Barracuda Gun. 52 ranged damage, use time 20. Fires four barracudas that latch onto enemies and shred them. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Piranha Gun, 5 Luminite Bar, 2 Shark Fin"
	Tooltip: "[c/E2735C:Weapon] Barracuda Gun: 52 ranged damage, use time 20"
}

GearBiofusillade: {
	Title: "Biofusillade"
	Contents: "[c/E2735C:Weapon] Obtain Biofusillade. 118 magic damage, use time 3, 4 mana. Unleashes a concentrated beam of life energy. How to get it: Craft at Bookcase from 1 Spell Tome, 12 Uelibloom Bar"
	Tooltip: "[c/E2735C:Weapon] Biofusillade: 118 magic damage, use time 3, 4 mana"
}

GearBlissfulBombardier: {
	Title: "Blissful Bombardier"
	Contents: "[c/E2735C:Weapon] Obtain Blissful Bombardier. 550 ranged damage, use time 39. Launches a crystalline missile high into the sky, raining holy fire on the cursor. The missile relentlessly seeks out a target before bursting into a massive explosion. How to get it: Found in Treasure Bag (Providence, the Profaned Goddess); Dropped by Providence, the Profaned Goddess"
	Tooltip: "[c/E2735C:Weapon] Blissful Bombardier: 550 ranged damage, use time 39"
}

GearBloodBoiler: {
	Title: "Blood Boiler"
	Contents: "[c/E2735C:Weapon] Obtain Blood Boiler. 120 ranged damage, use time 5. Fires twin streams of bloodfire that returns to you. Returning bloodfire reduces Potion Sickness if it struck an enemy. Uses your health as ammo. 20% chance to save health. How to get it: Craft at Mythril/Orichalcum Anvil from 25 Bloodstone, 10 Blood Orb"
	Tooltip: "[c/E2735C:Weapon] Blood Boiler: 120 ranged damage, use time 5"
}

GearBloodsoakedCrasher: {
	Title: "Bloodsoaked Crasher"
	Contents: "[c/E2735C:Weapon] Obtain Bloodsoaked Crasher. 245 rogue damage, use time 24. Throws a bloody axe that is affected by gravity and can bounce twice. The axe speeds up over time, but will slow down upon hitting an enemy. Spews blood orbs upon enemy hits. Picking up these blood orbs reduces the duration of Potion Sickness. Stealth strikes spawn homing blood bolts on hit. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Crushsaw Crasher, 25 Bloodstone, 10 Blood Orb"
	Tooltip: "[c/E2735C:Weapon] Bloodsoaked Crasher: 245 rogue damage, use time 24"
}

GearBurningRevelation: {
	Title: "Burning Revelation"
	Contents: "[c/E2735C:Weapon] Obtain Burning Revelation. 300 melee damage, use time 20. Reach: X tiles. Speed: 54. Infinite throw duration. An ever burning yoyo that constantly charges power. Direct hits greatly increase the charge and release profaned energy that scales with charge level. At maximum charge, the yoyo unleashes a volley of homing stars that gain damage the farther th... How to get it: Found in Treasure Bag (Providence, the Profaned Goddess); Dropped by Providence, the Profaned Goddess"
	Tooltip: "[c/E2735C:Weapon] Burning Revelation: 300 melee damage, use time 20"
}

GearCadaverousCarrion: {
	Title: "Cadaverous Carrion"
	Contents: "[c/E2735C:Weapon] Obtain Cadaverous Carrion. 384 summon damage, use time 30, 10 mana. Summons a sentry. Summons a gross, shark-puking Old Duke head on the ground. How to get it: Found in Treasure Bag (The Old Duke); Dropped by The Old Duke"
	Tooltip: "[c/E2735C:Weapon] Cadaverous Carrion: 384 summon damage, use time 30, 10 mana"
}

GearCalamarisLament: {
	Title: "Calamari's Lament"
	Contents: "[c/E2735C:Weapon] Obtain Calamari's Lament. 120 summon damage, use time 24, 10 mana. How to get it: Dropped by Colossal Squid; Dropped by Moon Lord Core"
	Tooltip: "[c/E2735C:Weapon] Calamari's Lament: 120 summon damage, use time 24, 10 mana"
}

GearCelestialReaper: {
	Title: "Celestial Reaper"
	Contents: "[c/E2735C:Weapon] Obtain Celestial Reaper. 140 rogue damage, use time 31. Throws a fast homing scythe. The scythe will bounce after hitting an enemy up to six times. Stealth strikes create damaging afterimages. How to get it: Sold by Bandit"
	Tooltip: "[c/E2735C:Weapon] Celestial Reaper: 140 rogue damage, use time 31"
}

GearChromaticEruption: {
	Title: "Chromatic Eruption"
	Contents: "[c/E2735C:Weapon] Obtain Chromatic Eruption. 94 ranged damage, use time 6. Charges up to spew rainbow flames and pairs of homing chromatic flares. Uses gel for ammo. 50% chance to not consume ammo. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Wildfire Bloom, 5 Luminite Bar, 5 Life Alloy, 5 Vortex Fragment"
	Tooltip: "[c/E2735C:Weapon] Chromatic Eruption: 94 ranged damage, use time 6"
}

GearChronomancersScythe: {
	Title: "Chronomancer's Scythe"
	Contents: "[c/E2735C:Weapon] Obtain Chronomancer's Scythe. 159 magic damage, use time 5, 30 mana. Rapidly fires icicles that cause Time Distortion on enemies. Press Right Click to swing the scythe around you, creating a clock pattern of homing icicles. Direct hits with the scythe have a chance to spawn clocks. Collecting the clocks increases movement speed and acceleration by 5% for each cloc... How to get it: Craft at Mythril/Orichalcum Anvil from 1 Ice Sickle, 1 Fast Clock, 10 Luminite Bar, 6 Essence of Eleum"
	Tooltip: "[c/E2735C:Weapon] Chronomancer's Scythe: 159 magic damage, use time 5, 30 mana"
}

GearClaretCannon: {
	Title: "Claret Cannon"
	Contents: "[c/E2735C:Weapon] Obtain Claret Cannon. 500 damage, use time 10. Fires a hypercondensed claret round. The round explodes upon striking an enemy and releases blood orbs. The explosion shreds enemies, dramatically reducing their defense. Picking up the blood orbs will reduce Potion Sickness when possible. If you do not have Potion Sickness, your natural regenera... How to get it: Craft at Mythril/Orichalcum Anvil from 25 Bloodstone, 10 Blood Orb"
	Tooltip: "[c/E2735C:Weapon] Claret Cannon: 500 damage, use time 10"
}

GearClockworkBow: {
	Title: "Clockwork Bow"
	Contents: "[c/E2735C:Weapon] Obtain Clockwork Bow. 770 ranged damage, use time 30. Hold Left Click to load up to six precision bolts. The more precision bolts are loaded, the harder they hit. How to get it: Craft at Mythril/Orichalcum Anvil from 5 Luminite Bar, 50 Cog"
	Tooltip: "[c/E2735C:Weapon] Clockwork Bow: 770 ranged damage, use time 30"
}

GearConferenceCall: {
	Title: "Conference Call"
	Contents: "[c/E2735C:Weapon] Obtain Conference Call. 53 ranged damage, use time 42. Fires a tight spread of bullets that call more bullets from the sky. @everyone. How to get it: Craft at Ancient Manipulator from 1 Tactical Shotgun, 12 Vortex Fragment"
	Tooltip: "[c/E2735C:Weapon] Conference Call: 53 ranged damage, use time 42"
}

GearCorinthPrime: {
	Title: "Corinth Prime"
	Contents: "[c/E2735C:Weapon] Obtain Corinth Prime. 140 ranged damage, use time 30. Shoots a tight burst of 6 high velocity bullets. Press Right Click to fire a grenade. The grenade emits a massive explosion if it doesn't touch anything for 2 seconds. Otherwise, the grenade emits an extremely weak explosion. Converts musket balls into high velocity explosive bullets. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Realm Ravager, 1 Vortex Beater, 1 Illegal Gun Parts, 3 Armored Shell"
	Tooltip: "[c/E2735C:Weapon] Corinth Prime: 140 ranged damage, use time 30"
}

GearCosmicKunai: {
	Title: "Cosmic Kunai"
	Contents: "[c/E2735C:Weapon] Obtain Cosmic Kunai. 110 rogue damage, use time 3. Fires a rapid stream of short-range kunai. Stealth strikes make kunai pierce foes, travel farther, and spawn 9 homing scythes. How to get it: Found in Treasure Bag (Signus); Dropped by Signus"
	Tooltip: "[c/E2735C:Weapon] Cosmic Kunai: 110 rogue damage, use time 3"
}

GearCosmicRainbow: {
	Title: "Cosmic Rainbow"
	Contents: "[c/E2735C:Weapon] Obtain Cosmic Rainbow. 117 magic damage, use time 10, 10 mana. Launches a barrage of rainbows and homing sparkles. How to get it: Craft at Ancient Manipulator from 1 Rainbow Gun, 5 Luminite Bar, 10 Crystal Shard, 10 Soul of Light"
	Tooltip: "[c/E2735C:Weapon] Cosmic Rainbow: 117 magic damage, use time 10, 10 mana"
}

GearCosmilamp: {
	Title: "Cosmilamp"
	Contents: "[c/E2735C:Weapon] Obtain Cosmilamp. 95 summon damage, use time 24, 10 mana. Summons a cosmic lantern above your head to fight for you. How to get it: Found in Treasure Bag (Signus); Dropped by Signus"
	Tooltip: "[c/E2735C:Weapon] Cosmilamp: 95 summon damage, use time 24, 10 mana"
}

GearCrescentMoon: {
	Title: "Crescent Moon"
	Contents: "[c/E2735C:Weapon] Obtain Crescent Moon. 1000 melee damage, use time 18. Throws a lunar flail that releases homing moons at the apex of its path. Holding Left Click spins the flail around you, generating Starbursts. With 20 Starbursts, hold Left Click again after throwing the flail to cause it to explode. Instead of releasing moons, this explosion summons Scorpius to... How to get it: Craft at Mythril/Orichalcum Anvil from 1 Blue Moon, 8 Lumenyl, 4 Ruinous Soul, 20 Exodium Cluster"
	Tooltip: "[c/E2735C:Weapon] Crescent Moon: 1000 melee damage, use time 18"
}

GearDaemonsFlame: {
	Title: "Daemon's Flame"
	Contents: "[c/E2735C:Weapon] Obtain Daemon's Flame. 162 ranged damage, use time 12. Shoots daemon flame fireballs as well as 4 regular arrows. 66% chance to not consume ammo. How to get it: Found in Treasure Bag (Polterghast); Dropped by Polterghast"
	Tooltip: "[c/E2735C:Weapon] Daemon's Flame: 162 ranged damage, use time 12"
}

GearDarkSpark: {
	Title: "Dark Spark"
	Contents: "[c/E2735C:Weapon] Obtain Dark Spark. 60 magic damage, use time 10, 12 mana. 'And everything under the sun is in tune, But the sun is eclipsed by the moon.'. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Last Prism, 10 Dark Plasma, 20 Ruinous Soul, 30 Divine Geode"
	Tooltip: "[c/E2735C:Weapon] Dark Spark: 60 magic damage, use time 10, 12 mana"
}

GearDazzlingStabberStaff: {
	Title: "Dazzling Stabber Staff"
	Contents: "[c/E2735C:Weapon] Obtain Dazzling Stabber Staff. 69 summon damage, use time 24, 10 mana. Summons three holy daggers made of profaned materials to fight for you. Holy flame daggers gallantly turn all that oppose them to ashes. Crystalline daggers gracefully carve foes to ribbons. Profane daggers brutishtly splinter and reform eternally. 'Ever onward, towards Her future'. How to get it: Found in Treasure Bag (Providence, the Profaned Goddess); Dropped by Providence, the Profaned Goddess"
	Tooltip: "[c/E2735C:Weapon] Dazzling Stabber Staff: 69 summon damage, use time 24, 10 mana"
}

GearDeadSunsWind: {
	Title: "Dead Sun's Wind"
	Contents: "[c/E2735C:Weapon] Obtain Dead Sun's Wind. 115 ranged damage, use time 22. Fires a concentrated blast of superheated cosmic plasma that explodes and can ricochet off blocks. Shots aggressively home in on enemies after being ricocheted. Consecutive hits cause larger explosions. Uses gel for ammo. How to get it: Craft at Ancient Manipulator from 18 Meld Blob"
	Tooltip: "[c/E2735C:Weapon] Dead Sun's Wind: 115 ranged damage, use time 22"
}

GearDeathsAscension: {
	Title: "Death's Ascension"
	Contents: "[c/E2735C:Weapon] Obtain Death's Ascension. 500 melee damage, use time 24. Performs powerful soul-infused swings that creates a rift orbited by scythes on enemy hits. Press Right Click to launch a barrage of homing scythes. The rift will fire scythes along with you. 'It feels just right in your grip... But the hands that wield it are not yours'. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Death Sickle, 4 Ruinous Soul, 15 Soul of Night, 3 Twisting Nether"
	Tooltip: "[c/E2735C:Weapon] Death's Ascension: 500 melee damage, use time 24"
}

GearDeepSeaDumbbell: {
	Title: "Deep Sea Dumbbell"
	Contents: "[c/E2735C:Weapon] Obtain Deep Sea Dumbbell. 466 rogue damage, use time 25. Throws a dumbbell that bounces and flings weights with each bounce. Press Right Click to flex, increasing the damage of your next attack up to 5 times damage. Flexes can hit enemies directly. How to get it: Dropped by Reaper Shark"
	Tooltip: "[c/E2735C:Weapon] Deep Sea Dumbbell: 466 rogue damage, use time 25"
}

GearDefiledGreatsword: {
	Title: "Defiled Greatsword"
	Contents: "[c/E2735C:Weapon] Obtain Defiled Greatsword. 111 melee damage, use time 28. Fires blazing, hyper, and sunlight blades. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Blighted Cleaver, 10 Uelibloom Bar, 5 Core of Calamity"
	Tooltip: "[c/E2735C:Weapon] Defiled Greatsword: 111 melee damage, use time 28"
}

GearDevilsSunrise: {
	Title: "Devil's Sunrise"
	Contents: "[c/E2735C:Weapon] Obtain Devil's Sunrise. 420 melee damage, use time 5. Unleashes a devilish flurry of swipes. Hellish energy charges in the blades over time, which is accelerated by striking foes. Press Right Click while swinging the blades with full energy to throw the spinning blades to your cursor. The spinning blades lodge into and repeatedly slice the first foe... How to get it: Craft at Mythril/Orichalcum Anvil from 1 Terragrim, 50 Bloodstone, 10 Scorched Bone"
	Tooltip: "[c/E2735C:Weapon] Devil's Sunrise: 420 melee damage, use time 5"
}

GearDragonbloodDisgorger: {
	Title: "Dragonblood Disgorger"
	Contents: "[c/E2735C:Weapon] Obtain Dragonblood Disgorger. 222 summon damage, use time 24, 10 mana. Summons a skeletal dragon and her two children. Baby spits burst into blood orbs upon hitting an enemy. Picking up these blood orbs reduces the duration of Potion Sickness. There can only be one family at a time. How to get it: Craft at Mythril/Orichalcum Anvil from 25 Bloodstone, 10 Blood Orb"
	Tooltip: "[c/E2735C:Weapon] Dragonblood Disgorger: 222 summon damage, use time 24, 10 mana"
}

GearEffervescence: {
	Title: "Effervescence"
	Contents: "[c/E2735C:Weapon] Obtain Effervescence. 60 magic damage, use time 15, 20 mana. Shoots a massive spread of bubbles. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Bubble Gun, 5 Luminite Bar, 10 Shimmer Block"
	Tooltip: "[c/E2735C:Weapon] Effervescence: 60 magic damage, use time 15, 20 mana"
}

GearEidolicWail: {
	Title: "Eidolic Wail"
	Contents: "[c/E2735C:Weapon] Obtain Eidolic Wail. 943 magic damage, use time 10, 90 mana. Fires a string of bouncing sound waves that slow down on enemy hits. RIP headphone users. How to get it: Dropped by Eidolon Wyrm; Dropped by Primordial Wyrm"
	Tooltip: "[c/E2735C:Weapon] Eidolic Wail: 943 magic damage, use time 10, 90 mana"
}

GearEidolonStaff: {
	Title: "Eidolon Staff"
	Contents: "[c/E2735C:Weapon] Obtain Eidolon Staff. 180 magic damage, use time 18, 24 mana. Fires a spread of ancient light and a spinning ice cluster. How to get it: Dropped by Eidolon Wyrm"
	Tooltip: "[c/E2735C:Weapon] Eidolon Staff: 180 magic damage, use time 18, 24 mana"
}

GearEmpyreanKnives: {
	Title: "Empyrean Knives"
	Contents: "[c/E2735C:Weapon] Obtain Empyrean Knives. 110 melee damage, use time 15. Throws a flurry of homing knives that bounce off of tiles and heal the user. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Vampire Knives, 1 Monstrous Knives, 3 Twisting Nether"
	Tooltip: "[c/E2735C:Weapon] Empyrean Knives: 110 melee damage, use time 15"
}

GearEntropicClaymore: {
	Title: "Entropic Claymore"
	Contents: "[c/E2735C:Weapon] Obtain Entropic Claymore. 90 melee damage, use time 30. Fires a spread of living plasma that swims though the air. Plasma will track your cursor or enemies near it, prioritizing which is closest. The plasma pierces, but will stop tracking after hitting the first enemy. How to get it: Craft at Ancient Manipulator from 18 Meld Blob"
	Tooltip: "[c/E2735C:Weapon] Entropic Claymore: 90 melee damage, use time 30"
}

GearEtherealSubjugator: {
	Title: "Ethereal Subjugator"
	Contents: "[c/E2735C:Weapon] Obtain Ethereal Subjugator. 160 summon damage, use time 24, 10 mana. Summons a phantom to protect you. How to get it: Found in Treasure Bag (Polterghast); Dropped by Polterghast"
	Tooltip: "[c/E2735C:Weapon] Ethereal Subjugator: 160 summon damage, use time 24, 10 mana"
}

GearEventHorizon: {
	Title: "Event Horizon"
	Contents: "[c/E2735C:Weapon] Obtain Event Horizon. 138 magic damage, use time 45, 45 mana. Fires a ring of stars to home in on nearby enemies. Stars spawn black holes on enemy hits. 'Nothing, not even light, can return'. How to get it: Craft at Bookcase from 1 Star Shower, 1 Nuclear Fury, 1 Relic of Ruin, 3 Dark Plasma"
	Tooltip: "[c/E2735C:Weapon] Event Horizon: 138 magic damage, use time 45, 45 mana"
}

GearEyeofMagnus: {
	Title: "Eye of Magnus"
	Contents: "[c/E2735C:Weapon] Obtain Eye of Magnus. 60 damage, use time 22. Fires seeking cosmic masses that restore health and mana on hit. Explodes into a nebula cloud that causes enemies to become Marked for Death. This weapon scales with the average of all your damage stats. How to get it: Craft at Ancient Manipulator from 1 Lunic Eye, 12 Nebula Fragment; Dropped by Wall of Flesh"
	Tooltip: "[c/E2735C:Weapon] Eye of Magnus: 60 damage, use time 22"
}

GearFatesReveal: {
	Title: "Fate's Reveal"
	Contents: "[c/E2735C:Weapon] Obtain Fate's Reveal. 120 magic damage, use time 16, 20 mana. Spawns ghostly fireballs that follow the player. How to get it: Found in Treasure Bag (Polterghast); Dropped by Polterghast"
	Tooltip: "[c/E2735C:Weapon] Fate's Reveal: 120 magic damage, use time 16, 20 mana"
}

GearFetidEmesis: {
	Title: "Fetid Emesis"
	Contents: "[c/E2735C:Weapon] Obtain Fetid Emesis. 214 ranged damage, use time 6. Fires an accelerating stream of bullets until the barrel overheats. When the barrel overheats, a spread of fetid chunks is vomited out. After firing, the gun must cool back down before it can be used again. 66% chance to not consume ammo. How to get it: Found in Treasure Bag (The Old Duke); Dropped by The Old Duke"
	Tooltip: "[c/E2735C:Weapon] Fetid Emesis: 214 ranged damage, use time 6"
}

GearFlowersOfMortality: {
	Title: "Flowers of Mortality"
	Contents: "[c/E2735C:Weapon] Obtain Flowers of Mortality. 70 summon damage, use time 24, 10 mana. Summons five rainbow flowers over your head. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Wither Blossoms Staff, 5 Luminite Bar, 5 Life Alloy, 5 Stardust Fragment"
	Tooltip: "[c/E2735C:Weapon] Flowers of Mortality: 70 summon damage, use time 24, 10 mana"
}

GearFreedomStar: {
	Title: "Freedom Star"
	Contents: "[c/E2735C:Weapon] Obtain Freedom Star. 120 ranged damage, use time 10. Tap Left Click to fire energy orbs. Hold Left Click to charge and fire a beam that explodes on hit. How to get it: Craft at Mythril/Orichalcum Anvil from 12 Mysterious Circuitry, 18 Dubious Plating, 8 Uelibloom Bar, 4 Luminite Bar"
	Tooltip: "[c/E2735C:Weapon] Freedom Star: 120 ranged damage, use time 10"
}

GearGalactusBlade: {
	Title: "Galactus Blade"
	Contents: "[c/E2735C:Weapon] Obtain Galactus Blade. 185 melee damage, use time 27. Launches a barrage of comets from the sky. Forged with the fury of nuclear chaos. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Star Wrath, 5 Life Alloy, 10 Divine Geode"
	Tooltip: "[c/E2735C:Weapon] Galactus Blade: 185 melee damage, use time 27"
}

GearFourSeasonsGalaxia: {
	Title: "Galaxia"
	Contents: "[c/E2735C:Weapon] Obtain Galaxia. 250 melee damage, use time 18. Freed from earthly shackles and coursing with cosmic power. Has access to all of the attunements at all times. Press Right Click to cycle the sword's attunement depending on the cursor's position. Active Attunement :. How to get it: Craft at Mythril/Orichalcum Anvil from 1 True Biome Blade, 1 Armored Shell, 1 Twisting Nether, 1 Dark Plasma"
	Tooltip: "[c/E2735C:Weapon] Galaxia: 250 melee damage, use time 18"
}

GearGalileoGladius: {
	Title: "Galileo Gladius"
	Contents: "[c/E2735C:Weapon] Obtain Galileo Gladius. 600 melee damage, use time 8. Rapidly stabs in front of the player, generating Starbursts on hit. Right Click to throw the gladius on a constellation chain, impaling foes and inflicting Voidfrost. When the blade is impaled, use Left Click or Right Click to free it. Left Click pulls it free and deals high damage, consuming 10... How to get it: Craft at Mythril/Orichalcum Anvil from 1 Gladius, 8 Lumenyl, 4 Ruinous Soul, 20 Exodium Cluster"
	Tooltip: "[c/E2735C:Weapon] Galileo Gladius: 600 melee damage, use time 8"
}

GearGammaHeart: {
	Title: "Gamma Heart"
	Contents: "[c/E2735C:Weapon] Obtain Gamma Heart. 93 summon damage, use time 24, 10 mana. Summons radioactive heads that are bound by your body. How to get it: Dropped by Nuclear Terror"
	Tooltip: "[c/E2735C:Weapon] Gamma Heart: 93 summon damage, use time 24, 10 mana"
}

GearGenesis: {
	Title: "Genesis"
	Contents: "[c/E2735C:Weapon] Obtain Genesis. 65 magic damage, use time 5, 20 mana. Fire an array of lasers that decreases in spread for each shot. Every sixth shot fires a splitting Genesis Beam and resets the spread of the weapon. Hitting an enemy before the Genesis Beam splits deals increased damage. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Laser Rifle, 5 Luminite Bar, 5 Life Alloy"
	Tooltip: "[c/E2735C:Weapon] Genesis: 65 magic damage, use time 5, 20 mana"
}

GearGhastlyVisage: {
	Title: "Ghastly Visage"
	Contents: "[c/E2735C:Weapon] Obtain Ghastly Visage. 120 magic damage, use time 27, 36 mana. Fires homing ghast energy that explodes. How to get it: Found in Treasure Bag (Polterghast); Dropped by Polterghast"
	Tooltip: "[c/E2735C:Weapon] Ghastly Visage: 120 magic damage, use time 27, 36 mana"
}

GearGhoulishGouger: {
	Title: "Ghoulish Gouger"
	Contents: "[c/E2735C:Weapon] Obtain Ghoulish Gouger. 204 rogue damage, use time 5. Throws sets of four ghoulish scythes at ultra high velocity. Stealth strikes summon a flurry of tormented souls on hit. How to get it: Found in Treasure Bag (Polterghast); Dropped by Polterghast"
	Tooltip: "[c/E2735C:Weapon] Ghoulish Gouger: 204 rogue damage, use time 5"
}

GearGildedProboscis: {
	Title: "Gilded Proboscis"
	Contents: "[c/E2735C:Weapon] Obtain Gilded Proboscis. 2090 melee damage, use time 65. Steals life proportional to the damage dealt to foes. Left Click to charge up a precise thrust. The thrust begins weak, but becomes more powerful the longer it's held. Right Click to dash forward with a mighty upstrike. The distance you dash depends on if you are moving with or against the dash.... How to get it: Found in Treasure Bag (The Dragonfolly); Dropped by Dragonfolly"
	Tooltip: "[c/E2735C:Weapon] Gilded Proboscis: 2090 melee damage, use time 65"
}

GearGoldenEagle: {
	Title: "Golden Eagle"
	Contents: "[c/E2735C:Weapon] Obtain Golden Eagle. 88 ranged damage, use time 18. Fires 5 bullets at once. How to get it: Found in Treasure Bag (The Dragonfolly); Dropped by Dragonfolly"
	Tooltip: "[c/E2735C:Weapon] Golden Eagle: 88 ranged damage, use time 18"
}

GearGrandDad: {
	Title: "Grand Dad"
	Contents: "[c/E2735C:Weapon] Obtain Grand Dad. 5577 melee damage, use time 77. How to get it: Dropped by Eidolon Wyrm; Dropped by Primordial Wyrm"
	Tooltip: "[c/E2735C:Weapon] Grand Dad: 5577 melee damage, use time 77"
}

GearGrandGuardian: {
	Title: "Grand Guardian"
	Contents: "[c/E2735C:Weapon] Obtain Grand Guardian. 360 melee damage, use time 35. An ornate winged blade that easily cuts through enemies. Creates cosmic explosions and heals you slightly on hit. How to get it: Craft at Ancient Manipulator from 1 Majestic Guard, 12 Nebula Fragment"
	Tooltip: "[c/E2735C:Weapon] Grand Guardian: 360 melee damage, use time 35"
}

GearGreatswordofJudgement: {
	Title: "Greatsword of Judgement"
	Contents: "[c/E2735C:Weapon] Obtain Greatsword of Judgement. 225 melee damage, use time 20. Fires a piercing energy wave that releases homing stars as it flies. Hits with the blade summon two stronger stars from behind you. How to get it: Craft at Ancient Manipulator from 7 Luminite Bar, 10 Shimmer Block, 1 Core of Calamity"
	Tooltip: "[c/E2735C:Weapon] Greatsword of Judgement: 225 melee damage, use time 20"
}

GearGuidelightofOblivion: {
	Title: "Guidelight of Oblivion"
	Contents: "[c/E2735C:Weapon] Obtain Guidelight of Oblivion. 75 summon damage, use time 30, 10 mana. Summons a sentry. Summons a lantern that swarms your enemies with flames. 'Shadows dream of endless fire, flames devour and embers swoop'. How to get it: Dropped by Scryllar"
	Tooltip: "[c/E2735C:Weapon] Guidelight of Oblivion: 75 summon damage, use time 30, 10 mana"
}

GearHalleysInferno: {
	Title: "Halley's Inferno"
	Contents: "[c/E2735C:Weapon] Obtain Halley's Inferno. 444 ranged damage, use time 5. Fires a burst of intensely concentrated lunar fire jets. Right Click to rapid-fire Starbursts that inflict Voidfrost. Generates Starbursts when hitting enemies, depending on your accuracy. Press the bound key to toggle long-range scope mode. Uses gel for ammo. 'Halley arrived sooner than expected'. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Elf Melter, 8 Lumenyl, 4 Ruinous Soul, 20 Exodium Cluster"
	Tooltip: "[c/E2735C:Weapon] Halley's Inferno: 444 ranged damage, use time 5"
}

GearHandheldTank: {
	Title: "Handheld Tank"
	Contents: "[c/E2735C:Weapon] Obtain Handheld Tank. 740 ranged damage, use time 74. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Rocket Launcher, 50 Any Iron Bar, 5 Divine Geode"
	Tooltip: "[c/E2735C:Weapon] Handheld Tank: 740 ranged damage, use time 74"
}

GearHolyCollider: {
	Title: "Holy Collider"
	Contents: "[c/E2735C:Weapon] Obtain Holy Collider. 2200 melee damage, use time 45. Swings a holy greatsword that can be charged for higher damage. Charged swings create four lingering flares that float around the point of impact. Striking a flare with an uncharged strike will push it around and extend its lifetime. Charged swings can empower flares, turning them into massive fi... How to get it: Found in Treasure Bag (Providence, the Profaned Goddess); Dropped by Providence, the Profaned Goddess"
	Tooltip: "[c/E2735C:Weapon] Holy Collider: 2200 melee damage, use time 45"
}

GearInsidiousImpaler: {
	Title: "Insidious Impaler"
	Contents: "[c/E2735C:Weapon] Obtain Insidious Impaler. 250 melee damage, use time 13. Throws self-propelling radioactive harpoons which chase foes. Harpoons ricochet at close range for additional hits. How to get it: Found in Treasure Bag (The Old Duke); Dropped by The Old Duke"
	Tooltip: "[c/E2735C:Weapon] Insidious Impaler: 250 melee damage, use time 13"
}

GearJawsOfOblivion: {
	Title: "Jaws of Oblivion"
	Contents: "[c/E2735C:Weapon] Obtain Jaws of Oblivion. 159 rogue damage, use time 15. Throws a tight spread of six reaper teeth with Venom that stick in enemies. The Venom can stack when more teeth are stuck in an enemy. Stealth strikes cause the teeth to emit a crushing shockwave on impact. 'You're gonna need a bigger boat'. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Leviathan Teeth, 6 Reaper Tooth, 15 Lumenyl, 2 Ruinous Soul"
	Tooltip: "[c/E2735C:Weapon] Jaws of Oblivion: 159 rogue damage, use time 15"
}

GearKingofConstellationsTenryu: {
	Title: "King of Constellations, Tenryū"
	Contents: "[c/E2735C:Weapon] Obtain King of Constellations, Tenryū. 175 summon damage, use time 24, 10 mana. Summons a pair of celestial dragons to fight for you. There can only be one pair of dragons at a time. 'The ones who will devour the Unmoving Star'. How to get it: Craft at Bookcase from 1 Stardust Dragon Staff, 1 Dark Shard, 1 Light Shard, 3 Twisting Nether"
	Tooltip: "[c/E2735C:Weapon] King of Constellations, Tenryū: 175 summon damage, use time 24, 10 mana"
}

GearLacerator: {
	Title: "Lacerator"
	Contents: "[c/E2735C:Weapon] Obtain Lacerator. 222 melee damage, use time 20. Reach: X tiles. Speed: 48. Infinite throw duration. Striking enemies conjures a bloody saw to shred them. The saw does more damage the more often the yoyo hits, and fades away when not striking enemies. Enemies touching the edge of the sawblade get blood orbs torn out of them. Picking up these bl... How to get it: Craft at Mythril/Orichalcum Anvil from 25 Bloodstone, 10 Blood Orb"
	Tooltip: "[c/E2735C:Weapon] Lacerator: 222 melee damage, use time 20"
}

GearLegionofCelestia: {
	Title: "Legion of Celestia"
	Contents: "[c/E2735C:Weapon] Obtain Legion of Celestia. 50 summon damage, use time 24, 10 mana. Summons a possessed, celestial axe to fight for you. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Plantation Staff, 1 Smolstar, 5 Luminite Bar, 5 Life Alloy, 5 Stardust Fragment"
	Tooltip: "[c/E2735C:Weapon] Legion of Celestia: 50 summon damage, use time 24, 10 mana"
}

GearLifehuntScythe: {
	Title: "Lifehunt Scythe"
	Contents: "[c/E2735C:Weapon] Obtain Lifehunt Scythe. 156 melee damage, use time 18. Heals you on hit and shoots an energy scythe. How to get it: Craft at Mythril/Orichalcum Anvil from 12 Uelibloom Bar"
	Tooltip: "[c/E2735C:Weapon] Lifehunt Scythe: 156 melee damage, use time 18"
}

GearLightspeed: {
	Title: "Lightspeed"
	Contents: "[c/E2735C:Weapon] Obtain Lightspeed. 200 melee damage, use time 20. Unleash a flurry of stabs which build Elemental Mastery on hit. Elemental Mastery is lost over time if it has not been gained for a few seconds. Press Right Click with maximum Elemental Mastery to dash toward your cursor. Hitting an enemy during the dash refunds some Elemental Mastery. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Piercing Starlight, 1 Lucrecia, 5 Luminite Bar, 5 Life Alloy, 5 Solar Fragment"
	Tooltip: "[c/E2735C:Weapon] Lightspeed: 200 melee damage, use time 20"
}

GearLionHeart: {
	Title: "Lion Heart"
	Contents: "[c/E2735C:Weapon] Obtain Lion Heart. 960 melee damage, use time 15. Summons an energy explosion on hit. Press Right Click to summon an energy shell for a few seconds that halves all damage sources. This has a 45 second cooldown. How to get it: Sold by Cyborg"
	Tooltip: "[c/E2735C:Weapon] Lion Heart: 960 melee damage, use time 15"
}

GearLunarKunai: {
	Title: "Lunar Kunai"
	Contents: "[c/E2735C:Weapon] Obtain Lunar Kunai. 102 rogue damage, use time 10. Throws out a set of three kunai that ignore gravity and slightly home in on enemies. After traveling enough distance, the kunai supercharge with lunar energy, homing in far more aggressively and exploding on impact. Stealth strikes instantly throw ten supercharged Kunai. How to get it: Craft at Ancient Manipulator from 5 Luminite Bar"
	Tooltip: "[c/E2735C:Weapon] Lunar Kunai: 102 rogue damage, use time 10"
}

GearMadAlchemistsCocktailGlove: {
	Title: "Mad Alchemist's Cocktail Glove"
	Contents: "[c/E2735C:Weapon] Obtain Mad Alchemist's Cocktail Glove. 240 magic damage, use time 15, 12 mana. Fires a variety of high-velocity flasks. Press Right Click to throw a prismatic flask that inflicts Elemental Mix. Red flasks explode violently. Blue flasks contain poison gas. Green flasks summon lunar flares. Purple flasks explode into homing shrapnel. How to get it: Craft at Alchemy Table from 1 Toxic Flask, 15 Bottled Water, 5 Leather, 5 Effulgent Feather, 1 Core of Calamity"
	Tooltip: "[c/E2735C:Weapon] Mad Alchemist's Cocktail Glove: 240 magic damage, use time 15, 12 mana"
}

GearMagneticMeltdown: {
	Title: "Magnetic Meltdown"
	Contents: "[c/E2735C:Weapon] Obtain Magnetic Meltdown. 200 magic damage, use time 37, 45 mana. Launches a diamond cross of supercharged magnet spheres. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Magnet Sphere, 3 Twisting Nether"
	Tooltip: "[c/E2735C:Weapon] Magnetic Meltdown: 200 magic damage, use time 37, 45 mana"
}

GearMirrorBlade: {
	Title: "Mirror Blade"
	Contents: "[c/E2735C:Weapon] Obtain Mirror Blade. 600 melee damage, use time 40. Striking an enemy or a hostile projectile summons up to 10 orbiting mirror shards. Any shards above 10 instead seek out enemies. Holding Right Click coalesces the orbiting mirror shards into a shield. How to get it: Found in Treasure Bag (Ceaseless Void); Dropped by Ceaseless Void"
	Tooltip: "[c/E2735C:Weapon] Mirror Blade: 600 melee damage, use time 40"
}

GearMistlestorm: {
	Title: "Mistlestorm"
	Contents: "[c/E2735C:Weapon] Obtain Mistlestorm. 59 magic damage, use time 6, 7 mana. Casts a storm of pine needles and leaves. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Razorpine, 1 Leaf Blower, 10 Uelibloom Bar, 3 Dark Plasma"
	Tooltip: "[c/E2735C:Weapon] Mistlestorm: 59 magic damage, use time 6, 7 mana"
}

GearMoltenAmputator: {
	Title: "Molten Amputator"
	Contents: "[c/E2735C:Weapon] Obtain Molten Amputator. 200 rogue damage, use time 25. Throw a spinning scythe that lingers at your cursor. Right Click to recall all existing scythes. Recalling a scythe while it's on an enemy rends them for massive damage. Right Click with sufficient stealth to empower the next X scythes and greatly increase attack speed. You cannot recall scythes... How to get it: Found in Treasure Bag (Providence, the Profaned Goddess); Dropped by Providence, the Profaned Goddess"
	Tooltip: "[c/E2735C:Weapon] Molten Amputator: 200 rogue damage, use time 25"
}

GearMonsoon: {
	Title: "Monsoon"
	Contents: "[c/E2735C:Weapon] Obtain Monsoon. 156 ranged damage, use time 20. Fires a spread of 5 arrows. Wooden arrows are converted into typhoon arrows and sharks. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Tsunami, 1 Flarewing Bow, 6 Reaper Tooth, 10 Depth Cells"
	Tooltip: "[c/E2735C:Weapon] Monsoon: 156 ranged damage, use time 20"
}

GearMourningstar: {
	Title: "Mourningstar"
	Contents: "[c/E2735C:Weapon] Obtain Mourningstar. 112 melee damage, use time 10. Launches two solar whip swords that explode on hit. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Solar Eruption, 6 Divine Geode, 6 Essence of Sunlight, 6 Essence of Havoc"
	Tooltip: "[c/E2735C:Weapon] Mourningstar: 112 melee damage, use time 10"
}

GearMutatedTruffle: {
	Title: "Mutated Truffle"
	Contents: "[c/E2735C:Weapon] Obtain Mutated Truffle. 250 summon damage, use time 24, 10 mana. Summons a younger fishron to irradiate your foes. The fishron will cycle between charging, projectiles, and a typhoon. There can only be one minion. How to get it: Found in Treasure Bag (The Old Duke); Dropped by The Old Duke"
	Tooltip: "[c/E2735C:Weapon] Mutated Truffle: 250 summon damage, use time 24, 10 mana"
}

GearNanoPurge: {
	Title: "Nano Purge"
	Contents: "[c/E2735C:Weapon] Obtain Nano Purge. 135 magic damage, use time 20, 8 mana. Fires a barrage of nano lasers. Bounces towards the nearest enemy after hitting a wall. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Laser Machinegun, 10 Uelibloom Bar, 100 Nanites"
	Tooltip: "[c/E2735C:Weapon] Nano Purge: 135 magic damage, use time 20, 8 mana"
}

GearNeptunesBounty: {
	Title: "Neptune's Bounty"
	Contents: "[c/E2735C:Weapon] Obtain Neptune's Bounty. 420 melee damage, use time 65. Tosses a spinning abyssal sword which constantly sprays water energy. Once the blade begins falling, it will redirect itself towards enemies with increased velocity and 2x damage. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Abyss Blade, 6 Reaper Tooth, 5 Ruinous Soul"
	Tooltip: "[c/E2735C:Weapon] Neptune's Bounty: 420 melee damage, use time 65"
}

GearNettlevineGreatbow: {
	Title: "Nettlevine Greatbow"
	Contents: "[c/E2735C:Weapon] Obtain Nettlevine Greatbow. 73 ranged damage, use time 18. Shoots 4 arrows at once. Fires 2 additional venom or chlorophyte arrows. How to get it: Craft at Mythril/Orichalcum Anvil from 12 Uelibloom Bar"
	Tooltip: "[c/E2735C:Weapon] Nettlevine Greatbow: 73 ranged damage, use time 18"
}

GearNuclearFury: {
	Title: "Nuclear Fury"
	Contents: "[c/E2735C:Weapon] Obtain Nuclear Fury. 91 magic damage, use time 25, 30 mana. Casts a torrent of cosmic typhoons. How to get it: Craft at Bookcase from 1 Razorblade Typhoon, 1 Poseidon, 5 Luminite Bar"
	Tooltip: "[c/E2735C:Weapon] Nuclear Fury: 91 magic damage, use time 25, 30 mana"
}

GearNucleosynthesis: {
	Title: "Nucleosynthesis"
	Contents: "[c/E2735C:Weapon] Obtain Nucleosynthesis. 70 magic damage, use time 4, 30 mana. Casts four celestial beams near the player. Solar beams explode into fire on enemy hits. Nebula beams sweep a little bit over time. Vortex beams act like fast lightning and electrify enemies on hit. Stardust beams release small stars that home on enemy hits. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Photosynthesis, 5 Luminite Bar, 5 Life Alloy, 5 Nebula Fragment"
	Tooltip: "[c/E2735C:Weapon] Nucleosynthesis: 70 magic damage, use time 4, 30 mana"
}

GearOntologicalDespoiler: {
	Title: "Ontological Despoiler"
	Contents: "[c/E2735C:Weapon] Obtain Ontological Despoiler. 445 ranged damage, use time 8. Condenses chargeable pockets of concentrated unreality. Right Click to swap modes only after firing a charged shot. Unstable condensate shots trifurcate and pierce enemies. Null condensate shots fire rapidly and home in on enemies. At 50% charge or higher, rate of fire significantly increases. Fu... How to get it: Craft at Mythril/Orichalcum Anvil from 1 Arc Nova Diffuser, 1 Nullification Pistol, 1 Illegal Gun Parts, 3 Dark Plasma"
	Tooltip: "[c/E2735C:Weapon] Ontological Despoiler: 445 ranged damage, use time 8"
}

GearOnyxChainBlaster: {
	Title: "Onyx Chain Blaster"
	Contents: "[c/E2735C:Weapon] Obtain Onyx Chain Blaster. 58 ranged damage, use time 15. Fires a spread of bullets and an onyx shard. 50% chance to not consume ammo. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Onyx Blaster, 1 Chain Gun, 5 Luminite Bar"
	Tooltip: "[c/E2735C:Weapon] Onyx Chain Blaster: 58 ranged damage, use time 15"
}

GearPearlGod: {
	Title: "Pearl God"
	Contents: "[c/E2735C:Weapon] Obtain Pearl God. 160 ranged damage, use time 9. Alternates between firing a bullet imbued with lifesteal and 3 bullets imbued with pearlescence. Pearlescent imbued bullets create a radiant flash on impact, dealing additional damage to the enemy they hit. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Arietes 41, 5 Life Alloy, 2 Ruinous Soul, 1 White Pearl"
	Tooltip: "[c/E2735C:Weapon] Pearl God: 160 ranged damage, use time 9"
}

GearPhantasmalFury: {
	Title: "Phantasmal Fury"
	Contents: "[c/E2735C:Weapon] Obtain Phantasmal Fury. 190 magic damage, use time 3, 120 mana. Casts a vortex of homing souls around you that repels enemies and will fly towards your cursor after a few seconds. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Spectre Staff, 2 Ruinous Soul, 1 Dark Plasma"
	Tooltip: "[c/E2735C:Weapon] Phantasmal Fury: 190 magic damage, use time 3, 120 mana"
}

GearPhosphorescentGauntlet: {
	Title: "Phosphorescent Gauntlet"
	Contents: "[c/E2735C:Weapon] Obtain Phosphorescent Gauntlet. 3200 melee damage, use time 40. Releases rapid sulphurous punches. On use, you lunge in the direction of the mouse. On collision, you are knocked back. How to get it: Dropped by Nuclear Terror"
	Tooltip: "[c/E2735C:Weapon] Phosphorescent Gauntlet: 3200 melee damage, use time 40"
}

GearPlanetaryAnnihilation: {
	Title: "Planetary Annihilation"
	Contents: "[c/E2735C:Weapon] Obtain Planetary Annihilation. 66 ranged damage, use time 22. Fires a storm of 7 arrows from the sky. Wooden arrows are converted into homing energy bolts. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Vernal Bolter, 1 Daedalus Stormbow, 5 Luminite Bar, 5 Life Alloy, 5 Vortex Fragment"
	Tooltip: "[c/E2735C:Weapon] Planetary Annihilation: 66 ranged damage, use time 22"
}

GearPlasmaCaster: {
	Title: "Plasma Caster"
	Contents: "[c/E2735C:Weapon] Obtain Plasma Caster. 705 magic damage, use time 45, 36 mana. Press Left Click to fire a large, exploding plasma bolt. Press Right Click to fire in turbo mode, increasing rate of fire but with hindered accuracy. How to get it: Craft at Mythril/Orichalcum Anvil from 18 Mysterious Circuitry, 12 Dubious Plating, 8 Uelibloom Bar, 4 Luminite Bar"
	Tooltip: "[c/E2735C:Weapon] Plasma Caster: 705 magic damage, use time 45, 36 mana"
}

GearPlasmaRifle: {
	Title: "Plasma Rifle"
	Contents: "[c/E2735C:Weapon] Obtain Plasma Rifle. 120 magic damage, use time 40, 40 mana. Fires an explosive plasma blast with pinpoint accuracy. Press Right Click to rapidly fire non-explosive blasts. How to get it: Craft at Ancient Manipulator from 1 Toxic Flask, 1 Laser Rifle, 6 Vortex Fragment"
	Tooltip: "[c/E2735C:Weapon] Plasma Rifle: 120 magic damage, use time 40, 40 mana"
}

GearPridefulHuntersPlanarRipper: {
	Title: "Prideful Hunter's Planar Ripper"
	Contents: "[c/E2735C:Weapon] Obtain Prideful Hunter's Planar Ripper. 79 ranged damage, use time 5. Every fourth shot deals 135% damage. Converts musket balls into Electrified lightning bolts. Lightning bolts travel extremely fast and explode on enemy kills. Lightning bolt crits grant a stacking speed boost to the player. This stacks up to 20 percent bonus movement speed and acceleration. The b... How to get it: Craft at Mythril/Orichalcum Anvil from 1 P90, 1 Uzi, 5 Luminite Bar, 10 Vortex Fragment"
	Tooltip: "[c/E2735C:Weapon] Prideful Hunter's Planar Ripper: 79 ranged damage, use time 5"
}

GearPristineFury: {
	Title: "Pristine Fury"
	Contents: "[c/E2735C:Weapon] Obtain Pristine Fury. 60 ranged damage, use time 3. Fires an intense helix of Holy Flames that burst into a column of smoke. Right Click to disperse a limited supply of flammable crystalline powder that restores over time. Powder can be ignited, causing it to explode for extra damage. Both helix flames and other nearby explosions can ignite the po... How to get it: Found in Treasure Bag (Providence, the Profaned Goddess); Dropped by Providence, the Profaned Goddess"
	Tooltip: "[c/E2735C:Weapon] Pristine Fury: 60 ranged damage, use time 3"
}

GearProfanedPartisan: {
	Title: "Profaned Partisan"
	Contents: "[c/E2735C:Weapon] Obtain Profaned Partisan. 300 rogue damage, use time 21. Throws a profaned spear that splits into miniature spears upon hitting an enemy. Stealth strikes remain impaled in an enemy for 10 seconds. While an enemy is impaled, all spears that strike them instead shatter into exploding stars. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Spear of Paleolith, 25 Unholy Essence"
	Tooltip: "[c/E2735C:Weapon] Profaned Partisan: 300 rogue damage, use time 21"
}

GearPulseDragon: {
	Title: "Pulse Dragon"
	Contents: "[c/E2735C:Weapon] Obtain Pulse Dragon. 300 melee damage, use time 20. Throws two mechanical dragon heads that emit damaging electrical fields. 'Yharim specifically requested this weapon to be modelled after the Dragons of old. How trite.'. How to get it: Craft at Mythril/Orichalcum Anvil from 12 Mysterious Circuitry, 18 Dubious Plating, 8 Uelibloom Bar, 4 Luminite Bar"
	Tooltip: "[c/E2735C:Weapon] Pulse Dragon: 300 melee damage, use time 20"
}

GearPurgeGuzzler: {
	Title: "Purge Guzzler"
	Contents: "[c/E2735C:Weapon] Obtain Purge Guzzler. 152 magic damage, use time 38, 14 mana. Fires a barrage of holy rays that converge into two massive sweeping beams. 'Baptism by holy fire'. How to get it: Found in Treasure Bag (Providence, the Profaned Goddess); Dropped by Providence, the Profaned Goddess"
	Tooltip: "[c/E2735C:Weapon] Purge Guzzler: 152 magic damage, use time 38, 14 mana"
}

GearRealityRupture: {
	Title: "Reality Rupture"
	Contents: "[c/E2735C:Weapon] Obtain Reality Rupture. 420 rogue damage, use time 37. Cycles between throwing 3 small homing spears and throwing a single piercing lance. Stealth strikes throw a high-velocity reality shattering lance that explodes on hit. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Spear of Destiny, 1 Armored Shell, 1 Twisting Nether, 1 Dark Plasma"
	Tooltip: "[c/E2735C:Weapon] Reality Rupture: 420 rogue damage, use time 37"
}

GearReboundingRainbow: {
	Title: "Rebounding Rainbow"
	Contents: "[c/E2735C:Weapon] Obtain Rebounding Rainbow. 92 rogue damage, use time 16. Throws a disk that has a chance to generate several disks if enemies are near it. Stealth strikes fly slower but travel farther, pierce through enemies, and spawn extra disks more frequently. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Samsara Slicer, 5 Luminite Bar, 5 Life Alloy, 5 Meld Blob"
	Tooltip: "[c/E2735C:Weapon] Rebounding Rainbow: 92 rogue damage, use time 16"
}

GearRecitationoftheBeast: {
	Title: "Recitation of the Beast"
	Contents: "[c/E2735C:Weapon] Obtain Recitation of the Beast. 60 magic damage, use time 22, 22 mana. Summons beast scythes around the player in a small circle. Beast scythes fire toward the cursor and home in to nearby enemies. How to get it: Craft at Bookcase from 1 Demon Scythe, 20 Bloodstone, 8 Essence of Havoc"
	Tooltip: "[c/E2735C:Weapon] Recitation of the Beast: 60 magic damage, use time 22, 22 mana"
}

GearRelicOfDeliverance: {
	Title: "Relic of Deliverance"
	Contents: "[c/E2735C:Weapon] Obtain Relic of Deliverance. 1700 damage, use time 35. Hold Left Click to mount and charge the spear, dashing towards your mouse when the button is released. The speed of the dash depends on the charge amount, and is reduced while a boss is alive. The dash can ram through enemies and travel through tiles. Press Right Click to dismount. Holding out th... How to get it: Dropped by Guardian Commander"
	Tooltip: "[c/E2735C:Weapon] Relic of Deliverance: 1700 damage, use time 35"
}

GearRemsRevenge: {
	Title: "Rem's Revenge"
	Contents: "[c/E2735C:Weapon] Obtain Rem's Revenge. 188 melee damage, use time 15. Summons blood explosions and inflicts Wither on hit. 'A deadly morning star befitting its demonic owner'. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Blue Moon, 5 Luminite Bar, 10 Lumenyl"
	Tooltip: "[c/E2735C:Weapon] Rem's Revenge: 188 melee damage, use time 15"
}

GearRespiteblock: {
	Title: "Respiteblock"
	Contents: "[c/E2735C:Weapon] Obtain Respiteblock. 70 melee damage, use time 10. A glistening white chainsaw that spews green and purple blood all over. Hitting enemies with the blade will heal you and deal immense damage. 'It's Ok To Be Dangerous'. How to get it: Craft at Ancient Manipulator from 1 Butchers Chainsaw, 4 Solar Fragment, 13 Essence of Sunlight"
	Tooltip: "[c/E2735C:Weapon] Respiteblock: 70 melee damage, use time 10"
}

GearRougeSlash: {
	Title: "Rouge Slash"
	Contents: "[c/E2735C:Weapon] Obtain Rouge Slash. 119 magic damage, use time 19, 30 mana. Fires a wave of 3 rouge air slashes. How to get it: Found in Treasure Bag (The Dragonfolly); Dropped by Dragonfolly"
	Tooltip: "[c/E2735C:Weapon] Rouge Slash: 119 magic damage, use time 19, 30 mana"
}

GearSanctifiedSpark: {
	Title: "Sanctified Spark"
	Contents: "[c/E2735C:Weapon] Obtain Sanctified Spark. 100 summon damage, use time 30, 100 mana. Summons a sentry. Summons a friendly immolator that will float towards you. Immolators rapidly fire homing flares of Holy Flames at nearby enemies, before continuing to float near you again. After firing, Immolators will fire one healing bolt at you for every 4 summon slots you have. 'They might... How to get it: Dropped by Impious Immolator"
	Tooltip: "[c/E2735C:Weapon] Sanctified Spark: 100 summon damage, use time 30, 100 mana"
}

GearSanguineFlare: {
	Title: "Sanguine Flare"
	Contents: "[c/E2735C:Weapon] Obtain Sanguine Flare. 1050 magic damage, use time 25, 36 mana. Charges up a sanguine flare that gains power over time. When striking an enemy, this flare causes a bloodsplosion and splits into blood orbs. Picking up these blood orbs reduces the duration of Potion Sickness. How to get it: Craft at Mythril/Orichalcum Anvil from 25 Bloodstone, 10 Blood Orb"
	Tooltip: "[c/E2735C:Weapon] Sanguine Flare: 1050 magic damage, use time 25, 36 mana"
}

GearScorpio: {
	Title: "Scorpio"
	Contents: "[c/E2735C:Weapon] Obtain Scorpio. 33 ranged damage, use time 30. Hold Left Click to fire a barrage of homing nano missiles and charge energy. Maximum charge is reached after firing 3 barrages. Right Click while holding Left Click at max charge to launch a nano nuke. Nano nukes deal massive damage and reset the cooldown of missile barrages. How to get it: Craft at Ancient Manipulator from 1 Snowman Cannon, 6 Nebula Fragment, 100 Nanites"
	Tooltip: "[c/E2735C:Weapon] Scorpio: 33 ranged damage, use time 30"
}

GearSeadragon: {
	Title: "Seadragon"
	Contents: "[c/E2735C:Weapon] Obtain Seadragon. 154 ranged damage, use time 3. Loads a 50 round magazine of alternating bullets and pressurized water jets. Water jets summon small fish that swim around you. When all bullets are fired, summoned fish swarm the cursor while you reload. 66% chance to not consume ammo. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Megalodon, 9 Necroplasm, 10 Sea Prism, 3 Armored Shell"
	Tooltip: "[c/E2735C:Weapon] Seadragon: 154 ranged damage, use time 3"
}

GearSealedSingularity: {
	Title: "Sealed Singularity"
	Contents: "[c/E2735C:Weapon] Obtain Sealed Singularity. 220 rogue damage, use time 30. Disables normal stealth generation. Throws a contained singularity bomb that slows down and creates a damaging field after a short fuse. Hold Left Click to generate stealth, but burn through the bomb's fuse. After the field collapses, the singularity seeks out the strongest target that it hit and... How to get it: Craft at Mythril/Orichalcum Anvil from 1 Duststorm in a Bottle, 3 Dark Plasma"
	Tooltip: "[c/E2735C:Weapon] Sealed Singularity: 220 rogue damage, use time 30"
}

GearSeekingScorcher: {
	Title: "Seeking Scorcher"
	Contents: "[c/E2735C:Weapon] Obtain Seeking Scorcher. 1170 melee damage, use time 55. Throws a massive crystalline axe which bounces to three additional targets after hitting. Crystallizes in place if all bounces have not been exhausted. Crystallized hatchets can be shattered by another axe. Doing so empowers the hatchet based on the amount shattered but prevents it from crystalli... How to get it: Craft at Mythril/Orichalcum Anvil from 1 Possessed Hatchet, 5 Divine Geode, 8 Unholy Essence"
	Tooltip: "[c/E2735C:Weapon] Seeking Scorcher: 1170 melee damage, use time 55"
}

GearSepticSkewer: {
	Title: "Septic Skewer"
	Contents: "[c/E2735C:Weapon] Obtain Septic Skewer. 933 ranged damage, use time 30. Launches a vile chained harpoon infested with toxins. Harpoons stick into enemies and inflict Sulphuric Poisoning for a long time. After being impaled for one second, harpoons rip themselves back out and spray damaging gores. Press Right Click to manually rip out all harpoons, dealing bonus damag... How to get it: Found in Treasure Bag (The Old Duke); Dropped by The Old Duke"
	Tooltip: "[c/E2735C:Weapon] Septic Skewer: 933 ranged damage, use time 30"
}

GearShadowboltStaff: {
	Title: "Shadowbolt Staff"
	Contents: "[c/E2735C:Weapon] Obtain Shadowbolt Staff. 285 magic damage, use time 8, 72 mana. Fires a shadow beam that creates a platform to redirect itself back at enemies for increased damage. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Shadowbeam Staff, 2 Ruinous Soul, 1 Armored Shell"
	Tooltip: "[c/E2735C:Weapon] Shadowbolt Staff: 285 magic damage, use time 8, 72 mana"
}

GearShardofAntumbra: {
	Title: "Shard of Antumbra"
	Contents: "[c/E2735C:Weapon] Obtain Shard of Antumbra. 111 rogue damage, use time 17. Throws a cosmic javelin that sticks into enemies and tiles, creating a small rift nearby on enemy hits. After hitting a target, it will charge with energy and teleport to the rift, aiming itself at the nearest target. Stealth strikes create a multitude of rifts to spawn additional javelins upon t... How to get it: Craft at Ancient Manipulator from 18 Meld Blob"
	Tooltip: "[c/E2735C:Weapon] Shard of Antumbra: 111 rogue damage, use time 17"
}

GearShatteredDawn: {
	Title: "Shattered Dawn"
	Contents: "[c/E2735C:Weapon] Obtain Shattered Dawn. 80 rogue damage, use time 12. Throws daggers that split into scorching homing daggers. Stealth strikes fire volleys of homing daggers from the player on dagger hits that suck enemies in. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Radiant Star, 6 Divine Geode"
	Tooltip: "[c/E2735C:Weapon] Shattered Dawn: 80 rogue damage, use time 12"
}

GearShredder: {
	Title: "Shredder"
	Contents: "[c/E2735C:Weapon] Obtain Shredder. 48 ranged damage, use time 4. Fires a barrage of energy bolts that split and bounce. 'The myth, the legend, the weapon that drops more frames than any other'. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Frostbite Blaster, 1 Bullet-Filled Shotgun, 5 Luminite Bar"
	Tooltip: "[c/E2735C:Weapon] Shredder: 48 ranged damage, use time 4"
}

GearShroomer: {
	Title: "Shroomer"
	Contents: "[c/E2735C:Weapon] Obtain Shroomer. 150 ranged damage, use time 35. Fires bullets and an extremely powerful homing mushroom. How to get it: Craft at Ancient Manipulator from 1 Sniper Rifle, 1 Fungicide, 6 Stardust Fragment"
	Tooltip: "[c/E2735C:Weapon] Shroomer: 150 ranged damage, use time 35"
}

GearSirius: {
	Title: "Sirius"
	Contents: "[c/E2735C:Weapon] Obtain Sirius. 90 summon damage, use time 24, 10 mana. Summons the brightest star in the sky, Sirius, to protect you. Continue summoning to complete Canis Major. Repeated summons increase its power greatly, even after the constellation is complete. Sirius passively generates Starbursts when targeting enemies. When Starbursts are full, Sirius consumes... How to get it: Craft at Mythril/Orichalcum Anvil from 1 Vengeful Sun Staff, 8 Lumenyl, 4 Ruinous Soul, 20 Exodium Cluster"
	Tooltip: "[c/E2735C:Weapon] Sirius: 90 summon damage, use time 24, 10 mana"
}

GearSkytideDragoon: {
	Title: "Skytide Dragoon"
	Contents: "[c/E2735C:Weapon] Obtain Skytide Dragoon. 365 melee damage, use time 35. Calls down a thunderbolt to strike and charge the tip of the spear. Press Left Click to discharge the electricity as a spread of bolts that narrows as you spend the energy. Hold Right Click when the spear catches the thunderbolt to redirect it to the cursor. How to get it: Found in Treasure Bag (Storm Weaver); Dropped by Storm Weaver"
	Tooltip: "[c/E2735C:Weapon] Skytide Dragoon: 365 melee damage, use time 35"
}

GearSnakeEyes: {
	Title: "Snake Eyes"
	Contents: "[c/E2735C:Weapon] Obtain Snake Eyes. 160 summon damage, use time 24, 12 mana. Summons a levitating drone which fires piercing, highly calibrated energy bolts. If a bolt hits, the drone will teleport into its path and reflect the bolt. Reflected bolts home in and explode on impact. 'Equipped with high-end sensors, little can evade them. Even less are able to escape their ev... How to get it: Craft at Mythril/Orichalcum Anvil from 18 Mysterious Circuitry, 12 Dubious Plating, 8 Uelibloom Bar, 4 Luminite Bar"
	Tooltip: "[c/E2735C:Weapon] Snake Eyes: 160 summon damage, use time 24, 12 mana"
}

GearSolsticeClaymore: {
	Title: "Solstice Claymore"
	Contents: "[c/E2735C:Weapon] Obtain Solstice Claymore. 235 melee damage, use time 16. Changes projectile color based on the time of year. Inflicts Daybroken during the day and Nightwither during the night. How to get it: Craft at Ancient Manipulator from 1 Beam Sword, 18 Astral Bar, 5 Luminite Bar, 5 Solar Fragment, 5 Stardust Fragment"
	Tooltip: "[c/E2735C:Weapon] Solstice Claymore: 235 melee damage, use time 16"
}

GearSpectralstormCannon: {
	Title: "Spectralstorm Cannon"
	Contents: "[c/E2735C:Weapon] Obtain Spectralstorm Cannon. 85 ranged damage, use time 11. Fires a barrage of spectral Nightwither flares that builds up a searing heat in the weapon. While cooling down, heat-seeking phantoms are continuously released. Firing for too long overheats the weapon, leaving it unusable for a short period and inflicting you with Nightwither. However, triggerin... How to get it: Craft at Ancient Manipulator from 1 Firestorm Cannon, 6 Solar Fragment, 10 Ectoplasm; Sold by a town NPC"
	Tooltip: "[c/E2735C:Weapon] Spectralstorm Cannon: 85 ranged damage, use time 11"
}

GearSpyker: {
	Title: "Spyker"
	Contents: "[c/E2735C:Weapon] Obtain Spyker. 210 ranged damage, use time 13. Converts musket balls into Venom infused spikes that stick to enemies, tiles and explode into shrapnel. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Needler, 1 Stynger, 10 Uelibloom Bar"
	Tooltip: "[c/E2735C:Weapon] Spyker: 210 ranged damage, use time 13"
}

GearStarofDestruction: {
	Title: "Star of Destruction"
	Contents: "[c/E2735C:Weapon] Obtain Star of Destruction. 400 rogue damage, use time 90. Throws a fan of cosmic bolts that meld together into a star of destruction. The explosive star will slowly follow your cursor until it expires or hits an enemy. Upon running out of time, the star will burst into a huge explosion that deals increased damage. Stealth strikes throw additional bolts... How to get it: Craft at Ancient Manipulator from 18 Meld Blob"
	Tooltip: "[c/E2735C:Weapon] Star of Destruction: 400 rogue damage, use time 90"
}

GearStarfleet: {
	Title: "Starfleet"
	Contents: "[c/E2735C:Weapon] Obtain Starfleet. 3170 ranged damage, use time 70. Left Click fires a spread of starshots. Right Click fires a concussive short range starburst. Starshots can be accelerated by firing when the starburst goes off. Perfect timing reduces spread and increases damage. Imperfect timing still increases damage, but heavily increases spread. Uses fallen... How to get it: Craft at Ancient Manipulator from 1 Super Star Cannon, 4 Ruinous Soul, 15 Fallen Star, 5 Stardust Fragment"
	Tooltip: "[c/E2735C:Weapon] Starfleet: 3170 ranged damage, use time 70"
}

GearStellarContempt: {
	Title: "Stellar Contempt"
	Contents: "[c/E2735C:Weapon] Obtain Stellar Contempt. 525 melee damage, use time 48. Throws a heavy, gravity-affected hammer that will return to you after striking an enemy. Consecutive hits call down more and more lunar flares from the sky. After hitting five times, the hammer supercharges with lunar energy to pulverize your target. How to get it: Craft at Ancient Manipulator from 1 Fallen Paladin's Hammer, 5 Luminite Bar, 5 Solar Fragment, 2 Core of Calamity"
	Tooltip: "[c/E2735C:Weapon] Stellar Contempt: 525 melee damage, use time 48"
}

GearStellarStriker: {
	Title: "Stellar Striker"
	Contents: "[c/E2735C:Weapon] Obtain Stellar Striker. 100 melee damage, use time 28. Summons a swarm of lunar flares from the sky on enemy hits. How to get it: Craft at Ancient Manipulator from 1 Comet Quasher, 5 Luminite Bar"
	Tooltip: "[c/E2735C:Weapon] Stellar Striker: 100 melee damage, use time 28"
}

GearStellarTorusStaff: {
	Title: "Stellar Torus Staff"
	Contents: "[c/E2735C:Weapon] Obtain Stellar Torus Staff. 132 summon damage, use time 24, 10 mana. Summons a Torus Orbital that fries foes with a telescoping light beam. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Xeno Staff, 6 Stardust Fragment, 3 Armored Shell"
	Tooltip: "[c/E2735C:Weapon] Stellar Torus Staff: 132 summon damage, use time 24, 10 mana"
}

GearStormRuler: {
	Title: "Storm Ruler"
	Contents: "[c/E2735C:Weapon] Obtain Storm Ruler. 80 melee damage, use time 25. Fires beams that generate tornadoes where they strike. Tornadoes suck enemies in. 'Only a storm can fell a greatwood'. How to get it: Craft at Ancient Manipulator from 1 Storm Saber, 1 Wind Blade, 6 Vortex Fragment"
	Tooltip: "[c/E2735C:Weapon] Storm Ruler: 80 melee damage, use time 25"
}

GearStratusSphere: {
	Title: "Stratus Sphere"
	Contents: "[c/E2735C:Weapon] Obtain Stratus Sphere. 400 damage, use time 30. Launches a singularity which exerts influence on all entities in a large area around it. Influenced players gain Starbursts over time and will consume Starbursts to fly when out of flight time. Right Click to cause Starbursts to form a barrier, causing you to lose Starbursts instead of health. La... How to get it: Craft at Mythril/Orichalcum Anvil from 1 Nebula Arcanum, 8 Lumenyl, 4 Ruinous Soul, 20 Exodium Cluster"
	Tooltip: "[c/E2735C:Weapon] Stratus Sphere: 400 damage, use time 30"
}

GearSulphuricAcidCannon: {
	Title: "Sulphuric Acid Cannon"
	Contents: "[c/E2735C:Weapon] Obtain Sulphuric Acid Cannon. 550 ranged damage, use time 35. Fires homing Acid Rockets. Acid Rockets stick to enemies and explode into toxic mist after a short delay. How to get it: Dropped by Mauler"
	Tooltip: "[c/E2735C:Weapon] Sulphuric Acid Cannon: 550 ranged damage, use time 35"
}

GearSuperradiantSlaughterer: {
	Title: "Superradiant Slaughterer"
	Contents: "[c/E2735C:Weapon] Obtain Superradiant Slaughterer. 100 ranged damage, use time 30. 'No one knows how it turns blood into rainbows...'. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Buzzkill, 1 Speed Blaster, 5 Luminite Bar, 5 Life Alloy, 5 Vortex Fragment"
	Tooltip: "[c/E2735C:Weapon] Superradiant Slaughterer: 100 ranged damage, use time 30"
}

GearSwordsplosion: {
	Title: "Swordsplosion"
	Contents: "[c/E2735C:Weapon] Obtain Swordsplosion. 48 melee damage, use time 30. Fires multiple rainbow beam swords that rain from the sky. Sword swarm. How to get it: Craft at Mythril/Orichalcum Anvil from 5 Luminite Bar, 10 Life Alloy, 15 Effulgent Feather"
	Tooltip: "[c/E2735C:Weapon] Swordsplosion: 48 melee damage, use time 30"
}

GearTacticalPlagueEngine: {
	Title: "Tactical Plague Engine"
	Contents: "[c/E2735C:Weapon] Obtain Tactical Plague Engine. 110 summon damage, use time 24, 10 mana. Summons a Plague jet to pummel your enemies into submission. Jets will fire bullets from your inventory. Sometimes shoots a missile instead of a bullet. 50% chance to save ammo. Missiles do not consume ammo. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Black Hawk Remote, 1 Fuel Cell Bundle, 5 Luminite Bar"
	Tooltip: "[c/E2735C:Weapon] Tactical Plague Engine: 110 summon damage, use time 24, 10 mana"
}

GearTacticiansTrumpCard: {
	Title: "Tactician's Trump Card"
	Contents: "[c/E2735C:Weapon] Obtain Tactician's Trump Card. 248 magic damage, use time 12, 20 mana. Fires an Electrified sword beam. 'Faint memories of a Princess from the future cross your mind...'. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Copper Shortsword, 1 Apathanull, 1 Flare Bolt, 1 Tradewinds, 1 Nuclear Fury, 10 Uelibloom Bar, 3 Dark Plasma (+1 alternative recipe)"
	Tooltip: "[c/E2735C:Weapon] Tactician's Trump Card: 248 magic damage, use time 12, 20 mana"
}

GearTarragonThrowingDart: {
	Title: "Tarragon Throwing Dart"
	Contents: "[c/E2735C:Weapon] Obtain Tarragon Throwing Dart. 380 rogue damage, use time 11. Fires a piercing dart. Stealth strikes erupt into thorns on enemy hits. How to get it: Craft at Mythril/Orichalcum Anvil from 12 Uelibloom Bar"
	Tooltip: "[c/E2735C:Weapon] Tarragon Throwing Dart: 380 rogue damage, use time 11"
}

GearTauCannon: {
	Title: "Tau Cannon"
	Contents: "[c/E2735C:Weapon] Obtain Tau Cannon. 620 ranged damage, use time 180. A bulky assault rifle with three charge levels that fires astral energy. Charge level one fires a burst of bolts. Charge level two fires a beam of energy that quickly fizzles out. Charge level three fires a massive laser and creates astral portals around you. 'This weapon is very ethically questi... How to get it: Craft at Mythril/Orichalcum Anvil from 1 Arc Nova Diffuser, 10 Mysterious Circuitry, 15 Dubious Plating, 10 Astral Bar, 2 Ruinous Soul"
	Tooltip: "[c/E2735C:Weapon] Tau Cannon: 620 ranged damage, use time 180"
}

GearTelluricGlare: {
	Title: "Telluric Glare"
	Contents: "[c/E2735C:Weapon] Obtain Telluric Glare. 83 ranged damage, use time 3. Rapidly fires volleys of arrows. Every other arrow is converted into radiant greatarrows which pierce but quicky disappear after striking. Wooden arrows are converted into more powerful greatarrows that deal increased damage. How to get it: Found in Treasure Bag (Providence, the Profaned Goddess); Dropped by Providence, the Profaned Goddess"
	Tooltip: "[c/E2735C:Weapon] Telluric Glare: 83 ranged damage, use time 3"
}

GearTenebreusTides: {
	Title: "Tenebreus Tides"
	Contents: "[c/E2735C:Weapon] Obtain Tenebreus Tides. 120 melee damage, use time 14. Shoots a water spear that pierces enemies and terrain. Striking enemies summons liquid blades and spears to assault the struck foe. 'Inundatio ex Laminis'. How to get it: Craft at Ancient Manipulator from 1 Amidias' Trident, 1 Atlantis, 1 Influx Waver, 50 Lumenyl"
	Tooltip: "[c/E2735C:Weapon] Tenebreus Tides: 120 melee damage, use time 14"
}

GearTerratomere: {
	Title: "Terratomere"
	Contents: "[c/E2735C:Weapon] Obtain Terratomere. 120 melee damage, use time 21. Heals the player on true melee hits. Fires several piercing energy bolts that rapidly seek targets. On hit, explodes and repeatedly slashes the target. 'Linked to the essence of Terraria'. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Terra Blade, 18 Uelibloom Bar"
	Tooltip: "[c/E2735C:Weapon] Terratomere: 120 melee damage, use time 21"
}

GearTerrorBlade: {
	Title: "Terror Blade"
	Contents: "[c/E2735C:Weapon] Obtain Terror Blade. 560 melee damage, use time 18. Fires a terror beam that bounces off tiles. On every bounce it emits an explosion. How to get it: Found in Treasure Bag (Polterghast); Dropped by Polterghast"
	Tooltip: "[c/E2735C:Weapon] Terror Blade: 560 melee damage, use time 18"
}

GearTeslastaff: {
	Title: "Teslastaff"
	Contents: "[c/E2735C:Weapon] Obtain Teslastaff. 166 magic damage, use time 10, 10 mana. Fires a channeled beam of pinpoint-accurate lightning. The beam has limited turning speed capability. Each successive hit on the same enemy increases damage per hit. The damage increases 10% per hit to a maximum of 500% damage. This damage will rapidly decrease after the enemy stops being hit. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Thunder Staff, 20 Any Copper Bar, 6 Essence of Sunlight, 3 Armored Shell"
	Tooltip: "[c/E2735C:Weapon] Teslastaff: 166 magic damage, use time 10, 10 mana"
}

GearTheLastMourning: {
	Title: "The Last Mourning"
	Contents: "[c/E2735C:Weapon] Obtain The Last Mourning. 600 melee damage, use time 20. Summons flaming pumpkins and mourning skulls. Pumpkins and skulls split into homing fire orbs on enemy hits. How to get it: Craft at Mythril/Orichalcum Anvil from 1 The Horsemans Blade, 30 Soul of Night, 5 Reaper Tooth, 3 Ruinous Soul"
	Tooltip: "[c/E2735C:Weapon] The Last Mourning: 600 melee damage, use time 20"
}

GearTheMaelstrom: {
	Title: "The Maelstrom"
	Contents: "[c/E2735C:Weapon] Obtain The Maelstrom. 550 ranged damage, use time 45. Fires charged Reaper Sharks that cause water explosions. How to get it: Craft at Mythril/Orichalcum Anvil from 1 The Storm, 3 Reaper Tooth, 20 Divine Geode, 50 Voidstone"
	Tooltip: "[c/E2735C:Weapon] The Maelstrom: 550 ranged damage, use time 45"
}

GearTheMutilator: {
	Title: "The Mutilator"
	Contents: "[c/E2735C:Weapon] Obtain The Mutilator. 1005 melee damage, use time 30. Striking enemies empowers The Mutilator, increasing its damage. At full charge, striking enemies causes a blood orb explosion. Picking up these blood orbs reduces the duration of Potion Sickness. How to get it: Craft at Mythril/Orichalcum Anvil from 25 Bloodstone, 10 Blood Orb"
	Tooltip: "[c/E2735C:Weapon] The Mutilator: 1005 melee damage, use time 30"
}

GearTheOldReaper: {
	Title: "The Old Reaper"
	Contents: "[c/E2735C:Weapon] Obtain The Old Reaper. 1420 rogue damage, use time 50. Throws a scythe that cuts through enemies. Deposits unstable isotopes on hit, which create delayed nuclear explosions when they decay. Stealth strikes are thrown into the sky and fall upon enemies a few seconds later. On hit, stealth strikes create a focused deluge of acid rain. How to get it: Found in Treasure Bag (The Old Duke); Dropped by The Old Duke"
	Tooltip: "[c/E2735C:Weapon] The Old Reaper: 1420 rogue damage, use time 50"
}

GearThePrince: {
	Title: "The Prince"
	Contents: "[c/E2735C:Weapon] Obtain The Prince. 180 magic damage, use time 21, 16 mana. Casts a holy fireball that explodes into six homing flames. 'So you're telling me that the prince exploded, and then turned into a flower?'. -Dain, the sailor druid. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Arch Amaryllis, 15 Divine Geode, 10 Unholy Essence"
	Tooltip: "[c/E2735C:Weapon] The Prince: 180 magic damage, use time 21, 16 mana"
}

GearTheSevensStriker: {
	Title: "The Sevens Striker"
	Contents: "[c/E2735C:Weapon] Obtain The Sevens Striker. 777 ranged damage, use time 30. Press Left Click to consume 1 coin and play a slot machine. The quality of the outcome depends on the coin used. 'A gun given to a great gunslinger. Forged by the arms of a man given no name'. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Coin Gun, 7 Platinum Coin, 77 Gold Coin, 12 Luminite Bar, 3 Twisting Nether"
	Tooltip: "[c/E2735C:Weapon] The Sevens Striker: 777 ranged damage, use time 30"
}

GearTheStorm: {
	Title: "The Storm"
	Contents: "[c/E2735C:Weapon] Obtain The Storm. 40 ranged damage, use time 2. Fires a spread of homing lightning bolts and arrows from the sky. Converts wooden arrows into powerful lightning bolts. How to get it: Found in Treasure Bag (Storm Weaver); Dropped by Storm Weaver"
	Tooltip: "[c/E2735C:Weapon] The Storm: 40 ranged damage, use time 2"
}

GearTheSwarmer: {
	Title: "The Swarmer"
	Contents: "[c/E2735C:Weapon] Obtain The Swarmer. 36 magic damage, use time 12, 14 mana. Fires a swarm of bees and wasps. How to get it: Craft at Ancient Manipulator from 1 Bee Gun, 1 Wasp Gun, 6 Stardust Fragment"
	Tooltip: "[c/E2735C:Weapon] The Swarmer: 36 magic damage, use time 12, 14 mana"
}

GearThornBlossom: {
	Title: "Thorn Blossom"
	Contents: "[c/E2735C:Weapon] Obtain Thorn Blossom. 120 magic damage, use time 23, 27 mana. Casts a beaming flower that explodes into homing petals alongside a deadly thorn. Costs 3 HP to fire. 'Every rose has its thorn'. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Arch Amaryllis, 10 Uelibloom Bar, 10 Unholy Essence"
	Tooltip: "[c/E2735C:Weapon] Thorn Blossom: 120 magic damage, use time 23, 27 mana"
}

GearToxicantTwister: {
	Title: "Toxicant Twister"
	Contents: "[c/E2735C:Weapon] Obtain Toxicant Twister. 272 rogue damage, use time 40. Throws a fan of four spinning disks that swirl around your cursor. Stealth strikes swirl in a wider range and create a vortex of raindrops that home in on enemies. How to get it: Found in Treasure Bag (The Old Duke); Dropped by The Old Duke"
	Tooltip: "[c/E2735C:Weapon] Toxicant Twister: 272 rogue damage, use time 40"
}

GearTwistingThunder: {
	Title: "Twisting Thunder"
	Contents: "[c/E2735C:Weapon] Obtain Twisting Thunder. 466 rogue damage, use time 21. Fires a lightning bolt to electrocute enemies. The lightning bolt travels faster while it is raining. Summons lightning from the sky on impact. Stealth strikes summon more lightning and travel faster. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Stormfront Razor, 15 Unholy Essence, 3 Armored Shell"
	Tooltip: "[c/E2735C:Weapon] Twisting Thunder: 466 rogue damage, use time 21"
}

GearUltraLiquidator: {
	Title: "Ultra Liquidator"
	Contents: "[c/E2735C:Weapon] Obtain Ultra Liquidator. 120 magic damage, use time 3, 25 mana. Summons liquidation blades that summon more blades on enemy hits. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Infernal Rift, 1 Aqua Scepter, 5 Luminite Bar, 5 Nebula Fragment"
	Tooltip: "[c/E2735C:Weapon] Ultra Liquidator: 120 magic damage, use time 3, 25 mana"
}

GearUnstableCastersGauntlet: {
	Title: "Unstable Caster's Gauntlet"
	Contents: "[c/E2735C:Weapon] Obtain Unstable Caster's Gauntlet. 320 magic damage, use time 20. Left Click to fire piercing needles. Right Click to summon a ring of sigils, each representing a primordial element. Hold Left Click with sigils available to consume random sigils, each unleashing an attack. Right Click again while the elemental ring is out to replace all empty slots with Warped... How to get it: Craft at Mythril/Orichalcum Anvil from 5 Luminite Bar, 5 Life Alloy, 5 Nebula Fragment"
	Tooltip: "[c/E2735C:Weapon] Unstable Caster's Gauntlet: 320 magic damage, use time 20"
}

GearUtensilPoker: {
	Title: "Utensil Poker"
	Contents: "[c/E2735C:Weapon] Obtain Utensil Poker. 333 rogue damage, use time 15. Fires utensils in bursts of three. Stealth strikes replace any utensil with a powerful butcher knife. 'Space chickens, that is all'. How to get it: Found in Treasure Bag (Moon Lord); Dropped by Moon Lord Core"
	Tooltip: "[c/E2735C:Weapon] Utensil Poker: 333 rogue damage, use time 15"
}

GearValediction: {
	Title: "Valediction"
	Contents: "[c/E2735C:Weapon] Obtain Valediction. 243 rogue damage, use time 17. Throws a homing reaper scythe. Stealth strikes spawn razorblade typhoons on enemy hits. How to get it: Dropped by Reaper Shark"
	Tooltip: "[c/E2735C:Weapon] Valediction: 243 rogue damage, use time 17"
}

GearVanishingPoint: {
	Title: "Vanishing Point"
	Contents: "[c/E2735C:Weapon] Obtain Vanishing Point. 240 melee damage, use time 45. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Botanic Piercer, 5 Luminite Bar, 5 Life Alloy, 5 Solar Fragment"
	Tooltip: "[c/E2735C:Weapon] Vanishing Point: 240 melee damage, use time 45"
}

GearVega: {
	Title: "Vega"
	Contents: "[c/E2735C:Weapon] Obtain Vega. 500 rogue damage, use time 20. Throws a spear that shatters into star fragments on impact and generates Starbursts. Stealth strikes conjure an image of Lyra to deal immense damage in an area. Right Click to consume 20 Starbursts and immediately perform a stealth strike, regardless of your current Stealth. This strike calls all... How to get it: Craft at Mythril/Orichalcum Anvil from 1 Profaned Partisan, 8 Lumenyl, 4 Ruinous Soul, 20 Exodium Cluster"
	Tooltip: "[c/E2735C:Weapon] Vega: 500 rogue damage, use time 20"
}

GearVenusianTrident: {
	Title: "Venusian Trident"
	Contents: "[c/E2735C:Weapon] Obtain Venusian Trident. 1150 magic damage, use time 65, 90 mana. Casts an infernal trident that erupts into a gigantic explosion of fire and magma shards. Always critically strikes, with critical strike chance increasing critical strike damage. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Inferno Fork, 2 Ruinous Soul, 1 Twisting Nether"
	Tooltip: "[c/E2735C:Weapon] Venusian Trident: 1150 magic damage, use time 65, 90 mana"
}

GearViridVanguard: {
	Title: "Virid Vanguard"
	Contents: "[c/E2735C:Weapon] Obtain Virid Vanguard. 55 summon damage, use time 24, 10 mana. Alternates between summoning axes and swords, both laced with a powerful poison. Axes orbit the player, dealing high damage at a close range. Swords chase down enemies with extreme precision, tearing them to shreds. All weapons inflict Sage Poison, which becomes more powerful the more weapons are... How to get it: Craft at Mythril/Orichalcum Anvil from 1 Igneous Exaltation, 1 Viral Sprout, 12 Uelibloom Bar"
	Tooltip: "[c/E2735C:Weapon] Virid Vanguard: 55 summon damage, use time 24, 10 mana"
}

GearViscera: {
	Title: "Viscera"
	Contents: "[c/E2735C:Weapon] Obtain Viscera. 229 magic damage, use time 7, 18 mana. Fires a rapid barrage of piercing blood beams. The first enemy struck by each beam will burst into blood orbs. Picking up these blood orbs reduces the duration of Potion Sickness. Each successive beam in the barrage deals more damage. The last beam of the barrage instead explodes upon hitting an... How to get it: Craft at Mythril/Orichalcum Anvil from 25 Bloodstone, 10 Blood Orb"
	Tooltip: "[c/E2735C:Weapon] Viscera: 229 magic damage, use time 7, 18 mana"
}

GearVitriolicViper: {
	Title: "Vitriolic Viper"
	Contents: "[c/E2735C:Weapon] Obtain Vitriolic Viper. 2626 magic damage, use time 16, 60 mana. Charges up and fires a slithering beam of radiation. If fully charged, instead fires a huge spread of short range fangs. How to get it: Found in Treasure Bag (The Old Duke); Dropped by The Old Duke"
	Tooltip: "[c/E2735C:Weapon] Vitriolic Viper: 2626 magic damage, use time 16, 60 mana"
}

GearVoidConcentrationStaff: {
	Title: "Void Concentration Staff"
	Contents: "[c/E2735C:Weapon] Obtain Void Concentration Staff. 200 summon damage, use time 24, 10 mana. Summons an endless darkness that surrounds you with orbiting dark energies. While the dark energies are orbiting you, you take 15% less damage from all attacks. Right Click to condense the energy onto a target, focusing your minions on them and creating homing beams. When the focused enemy takes... How to get it: Found in Treasure Bag (Ceaseless Void); Dropped by Ceaseless Void"
	Tooltip: "[c/E2735C:Weapon] Void Concentration Staff: 200 summon damage, use time 24, 10 mana"
}

GearVoidEdge: {
	Title: "Void Edge"
	Contents: "[c/E2735C:Weapon] Obtain Void Edge. 210 melee damage, use time 24. Fires the ghastly souls of long-deceased abyss dwellers. Striking with the blade summons additional souls from below. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Hellfire Flamberge, 15 Necroplasm, 3 Ruinous Soul"
	Tooltip: "[c/E2735C:Weapon] Void Edge: 210 melee damage, use time 24"
}

GearVolterion: {
	Title: "Volterion"
	Contents: "[c/E2735C:Weapon] Obtain Volterion. 890 magic damage, use time 80, 90 mana. Discharges a high-voltage stream which bursts into 5 balls of lightning on hit. Each ball lightning emits two additional lightning bolts before exploding. How to get it: Found in Treasure Bag (Storm Weaver); Dropped by Storm Weaver"
	Tooltip: "[c/E2735C:Weapon] Volterion: 890 magic damage, use time 80, 90 mana"
}

GearVortexpopper: {
	Title: "Vortexpopper"
	Contents: "[c/E2735C:Weapon] Obtain Vortexpopper. 30 ranged damage, use time 21. Fires bubbles everywhere that pop into bullets. How to get it: Craft at Ancient Manipulator from 1 Xenopopper, 12 Vortex Fragment"
	Tooltip: "[c/E2735C:Weapon] Vortexpopper: 30 ranged damage, use time 21"
}

GearPhalanxSurge: {
	Title: "W-LSR: Phalanx Surge"
	Contents: "[c/E2735C:Weapon] Obtain W-LSR: Phalanx Surge. 175 ranged damage, use time 30. Fires a spread of lasers. Holding Right Click charges the weapon, allowing it to thrust forward and impale enemies with an energy spear. Holding Left Click when firing the charge attack will launch you forward at high speeds and deal extra damage. Using the charged attack has a short cooldown. 'T... How to get it: Craft at Mythril/Orichalcum Anvil from 15 Mysterious Circuitry, 15 Dubious Plating, 8 Uelibloom Bar, 4 Luminite Bar"
	Tooltip: "[c/E2735C:Weapon] W-LSR: Phalanx Surge: 175 ranged damage, use time 30"
}

GearWarloksMoonFist: {
	Title: "Warloks' Moon Fist"
	Contents: "[c/E2735C:Weapon] Obtain Warloks' Moon Fist. 450 summon damage, use time 24, 10 mana. Summons a celestial fist to punch enemies for you. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Golem Fist, 8 Lumenyl, 4 Ruinous Soul, 20 Exodium Cluster"
	Tooltip: "[c/E2735C:Weapon] Warloks' Moon Fist: 450 summon damage, use time 24, 10 mana"
}

GearWavePounder: {
	Title: "Wave Pounder"
	Contents: "[c/E2735C:Weapon] Obtain Wave Pounder. 75 rogue damage, use time 56. Throws a bomb which explodes into a agonizingly forceful shockwave. Stealth strikes emit absurdly powerful shockwaves. How to get it: Craft at Mythril/Orichalcum Anvil from 12 Mysterious Circuitry, 18 Dubious Plating, 8 Uelibloom Bar, 4 Luminite Bar"
	Tooltip: "[c/E2735C:Weapon] Wave Pounder: 75 rogue damage, use time 56"
}

GearPulseRifle: {
	Title: "A-PLS: Pulse Rifle"
	Contents: "[c/E2735C:Weapon] Obtain A-PLS: Pulse Rifle. 530 ranged damage, use time 55. Fires an enhanced pulse beam that dissipates into 4 high-frequency pulse orbs on hit. Pulse orbs aggressively track nearby targets and track faster the more they hit. Pulse orb pierce will not decrease when killing enemies or dealing low damage. 'My own personal weapon, used to stamp out failed c... How to get it: Craft at Cosmic Anvil from 20 Mysterious Circuitry, 20 Dubious Plating, 8 Cosmilite Bar, 2 Ascendant Spirit Essence; Dropped by Draedon"
	Tooltip: "[c/E2735C:Weapon] A-PLS: Pulse Rifle: 530 ranged damage, use time 55"
}

GearAcesHigh: {
	Title: "Ace's High"
	Contents: "[c/E2735C:Weapon] Obtain Ace's High. 325 ranged damage, use time 3. Fires a string of cards with varying effects based on card type. Hearts grant lifesteal. Spades pierce enemies. Diamonds violently explode. Clubs split into three. How to get it: Craft at Cosmic Anvil from 1 Revolver, 1 Claret Cannon, 1 Fantasy Talisman, 5 Auric Bar"
	Tooltip: "[c/E2735C:Weapon] Ace's High: 325 ranged damage, use time 3"
}

GearAetherfluxCannon: {
	Title: "Aetherflux Cannon"
	Contents: "[c/E2735C:Weapon] Obtain Aetherflux Cannon. 315 magic damage, use time 36, 7 mana. Fires a focused photon helix that phases through everything. How to get it: Craft at Cosmic Anvil from 1 Nano Purge, 5 Auric Bar, 12 Uelibloom Bar, 8 Divine Geode"
	Tooltip: "[c/E2735C:Weapon] Aetherflux Cannon: 315 magic damage, use time 36, 7 mana"
}

GearAlluvion: {
	Title: "Alluvion"
	Contents: "[c/E2735C:Weapon] Obtain Alluvion. 96 ranged damage, use time 15. Unleashes a torrent of six arrows at once. Converts wooden arrows into a combination of sharks, torrential and typhoon arrows. How to get it: Craft at Cosmic Anvil from 1 Monsoon, 8 Cosmilite Bar, 20 Endothermic Energy, 20 Lumenyl"
	Tooltip: "[c/E2735C:Weapon] Alluvion: 96 ranged damage, use time 15"
}

GearAntiMaterielRifle: {
	Title: "Anti-materiel Rifle"
	Contents: "[c/E2735C:Weapon] Obtain Anti-materiel Rifle. 1818 ranged damage, use time 60. Converts musket balls into .50 caliber sniper rounds that rip apart enemy defense and cause enemies to become Marked for Death. Unleashes a second swarm of bullets on hit, with additional bullets on critical strikes. How to get it: Craft at Cosmic Anvil from 1 Shroomer, 8 Cosmilite Bar, 20 Nightmare Fuel"
	Tooltip: "[c/E2735C:Weapon] Anti-materiel Rifle: 1818 ranged damage, use time 60"
}

GearAresExoskeleton: {
	Title: "Ares' Exoskeleton"
	Contents: "[c/E2735C:Weapon] Obtain Ares' Exoskeleton. 550 summon damage, use time 24, 80 mana. Creates a panel with four slots and four choices above it: Plasma, Tesla, Laser, and Gauss. Clicking one of the choices and then clicking one of the slots summons a cannon of that type. Clicking on a slot that's already occupied destroys its associated cannon and clears the slot. How to get it: Found in Treasure Box (Exo Mechs); Dropped by XF-09 Ares"
	Tooltip: "[c/E2735C:Weapon] Ares' Exoskeleton: 550 summon damage, use time 24, 80 mana"
}

GearArkoftheCosmos: {
	Title: "Ark of the Cosmos"
	Contents: "[c/E2735C:Weapon] Obtain Ark of the Cosmos. 1700 melee damage, use time 15. The physical culmination of your journey, capable of rending gods asunder. How to get it: Craft at Cosmic Anvil from 1 Galaxia, 1 Ark of the Elements, 5 Auric Bar"
	Tooltip: "[c/E2735C:Weapon] Ark of the Cosmos: 1700 melee damage, use time 15"
}

GearAtaraxia: {
	Title: "Ataraxia"
	Contents: "[c/E2735C:Weapon] Obtain Ataraxia. 325 melee damage, use time 10. Equanimity. How to get it: Craft at Cosmic Anvil from 1 Broken Hero Sword, 5 Auric Bar, 8 Cosmilite Bar, 2 Ascendant Spirit Essence"
	Tooltip: "[c/E2735C:Weapon] Ataraxia: 325 melee damage, use time 10"
}

GearAtlasMunitionsBeacon: {
	Title: "Atlas Munitions Beacon"
	Contents: "[c/E2735C:Weapon] Obtain Atlas Munitions Beacon. 200 summon damage, use time 30, 10 mana. Summons a sentry. Brings forth an exo-powered, stationary cannon. The cannon will fire at enemies within its range. If an enemy is in close proximity, it will enter Overdrive. When in Overdrive the cannon uses its full power to bring down any foe. While in Overdrive, the cannon will build up heat... How to get it: Found in Treasure Box (Exo Mechs); Dropped by XF-09 Ares"
	Tooltip: "[c/E2735C:Weapon] Atlas Munitions Beacon: 200 summon damage, use time 30, 10 mana"
}

GearCelestus: {
	Title: "Celestus"
	Contents: "[c/E2735C:Weapon] Obtain Celestus. 280 rogue damage, use time 22. Throws a high-velocity scythe that splits into multiple phantom scythes on enemy hits. Stealth strikes reverse direction and home in on enemies after returning to the player. Struck enemies are decimated by Miracle Blight. How to get it: Craft at Draedons Forge from 1 Rebounding Rainbow, 1 Molten Amputator, 1 Subduction Slicer, 1 Enchanted Axe, 1 Miracle Matter"
	Tooltip: "[c/E2735C:Weapon] Celestus: 280 rogue damage, use time 22"
}

GearChickenCannon: {
	Title: "Chicken Cannon"
	Contents: "[c/E2735C:Weapon] Obtain Chicken Cannon. 277 ranged damage, use time 30. Fires chicken flares which create enormous Dragonfire explosions. How to get it: Found in Treasure Cache (Yharon); Dropped by Yharon, Dragon of Rebirth"
	Tooltip: "[c/E2735C:Weapon] Chicken Cannon: 277 ranged damage, use time 30"
}

GearCindersOfLament: {
	Title: "Cinders of Lament"
	Contents: "[c/E2735C:Weapon] Obtain Cinders of Lament. 1666 summon damage, use time 80, 10 mana. Summons either Cataclysm or Catastrophe at the mouse position. They will look at you for a moment before charging at you. They can do damage to both you and enemies. How to get it: Enchant Entropy's Vigil at Calamitas' Brimstone altar"
	Tooltip: "[c/E2735C:Weapon] Cinders of Lament: 1666 summon damage, use time 80, 10 mana"
}

GearCleansingBlaze: {
	Title: "Cleansing Blaze"
	Contents: "[c/E2735C:Weapon] Obtain Cleansing Blaze. 275 ranged damage, use time 3. Unleashes a torrent of God Slayer Inferno which can pass through tiles. Uses gel for ammo. How to get it: Craft at Cosmic Anvil from 10 Cosmilite Bar"
	Tooltip: "[c/E2735C:Weapon] Cleansing Blaze: 275 ranged damage, use time 3"
}

GearCondemnation: {
	Title: "Condemnation"
	Contents: "[c/E2735C:Weapon] Obtain Condemnation. 2130 ranged damage, use time 22. Fires powerful scarlet bolts suffused with hateful magics. Hold Left Click to load up to nine bolts for powerful burst fire. How to get it: Found in Treasure Coffer (Calamitas); Dropped by Supreme Witch, Calamitas"
	Tooltip: "[c/E2735C:Weapon] Condemnation: 2130 ranged damage, use time 22"
}

GearCorvidHarbringerStaff: {
	Title: "Corvid Harbinger Staff"
	Contents: "[c/E2735C:Weapon] Obtain Corvid Harbinger Staff. 99 summon damage, use time 24, 10 mana. Summons a powerful raven which teleports and dashes. 'Nevermore'. How to get it: Craft at Cosmic Anvil from 1 Raven Staff, 8 Cosmilite Bar, 20 Nightmare Fuel"
	Tooltip: "[c/E2735C:Weapon] Corvid Harbinger Staff: 99 summon damage, use time 24, 10 mana"
}

GearCosmicDischarge: {
	Title: "Cosmic Discharge"
	Contents: "[c/E2735C:Weapon] Obtain Cosmic Discharge. 450 melee damage, use time 15. Striking an enemy with the whip causes glacial explosions that grant the player the Cosmic Freeze buff. Cosmic Freeze gives the player +2 HP/s life regen while standing still and freezes enemies near the player. How to get it: Found in Treasure Bag (The Devourer of Gods); Dropped by The Devourer of Gods"
	Tooltip: "[c/E2735C:Weapon] Cosmic Discharge: 450 melee damage, use time 15"
}

GearCosmicImmaterializer: {
	Title: "Cosmic Immaterializer"
	Contents: "[c/E2735C:Weapon] Obtain Cosmic Immaterializer. 560 summon damage, use time 24, 10 mana. Summons a cosmic energy spiral to fight for you. The spiral will fire swarms of homing energy bolts when enemies are detected by it. Struck enemies are cleansed by Miracle Blight. There can only be one energy spiral. How to get it: Craft at Draedons Forge from 1 Legion of Celestia, 1 Ethereal Subjugator, 1 Cosmilamp, 1 Calamari's Lament, 1 Miracle Matter"
	Tooltip: "[c/E2735C:Weapon] Cosmic Immaterializer: 560 summon damage, use time 24, 10 mana"
}

GearCosmicShiv: {
	Title: "Cosmic Shiv"
	Contents: "[c/E2735C:Weapon] Obtain Cosmic Shiv. 155 melee damage, use time 30. Fires a cosmic star that homes in on enemies. Upon hitting an enemy, a barrage of blades will persistently strike. Landing more stars causes more blades to strike. How to get it: Craft at Cosmic Anvil from 1 Lightspeed, 10 Cosmilite Bar"
	Tooltip: "[c/E2735C:Weapon] Cosmic Shiv: 155 melee damage, use time 30"
}

GearCosmicViperEngine: {
	Title: "Cosmic Viper Engine"
	Contents: "[c/E2735C:Weapon] Obtain Cosmic Viper Engine. 255 summon damage, use time 24, 10 mana. Summons a cosmic gunship to shoot down your foes. Gunships will fire bullets from your inventory. Alternates firing rockets and bullets. 50% chance to save ammo. Rockets do not consume ammo. How to get it: Craft at Cosmic Anvil from 1 Tactical Plague Engine, 10 Cosmilite Bar"
	Tooltip: "[c/E2735C:Weapon] Cosmic Viper Engine: 255 summon damage, use time 24, 10 mana"
}

GearDevilsDevastation: {
	Title: "Devil's Devastation"
	Contents: "[c/E2735C:Weapon] Obtain Devil's Devastation. 333 melee damage, use time 45. Throw a demonic blade that impales, immolates, and slows enemies. Up to five blades can impale an enemy at a time, with further hits launching the previous impaled blades. Press Right Click to enter a stance where you can use Left Click to perform a colossal, devastating slash. While in the stanc... How to get it: Craft at Cosmic Anvil from 1 Exalted Oathblade, 8 Cosmilite Bar, 20 Nightmare Fuel"
	Tooltip: "[c/E2735C:Weapon] Devil's Devastation: 333 melee damage, use time 45"
}

GearDimensionTearingDisk: {
	Title: "Dimension-Tearing Disk"
	Contents: "[c/E2735C:Weapon] Obtain Dimension-Tearing Disk. 725 rogue damage, use time 27. Throws a disk that tears space in the direction of the nearest enemy. Stealth strikes stick to enemies and unleash God's Bane Doombeam Array. How to get it: Found in Treasure Bag (The Devourer of Gods); Dropped by The Devourer of Gods"
	Tooltip: "[c/E2735C:Weapon] Dimension-Tearing Disk: 725 rogue damage, use time 27"
}

GearDragonPow: {
	Title: "Dragon Pow"
	Contents: "[c/E2735C:Weapon] Obtain Dragon Pow. 333 melee damage, use time 20. Fires a dragon head that releases Dragonfire sparks. Summons a barrage of petals and waterfalls on enemy hits. How to get it: Craft at Cosmic Anvil from 1 Mourningstar, 1 Dao of Pow, 1 Flower Pow, 1 Flairon, 1 Ball O' Fugu, 1 Tumbleweed, 5 Auric Bar, 4 Yharon Soul Fragment"
	Tooltip: "[c/E2735C:Weapon] Dragon Pow: 333 melee damage, use time 20"
}

GearDragonRage: {
	Title: "Dragon Rage"
	Contents: "[c/E2735C:Weapon] Obtain Dragon Rage. 888 melee damage, use time 25. Twirls a baton that causes explosions of Dragonfire on enemy hits. Once every two seconds, hits summon a ring of fireballs that target the enemy with the most health. How to get it: Found in Treasure Cache (Yharon); Dropped by Yharon, Dragon of Rebirth"
	Tooltip: "[c/E2735C:Weapon] Dragon Rage: 888 melee damage, use time 25"
}

GearDragonsBreath: {
	Title: "Dragon's Breath"
	Contents: "[c/E2735C:Weapon] Obtain Dragon's Breath. 328 ranged damage, use time 30. Fires intense blasts of Dragonfire at an accelerating pace. Upon firing for long enough, you will begin using a cartridge of energy. While using a cartridge you will shoot a draconic beam of pure Dragonfire that doesn't consume ammo. Once a cartridge has been ejected you will return to the origin... How to get it: Found in Treasure Cache (Yharon); Dropped by Yharon, Dragon of Rebirth"
	Tooltip: "[c/E2735C:Weapon] Dragon's Breath: 328 ranged damage, use time 30"
}

GearDrataliornus: {
	Title: "Drataliornus"
	Contents: "[c/E2735C:Weapon] Obtain Drataliornus. 129 ranged damage, use time 12. Fires an escalating stream of Dragonfire arrows. Fireballs rain meteors, leave dragon dust trails, and launch additional bolts at max speed. Taking damage while firing the stream will interrupt it and reduce your wing flight time. Press Right Click to fire two devastating barrages of five empower... How to get it: Craft at Cosmic Anvil from 1 Blossom Flux, 5 Auric Bar, 4 Yharon Soul Fragment, 12 Effulgent Feather"
	Tooltip: "[c/E2735C:Weapon] Drataliornus: 129 ranged damage, use time 12"
}

GearDynamicPursuer: {
	Title: "Dynamic Pursuer"
	Contents: "[c/E2735C:Weapon] Obtain Dynamic Pursuer. 2000 rogue damage, use time 42. Throws a calculation-processing disk that fires electricity at enemies. Stealth strikes allows the disk to ricochet to other targets, fire lasers, and unleash an explosion. If the disk cannot find a new target to ricochet to, it will pursue the original target instead. How to get it: Craft at Cosmic Anvil from 1 Dimension-Tearing Disk, 1 P-LSR: Aerial Tracker, 5 Auric Bar"
	Tooltip: "[c/E2735C:Weapon] Dynamic Pursuer: 2000 rogue damage, use time 42"
}

GearEclipsesFall: {
	Title: "Eclipse's Fall"
	Contents: "[c/E2735C:Weapon] Obtain Eclipse's Fall. 700 rogue damage, use time 24. Throws a javelin that shatters into fragments of primordial light upon enemy hits. If more than 20 fragments exist, the oldest fragments will seek out enemies to attack. Stealth strikes coalesce fragments into Spear of Obscuration, gaining power based on the number of fragments. Spear of Obscurat... How to get it: Craft at Cosmic Anvil from 1 Vega, 5 Auric Bar, 15 Darksun Fragment"
	Tooltip: "[c/E2735C:Weapon] Eclipse's Fall: 700 rogue damage, use time 24"
}

GearEndoHydraStaff: {
	Title: "Endo Hydra Staff"
	Contents: "[c/E2735C:Weapon] Obtain Endo Hydra Staff. 190 summon damage, use time 24, 10 mana. Summons a frigid endothermic entity with one head. If the entity already exists, using this item again will cause it to gain more heads. How to get it: Craft at Cosmic Anvil from 1 Staffofthe Frost Hydra, 8 Cosmilite Bar, 20 Endothermic Energy"
	Tooltip: "[c/E2735C:Weapon] Endo Hydra Staff: 190 summon damage, use time 24, 10 mana"
}

GearEssenceFlayer: {
	Title: "Essence Flayer"
	Contents: "[c/E2735C:Weapon] Obtain Essence Flayer. 220 melee damage, use time 19. Shoots an essence scythe that generates healing spirits on enemy kills. How to get it: Craft at Cosmic Anvil from 10 Cosmilite Bar"
	Tooltip: "[c/E2735C:Weapon] Essence Flayer: 220 melee damage, use time 19"
}

GearExecutionersBlade: {
	Title: "Executioner's Blade"
	Contents: "[c/E2735C:Weapon] Obtain Executioner's Blade. 165 rogue damage, use time 3. Throws a stream of homing blades. Stealth strikes summon a guillotine of blades on hit. How to get it: Craft at Cosmic Anvil from 10 Cosmilite Bar"
	Tooltip: "[c/E2735C:Weapon] Executioner's Blade: 165 rogue damage, use time 3"
}

GearExoblade: {
	Title: "Exoblade"
	Contents: "[c/E2735C:Weapon] Obtain Exoblade. 915 melee damage, use time 49. Press Left Click to release multiple energy beams that home in on enemies and slice them on hit. Press Right Click to dash in the direction of the cursor with the blade. Enemy hits from the blade during the dash result in massive damage and a rebound. Press Left Click immediately after a rebound... How to get it: Craft at Draedons Forge from 1 Terratomere, 1 Lightspeed, 1 Entropic Claymore, 1 Flarefrost Blade, 1 Miracle Matter"
	Tooltip: "[c/E2735C:Weapon] Exoblade: 915 melee damage, use time 49"
}

GearFaceMelter: {
	Title: "Face Melter"
	Contents: "[c/E2735C:Weapon] Obtain Face Melter. 130 magic damage, use time 10, 14 mana. Fires music notes. Press Right Click to summon an amplifier that shoots towards your mouse. 'WOOO!! FAAAAAAANTASYY WORLDDDDD!'. How to get it: Craft at Cosmic Anvil from 1 The Axe, 1 Sparkle Guitar, 8 Cosmilite Bar, 20 Nightmare Fuel"
	Tooltip: "[c/E2735C:Weapon] Face Melter: 130 magic damage, use time 10, 14 mana"
}

GearGalaxySmasher: {
	Title: "Galaxy Smasher"
	Contents: "[c/E2735C:Weapon] Obtain Galaxy Smasher. 1100 melee damage, use time 48. Throws a heavy, gravity-affected hammer that will return to you after striking an enemy. Consecutive hits summon more and more cosmic shards. After hitting eight times, the hammer supercharges itself with galactic energies, delivering an apocalyptic strike that reverberates through space and time. How to get it: Craft at Cosmic Anvil from 1 Stellar Contempt, 10 Cosmilite Bar"
	Tooltip: "[c/E2735C:Weapon] Galaxy Smasher: 1100 melee damage, use time 48"
}

GearGodsParanoia: {
	Title: "Gods' Paranoia"
	Contents: "[c/E2735C:Weapon] Obtain Gods' Paranoia. 163 rogue damage, use time 29. Hurls homing spiky balls which attach to enemies. Attached spiky balls summon a localized storm of god slayer kunai on each hit. Stealth strikes home in faster and hit at a faster rate. How to get it: Craft at Cosmic Anvil from 10 Cosmilite Bar"
	Tooltip: "[c/E2735C:Weapon] Gods' Paranoia: 163 rogue damage, use time 29"
}

GearGruesomeEminence: {
	Title: "Gruesome Eminence"
	Contents: "[c/E2735C:Weapon] Obtain Gruesome Eminence. 666 magic damage, use time 27, 30 mana. Summons a gaseous conglomeration of spirits near the cursor that fly around wildly. Over time, the spirits accumulate to create a single, controllable monstrosity. How to get it: Enchant Ghastly Visage at Calamitas' Brimstone altar"
	Tooltip: "[c/E2735C:Weapon] Gruesome Eminence: 666 magic damage, use time 27, 30 mana"
}

GearHeavenlyGale: {
	Title: "Heavenly Gale"
	Contents: "[c/E2735C:Weapon] Obtain Heavenly Gale. 256 ranged damage, use time 40. Fires a rapid stream of supercharged exo-crystals. Holding the bow and waiting for some time before firing causes the crystals to become more powerful. If the crystals are sufficiently powerful enough they will summon torrents of exo-lightning above whatever target they hit. Enemies struck with E... How to get it: Craft at Draedons Forge from 1 Planetary Annihilation, 1 Telluric Glare, 1 Clockwork Bow, 1 The Ballista, 1 Miracle Matter"
	Tooltip: "[c/E2735C:Weapon] Heavenly Gale: 256 ranged damage, use time 40"
}

GearHeliumFlash: {
	Title: "Helium Flash"
	Contents: "[c/E2735C:Weapon] Obtain Helium Flash. 3200 magic damage, use time 17, 120 mana. Launches volatile star cores which erupt into colossal fusion blasts. Always critically strikes, with critical strike chance increasing critical strike damage. 'The power of a galaxy, if only for mere moments'. How to get it: Craft at Cosmic Anvil from 1 Venusian Trident, 1 Forbidden Sun, 5 Auric Bar, 10 Solar Fragment, 5 Nebula Fragment"
	Tooltip: "[c/E2735C:Weapon] Helium Flash: 3200 magic damage, use time 17, 120 mana"
}

GearHeresy: {
	Title: "Heresy"
	Contents: "[c/E2735C:Weapon] Obtain Heresy. 960 magic damage, use time 120, 15 mana. Releases fire and souls upward from a held book. As the book is held the power of both increases. How to get it: Found in Treasure Coffer (Calamitas); Dropped by Supreme Witch, Calamitas"
	Tooltip: "[c/E2735C:Weapon] Heresy: 960 magic damage, use time 120, 15 mana"
}

GearHyperdeathRiftScepter: {
	Title: "Hyperdeath Rift Scepter"
	Contents: "[c/E2735C:Weapon] Obtain Hyperdeath Rift Scepter. 4100 magic damage, use time 50, 50 mana. Tears space in two with Hyperdeath Rift Ripper. How to get it: Found in Treasure Bag (The Devourer of Gods); Dropped by The Devourer of Gods"
	Tooltip: "[c/E2735C:Weapon] Hyperdeath Rift Scepter: 4100 magic damage, use time 50, 50 mana"
}

GearHypothermia: {
	Title: "Hypothermia"
	Contents: "[c/E2735C:Weapon] Obtain Hypothermia. 148 rogue damage, use time 4. Throws a constant barrage of black ice shards. Stealth strikes hurl a set of razor sharp ice chunks that shatter on impact. How to get it: Craft at Cosmic Anvil from 8 Cosmilite Bar, 20 Endothermic Energy, 6 Ruinous Soul"
	Tooltip: "[c/E2735C:Weapon] Hypothermia: 148 rogue damage, use time 4"
}

GearIceBarrage: {
	Title: "Ice Barrage"
	Contents: "[c/E2735C:Weapon] Obtain Ice Barrage. 2250 magic damage, use time 300, 300 mana. Casts a deadly and powerful ice spell in the location of the cursor. This ice spell locks itself to the position of nearby enemies. Consumes 2 Blood Runes every time it's used. 'Oh dear, you are dead!'. How to get it: Craft at Cosmic Anvil from 1 Blizzard Staff, 1 Ice Rod, 1 Icicle Staff, 8 Cosmilite Bar, 40 Endothermic Energy; Sold by Archmage"
	Tooltip: "[c/E2735C:Weapon] Ice Barrage: 2250 magic damage, use time 300, 300 mana"
}

GearInfinity: {
	Title: "Infinity"
	Contents: "[c/E2735C:Weapon] Obtain Infinity. 75 ranged damage, use time 1. Fires a twin stream of energy bolts that split. Ignores 20 points of enemy Defense. 80% chance to not consume ammo. 'They say infinity is neverending, yet you hold it in your hands'. How to get it: Craft at Cosmic Anvil from 1 Shredder, 8 Cosmilite Bar, 20 Nightmare Fuel"
	Tooltip: "[c/E2735C:Weapon] Infinity: 75 ranged damage, use time 1"
}

GearKarasawa: {
	Title: "Karasawa"
	Contents: "[c/E2735C:Weapon] Obtain Karasawa. 2400 ranged damage, use time 52. ...This is heavy... too heavy. How to get it: Craft at Cosmic Anvil from 1 Large Ruby, 15 Mysterious Circuitry, 25 Dubious Plating, 8 Cosmilite Bar, 20 Nightmare Fuel"
	Tooltip: "[c/E2735C:Weapon] Karasawa: 2400 ranged damage, use time 52"
}

GearKingsbane: {
	Title: "Kingsbane"
	Contents: "[c/E2735C:Weapon] Obtain Kingsbane. 249 ranged damage, use time 3. After revving up, rapidly fire bullets. When you stop firing you will release a barrage of auric bullets. Auric bullets aggressively home in on enemies, ignore 50 points of defense, and inflict Auric Rebuke. Constantly consumes ammo while in use. 95% chance to not consume ammo. How to get it: Craft at Cosmic Anvil from 1 Chain Gun, 1 P90, 5 Auric Bar, 3 Life Alloy"
	Tooltip: "[c/E2735C:Weapon] Kingsbane: 249 ranged damage, use time 3"
}

GearLightGodsBrilliance: {
	Title: "Light God's Brilliance"
	Contents: "[c/E2735C:Weapon] Obtain Light God's Brilliance. 111 magic damage, use time 6, 6 mana. Casts small, homing light beads along with explosive light balls. How to get it: Craft at Bookcase from 1 Shadecrystal Barrage, 1 Abyssal Tome, 10 Holy Water, 8 Cosmilite Bar, 20 Nightmare Fuel, 5 Effulgent Feather, 30 Soul of Light"
	Tooltip: "[c/E2735C:Weapon] Light God's Brilliance: 111 magic damage, use time 6, 6 mana"
}

GearLiliesOfFinality: {
	Title: "Lilies of Finality"
	Contents: "[c/E2735C:Weapon] Obtain Lilies of Finality. 512 summon damage, use time 24, 10 mana. Can only be summoned once. 'Wake up'. How to get it: Obtained by breaking Lilies Of Finality"
	Tooltip: "[c/E2735C:Weapon] Lilies of Finality: 512 summon damage, use time 24, 10 mana"
}

GearMagnomalyCannon: {
	Title: "Magnomaly Cannon"
	Contents: "[c/E2735C:Weapon] Obtain Magnomaly Cannon. 279 ranged damage, use time 15. Launches a powerful exo rocket to nuke anything and everything with Miracle Blight. Rockets are surrounded by an invisible damaging aura and split into damaging beams on hit. 50% chance to not consume ammo. How to get it: Craft at Draedons Forge from 1 The Pack, 1 Scorched Earth, 1 Electrosphere Launcher, 1 Miracle Matter"
	Tooltip: "[c/E2735C:Weapon] Magnomaly Cannon: 279 ranged damage, use time 15"
}

GearMawOfInfinity: {
	Title: "Maw of Infinity"
	Contents: "[c/E2735C:Weapon] Obtain Maw of Infinity. 2080 melee damage, use time 33. Swings a blade forged from the Devourer's maw in a 3-swing combo. The first swing only hits close range. The second swing additionally launches Faith Incinerator. The third swing unleashes Divinity Devourer at your cursor, exploding for massive damage. How to get it: Found in Treasure Bag (The Devourer of Gods); Dropped by The Devourer of Gods"
	Tooltip: "[c/E2735C:Weapon] Maw of Infinity: 2080 melee damage, use time 33"
}

GearMetastasis: {
	Title: "Metastasis"
	Contents: "[c/E2735C:Weapon] Obtain Metastasis. 400 summon damage, use time 24, 10 mana. Summons a Sepulcher to fight for you. While the Sepulcher is active, brimstone hearts will begin to appear and orbit you. When too many hearts are present, it will interrupt attacking to attack the hearts instead. This happens more frequently depending on how many hearts are present. Can only be... How to get it: Enchant Void Eater Marionette at Calamitas' Brimstone altar"
	Tooltip: "[c/E2735C:Weapon] Metastasis: 400 summon damage, use time 24, 10 mana"
}

GearMidnightSunBeacon: {
	Title: "Midnight Sun Beacon"
	Contents: "[c/E2735C:Weapon] Obtain Midnight Sun Beacon. 176 summon damage, use time 24, 10 mana. Summons a UFO to vaporize enemies. How to get it: Craft at Cosmic Anvil from 1 Xeno Staff, 5 Auric Bar, 15 Darksun Fragment"
	Tooltip: "[c/E2735C:Weapon] Midnight Sun Beacon: 176 summon damage, use time 24, 10 mana"
}

GearMirrorofKalandra: {
	Title: "Mirror of Kalandra"
	Contents: "[c/E2735C:Weapon] Obtain Mirror of Kalandra. 256 summon damage, use time 24, 10 mana. Summons five ancient weapons to annihilate your enemies. There can only be one of each individual weapon. Atziri's Disfavor brutally cleaves through enemies. Starforge rips through foes and occasionally induces cosmic explosions. Paradoxica teleports to enemies and blitzes through them at high sp... How to get it: Craft by hand from 1 Magic Mirror, 8 Cosmilite Bar, 10 Divine Geode (+1 alternative recipe)"
	Tooltip: "[c/E2735C:Weapon] Mirror of Kalandra: 256 summon damage, use time 24, 10 mana"
}

GearMurasama: {
	Title: "Murasama"
	Contents: "[c/E2735C:Weapon] Obtain Murasama. 2200 melee damage, use time 5. A high-frequency blade that can cleanly slice through even the mightiest foe. Every third swing deals immense damage. Prove your worth by slaying The Devourer of Gods to unsheath this sword. 'There will be blood!'. How to get it: Found in Draedon Structures chests"
	Tooltip: "[c/E2735C:Weapon] Murasama: 2200 melee damage, use time 5"
}

GearNadir: {
	Title: "Nadir"
	Contents: "[c/E2735C:Weapon] Obtain Nadir. 365 melee damage, use time 18. Fires void essences which flay nearby enemies with tentacles. 'The abyss has stared back at you long enough. It now speaks, and it does not speak softly'. How to get it: Craft at Cosmic Anvil from 1 Vanishing Point, 5 Auric Bar, 8 Darksun Fragment, 5 Twisting Nether"
	Tooltip: "[c/E2735C:Weapon] Nadir: 365 melee damage, use time 18"
}

GearNebulousCataclysm: {
	Title: "Nebulous Cataclysm"
	Contents: "[c/E2735C:Weapon] Obtain Nebulous Cataclysm. 530 magic damage, use time 30, 120 mana. 'The true power of the Nebula Mage rests in your hands...'. How to get it: Craft at Cosmic Anvil from 1 Nebula Arcanum, 1 Nebula Blaze, 8 Cosmilite Bar, 20 Nightmare Fuel"
	Tooltip: "[c/E2735C:Weapon] Nebulous Cataclysm: 530 magic damage, use time 30, 120 mana"
}

GearNorfleet: {
	Title: "Norfleet"
	Contents: "[c/E2735C:Weapon] Obtain Norfleet. 5678 ranged damage, use time 70. Fires a cluster of erratic energy spheres that each contain a different element. Every three shots the weapon must recharge its energy to reload. 'Blows up everything!'. How to get it: Craft at Cosmic Anvil from 1 Stellar Cannon, 8 Cosmilite Bar, 20 Darksun Fragment"
	Tooltip: "[c/E2735C:Weapon] Norfleet: 5678 ranged damage, use time 70"
}

GearOmicron: {
	Title: "Omicron"
	Contents: "[c/E2735C:Weapon] Obtain Omicron. 80 magic damage, use time 4, 15 mana. Fires a continuous array of lasers and spawns two Wingmen which orbit you and fire lasers at your cursor. Press Right Click when firing to shoot an Omicron Beam that splits upon hitting an enemy. After firing an Omicron Beam your Wingmen will launch a pair of grenades. Hitting an enemy with an Om... How to get it: Craft at Cosmic Anvil from 1 Genesis, 1 Wingman, 8 Cosmilite Bar, 20 Endothermic Energy"
	Tooltip: "[c/E2735C:Weapon] Omicron: 80 magic damage, use time 4, 15 mana"
}

GearOnyxia: {
	Title: "Onyxia"
	Contents: "[c/E2735C:Weapon] Obtain Onyxia. 90 ranged damage, use time 10. Fires a storm of bullets and onyx shards. 50% chance to not consume ammo. How to get it: Craft at Cosmic Anvil from 1 Onyx Chain Blaster, 8 Cosmilite Bar, 8 Darksun Fragment"
	Tooltip: "[c/E2735C:Weapon] Onyxia: 90 ranged damage, use time 10"
}

GearOrderbringer: {
	Title: "Orderbringer"
	Contents: "[c/E2735C:Weapon] Obtain Orderbringer. 700 melee damage, use time 16. Fires piercing energy waves and summons four homing stars near your cursor. Hits with the blade summon two beams from the sky. 'No matter where you may be you are never alone'. How to get it: Craft at Cosmic Anvil from 1 Greatsword of Judgement, 5 Auric Bar, 5 Life Alloy"
	Tooltip: "[c/E2735C:Weapon] Orderbringer: 700 melee damage, use time 16"
}

GearPenumbra: {
	Title: "Penumbra"
	Contents: "[c/E2735C:Weapon] Obtain Penumbra. 725 rogue damage, use time 35. Throws a shadow bomb that explodes into homing souls and flames. Stealth strikes make the bomb manifest on the cursor and explode into more souls. How to get it: Craft at Cosmic Anvil from 8 Cosmilite Bar, 20 Nightmare Fuel, 6 Ruinous Soul"
	Tooltip: "[c/E2735C:Weapon] Penumbra: 725 rogue damage, use time 35"
}

GearPerdition: {
	Title: "Perdition"
	Contents: "[c/E2735C:Weapon] Obtain Perdition. 375 summon damage, use time 30, 10 mana. Summons a sentry. Summons a beacon at the position of the mouse. When a target is manually selected via Right Click it releases torrents of souls from below onto the target. Only one beacon may exist at a time. How to get it: Found in Treasure Coffer (Calamitas); Dropped by Supreme Witch, Calamitas"
	Tooltip: "[c/E2735C:Weapon] Perdition: 375 summon damage, use time 30, 10 mana"
}

GearPhaseslayer: {
	Title: "Phaseslayer"
	Contents: "[c/E2735C:Weapon] Obtain Phaseslayer. 1350 melee damage, use time 24. Projects a colossal laser blade which is controlled by the cursor. Move the cursor to swing the blade and rip and tear through enemies. Faster swings deal more damage and release additional sword beams. How to get it: Craft at Cosmic Anvil from 15 Mysterious Circuitry, 25 Dubious Plating, 8 Cosmilite Bar, 2 Ascendant Spirit Essence"
	Tooltip: "[c/E2735C:Weapon] Phaseslayer: 1350 melee damage, use time 24"
}

GearPhoenixFlameBarrage: {
	Title: "Phoenix Flame Barrage"
	Contents: "[c/E2735C:Weapon] Obtain Phoenix Flame Barrage. 140 magic damage, use time 15, 40 mana. Casts a barrage of Dragonfire from the sky. 'Baptism by draconic fire'. How to get it: Found in Treasure Cache (Yharon); Dropped by Yharon, Dragon of Rebirth"
	Tooltip: "[c/E2735C:Weapon] Phoenix Flame Barrage: 140 magic damage, use time 15, 40 mana"
}

GearPhotonRipper: {
	Title: "Photon Ripper"
	Contents: "[c/E2735C:Weapon] Obtain Photon Ripper. 1400 melee damage, use time 5. Projects a directed stream of hardlight teeth at ultra high velocity. This weapon and its projectiles function as a chainsaw. Press Right Click to use without chopping down trees. How to get it: Found in Treasure Box (Exo Mechs); Dropped by XF-09 Ares"
	Tooltip: "[c/E2735C:Weapon] Photon Ripper: 1400 melee damage, use time 5"
}

GearPhotoviscerator: {
	Title: "Photoviscerator"
	Contents: "[c/E2735C:Weapon] Obtain Photoviscerator. 495 ranged damage, use time 10. Emits a continuous beam of Miracle Blight that disintegrates everything. Press Right Click to fire homing exo flares which stick to and incinerate enemies. Uses gel for ammo. The beam has a 95% chance to save ammo. How to get it: Craft at Draedons Forge from 1 Chromatic Eruption, 1 Halley's Inferno, 1 Dead Sun's Wind, 1 Miracle Matter"
	Tooltip: "[c/E2735C:Weapon] Photoviscerator: 495 ranged damage, use time 10"
}

GearPlasmaGrenade: {
	Title: "Plasma Grenade"
	Contents: "[c/E2735C:Weapon] Obtain Plasma Grenade. 860 rogue damage, use time 30. Throws a grenade that explodes into plasma on collision. Stealth strikes explode violently on collision into a vaporizing blast. 'Each grenade contains a heavily condensed and heated unit of plasma. Use with extreme caution.'. How to get it: Craft at Cosmic Anvil from 15 Mysterious Circuitry, 25 Dubious Plating, 8 Cosmilite Bar, 2 Ascendant Spirit Essence"
	Tooltip: "[c/E2735C:Weapon] Plasma Grenade: 860 rogue damage, use time 30"
}

GearPoleWarper: {
	Title: "Pole Warper"
	Contents: "[c/E2735C:Weapon] Obtain Pole Warper. 207 summon damage, use time 24, 12 mana. Summons a pair of floating magnets that repel each other and relentlessly swarm enemies. Magnetic devices which tear at foes by propelling themselves off their opposite counterparts. How to get it: Craft at Cosmic Anvil from 25 Mysterious Circuitry, 15 Dubious Plating, 8 Cosmilite Bar, 2 Ascendant Spirit Essence"
	Tooltip: "[c/E2735C:Weapon] Pole Warper: 207 summon damage, use time 24, 12 mana"
}

GearPrimordialAncient: {
	Title: "Primordial Ancient"
	Contents: "[c/E2735C:Weapon] Obtain Primordial Ancient. 3825 magic damage, use time 72, 104 mana. Casts five primordial sand blasts that converge at your cursor after a moment and create a giant explosion. Casting this spell at max mana while without mana sickness will cause it to give you and any player it hits the Aeolian Earth buff. How to get it: Craft at Bookcase from 1 Primordial Earth, 8 Cosmilite Bar, 20 Endothermic Energy"
	Tooltip: "[c/E2735C:Weapon] Primordial Ancient: 3825 magic damage, use time 72, 104 mana"
}

GearPrismaticBreaker: {
	Title: "Prismatic Breaker"
	Contents: "[c/E2735C:Weapon] Obtain Prismatic Breaker. 425 damage, use time 13. Fires several bursts of magic stars as the weapon charges up. After charging up, a massive rainbow laser is unleashed to devastate your foes. This weapon is boosted by both melee and ranged damage. Seems to belong to a certain magical girl. Radiates with intense cosmic energy. How to get it: Craft at Cosmic Anvil from 1 Cosmic Rainbow, 1 Solstice Claymore, 8 Cosmilite Bar, 20 Endothermic Energy"
	Tooltip: "[c/E2735C:Weapon] Prismatic Breaker: 425 damage, use time 13"
}

GearRancor: {
	Title: "Rancor"
	Contents: "[c/E2735C:Weapon] Obtain Rancor. 333 magic damage, use time 25, 25 mana. Casts a magic circle that charges energy and eventually releases a powerful laser burst of controlled maleficent magic. The laser causes arms and searing lava to appear on surfaces it touches. How to get it: Enchant Burning Sea at Calamitas' Brimstone altar"
	Tooltip: "[c/E2735C:Weapon] Rancor: 333 magic damage, use time 25, 25 mana"
}

GearRefractionRotor: {
	Title: "Refraction Rotor"
	Contents: "[c/E2735C:Weapon] Obtain Refraction Rotor. 240 rogue damage, use time 40. Throws a huge prismatic shuriken. The shuriken shatters moments after impact into homing blades. Stealth strikes throw 3 shurikens that rapidly home on enemies. How to get it: Found in Treasure Box (Exo Mechs); Dropped by XF-09 Ares"
	Tooltip: "[c/E2735C:Weapon] Refraction Rotor: 240 rogue damage, use time 40"
}

GearRiftburst: {
	Title: "Riftburst"
	Contents: "[c/E2735C:Weapon] Obtain Riftburst. 91 ranged damage, use time 12. Fires a spread of 5 arrows and emits phantom arrows on enemy hits. 66% chance to not consume ammo. How to get it: Craft at Cosmic Anvil from 1 Phantasm, 8 Cosmilite Bar, 20 Necroplasm, 20 Nightmare Fuel"
	Tooltip: "[c/E2735C:Weapon] Riftburst: 91 ranged damage, use time 12"
}

GearSDFMG: {
	Title: "SDFMG"
	Contents: "[c/E2735C:Weapon] Obtain SDFMG. 118 ranged damage, use time 3. 66% chance to not consume ammo. 'It came from the edge of Terraria'. How to get it: Craft at Cosmic Anvil from 1 SDMG, 8 Cosmilite Bar, 20 Endothermic Energy"
	Tooltip: "[c/E2735C:Weapon] SDFMG: 118 ranged damage, use time 3"
}

GearSacrifice: {
	Title: "Sacrifice"
	Contents: "[c/E2735C:Weapon] Obtain Sacrifice. 300 rogue damage, use time 9. Throws sacrificial daggers that lodge themselves in enemies. Press Right Click to cause all stuck daggers to fly back at you and give you life. Daggers stuck to enemies release bloodsplosions over time. Stealth strikes lodge for longer and provide much more life when returning to you. How to get it: Found in Treasure Coffer (Calamitas); Dropped by Supreme Witch, Calamitas"
	Tooltip: "[c/E2735C:Weapon] Sacrifice: 300 rogue damage, use time 9"
}

GearSarosPossession: {
	Title: "Saros Possession"
	Contents: "[c/E2735C:Weapon] Obtain Saros Possession. 66 summon damage, use time 24, 10 mana. Summons a radiant aura harnessing the power of primordial light. Repeated summons increase the power of the aura. Left Click with full summon slots to channel Totality Ray. Totality Ray decays while in use and recharges when not in use. 'A ballet of light and shadow, torn from the sky'. How to get it: Craft at Cosmic Anvil from 1 Sirius, 5 Auric Bar, 15 Darksun Fragment"
	Tooltip: "[c/E2735C:Weapon] Saros Possession: 66 summon damage, use time 24, 10 mana"
}

GearScorchedEarth: {
	Title: "Scorched Earth"
	Contents: "[c/E2735C:Weapon] Obtain Scorched Earth. 550 ranged damage, use time 60. Fires a burst of four heat seeking missiles that rapidly accelerate after a short delay. All rockets explode into napalm cluster bombs on impact. 50% chance to not consume ammo. 'Burns your targets to a fine crisp'. How to get it: Craft at Cosmic Anvil from 1 Scorpio, 15 Any Adamantite Bar, 10 Darksun Fragment, 50 Solar Fragment"
	Tooltip: "[c/E2735C:Weapon] Scorched Earth: 550 ranged damage, use time 60"
}

GearScourgeoftheCosmos: {
	Title: "Scourge of the Cosmos"
	Contents: "[c/E2735C:Weapon] Obtain Scourge of the Cosmos. 380 melee damage, use time 16. Throws a bouncing cosmic scourge that emits tiny homing cosmic scourges on enemy and tile hits. How to get it: Craft at Cosmic Anvil from 1 Scourgeofthe Corruptor, 1 Bonebreaker, 10 Cosmilite Bar"
	Tooltip: "[c/E2735C:Weapon] Scourge of the Cosmos: 380 melee damage, use time 16"
}

GearSeraphim: {
	Title: "Seraphim"
	Contents: "[c/E2735C:Weapon] Obtain Seraphim. 280 rogue damage, use time 13. Throws an extraordinarily fast dagger which slows down exponentially and dissipates into light. Once dissipation has ended, 6 splitting blades that slice nearby targets are released, along with a large laserbeam. Stealth strikes release a volley of 8 lights which explode into smaller laser beams... How to get it: Craft at Cosmic Anvil from 1 Shattered Dawn, 5 Auric Bar"
	Tooltip: "[c/E2735C:Weapon] Seraphim: 280 rogue damage, use time 13"
}

GearSoulPiercer: {
	Title: "Soul Piercer"
	Contents: "[c/E2735C:Weapon] Obtain Soul Piercer. 235 magic damage, use time 25, 30 mana. Casts a powerful ray that summons extra rays on its first hit. How to get it: Craft at Cosmic Anvil from 10 Cosmilite Bar"
	Tooltip: "[c/E2735C:Weapon] Soul Piercer: 235 magic damage, use time 25, 30 mana"
}

GearSpineOfThanatos: {
	Title: "Spine of Thanatos"
	Contents: "[c/E2735C:Weapon] Obtain Spine of Thanatos. 128 melee damage, use time 24. Releases 3 fast metallic whips outward. Once all three collide, a prism of light is shot outward. If an enemy is within the line of sight of the whips on collision, the light will fire towards it. How to get it: Found in Treasure Box (Exo Mechs); Dropped by XF-09 Ares"
	Tooltip: "[c/E2735C:Weapon] Spine of Thanatos: 128 melee damage, use time 24"
}

GearStarmada: {
	Title: "Starmada"
	Contents: "[c/E2735C:Weapon] Obtain Starmada. 4900 ranged damage, use time 70. Left Click fires a spread of starshots. Right Click fires a concussive short range starburst. Starshots can be accelerated by firing when the starburst goes off. Perfect timing reduces spread, increases damage, and adds a stacking weapon power buff. Imperfect timing still increases damage, but he... How to get it: Craft at Cosmic Anvil from 1 Starfleet, 5 Auric Bar, 25 Exodium Cluster"
	Tooltip: "[c/E2735C:Weapon] Starmada: 4900 ranged damage, use time 70"
}

GearStarmageddon: {
	Title: "Starmageddon"
	Contents: "[c/E2735C:Weapon] Obtain Starmageddon. 138 ranged damage, use time 30. Projects the finality of cosmic annihilation with Darksun power. How to get it: Craft at Cosmic Anvil from 1 Starfleet, 1 Barracuda Gun, 8 Cosmilite Bar, 8 Darksun Fragment, 15 Exodium Cluster"
	Tooltip: "[c/E2735C:Weapon] Starmageddon: 138 ranged damage, use time 30"
}

GearStreamGouge: {
	Title: "Stream Gouge"
	Contents: "[c/E2735C:Weapon] Obtain Stream Gouge. 470 melee damage, use time 19. Summons a portal that the spear crosses through. Shortly after going through the portal, portals appear near the mouse that release copies of the spear's cutting edge. Enemies hit by the copies create lacerations in space, revealing a cosmic background. How to get it: Craft at Cosmic Anvil from 10 Cosmilite Bar"
	Tooltip: "[c/E2735C:Weapon] Stream Gouge: 470 melee damage, use time 19"
}

GearSubsumingVortex: {
	Title: "Subsuming Vortex"
	Contents: "[c/E2735C:Weapon] Obtain Subsuming Vortex. 460 magic damage, use time 20, 28 mana. Press Left Click to release a barrage of vortices that race towards enemies. Press Right Click to cast a gigantic vortex in front of you with a bias towards the mouse. When enemies are near the vortex, it sends multiple fast-moving smaller vortices towards them. Releasing Right Click fires the vo... How to get it: Craft at Draedons Forge from 1 Augur of the Void, 1 Event Horizon, 1 Tears of Heaven, 1 Miracle Matter"
	Tooltip: "[c/E2735C:Weapon] Subsuming Vortex: 460 magic damage, use time 20, 28 mana"
}

GearSupernova: {
	Title: "Supernova"
	Contents: "[c/E2735C:Weapon] Obtain Supernova. 5200 rogue damage, use time 70. Disables normal stealth generation. Hold Left Click to generate stealth, or hold Right Click to toss the bomb without generating stealth. Tosses a smart bomb that locks onto and tracks targets. If no target is found it will return to you. Each bomb creates a miniature Miracle Blight supernova tha... How to get it: Craft at Draedons Forge from 1 Sealed Singularity, 1 Star of Destruction, 1 Totality Breakers, 1 Ballistic Poison Bomb, 1 Miracle Matter"
	Tooltip: "[c/E2735C:Weapon] Supernova: 5200 rogue damage, use time 70"
}

GearSurgeDriver: {
	Title: "Surge Driver"
	Contents: "[c/E2735C:Weapon] Obtain Surge Driver. 140 ranged damage, use time 28. Press Left Click to release a laser ray that explodes on collision. Press Right Click to release a barrage of laser beams that release homing energy on enemy hits. How to get it: Found in Treasure Box (Exo Mechs); Dropped by XF-09 Ares"
	Tooltip: "[c/E2735C:Weapon] Surge Driver: 140 ranged damage, use time 28"
}

GearTeslaCannon: {
	Title: "Tesla Cannon"
	Contents: "[c/E2735C:Weapon] Obtain Tesla Cannon. 1200 magic damage, use time 90, 120 mana. A lightweight energy cannon that blasts an intense electrical beam that explodes. The beam can arc to nearby targets. How to get it: Craft at Cosmic Anvil from 25 Mysterious Circuitry, 15 Dubious Plating, 8 Cosmilite Bar, 2 Ascendant Spirit Essence"
	Tooltip: "[c/E2735C:Weapon] Tesla Cannon: 1200 magic damage, use time 90, 120 mana"
}

GearTheAnomalysNanogun: {
	Title: "The Anomaly's Nanogun"
	Contents: "[c/E2735C:Weapon] Obtain The Anomaly's Nanogun. 1600 ranged damage. Press Left Click to charge up 5 rapid-fire plasma beams. Press Right Click to launch 3 fission bombs. 'Welcome to the party, pal'. How to get it: Craft at Cosmic Anvil from 20 Mysterious Circuitry, 20 Dubious Plating, 8 Cosmilite Bar, 2 Ascendant Spirit Essence"
	Tooltip: "[c/E2735C:Weapon] The Anomaly's Nanogun: 1600 ranged damage"
}

GearTheAtomSplitter: {
	Title: "The Atom Splitter"
	Contents: "[c/E2735C:Weapon] Obtain The Atom Splitter. 296 rogue damage, use time 25. Throws a quantum-superimposed javelin that strikes from numerous timelines at once. Stealth strikes perform far more simultaneous strikes. How to get it: Found in Treasure Box (Exo Mechs); Dropped by XF-09 Ares"
	Tooltip: "[c/E2735C:Weapon] The Atom Splitter: 296 rogue damage, use time 25"
}

GearTheBurningSky: {
	Title: "The Burning Sky"
	Contents: "[c/E2735C:Weapon] Obtain The Burning Sky. 147 melee damage, use time 8. Rains down a stream of Dragonfire at the cursor. 'Hold the blade to the sky, and witness Armageddon'. How to get it: Found in Treasure Cache (Yharon); Dropped by Yharon, Dragon of Rebirth"
	Tooltip: "[c/E2735C:Weapon] The Burning Sky: 147 melee damage, use time 8"
}

GearTheFinalDawn: {
	Title: "The Final Dawn"
	Contents: "[c/E2735C:Weapon] Obtain The Final Dawn. 2500 rogue damage, use time 15. Attack enemies with a giant scythe swing to replenish stealth. Press up and attack to throw the scythe. Stealth strikes perform a horizontal swing that leaves a lingering fire aura. Stealth strikes performed while pressing up fling yourself at the enemy and slice through them, causing homing fire... How to get it: Found in Treasure Cache (Yharon); Dropped by Yharon, Dragon of Rebirth"
	Tooltip: "[c/E2735C:Weapon] The Final Dawn: 2500 rogue damage, use time 15"
}

GearTheJailor: {
	Title: "The Jailor"
	Contents: "[c/E2735C:Weapon] Obtain The Jailor. 235 ranged damage, use time 28. Releases electric mines outward that connect to each-other via arcs. How to get it: Found in Treasure Box (Exo Mechs); Dropped by XF-09 Ares"
	Tooltip: "[c/E2735C:Weapon] The Jailor: 235 ranged damage, use time 28"
}

GearTheObliterator: {
	Title: "The Obliterator"
	Contents: "[c/E2735C:Weapon] Obtain The Obliterator. 370 melee damage, use time 20. Reach: X tiles. Speed: 54. Infinite throw duration. How to get it: Found in Treasure Bag (The Devourer of Gods); Dropped by The Devourer of Gods"
	Tooltip: "[c/E2735C:Weapon] The Obliterator: 370 melee damage, use time 20"
}

GearTheOracle: {
	Title: "The Oracle"
	Contents: "[c/E2735C:Weapon] Obtain The Oracle. 201 melee damage, use time 20. Reach: X tiles. Speed: 60. Infinite throw duration. Emits an aura of auric lightning which charges up when hitting enemies. Fires auric orbs when supercharged. 'Gaze into the past, the present, the future... and the circumstances of your inevitable demise'. How to get it: Craft at Cosmic Anvil from 1 Burning Revelation, 1 The Obliterator, 5 Auric Bar"
	Tooltip: "[c/E2735C:Weapon] The Oracle: 201 melee damage, use time 20"
}

GearThePack: {
	Title: "The Pack"
	Contents: "[c/E2735C:Weapon] Obtain The Pack. 1000 ranged damage, use time 53. Fires large homing rockets that explode into more homing mini rockets when in proximity to an enemy. How to get it: Craft at Cosmic Anvil from 1 Scorpio, 50 Marble Block, 8 Cosmilite Bar, 20 Endothermic Energy, 4 Armored Shell"
	Tooltip: "[c/E2735C:Weapon] The Pack: 1000 ranged damage, use time 53"
}

GearTheWand: {
	Title: "The Wand"
	Contents: "[c/E2735C:Weapon] Obtain The Wand. 1 magic damage, use time 19, 200 mana. The ultimate wand. How to get it: Sold by Shady Salesman"
	Tooltip: "[c/E2735C:Weapon] The Wand: 1 magic damage, use time 19, 200 mana"
}

GearThreadOfEradication: {
	Title: "Thread of Eradication"
	Contents: "[c/E2735C:Weapon] Obtain Thread of Eradication. 1500 ranged damage, use time 45. Charges up God's Bane Doombeam. Channelling the weapon causes it to charge up Hyperdeath Rift instead. While charging Hyperdeath Rift, the bow's turning speed is slowed down. Always critically strikes, with critical strike chance increasing critical strike damage. How to get it: Found in Treasure Bag (The Devourer of Gods); Dropped by The Devourer of Gods"
	Tooltip: "[c/E2735C:Weapon] Thread of Eradication: 1500 ranged damage, use time 45"
}

GearTimeBolt: {
	Title: "Time Bolt"
	Contents: "[c/E2735C:Weapon] Obtain Time Bolt. 303 rogue damage, use time 20. Throws a temporal knife that causes Time Distortion around enemies. Stealth strikes can hit more enemies and create a larger time field. 'Every maid needs a knife, and every knife needs a cutting board'. How to get it: Craft at Cosmic Anvil from 1 Lunar Kunai, 1 Stellar Knife, 1 Gold Watch, 8 Cosmilite Bar, 20 Endothermic Energy"
	Tooltip: "[c/E2735C:Weapon] Time Bolt: 303 rogue damage, use time 20"
}

GearTyrannysEnd: {
	Title: "Tyranny's End"
	Contents: "[c/E2735C:Weapon] Obtain Tyranny's End. 2150 ranged damage, use time 60. Converts musket balls into .70 caliber sniper rounds that deal devastating damage. Causes enemies to become Marked for Death and bypasses defense. Critical hits summon a swarm of 6 additional bullets. 'Pierce the heart of even the most heavily-armored foe'. How to get it: Craft at Cosmic Anvil from 1 Rubico Prime, 1 Anti-materiel Rifle, 5 Auric Bar, 3 Life Alloy"
	Tooltip: "[c/E2735C:Weapon] Tyranny's End: 2150 ranged damage, use time 60"
}

GearUltima: {
	Title: "Ultima"
	Contents: "[c/E2735C:Weapon] Obtain Ultima. 115 ranged damage, use time 8. Casts a continuous stream of plasma bolts. Over time bolts power up into solid beams as you continue shooting. 66% chance to not consume ammo. How to get it: Craft at Cosmic Anvil from 1 Pulse Bow, 1 Laser Rifle, 1 The Storm, 8 Cosmilite Bar, 8 Darksun Fragment, 15 Exodium Cluster"
	Tooltip: "[c/E2735C:Weapon] Ultima: 115 ranged damage, use time 8"
}

GearUniversalGenesis: {
	Title: "Universal Genesis"
	Contents: "[c/E2735C:Weapon] Obtain Universal Genesis. 180 ranged damage, use time 26. Fires a spread of bullets from the gun and a flurry of stars to rain down on the cursor. Converts musket balls into starcaller shots that summon additional stars on enemy hits. 'Let the starry sky fall upon your enemies'. How to get it: Craft at Cosmic Anvil from 1 Conference Call, 3 Star Cloak, 5 Cosmilite Bar, 4 Ascendant Spirit Essence"
	Tooltip: "[c/E2735C:Weapon] Universal Genesis: 180 ranged damage, use time 26"
}

GearVehemence: {
	Title: "Vehemence"
	Contents: "[c/E2735C:Weapon] Obtain Vehemence. 6666 magic damage, use time 43, 120 mana. Casts intense bolts of hellish power that explode into skulls. How to get it: Found in Treasure Coffer (Calamitas); Dropped by Supreme Witch, Calamitas"
	Tooltip: "[c/E2735C:Weapon] Vehemence: 6666 magic damage, use time 43, 120 mana"
}

GearVigilance: {
	Title: "Vigilance"
	Contents: "[c/E2735C:Weapon] Obtain Vigilance. 115 summon damage, use time 24, 10 mana. Summons a soul seeker to fight for you. How to get it: Found in Treasure Coffer (Calamitas); Dropped by Supreme Witch, Calamitas"
	Tooltip: "[c/E2735C:Weapon] Vigilance: 115 summon damage, use time 24, 10 mana"
}

GearViolence: {
	Title: "Violence"
	Contents: "[c/E2735C:Weapon] Obtain Violence. 485 melee damage, use time 25. A demonic pitchfork, cursed to cause endless bloodshed. Left Click commands the trident to follow your cursor and shred enemies with devastating speed. Right Click throws the trident, violently tearing through enemies with immense power and inflicting Vulnerability Hex. How to get it: Found in Treasure Coffer (Calamitas); Dropped by Supreme Witch, Calamitas"
	Tooltip: "[c/E2735C:Weapon] Violence: 485 melee damage, use time 25"
}

GearVividClarity: {
	Title: "Vivid Clarity"
	Contents: "[c/E2735C:Weapon] Obtain Vivid Clarity. 162 magic damage, use time 4, 54 mana. Fires five randomized rays of exo-energy towards the cursor. Enemy and tile hits either cause a big flash explosion, an additional laser from the sky, or split into energy orbs. Struck enemies are liquified by Miracle Blight. 'Its majesty inspires a stroke of unparalleled genius'. How to get it: Craft at Draedons Forge from 1 Nucleosynthesis, 1 Phantasmal Fury, 1 Shadowbolt Staff, 1 Ultra Liquidator, 1 Miracle Matter"
	Tooltip: "[c/E2735C:Weapon] Vivid Clarity: 162 magic damage, use time 4, 54 mana"
}

GearVoidEaterMarionette: {
	Title: "Void Eater Marionette"
	Contents: "[c/E2735C:Weapon] Obtain Void Eater Marionette. 110 summon damage, use time 24, 10 mana. Contains the power to control a miniature Devourer. Repeated summons increase the length and power of the Devourer. The Devourer attacks with Divinity Devourer, Faith Incinerator and Ultracosmic Maelstrom. Can play fetch with dropped items. Press the bound key while holding this item when the Dev... How to get it: Found in Treasure Bag (The Devourer of Gods); Dropped by The Devourer of Gods"
	Tooltip: "[c/E2735C:Weapon] Void Eater Marionette: 110 summon damage, use time 24, 10 mana"
}

GearVoidVortex: {
	Title: "Void Vortex"
	Contents: "[c/E2735C:Weapon] Obtain Void Vortex. 210 magic damage, use time 49, 70 mana. Conjures a swirling vortex of supercharged magnet spheres around the cursor that explodes into a storm of homing mini spheres. How to get it: Craft at Cosmic Anvil from 1 Voltaic Climax, 5 Auric Bar"
	Tooltip: "[c/E2735C:Weapon] Void Vortex: 210 magic damage, use time 49, 70 mana"
}

GearVoltaicClimax: {
	Title: "Voltaic Climax"
	Contents: "[c/E2735C:Weapon] Obtain Voltaic Climax. 215 magic damage, use time 34, 45 mana. Conjures a ring of supercharged magnet spheres around the cursor. How to get it: Craft at Cosmic Anvil from 1 Magnetic Meltdown, 8 Cosmilite Bar, 8 Darksun Fragment"
	Tooltip: "[c/E2735C:Weapon] Voltaic Climax: 215 magic damage, use time 34, 45 mana"
}

GearWrathwing: {
	Title: "Wrathwing"
	Contents: "[c/E2735C:Weapon] Obtain Wrathwing. 592 rogue damage, use time 13. Throws an agile, homing winged spear that constantly spits Dragonfire. Stealth strikes create an eruption of cinders on hit. How to get it: Found in Treasure Cache (Yharon); Dropped by Yharon, Dragon of Rebirth"
	Tooltip: "[c/E2735C:Weapon] Wrathwing: 592 rogue damage, use time 13"
}

GearYharimsCrystal: {
	Title: "Yharim's Crystal"
	Contents: "[c/E2735C:Weapon] Obtain Yharim's Crystal. 65 magic damage, use time 10, 15 mana. How to get it: Found in Treasure Cache (Yharon); Dropped by Yharon, Dragon of Rebirth"
	Tooltip: "[c/E2735C:Weapon] Yharim's Crystal: 65 magic damage, use time 10, 15 mana"
}

GearYharonsKindleStaff: {
	Title: "Yharon's Kindle Staff"
	Contents: "[c/E2735C:Weapon] Obtain Yharon's Kindle Staff. 325 summon damage, use time 24, 10 mana. Summons a fiery draconid to fight for you. How to get it: Found in Treasure Cache (Yharon); Dropped by Yharon, Dragon of Rebirth"
	Tooltip: "[c/E2735C:Weapon] Yharon's Kindle Staff: 325 summon damage, use time 24, 10 mana"
}

GearTopazRing: {
	Title: "Accuser's Ring"
	Contents: "[c/6CC4E8:Accessory] Equip Accuser's Ring. Accessory. Killing enemies grants a random buff for 30 seconds. How to get it: Sold by Archaeologist; Found in Gem Structures chests"
	Tooltip: "[c/6CC4E8:Accessory] Accuser's Ring: Accessory"
}

GearEmptyNecklace: {
	Title: "Amulet of Emptiness"
	Contents: "[c/6CC4E8:Accessory] Equip Amulet of Emptiness. Accessory. Increases void regeneration speed by 50%. How to get it: Found in Sanctuary chests"
	Tooltip: "[c/6CC4E8:Accessory] Amulet of Emptiness: Accessory"
}

GearAnomalyInterceptor: {
	Title: "Anomaly Interceptor"
	Contents: "[c/6CC4E8:Accessory] Equip Anomaly Interceptor. Accessory. Displays the location and description of various anomalies, such as electromagnetic transmissions, wormholes, and teleported items, on the Minimap. Functions while in the inventory, equipped as an accessory, or worn as a vanity accessory. How to get it: Craft at Tinkerer's Workshop from 1 Anomaly Locator, 8 Any Egg"
	Tooltip: "[c/6CC4E8:Accessory] Anomaly Interceptor: Accessory"
}

GearAnomalyLocator: {
	Title: "Anomaly Locator"
	Contents: "[c/6CC4E8:Accessory] Equip Anomaly Locator. Accessory. Displays the location of various anomalies, such as electromagnetic transmissions, wormholes, and teleported items, on the Minimap. Functions while in the inventory, equipped as an accessory, or worn as a vanity accessory. How to get it: Sold by Archaeologist"
	Tooltip: "[c/6CC4E8:Accessory] Anomaly Locator: Accessory"
}

GearArcaneAqueduct: {
	Title: "Arcane Aqueduct"
	Contents: "[c/6CC4E8:Accessory] Equip Arcane Aqueduct. Accessory. Surrounds you with 2 orbital projectiles. How to get it: Craft at Tinkerer's Workshop from 1 Water Bolt, 1 Aqua Scepter, 25 Marble Block, 4 Fragment of Tide"
	Tooltip: "[c/6CC4E8:Accessory] Arcane Aqueduct: Accessory"
}

GearArchaeologistToolbelt: {
	Title: "Archaeologist's Toolbelt"
	Contents: "[c/6CC4E8:Accessory] Equip Archaeologist's Toolbelt. Accessory. Increases block placement and tool range by 3. Allows the placement and destruction of conduits. Extends the pickup range for conduit items. How to get it: Sold by Archaeologist"
	Tooltip: "[c/6CC4E8:Accessory] Archaeologist's Toolbelt: Accessory"
}

GearAmberRing: {
	Title: "Asmodeus's Ring"
	Contents: "[c/6CC4E8:Accessory] Equip Asmodeus's Ring. Accessory, 1 defense. Getting hit grants a random buff for 30 seconds. How to get it: Sold by Archaeologist; Found in Gem Structures chests"
	Tooltip: "[c/6CC4E8:Accessory] Asmodeus's Ring: Accessory, 1 defense"
}

GearAutoClicker: {
	Title: "Auto Clicker"
	Contents: "[c/6CC4E8:Accessory] Equip Auto Clicker. Accessory. Increases attack speed by 10% and makes all items auto swing. How to get it: Found in Abandoned Village chests"
	Tooltip: "[c/6CC4E8:Accessory] Auto Clicker: Accessory"
}

GearBackupBow: {
	Title: "Backup Bow"
	Contents: "[c/6CC4E8:Accessory] Equip Backup Bow. Accessory. Bows fire additional arrows behind you for 50% damage. How to get it: Found in Abandoned Village chests"
	Tooltip: "[c/6CC4E8:Accessory] Backup Bow: Accessory"
}

GearBagOfAmmoGathering: {
	Title: "Bag of Ammunition Gathering"
	Contents: "[c/6CC4E8:Accessory] Equip Bag of Ammunition Gathering. Accessory. 20% chance not to consume ammo. Striking enemies has a chance to refund ammo. Landing the killing blow on enemies may also refund ammo. How to get it: Sold by Archaeologist; Found in Gem Structures chests"
	Tooltip: "[c/6CC4E8:Accessory] Bag of Ammunition Gathering: Accessory"
}

GearRubyRing: {
	Title: "Beelzebub's Ring"
	Contents: "[c/6CC4E8:Accessory] Equip Beelzebub's Ring. Accessory. Killed enemies have a 50% chance to drop additional hearts. This chance increases to 100% with critical strikes. Collecting hearts lengthens the duration of active buffs, up to double the original duration. How to get it: Sold by Archaeologist; Found in Gem Structures chests"
	Tooltip: "[c/6CC4E8:Accessory] Beelzebub's Ring: Accessory"
}

GearAmethystRing: {
	Title: "Belphegor's Ring"
	Contents: "[c/6CC4E8:Accessory] Equip Belphegor's Ring. Accessory. Chain together blocks when mining, breaking up to 50 blocks at once. How to get it: Sold by Archaeologist; Found in Gem Structures chests"
	Tooltip: "[c/6CC4E8:Accessory] Belphegor's Ring: Accessory"
}

GearBloodstainedCoin: {
	Title: "Bloodstained Coin"
	Contents: "[c/6CC4E8:Accessory] Equip Bloodstained Coin. Accessory. Critical strikes have a 50% chance to deal 20 more damage. Receiving damage has a 50% chance to bleed you. How to get it: Craft at Anvil from 5 Vertebrae, 8 Ancient Steel Bar, 4 Fragment of Evil; Found in Abandoned Village chests"
	Tooltip: "[c/6CC4E8:Accessory] Bloodstained Coin: Accessory"
}

GearBotanicalSymbiote: {
	Title: "Botanical Symbiote"
	Contents: "[c/6CC4E8:Accessory] Equip Botanical Symbiote. Accessory. Increases life regeneration by 1 during the day. Attaches a Blooming Hook to all minions. How to get it: Dropped by Flowering Slime"
	Tooltip: "[c/6CC4E8:Accessory] Botanical Symbiote: Accessory"
}

GearChallengerRing: {
	Title: "Challenger's Ring"
	Contents: "[c/6CC4E8:Accessory] Equip Challenger's Ring. Accessory. Right click while favorited to invert the currently selected gem, disabling the effect of the gem and enabling the inverted effect. 0. 1. 2. 3. 4. 5. 6. How to get it: Craft at Tinkerer's Workshop from 1 Belphegor's Ring, 1 Accuser's Ring, 1 Mammon's Ring, 1 Leviathan's Ring, 1 Beelzebub's Ring, 1 Light-Bringer's Ring, 1 Asmodeus's Ring, 1 Primordial Cluster"
	Tooltip: "[c/6CC4E8:Accessory] Challenger's Ring: Accessory"
}

GearCloverCharm: {
	Title: "Clover Charm"
	Contents: "[c/6CC4E8:Accessory] Equip Clover Charm. Accessory. Critical strikes have a 50% chance to steal life. Increases critical strike chance by 1%. How to get it: Craft at Work Bench from 20 Wood, 4 Fragment of Nature, 1 Sky Blue Flower"
	Tooltip: "[c/6CC4E8:Accessory] Clover Charm: Accessory"
}

GearCrestofDasuver: {
	Title: "Crest of Dasuver"
	Contents: "[c/6CC4E8:Accessory] Equip Crest of Dasuver. Accessory, 3 defense. Increases critical strike chance by 6%. How to get it: Craft at Tinkerer's Workshop from 1 Shield of Desecar, 1 Shield of Stekpla"
	Tooltip: "[c/6CC4E8:Accessory] Crest of Dasuver: Accessory, 3 defense"
}

GearCrushingAmplifier: {
	Title: "Crushing Amplifier"
	Contents: "[c/6CC4E8:Accessory] Equip Crushing Amplifier. Accessory. Extends the range of Crushers by 1. Also increases melee damage by 5%. How to get it: Found in world-generated chests"
	Tooltip: "[c/6CC4E8:Accessory] Crushing Amplifier: Accessory"
}

GearCrushingCapacitor: {
	Title: "Crushing Capacitor"
	Contents: "[c/6CC4E8:Accessory] Equip Crushing Capacitor. Accessory. Makes the fourth charge of Crushers no longer consume void. How to get it: Sold by Traveling Merchant; Found in world-generated chests"
	Tooltip: "[c/6CC4E8:Accessory] Crushing Capacitor: Accessory"
}

GearCrushingResistor: {
	Title: "Crushing Resistor"
	Contents: "[c/6CC4E8:Accessory] Equip Crushing Resistor. Accessory. The second charge of a Crusher has a 33% chance to not consume void. How to get it: Dropped by Bridgeburner; Found in world-generated chests"
	Tooltip: "[c/6CC4E8:Accessory] Crushing Resistor: Accessory"
}

GearCrushingTransformer: {
	Title: "Crushing Transformer"
	Contents: "[c/6CC4E8:Accessory] Equip Crushing Transformer. Accessory. Increases melee speed by 8%. Increases Crusher charge speed by 12%. How to get it: Sold by Mechanic; Found in world-generated chests"
	Tooltip: "[c/6CC4E8:Accessory] Crushing Transformer: Accessory"
}

GearDreamcatcher: {
	Title: "Dreamcatcher"
	Contents: "[c/6CC4E8:Accessory] Equip Dreamcatcher. Accessory. Prevents attacks from dealing damage to your void meter. Increases void damage by 10%. How to get it: Found in Sanctuary chests"
	Tooltip: "[c/6CC4E8:Accessory] Dreamcatcher: Accessory"
}

GearDrillHand: {
	Title: "Drill Arm"
	Contents: "[c/6CC4E8:Accessory] Equip Drill Arm. Accessory. Mine in a 3x3 area, but reduce mining speed by 50% and pickaxe power by 15. When smart cursor is enabled, increase mining speed by 15% instead. How to get it: Found in Treasure Bag (The Excavator)"
	Tooltip: "[c/6CC4E8:Accessory] Drill Arm: Accessory"
}

GearEarthDrive: {
	Title: "Earthdrive"
	Contents: "[c/6CC4E8:Accessory] Equip Earthdrive. Accessory. Increases melee speed by 100% of the increases received to mining speed from other sources. Increases mining speed by 100% of the increases received to melee speed from other sources. How to get it: Dropped by Earthen Gizmo"
	Tooltip: "[c/6CC4E8:Accessory] Earthdrive: Accessory"
}

GearVisionAmulet: {
	Title: "Elemental Amulet"
	Contents: "[c/6CC4E8:Accessory] Equip Elemental Amulet. Accessory. Epic Gamer. 'Resonates with your ambitions'. How to get it: Found in Abandoned Village chests"
	Tooltip: "[c/6CC4E8:Accessory] Elemental Amulet: Accessory"
}

GearEmeraldBracelet: {
	Title: "Emerald Bracelet"
	Contents: "[c/6CC4E8:Accessory] Equip Emerald Bracelet. Accessory. Increases void gain by 2. How to get it: Found in Pyramid Crate; Found in world-generated chests"
	Tooltip: "[c/6CC4E8:Accessory] Emerald Bracelet: Accessory"
}

GearEndothermicAfterburner: {
	Title: "Endothermic Afterburner"
	Contents: "[c/6CC4E8:Accessory] Equip Endothermic Afterburner. Accessory. Melee attacks send a Frost Burst behind you, dealing 70% damage and inflicting Frostburn. Hitting an enemy with the Frost Burst will increase movement speed and melee speed by 10% for 10 seconds. How to get it: Dropped by Permafrost Construct"
	Tooltip: "[c/6CC4E8:Accessory] Endothermic Afterburner: Accessory"
}

GearExperimentalInjection: {
	Title: "Experimental Injection"
	Contents: "[c/6CC4E8:Accessory] Equip Experimental Injection. Accessory. How to get it: Found in Treasure Bag (Putrid Pinky); Dropped by Putrid Pinky"
	Tooltip: "[c/6CC4E8:Accessory] Experimental Injection: Accessory"
}

GearGelWings: {
	Title: "Gel Wings"
	Contents: "[c/6CC4E8:Accessory] Equip Gel Wings. Accessory. Allows flight and slow fall. 'It really shouldn't hold up well'. How to get it: Craft at Anvil from 8 Corrosive Gel, 24 Goopwood, 10 Feather; Found in Treasure Bag (Putrid Pinky)"
	Tooltip: "[c/6CC4E8:Accessory] Gel Wings: Accessory"
}

GearGlowJelly: {
	Title: "Glow Jelly"
	Contents: "[c/6CC4E8:Accessory] Equip Glow Jelly. Accessory. Increases healing and mana received from potions by 40. How to get it: Craft at Tinkerer's Workshop from 1 Royal Jelly, 1 Glow Spores"
	Tooltip: "[c/6CC4E8:Accessory] Glow Jelly: Accessory"
}

GearGlowSpores: {
	Title: "Glow Spores"
	Contents: "[c/6CC4E8:Accessory] Equip Glow Spores. Accessory. Increases mana received from potions by 40. Increases magic critical strike chance by 5%. How to get it: Dropped by Glowmoth"
	Tooltip: "[c/6CC4E8:Accessory] Glow Spores: Accessory"
}

GearGoldBattery: {
	Title: "Gold Battery"
	Contents: "[c/6CC4E8:Accessory] Equip Gold Battery. Accessory. Increases void gain by 1 and max void by 20. When hurt, 10% of damage taken is converted into void. If hurt while the void meter is maxed, there is a 10% chance to be inflicted with Ichor. How to get it: Craft at Anvil from 10 Gold Bar, 1 Fragment of Evil"
	Tooltip: "[c/6CC4E8:Accessory] Gold Battery: Accessory"
}

GearGoldenTrowel: {
	Title: "Golden Trowel"
	Contents: "[c/6CC4E8:Accessory] Equip Golden Trowel. Accessory. Mining blocks has a chance to drop bonus resources, such as coins and silt. Increases mining speed by 5%. How to get it: Sold by Archaeologist"
	Tooltip: "[c/6CC4E8:Accessory] Golden Trowel: Accessory"
}

GearWormWoodParasite: {
	Title: "Goopwood Parasite"
	Contents: "[c/6CC4E8:Accessory] Equip Goopwood Parasite. Accessory. Increases void gain by 2 and void critical strike chance by 8%. Critical strikes heal small amounts of void. Decreases max void by 20. How to get it: Craft at Anvil from 32 Corrosive Gel, 16 Goopwood; Found in Treasure Bag (Putrid Pinky)"
	Tooltip: "[c/6CC4E8:Accessory] Goopwood Parasite: Accessory"
}

GearGraniteProtector: {
	Title: "Granite Protector"
	Contents: "[c/6CC4E8:Accessory] Equip Granite Protector. Accessory, 1 defense. Reduces damage taken by 6%. How to get it: Craft at Anvil from 50 Granite, 4 Fragment of Earth"
	Tooltip: "[c/6CC4E8:Accessory] Granite Protector: Accessory, 1 defense"
}

GearGuideToIllumination: {
	Title: "Guide to Illumination"
	Contents: "[c/6CC4E8:Accessory] Equip Guide to Illumination. Accessory. The first time an enemy takes damage, they will sparkle, stunning them for 10 damage. How to get it: Found in Treasure Bag (Glowmoth); Dropped by Glowmoth"
	Tooltip: "[c/6CC4E8:Accessory] Guide to Illumination: Accessory"
}

GearHarvestersScythe: {
	Title: "Harvester's Scythe"
	Contents: "[c/6CC4E8:Accessory] Equip Harvester's Scythe. Accessory. Increases critical strike damage by 20%. Enemies have a 10% chance to drop double the loot, or 20% when killed by critical strike. How to get it: Craft at Anvil from 4 Vibrant Alloy"
	Tooltip: "[c/6CC4E8:Accessory] Harvester's Scythe: Accessory"
}

GearHeartOfTheSea: {
	Title: "Heart of the Sea"
	Contents: "[c/6CC4E8:Accessory] Equip Heart of the Sea. Accessory. Release waves of damage periodically. Release more waves at lower health. Waves ignore up to 8 defense. Increases max life by 20. Waves disabled when hidden. 'Death by heartbeat'. How to get it: Craft at Tinkerer's Workshop from 1 Life Crystal, 1 Dissolving Deluge, 8 Ripple Potion"
	Tooltip: "[c/6CC4E8:Accessory] Heart of the Sea: Accessory"
}

GearHellfireIcosahedron: {
	Title: "Hellfire Icosahedron"
	Contents: "[c/6CC4E8:Accessory] Equip Hellfire Icosahedron. Accessory. Critical strikes may cause a flaming explosion, dealing 100% damage. Increases critical strike chance by 1%. How to get it: Craft at Anvil from 6 Hellstone Bar, 6 Fragment of Inferno"
	Tooltip: "[c/6CC4E8:Accessory] Hellfire Icosahedron: Accessory"
}

GearIlluminantLantern: {
	Title: "Illuminant Lantern"
	Contents: "[c/6CC4E8:Accessory] Equip Illuminant Lantern. Accessory. Greatly increases the intensity of lighting. Increases void damage by 5%. How to get it: Found in Treasure Bag (Glowmoth)"
	Tooltip: "[c/6CC4E8:Accessory] Illuminant Lantern: Accessory"
}

GearInfinityPouch: {
	Title: "Infinity Pouch"
	Contents: "[c/6CC4E8:Accessory] Equip Infinity Pouch. Accessory. Consume void instead of ammunition. How to get it: Convert Bag of Ammunition Gathering by throwing it into a Wormhole Anomaly"
	Tooltip: "[c/6CC4E8:Accessory] Infinity Pouch: Accessory"
}

GearKeepersBox: {
	Title: "Keeper's Box"
	Contents: "[c/6CC4E8:Accessory] Equip Keeper's Box. Accessory, 1 defense. Don't lose coins upon death. How to get it: Sold by Merchant"
	Tooltip: "[c/6CC4E8:Accessory] Keeper's Box: Accessory, 1 defense"
}

GearEmeraldRing: {
	Title: "Leviathan's Ring"
	Contents: "[c/6CC4E8:Accessory] Equip Leviathan's Ring. Accessory. Enemies have a 14.3% chance to drop double the loot. How to get it: Sold by Archaeologist; Found in Gem Structures chests"
	Tooltip: "[c/6CC4E8:Accessory] Leviathan's Ring: Accessory"
}

GearDiamondRing: {
	Title: "Light-Bringer's Ring"
	Contents: "[c/6CC4E8:Accessory] Equip Light-Bringer's Ring. Accessory. Increase damage based on defense, then decreases defense by a third of the damage buff. Increases damage by X%. Decreases defense by X. How to get it: Sold by Archaeologist; Found in Gem Structures chests"
	Tooltip: "[c/6CC4E8:Accessory] Light-Bringer's Ring: Accessory"
}

GearLittleWoes: {
	Title: "Little Woes"
	Contents: "[c/6CC4E8:Accessory] Equip Little Woes. Accessory. Increases void gain by 1 during the night. Attaches a Little Woe to all minions. How to get it: Dropped by Throe"
	Tooltip: "[c/6CC4E8:Accessory] Little Woes: Accessory"
}

GearLockpick: {
	Title: "Lockpick"
	Contents: "[c/6CC4E8:Accessory] Equip Lockpick. Accessory, 1 defense. 33% chance not to lose keys when unlocking chests. Recover scrap materials from lost keys. How to get it: Found in Abandoned Village chests"
	Tooltip: "[c/6CC4E8:Accessory] Lockpick: Accessory, 1 defense"
}

GearSapphireRing: {
	Title: "Mammon's Ring"
	Contents: "[c/6CC4E8:Accessory] Equip Mammon's Ring. Accessory. Generate coins when void is gained. How to get it: Sold by Archaeologist; Found in Gem Structures chests"
	Tooltip: "[c/6CC4E8:Accessory] Mammon's Ring: Accessory"
}

GearMarbleDefender: {
	Title: "Marble Defender"
	Contents: "[c/6CC4E8:Accessory] Equip Marble Defender. Accessory, 1 defense. Launches attackers away from you with javelins. How to get it: Craft at Anvil from 50 Marble, 4 Fragment of Earth"
	Tooltip: "[c/6CC4E8:Accessory] Marble Defender: Accessory, 1 defense"
}

GearMrBurns: {
	Title: "Mr. Burns"
	Contents: "[c/6CC4E8:Accessory] Equip Mr. Burns. Accessory. Increases max void by 20. Decreases the potency of Void Shock and Void Recovery. How to get it: Craft at Loom from 12 Charred Wood, 5 Silk; Found in Abandoned Village chests"
	Tooltip: "[c/6CC4E8:Accessory] Mr. Burns: Accessory"
}

GearMrEepy: {
	Title: "Mr. Eepy"
	Contents: "[c/6CC4E8:Accessory] Equip Mr. Eepy. Accessory. Decreases the potency of Void Shock and Void Recovery. Prevents attacks from dealing damage to your void meter. Increases void damage by 10% and max void by 50. How to get it: Craft at Tinkerer's Workshop from 1 Mr. Burns, 1 Dreamcatcher"
	Tooltip: "[c/6CC4E8:Accessory] Mr. Eepy: Accessory"
}

GearMrGlorp: {
	Title: "Mr. Glorp"
	Contents: "[c/6CC4E8:Accessory] Equip Mr. Glorp. Accessory. Increases max void by 100. Decreases the potency of Void Shock and Void Recovery. How to get it: Convert Mr. Burns by throwing it into a Wormhole Anomaly"
	Tooltip: "[c/6CC4E8:Accessory] Mr. Glorp: Accessory"
}

GearMrMcMillen: {
	Title: "Mr. McMillen"
	Contents: "[c/6CC4E8:Accessory] Equip Mr. McMillen. Accessory. Decreases the potency of Void Shock and Void Recovery. Increases void regeneration speed by 50% and max void by 50. 'Cow on a trash farm...'. How to get it: Craft at Tinkerer's Workshop from 1 Mr. Burns, 1 Amulet of Emptiness"
	Tooltip: "[c/6CC4E8:Accessory] Mr. McMillen: Accessory"
}

GearOtherworldlyAmplifier: {
	Title: "Otherworldly Amplifier"
	Contents: "[c/6CC4E8:Accessory] Equip Otherworldly Amplifier. Accessory. Critical strikes deal 8 more damage. How to get it: Craft at Anvil from 5 Amber, 4 Fragment of Otherworld"
	Tooltip: "[c/6CC4E8:Accessory] Otherworldly Amplifier: Accessory"
}

GearAcidicInjection: {
	Title: "Overkill Injection"
	Contents: "[c/6CC4E8:Accessory] Equip Overkill Injection. Accessory. The first application of any stackable debuff is doubled. How to get it: Found in Abandoned Village chests"
	Tooltip: "[c/6CC4E8:Accessory] Overkill Injection: Accessory"
}

GearPlatinumBattery: {
	Title: "Platinum Battery"
	Contents: "[c/6CC4E8:Accessory] Equip Platinum Battery. Accessory. Increases void gain by 1 and max void by 20. When hurt, 10% of damage taken is converted into void. If hurt while the void meter is maxed, there is a 10% chance to be inflicted with Broken Armor. How to get it: Craft at Anvil from 10 Platinum Bar, 1 Fragment of Evil"
	Tooltip: "[c/6CC4E8:Accessory] Platinum Battery: Accessory"
}

GearPricklyPearShield: {
	Title: "Prickly Pear Shield"
	Contents: "[c/6CC4E8:Accessory] Equip Prickly Pear Shield. Accessory, 1 defense. Getting hit releases Cactus Spines that poison nearby enemies. How to get it: Craft at Work Bench from 20 Cactus, 4 Fragment of Nature, 1 Pink Prickly Pear"
	Tooltip: "[c/6CC4E8:Accessory] Prickly Pear Shield: Accessory, 1 defense"
}

GearPutridCoin: {
	Title: "Putrid Coin"
	Contents: "[c/6CC4E8:Accessory] Equip Putrid Coin. Accessory. Critical strikes have a 50% chance to deal 20 more damage. Receiving damage has a 50% chance to poison you. How to get it: Craft at Anvil from 5 Rotten Chunk, 8 Ancient Steel Bar, 4 Fragment of Evil; Found in Abandoned Village chests"
	Tooltip: "[c/6CC4E8:Accessory] Putrid Coin: Accessory"
}

GearRockCandy: {
	Title: "Rock Candy"
	Contents: "[c/6CC4E8:Accessory] Equip Rock Candy. Accessory. Increases pickaxe power by 5. Increases mining speed, melee speed, and movement speed by 5%. How to get it: Sold by Archaeologist; Found in Gem Structures chests"
	Tooltip: "[c/6CC4E8:Accessory] Rock Candy: Accessory"
}

GearRockingHorse: {
	Title: "Rocking Horse"
	Contents: "[c/6CC4E8:Accessory] Equip Rocking Horse. Accessory. Increases movement speed by 5% and void gain 2. How to get it: Craft at Anvil from 24 Charred Wood, 2 Ancient Steel Bar; Found in Abandoned Village chests"
	Tooltip: "[c/6CC4E8:Accessory] Rocking Horse: Accessory"
}

GearRotHeart: {
	Title: "Rot Heart"
	Contents: "[c/6CC4E8:Accessory] Equip Rot Heart. Accessory. Increases max life by 20. All boosts to life regeneration are converted into boosts to void gain. When using void, 10% of the void used is converted into life. 'Yucky!'. How to get it: Dropped by Famished"
	Tooltip: "[c/6CC4E8:Accessory] Rot Heart: Accessory"
}

GearRoyalJelly: {
	Title: "Royal Jelly"
	Contents: "[c/6CC4E8:Accessory] Equip Royal Jelly. Accessory. Increases healing received from potions by 40. 'I could make a very, very bad joke right now...'. How to get it: Dropped by Queen Bee"
	Tooltip: "[c/6CC4E8:Accessory] Royal Jelly: Accessory"
}

GearSafetySwitch: {
	Title: "Safety Switch"
	Contents: "[c/6CC4E8:Accessory] Equip Safety Switch. Accessory. Prevents you from using void weapons if doing so would drop your void below zero. How to get it: Sold by Traveling Merchant"
	Tooltip: "[c/6CC4E8:Accessory] Safety Switch: Accessory"
}

GearShatterHeartShield: {
	Title: "Shatter Heart Shield"
	Contents: "[c/6CC4E8:Accessory] Equip Shatter Heart Shield. Accessory, 1 defense. Getting hit surrounds you with ice shards. Increases max life by 20. How to get it: Craft at Anvil from 8 Frigid Bar, 1 Life Crystal"
	Tooltip: "[c/6CC4E8:Accessory] Shatter Heart Shield: Accessory, 1 defense"
}

GearShieldofDesecar: {
	Title: "Shield of Desecar"
	Contents: "[c/6CC4E8:Accessory] Equip Shield of Desecar. Accessory. Grants 1 defense for every 4 empty inventory slots. 'Less is more'. How to get it: Craft at Anvil from 1 Dissolving Earth, 20 Gold Bar; Found in world-generated chests"
	Tooltip: "[c/6CC4E8:Accessory] Shield of Desecar: Accessory"
}

GearShieldofStekpla: {
	Title: "Shield of Stekpla"
	Contents: "[c/6CC4E8:Accessory] Equip Shield of Stekpla. Accessory. Increases critical strike chance by 1% for every 4 full inventory slots. 'More is more'. How to get it: Craft at Anvil from 1 Dissolving Aurora, 20 Platinum Bar; Found in world-generated chests"
	Tooltip: "[c/6CC4E8:Accessory] Shield of Stekpla: Accessory"
}

GearShoeIce: {
	Title: "Shoe Ice"
	Contents: "[c/6CC4E8:Accessory] Equip Shoe Ice. Accessory. Allows the ability to slide down walls. Improved ability if combined with Climbing Claws or Shoe Spikes. 40% increased movement speed. 'Ice physics, everyone's favorite!'. How to get it: Craft at Anvil from 1 Shoe Spikes, 4 Fragment of Permafrost"
	Tooltip: "[c/6CC4E8:Accessory] Shoe Ice: Accessory"
}

GearSpiritGlove: {
	Title: "Spirit Glove"
	Contents: "[c/6CC4E8:Accessory] Equip Spirit Glove. Accessory. Increases void regeneration speed by 5% and melee critical strike chance by 8%. How to get it: Craft at Anvil from 32 Soul Residue, 1 Emerald, 8 Any Gold Bar"
	Tooltip: "[c/6CC4E8:Accessory] Spirit Glove: Accessory"
}

GearSpiritShield: {
	Title: "Spirit Shield"
	Contents: "[c/6CC4E8:Accessory] Equip Spirit Shield. Accessory, 2 defense. Increases void gain by 2, life regeneration by 1, and reduces damage taken by 2%. How to get it: Craft at Tinkerer's Workshop from 25 Soul Residue, 1 Emerald Bracelet, 1 Band of Regeneration"
	Tooltip: "[c/6CC4E8:Accessory] Spirit Shield: Accessory, 2 defense"
}

GearSteelerWheeler: {
	Title: "Steeler Wheeler"
	Contents: "[c/6CC4E8:Accessory] Equip Steeler Wheeler. Accessory, 1 defense. Increases movement speed by 5% and reduces damage taken by 3%. How to get it: Craft at Anvil from 8 Ancient Steel Bar; Found in Abandoned Village chests"
	Tooltip: "[c/6CC4E8:Accessory] Steeler Wheeler: Accessory, 1 defense"
}

GearSunbulb: {
	Title: "Sunbulb"
	Contents: "[c/6CC4E8:Accessory] Equip Sunbulb. Accessory. temp. How to get it: Found in Sanctuary chests"
	Tooltip: "[c/6CC4E8:Accessory] Sunbulb: Accessory"
}

GearSunlightAmulet: {
	Title: "Sunlight Amulet"
	Contents: "[c/6CC4E8:Accessory] Equip Sunlight Amulet. Accessory. Grants permanent hunter and dangersense effects. How to get it: Found in Pyramid Crate; Found in world-generated chests"
	Tooltip: "[c/6CC4E8:Accessory] Sunlight Amulet: Accessory"
}

GearSwallowedPenny: {
	Title: "Swallowed Penny"
	Contents: "[c/6CC4E8:Accessory] Equip Swallowed Penny. Accessory. Increases critical strike chance by 4%. Generate coins when hurt. 'Gulp!'. How to get it: Obtained by breaking certain tiles (pots/ores)"
	Tooltip: "[c/6CC4E8:Accessory] Swallowed Penny: Accessory"
}

GearSyntheticLiver: {
	Title: "Synthetic Liver"
	Contents: "[c/6CC4E8:Accessory] Equip Synthetic Liver. Accessory. Increases void received from food by 25%. Receiving the same buff multiple times will increase buff duration instead of resetting it, up to double the original duration. Debuff durations are drained faster, prolonging the duration of all active buffs. How to get it: Sold by Archaeologist; Found in Gem Structures chests"
	Tooltip: "[c/6CC4E8:Accessory] Synthetic Liver: Accessory"
}

GearTinyPlanet: {
	Title: "Tiny Planet"
	Contents: "[c/6CC4E8:Accessory] Equip Tiny Planet. Accessory. Surrounds you with 2 orbital projectiles. How to get it: Craft at Tinkerer's Workshop from 1 Planet Fish, 100 Stone Block; Found in world-generated chests"
	Tooltip: "[c/6CC4E8:Accessory] Tiny Planet: Accessory"
}

GearVoidAnomaly: {
	Title: "Void Anomaly"
	Contents: "[c/6CC4E8:Accessory] Equip Void Anomaly. Accessory. Increases void gain by 1 and void regeneration speed by 5%. Getting hit will convert void into life for a duration. Increases the potency of Void Shock and Void Recovery. Allows access to wormhole crafting recipes. How to get it: Convert Tainted Keystone by throwing it into a Wormhole Anomaly"
	Tooltip: "[c/6CC4E8:Accessory] Void Anomaly: Accessory"
}

GearVoidTablet: {
	Title: "Void Tablet"
	Contents: "[c/6CC4E8:Accessory] Equip Void Tablet. Accessory, 1 defense. Increases void gain by 1 and max void by 50. Reduces healing received from potions by 20. How to get it: Craft at Anvil from 50 Evostone, 4 Fragment of Earth"
	Tooltip: "[c/6CC4E8:Accessory] Void Tablet: Accessory, 1 defense"
}

GearVoidenBracelet: {
	Title: "Voiden Bracelet"
	Contents: "[c/6CC4E8:Accessory] Equip Voiden Bracelet. Accessory. Increases void damage and magic damage by 8%. Reduces void cost by 8%. How to get it: Craft at Anvil from 4 Cursed Matter, 8 Keystone Shard"
	Tooltip: "[c/6CC4E8:Accessory] Voiden Bracelet: Accessory"
}

GearWardingCharm: {
	Title: "Warding Charm"
	Contents: "[c/6CC4E8:Accessory] Equip Warding Charm. Accessory, 1 defense. How to get it: Craft at Anvil from 20 Copper Bar (+1 alternative recipe)"
	Tooltip: "[c/6CC4E8:Accessory] Warding Charm: Accessory, 1 defense"
}

GearWishingStar: {
	Title: "Wishing Star"
	Contents: "[c/6CC4E8:Accessory] Equip Wishing Star. Accessory. Temp1. Temp2. How to get it: Sold by Archaeologist; Found in world-generated chests"
	Tooltip: "[c/6CC4E8:Accessory] Wishing Star: Accessory"
}

GearZombieHand: {
	Title: "Zombie Hand"
	Contents: "[c/6CC4E8:Accessory] Equip Zombie Hand. Accessory. Allows melee swings to harm Town NPCs. 'Finally, I can kill the painter!'. How to get it: Dropped by Greek Skeleton"
	Tooltip: "[c/6CC4E8:Accessory] Zombie Hand: Accessory"
}

GearBladeGenerator: {
	Title: "Blade Generator"
	Contents: "[c/6CC4E8:Accessory] Equip Blade Generator. Accessory. Periodically accumulate up to 9 swords that rotate around you. Every 10th melee attack will launch forth the swords. How to get it: Dropped by Holo Blade"
	Tooltip: "[c/6CC4E8:Accessory] Blade Generator: Accessory"
}

GearBladeNecklace: {
	Title: "Blade Necklace"
	Contents: "[c/6CC4E8:Accessory] Equip Blade Necklace. Accessory. Increases void gain by 1. Periodically accumulate up to 9 swords that rotate around you. Every 10th melee attack will launch forth the swords. Getting hit summons 5 Souls of Retaliation into the air. Every 10th void attack will release the souls in the form of a powerful laser. How to get it: Craft at Tinkerer's Workshop from 1 Blade Generator, 1 Twilight Beads"
	Tooltip: "[c/6CC4E8:Accessory] Blade Necklace: Accessory"
}

GearBlinkPack: {
	Title: "Blink Pack"
	Contents: "[c/6CC4E8:Accessory] Equip Blink Pack. Accessory. Press 'X' to blink towards your cursor. Blinking through enemies will deal damage and trigger a lower cooldown, but can only be done up to 3 times in quick succession. Provides some immunity after dashing. Negates fall damage. How to get it: Craft at Hardlight Fabricator from 5 Fragment of Chaos, 12 Twilight Alloy; Found in world-generated chests"
	Tooltip: "[c/6CC4E8:Accessory] Blink Pack: Accessory"
}

GearBundleOfSnakes: {
	Title: "Bundle of Snakes"
	Contents: "[c/6CC4E8:Accessory] Equip Bundle of Snakes. Accessory. Increases life regeneration by 1 during the night. Attaches a Venomous Snake to all minions. How to get it: Dropped by Chimera"
	Tooltip: "[c/6CC4E8:Accessory] Bundle of Snakes: Accessory"
}

GearCalculator: {
	Title: "Calculator"
	Contents: "[c/6CC4E8:Accessory] Equip Calculator. Accessory. Summons a pet Advisor to assist in combat. Instead of attacking enemies directly, the Advisor assists with your aim. 'He really wants to help!'. How to get it: Craft at Hardlight Fabricator from 1 Primordial Cluster, 10 Hardlight Alloy; Found in world-generated chests"
	Tooltip: "[c/6CC4E8:Accessory] Calculator: Accessory"
}

GearChaosBadge: {
	Title: "Chaos Badge"
	Contents: "[c/6CC4E8:Accessory] Equip Chaos Badge. Accessory. Increases critical strike chance by 9%. How to get it: Craft at Anvil from 10 Cobalt Bar, 4 Fragment of Chaos (+1 alternative recipe)"
	Tooltip: "[c/6CC4E8:Accessory] Chaos Badge: Accessory"
}

GearChiseledBarrier: {
	Title: "Chiseled Barrier"
	Contents: "[c/6CC4E8:Accessory] Equip Chiseled Barrier. Accessory, 1 defense. Surrounds you with 4 orbital projectiles. Launches attackers away from you with javelins. Projectiles disabled when hidden. How to get it: Craft at Tinkerer's Workshop from 1 Marble Defender, 1 Arcane Aqueduct, 1 Tiny Planet"
	Tooltip: "[c/6CC4E8:Accessory] Chiseled Barrier: Accessory, 1 defense"
}

GearCircuitBoard: {
	Title: "Circuit Board"
	Contents: "[c/6CC4E8:Accessory] Equip Circuit Board. Accessory. The second charge of a Crusher has a 33% chance to not consume void. The fourth charge of Crushers no longer consumes void. Extends the range of Crushers by 1. Increases melee speed and melee damage by 5%. Increases Crusher charge speed by 10%. How to get it: Craft at Tinkerer's Workshop from 1 Crushing Amplifier, 1 Crushing Capacitor, 1 Crushing Resistor, 1 Crushing Transformer"
	Tooltip: "[c/6CC4E8:Accessory] Circuit Board: Accessory"
}

GearCursedApple: {
	Title: "Cursed Apple"
	Contents: "[c/6CC4E8:Accessory] Equip Cursed Apple. Accessory. Temp. How to get it: Obtained by breaking Strange Fruit; Sold by Archaeologist"
	Tooltip: "[c/6CC4E8:Accessory] Cursed Apple: Accessory"
}

GearGravityAnchor: {
	Title: "Gravity Anchor"
	Contents: "[c/6CC4E8:Accessory] Equip Gravity Anchor. Accessory. Normalizes gravity and grants immunity to knockback. How to get it: Dropped by Phase Assaulter; Dropped by Ultracap"
	Tooltip: "[c/6CC4E8:Accessory] Gravity Anchor: Accessory"
}

GearHeartInAJar: {
	Title: "Heart in a Jar"
	Contents: "[c/6CC4E8:Accessory] Equip Heart in a Jar. Accessory. Curses enemies within a small radius around you, draining 10 life per second. Cursed enemies release a Curse Fragment upon death, which seeks out other enemies. Curse fragments deal damage equivalent to 10% of the killed enemies max health plus an additional 10 damage. Increases max life by 20. How to get it: Found in Treasure Bag (Pharaoh's Curse)"
	Tooltip: "[c/6CC4E8:Accessory] Heart in a Jar: Accessory"
}

GearHydrokineticAntennae: {
	Title: "Hydrokinetic Antennae"
	Contents: "[c/6CC4E8:Accessory] Equip Hydrokinetic Antennae. Accessory. Use hydrokinesis to extend the effective range of melee weapons and other low-reach items, such as whips. Increases melee damage by 50% of the increases received to summon damage from other sources. Increases summon damage by 50% of the increases received to melee damage from other sources. How to get it: Dropped by Phantaray; Convert Pog Shark by throwing it into a Wormhole Anomaly"
	Tooltip: "[c/6CC4E8:Accessory] Hydrokinetic Antennae: Accessory"
}

GearOlympianAegis: {
	Title: "Olympian Aegis"
	Contents: "[c/6CC4E8:Accessory] Equip Olympian Aegis. Accessory, 3 defense. Increases void gain by 2 and life regeneration by 1. Reduces damage taken by 7% and increases critical strike chance by 4%. How to get it: Craft at Tinkerer's Workshop from 1 Granite Protector, 1 Spirit Shield, 1 Crest of Dasuver"
	Tooltip: "[c/6CC4E8:Accessory] Olympian Aegis: Accessory, 3 defense"
}

GearParticleRelocator: {
	Title: "Particle Relocator"
	Contents: "[c/6CC4E8:Accessory] Equip Particle Relocator. Accessory. When an enemy hits you, you will be teleported behind them, avoiding damage and freezing them in time temporarily. Has a 16 second cooldown, but increases melee damage by 50% for 7 seconds after teleporting. Does damage equal to your defense. How to get it: Dropped by Chaos Construct"
	Tooltip: "[c/6CC4E8:Accessory] Particle Relocator: Accessory"
}

GearPeanutButter: {
	Title: "Peanut Butter"
	Contents: "[c/6CC4E8:Accessory] Equip Peanut Butter. Accessory. Summons a pet Putrid Pinky to assist in combat. Latches onto enemies, slowing them down and draining life. Increases life regeneration by 1. How to get it: Dropped by Putrid Pinky"
	Tooltip: "[c/6CC4E8:Accessory] Peanut Butter: Accessory"
}

GearPlatformGenerator: {
	Title: "Platform Generator"
	Contents: "[c/6CC4E8:Accessory] Equip Platform Generator. Accessory. Increases summon damage by 10%. Generates 2 platforms to the left and right of you. You can right click to drag the platforms, but they will always remain symmetrical. Sentries can be summoned on top of the platforms. 'Bring your sentries with you!'. How to get it: Craft at Hardlight Fabricator from 1 Dissolving Aether, 8 Hardlight Alloy; Found in world-generated chests"
	Tooltip: "[c/6CC4E8:Accessory] Platform Generator: Accessory"
}

GearPolishedCoin: {
	Title: "Polished Coin"
	Contents: "[c/6CC4E8:Accessory] Equip Polished Coin. Accessory, 1 defense. Critical strikes have a 50% chance to deal 30 more damage. Increases critical strike chance by 2%. Immunity to Poison and Bleeding. How to get it: Craft at Tinkerer's Workshop from 1 Putrid Coin, 1 Medicated Bandage, 1 Dissolving Umbra (+1 alternative recipe)"
	Tooltip: "[c/6CC4E8:Accessory] Polished Coin: Accessory, 1 defense"
}

GearPrismarineNecklace: {
	Title: "Prismarine Necklace"
	Contents: "[c/6CC4E8:Accessory] Equip Prismarine Necklace. Accessory. Increases armor penetration by 8 and max life by 20. Release waves of damage periodically. Release more waves at lower health. Waves ignore up to 16 defense total. Waves disabled when hidden. How to get it: Craft at Tinkerer's Workshop from 1 Heart of the Sea, 1 Shark Tooth Necklace"
	Tooltip: "[c/6CC4E8:Accessory] Prismarine Necklace: Accessory"
}

GearSandwich: {
	Title: "Sandwich"
	Contents: "[c/6CC4E8:Accessory] Equip Sandwich. Accessory. Increases healing received from potions by 40. Killing enemies will drop baguette crumbs. Summons a pet Putrid Pinky to assist in combat. Latches onto enemies, slowing them down and draining life. Increases life regeneration by 1. How to get it: Craft at Cooking Pot from 1 Baguette, 1 Royal Jelly, 1 Peanut Butter"
	Tooltip: "[c/6CC4E8:Accessory] Sandwich: Accessory"
}

GearSkywareBattery: {
	Title: "Skyware Battery"
	Contents: "[c/6CC4E8:Accessory] Equip Skyware Battery. Accessory. Increases void gain by 2 and max void by 50. When hurt, 12% of damage taken is converted into void. Immunity to Broken Armor and Ichor. How to get it: Craft at Hardlight Fabricator from 1 Platinum Battery, 1 Armor Polish, 8 Starlight Alloy (+1 alternative recipe); Found in world-generated chests"
	Tooltip: "[c/6CC4E8:Accessory] Skyware Battery: Accessory"
}

GearSoulOfTheKeeper: {
	Title: "Soul of the Keeper"
	Contents: "[c/6CC4E8:Accessory] Equip Soul of the Keeper. Accessory, 1 defense. Increases mining speed by 5% and critical strike chance by 5%. Generate coins when hurt and don't lose coins upon death. Mining blocks has a chance to drop bonus resources, such as coins and silt. How to get it: Craft at Tinkerer's Workshop from 1 Swallowed Penny, 1 Keeper's Box, 1 Golden Trowel"
	Tooltip: "[c/6CC4E8:Accessory] Soul of the Keeper: Accessory, 1 defense"
}

GearStarbelt: {
	Title: "Starbelt"
	Contents: "[c/6CC4E8:Accessory] Equip Starbelt. Accessory. Critical strikes recover mana. Increases max mana by 40. Increases magic critical strike chance by 10%. How to get it: Craft at Hardlight Fabricator from 1 Mana Crystal, 1 Dissolving Aether, 8 Starlight Alloy; Found in world-generated chests"
	Tooltip: "[c/6CC4E8:Accessory] Starbelt: Accessory"
}

GearThermalPolarizer: {
	Title: "Thermal Polarizer"
	Contents: "[c/6CC4E8:Accessory] Equip Thermal Polarizer. Accessory. Increases max life, mana, and void by 20. Changes the effects of thermal dissolving elements in your inventory. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Dissolving Nether, 1 Dissolving Aurora, 5 Ancient Steel Bar, 5 Frigid Bar, 5 Hellstone Bar"
	Tooltip: "[c/6CC4E8:Accessory] Thermal Polarizer: Accessory"
}

GearTwilightBeads: {
	Title: "Twilight Beads"
	Contents: "[c/6CC4E8:Accessory] Equip Twilight Beads. Accessory. Increases void gain by 1. Getting hit summons 5 Souls of Retaliation into the air. Every 10th void attack will release the souls in the form of a powerful laser. How to get it: Dropped by Phase Speeder"
	Tooltip: "[c/6CC4E8:Accessory] Twilight Beads: Accessory"
}

GearTwilightGyroscope: {
	Title: "Twilight Gyroscope"
	Contents: "[c/6CC4E8:Accessory] Equip Twilight Gyroscope. Accessory. Increases jump height and flight speed. Increases movement speed by 20%. Hold down to fall quickly to the floor. Provides immunity to fall damage. How to get it: Found in Treasure Bag (The Advisor)"
	Tooltip: "[c/6CC4E8:Accessory] Twilight Gyroscope: Accessory"
}

GearVibrancyModule: {
	Title: "Vibrancy Module"
	Contents: "[c/6CC4E8:Accessory] Equip Vibrancy Module. Accessory. Increases void attack speed by 10%. Reduces void cost by 10%. How to get it: Craft at Hardlight Fabricator from 8 Vibrant Alloy, 12 Twilight Alloy; Found in world-generated chests"
	Tooltip: "[c/6CC4E8:Accessory] Vibrancy Module: Accessory"
}

GearVoidCharm: {
	Title: "Void Charm"
	Contents: "[c/6CC4E8:Accessory] Equip Void Charm. Accessory. Critical strikes have a 50% chance to regenerate void. Increases critical strike chance by 1%. How to get it: Craft at Mythril/Orichalcum Anvil from 4 Chocolate, 4 Fragment of Tide"
	Tooltip: "[c/6CC4E8:Accessory] Void Charm: Accessory"
}

GearWispInAJar: {
	Title: "Wisp in a Jar"
	Contents: "[c/6CC4E8:Accessory] Equip Wisp in a Jar. Accessory. Summons a Inferno Wisp that assists in combat. Killed enemies explode into flames for 30% of the damage dealt to them on the killing blow. How to get it: Craft at Mythril/Orichalcum Anvil from 20 Glass, 1 Dissolving Nether, 8 Bluefire Potion"
	Tooltip: "[c/6CC4E8:Accessory] Wisp in a Jar: Accessory"
}

GearWitchHeart: {
	Title: "Witch's Heart"
	Contents: "[c/6CC4E8:Accessory] Equip Witch's Heart. Accessory. Increases critical strike chance by 5%. Critical strikes unleash Nightmare Arms that do 10% damage and pull enemies together. Has a 6 second cooldown. Increases max life by 20. How to get it: Craft at Mythril/Orichalcum Anvil from 4 Life Fruit, 1 Dissolving Umbra, 8 Nightmare Potion"
	Tooltip: "[c/6CC4E8:Accessory] Witch's Heart: Accessory"
}

GearWorldlyPolarizer: {
	Title: "Worldly Polarizer"
	Contents: "[c/6CC4E8:Accessory] Equip Worldly Polarizer. Accessory. Increases damage, endurance, and movement speed by 2%. Changes the effects of worldly dissolving elements in your inventory. How to get it: Craft at Anvil from 1 Dissolving Nature, 1 Dissolving Earth, 1 Dissolving Deluge, 5 Ancient Steel Bar, 5 Vibrant Alloy"
	Tooltip: "[c/6CC4E8:Accessory] Worldly Polarizer: Accessory"
}

GearAlchemistsCharm: {
	Title: "Alchemist's Charm"
	Contents: "[c/6CC4E8:Accessory] Equip Alchemist's Charm. Accessory. Increases healing and mana received from potions by 100. Increases buff duration by 67%. Increases life regeneration by 2 and reduces the cooldown of healing potions by 25%. How to get it: Craft at Tinkerer's Workshop from 1 Charm of Myths, 1 Lihzahrd Tail, 1 Glow Jelly, 10 Ectoplasm"
	Tooltip: "[c/6CC4E8:Accessory] Alchemist's Charm: Accessory"
}

GearBagOfCharms: {
	Title: "Bag of Charms"
	Contents: "[c/6CC4E8:Accessory] Equip Bag of Charms. Accessory. Increases critical strike chance by 5%. Critical strikes may detonate enemies for 100% damage. Critical strikes steal life, regenerate void, and recover mana. How to get it: Craft at Tinkerer's Workshop from 1 Cursed Icosahedron, 1 Soul Charm, 10 Phase Bar"
	Tooltip: "[c/6CC4E8:Accessory] Bag of Charms: Accessory"
}

GearBlazingQuiver: {
	Title: "Blazing Quiver"
	Contents: "[c/6CC4E8:Accessory] Equip Blazing Quiver. Accessory. Increases ranged damage by 10% and greatly increases arrow speed. 20% chance not to consume arrows. Converts wooden arrows into Blazing Arrows. Blazing Arrows ignore gravity, pierce once, and explode for 15% damage. How to get it: Craft at Tinkerer's Workshop from 1 Molten Quiver, 1 Dissolving Nether, 5 Fragment of Inferno, 10 Soul of Fright"
	Tooltip: "[c/6CC4E8:Accessory] Blazing Quiver: Accessory"
}

GearBorealisIcosahedron: {
	Title: "Borealis Icosahedron"
	Contents: "[c/6CC4E8:Accessory] Equip Borealis Icosahedron. Accessory. Critical strikes may cause a frostburn explosion, dealing 200% damage. Increases critical strike chance by 1%. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Dissolving Aurora, 1 Frost Core, 6 Absolute Alloy"
	Tooltip: "[c/6CC4E8:Accessory] Borealis Icosahedron: Accessory"
}

GearBulwarkOfTheAncients: {
	Title: "Bulwark of the Ancients"
	Contents: "[c/6CC4E8:Accessory] Equip Bulwark of the Ancients. Accessory, 6 defense. Grants immunity to knockback and fire blocks. Grants immunity to most debuffs. Increases void gain by 2, life regeneration by 1, reduces damage taken by 5%, and increases critical strike chance by 4%. Surrounds you with 4 orbital projectiles. Projectiles disabled when hidden. How to get it: Craft at Tinkerer's Workshop from 1 Olympian Aegis, 1 Chiseled Barrier, 1 Ankh Shield, 1 Terminal Cluster"
	Tooltip: "[c/6CC4E8:Accessory] Bulwark of the Ancients: Accessory, 6 defense"
}

GearCursedIcosahedron: {
	Title: "Cursed Icosahedron"
	Contents: "[c/6CC4E8:Accessory] Equip Cursed Icosahedron. Accessory. Critical strikes may cause a release of cursed thunder, dealing 100% damage. Critical strikes may also cause frostburn or flaming explosions, dealing 100% damage. Increases critical strike chance by 2%. How to get it: Craft at Tinkerer's Workshop from 1 Borealis Icosahedron, 1 Hellfire Icosahedron, 1 Dissolving Umbra, 10 Cursed Flame"
	Tooltip: "[c/6CC4E8:Accessory] Cursed Icosahedron: Accessory"
}

GearExoticPolarizer: {
	Title: "Exotic Polarizer"
	Contents: "[c/6CC4E8:Accessory] Equip Exotic Polarizer. Accessory. Increases jump speed, life regeneration, and void gain by 2. Changes the effects of exotic dissolving elements in your inventory. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Dissolving Aether, 1 Dissolving Brilliance, 1 Dissolving Umbra, 5 Ancient Steel Bar, 5 Phase Bar"
	Tooltip: "[c/6CC4E8:Accessory] Exotic Polarizer: Accessory"
}

GearEyeOfChaos: {
	Title: "Eye of Chaos"
	Contents: "[c/6CC4E8:Accessory] Equip Eye of Chaos. Accessory. Increases critical strike chance by 18%. How to get it: Craft at Tinkerer's Workshop from 1 Snake Eyes, 1 Chaos Badge, 1 Eyeofthe Golem"
	Tooltip: "[c/6CC4E8:Accessory] Eye of Chaos: Accessory"
}

GearFlashsparkBoots: {
	Title: "Flashspark Boots"
	Contents: "[c/6CC4E8:Accessory] Equip Flashspark Boots. Accessory. Provides tremendous acceleration while running. Also provides flight and extra mobility on ice. Increases movement speed greatly. Provides the ability to walk on water and lava. Grants immunity to fire blocks and 10 seconds of immunity to lava. Running causes you to blast forward, granting higher... How to get it: Craft at Tinkerer's Workshop from 1 Terraspark Boots, 12 Absolute Alloy"
	Tooltip: "[c/6CC4E8:Accessory] Flashspark Boots: Accessory"
}

GearFocusCrystal: {
	Title: "Focus Crystal"
	Contents: "[c/6CC4E8:Accessory] Equip Focus Crystal. Accessory, 1 defense. Critical strikes deal 40 more damage. Increases critical strike chance by 4%. Immunity to Poison and Bleeding. How to get it: Craft at Tinkerer's Workshop from 1 Polished Coin, 1 Otherworldly Amplifier, 1 Dissolving Nether, 5 Fragment of Inferno, 5 Soul of Plight"
	Tooltip: "[c/6CC4E8:Accessory] Focus Crystal: Accessory, 1 defense"
}

GearFocusReticle: {
	Title: "Focus Reticle"
	Contents: "[c/6CC4E8:Accessory] Equip Focus Reticle. Accessory, 1 defense. Increases critical strike chance by 20%. Critical strikes deal 40 more damage. Immunity to bleeding and poisoned debuffs. How to get it: Craft at Tinkerer's Workshop from 1 Focus Crystal, 1 Eye of Chaos, 10 Sanguite Scales"
	Tooltip: "[c/6CC4E8:Accessory] Focus Reticle: Accessory, 1 defense"
}

GearFoggyClairvoyance: {
	Title: "Foggy Clairvoyance"
	Contents: "[c/6CC4E8:Accessory] Equip Foggy Clairvoyance. Accessory. Increases damage by 15% and grants immunity to most debuffs. 'Cursed'. How to get it: Craft at Mythril/Orichalcum Anvil from 15 Sanguite Scales, 1 Primordial Cluster"
	Tooltip: "[c/6CC4E8:Accessory] Foggy Clairvoyance: Accessory"
}

GearFortressGenerator: {
	Title: "Fortress Generator"
	Contents: "[c/6CC4E8:Accessory] Equip Fortress Generator. Accessory, 6 defense. Increases max minions and max sentries by 1. Increases damage by 10% and life regeneration by 2. Generates 4 platforms to the left and right of you. You can right click to drag the platforms, but they will always remain symmetrical. Sentries can be summoned on top of the platforms. Absorbs 25% of... How to get it: Craft at Tinkerer's Workshop from 1 Platform Generator, 1 Paladins Shield, 1 Pygmy Necklace, 1 Any T 2 DD 2 Armor, 1 Any T 2 DD 2 Accessory, 10 Spectre Bar, 1 Dissolving Deluge"
	Tooltip: "[c/6CC4E8:Accessory] Fortress Generator: Accessory, 6 defense"
}

GearFrigidHourglass: {
	Title: "Frigid Hourglass"
	Contents: "[c/6CC4E8:Accessory] Equip Frigid Hourglass. Accessory. Freezes your void meter for 15 seconds every minute. Provides immunity to Slow, Chilled, Frozen, and Frostburn. Increases movement speed by 10%. How to get it: Found in Treasure Bag (Polaris)"
	Tooltip: "[c/6CC4E8:Accessory] Frigid Hourglass: Accessory"
}

GearGreedierRing: {
	Title: "Greedier Ring"
	Contents: "[c/6CC4E8:Accessory] Equip Greedier Ring. Accessory, 2 defense. Increases mining speed by 5% and critical strike chance by 5%. Generate coins when hurt or when void is gained and don't lose coins upon death. Mining blocks has a chance to drop bonus resources, such as coins and silt. Increases coin pickup range and shops prices lowered by 20%. Hitting enemies... How to get it: Craft at Tinkerer's Workshop from 1 Soul of the Keeper, 1 Greedy Ring, 1 Mammon's Ring, 1 Dissolving Aether"
	Tooltip: "[c/6CC4E8:Accessory] Greedier Ring: Accessory, 2 defense"
}

GearHyperdrive: {
	Title: "Hyperdrive"
	Contents: "[c/6CC4E8:Accessory] Equip Hyperdrive. Accessory. The second charge of a Crusher has a 33% chance to not consume void. The fourth charge of Crushers no longer consume void. Extends the range of Crushers by 1. Increases attack speed by 25% and melee damage by 5%. Reduces void cost by 10%. How to get it: Craft at Tinkerer's Workshop from 20 Phase Bar, 1 Circuit Board, 1 Vibrancy Module"
	Tooltip: "[c/6CC4E8:Accessory] Hyperdrive: Accessory"
}

GearLihzahrdTail: {
	Title: "Lihzahrd Tail"
	Contents: "[c/6CC4E8:Accessory] Equip Lihzahrd Tail. Accessory. Increases buff duration by 67%. Increases healing and mana received from potions by 50. How to get it: Dropped by Lihzahrd Crawler; Found in world-generated chests"
	Tooltip: "[c/6CC4E8:Accessory] Lihzahrd Tail: Accessory"
}

GearMidnightPrism: {
	Title: "Midnight Prism"
	Contents: "[c/6CC4E8:Accessory] Equip Midnight Prism. Accessory. Increases armor penetration by 8, critical strike chance by 5%, and max life by 40. Release waves of damage periodically that ignore up to 16 defense total. Release more waves at lower health. Critical strikes unleash Nightmare Arms that do 10% damage and pull enemies together. Has a 6 second coo... How to get it: Craft at Tinkerer's Workshop from 1 Prismarine Necklace, 1 Witch's Heart"
	Tooltip: "[c/6CC4E8:Accessory] Midnight Prism: Accessory"
}

GearPermafrostMedallion: {
	Title: "Permafrost Medallion"
	Contents: "[c/6CC4E8:Accessory] Equip Permafrost Medallion. Accessory. Surrounds you with a blizzard of artifact probes that fire lasers at nearby enemies. How to get it: Craft at Mythril/Orichalcum Anvil from 7 Absolute Alloy, 1 Night Illuminator"
	Tooltip: "[c/6CC4E8:Accessory] Permafrost Medallion: Accessory"
}

GearPlasmaShrimp: {
	Title: "Plasma Shrimp"
	Contents: "[c/6CC4E8:Accessory] Equip Plasma Shrimp. Accessory. When above 40% mana, magic weapons fire additional, hot, shrimpy plasma for 50% damage. Reduces mana cost by 5%. 'Not so shrimple now'. How to get it: Craft at Tinkerer's Workshop from 1 Pistol Shrimp, 1 Sorcerer Emblem, 1 Dissolving Deluge"
	Tooltip: "[c/6CC4E8:Accessory] Plasma Shrimp: Accessory"
}

GearSerpentSpine: {
	Title: "Serpent Spine"
	Contents: "[c/6CC4E8:Accessory] Equip Serpent Spine. Accessory. Increases melee weapon size by 40% and whip length by 40%. Increases melee speed by 10%. Melee and whip attacks may scorch enemies, increasing damage dealt by 3% permanently. How to get it: Found in Treasure Bag (Subspace Serpent)"
	Tooltip: "[c/6CC4E8:Accessory] Serpent Spine: Accessory"
}

GearShardGuard: {
	Title: "Shard Guard"
	Contents: "[c/6CC4E8:Accessory] Equip Shard Guard. Accessory, 1 defense. Puts a shell around the owner when below 50% life that reduces damage by 25%. Surrounds you with a blizzard of artifact probes that fire lasers at nearby enemies. Getting hit surrounds you with ice shards. Increases max life by 20. How to get it: Craft at Tinkerer's Workshop from 1 Dissolving Aurora, 1 Frozen Turtle Shell, 1 Permafrost Medallion, 1 Shatter Heart Shield"
	Tooltip: "[c/6CC4E8:Accessory] Shard Guard: Accessory, 1 defense"
}

GearSoulCharm: {
	Title: "Soul Charm"
	Contents: "[c/6CC4E8:Accessory] Equip Soul Charm. Accessory. Critical strikes steal life, regenerate void, and recover mana. Increases critical strike chance by 2%. How to get it: Craft at Tinkerer's Workshop from 1 Clover Charm, 1 Void Charm, 1 Starbelt, 1 Dissolving Deluge"
	Tooltip: "[c/6CC4E8:Accessory] Soul Charm: Accessory"
}

GearSpiritInsignia: {
	Title: "Spirit Insignia"
	Contents: "[c/6CC4E8:Accessory] Equip Spirit Insignia. Accessory. Grants infinite wing and rocket boot flight. Increases flight and jump mobility. Increases void gain by 1 and void regeneration speed by 25%. Doubles damage done to non-Lux spirit enemies. How to get it: Craft at Tinkerer's Workshop from 1 Spirit Symphony, 1 Empress Flight Booster, 1 Dissolving Brilliance"
	Tooltip: "[c/6CC4E8:Accessory] Spirit Insignia: Accessory"
}

GearSpiritSymphony: {
	Title: "Spirit Symphony"
	Contents: "[c/6CC4E8:Accessory] Equip Spirit Symphony. Accessory. Increases void gain by 1 and void regeneration speed by 25%. Doubles damage done to non-Lux spirit enemies. How to get it: Found in Treasure Bag (Lux)"
	Tooltip: "[c/6CC4E8:Accessory] Spirit Symphony: Accessory"
}

GearSupernovaEmblem: {
	Title: "Supernova Emblem"
	Contents: "[c/6CC4E8:Accessory] Equip Supernova Emblem. Accessory. Killing enemies releases a seeker for 150% damage. Enemies killed by seekers release 2 seekers instead, each doing 75% damage. Increases melee damage by 15%. Increases void gain by 2 and max void by 50. When hurt, 12% of damage taken is converted into void. Immunity to Broken Armor and Ichor. How to get it: Craft at Tinkerer's Workshop from 1 Supernova Hammer, 1 Skyware Battery, 1 Warrior Emblem, 1 Dissolving Nether"
	Tooltip: "[c/6CC4E8:Accessory] Supernova Emblem: Accessory"
}

GearTheDarkEye: {
	Title: "The Dark Eye"
	Contents: "[c/6CC4E8:Accessory] Equip The Dark Eye. Accessory. Allows the ability to perform an instant dash to the left or right at the cost of 5 void. Also allows the ability to dash through walls. Dashing into enemies will strike them, but consumes more void. How to get it: Dropped by Wall Mimic"
	Tooltip: "[c/6CC4E8:Accessory] The Dark Eye: Accessory"
}

GearUltimatePolarizer: {
	Title: "Ultimate Polarizer"
	Contents: "[c/6CC4E8:Accessory] Equip Ultimate Polarizer. Accessory. Increases damage, endurance, and movement speed by 2%. Increases max life, mana, and void by 20. Increases jump speed, life regeneration, and void gain by 2. Changes the effects of all dissolving elements in your inventory. How to get it: Craft at Tinkerer's Workshop from 1 Exotic Polarizer, 1 Thermal Polarizer, 1 Worldly Polarizer"
	Tooltip: "[c/6CC4E8:Accessory] Ultimate Polarizer: Accessory"
}

GearVoidmageIncubator: {
	Title: "Voidmage Incubator"
	Contents: "[c/6CC4E8:Accessory] Equip Voidmage Incubator. Accessory. Epic Gamer. Increases void gain by 2. Getting hit will freeze time, converting void into life for the duration. Increases the potency of Void Shock and Void Recovery. Allows access to wormhole crafting recipes. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Void Anomaly, 1 Dissolving Brilliance, 100 Skip Shard"
	Tooltip: "[c/6CC4E8:Accessory] Voidmage Incubator: Accessory"
}

GearVoidspaceEmblem: {
	Title: "Voidspace Emblem"
	Contents: "[c/6CC4E8:Accessory] Equip Voidspace Emblem. Accessory. Increases void damage and magic damage by 10%. Increases void critical strike chance by 10%. Critical strikes heal small amounts of void. Reduces void cost by 8%. Increases void gain by 4 and max void by 50. Regenerate void when hit. Immunity to Broken Armor and Ichor. How to get it: Craft at Mythril/Orichalcum Anvil from 15 Sanguite Scales, 1 Goopwood Parasite, 1 Voiden Bracelet, 1 Skyware Battery"
	Tooltip: "[c/6CC4E8:Accessory] Voidspace Emblem: Accessory"
}

GearGildedBladeWings: {
	Title: "Gilded Blade Wings"
	Contents: "[c/6CC4E8:Accessory] Equip Gilded Blade Wings. Accessory. Allows infinite flight and slow fall. Increases void gain by 3 and void regeneration speed by 25%. Doubles damage done to non-Lux spirit enemies. Press 'X' to gain fast, multidirectional flight. Hold 'X' to fly slower while in the special flight mode. How to get it: Craft at Tinkerer's Workshop from 1 Machina Booster, 1 Spirit Insignia"
	Tooltip: "[c/6CC4E8:Accessory] Gilded Blade Wings: Accessory"
}

GearInfiniteVoid: {
	Title: "Infinite Void"
	Contents: "[c/6CC4E8:Accessory] Equip Infinite Void. Accessory. Increases max void by 10000. How to get it: Obtained in-world (source not found) [c/9AA0A6:(source unconfirmed)]"
	Tooltip: "[c/6CC4E8:Accessory] Infinite Void: Accessory"
}

GearMachinaBooster: {
	Title: "Machina Booster"
	Contents: "[c/6CC4E8:Accessory] Equip Machina Booster. Accessory. Allows flight and slow fall. Increases void gain by 1. Press 'X' to gain fast, multidirectional flight at the cost of 5 void. Increases void drain by 3 while active. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Twilight Gyroscope, 1 Dissolving Aether, 20 Starlight Alloy, 20 Soul of Flight (+1 alternative recipe)"
	Tooltip: "[c/6CC4E8:Accessory] Machina Booster: Accessory"
}

GearSubspaceBoosters: {
	Title: "Subspace Boosters"
	Contents: "[c/6CC4E8:Accessory] Equip Subspace Boosters. Accessory. Provides tremendous acceleration while running. Also provides flight and extra mobility on ice. Increases movement speed greatly. Provides the ability to walk on water and lava. Grants immunity to fire blocks and 10 seconds of immunity to lava. Double tap dash while on the ground to blast forward... How to get it: Craft at Tinkerer's Workshop from 1 Flashspark Boots, 1 Tabi, 12 Sanguite Scales"
	Tooltip: "[c/6CC4E8:Accessory] Subspace Boosters: Accessory"
}

GearSubspaceLocket: {
	Title: "Subspace Locket"
	Contents: "[c/6CC4E8:Accessory] Equip Subspace Locket. Accessory. Summons a Subspace Servant to assist in combat. Uses the item in your last inventory slot for you. Decreases damage by 25% multiplicatively. Increases max void by 50, but reduces healing received from potions by 40. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Terminal Cluster, 1 Primordial Cluster, 1 Void Tablet, 15 Sanguite Scales"
	Tooltip: "[c/6CC4E8:Accessory] Subspace Locket: Accessory"
}

GearAbyssalTonic: {
	Title: "Abyssal Tonic"
	Contents: "[c/79BD84:Potion] Obtain Abyssal Tonic. Buffs: Gills, Ripple, Flipper, Calm. Randomly receive 2 of the following: Gills for 15 minutes. Flipper for 13 minutes. Ripple for 11 minutes. Calm for 9 minutes. How to get it: Craft by hand from 1 Dissolving Deluge; Found in world-generated chests"
	Tooltip: "[c/79BD84:Potion] Abyssal Tonic: Buffs: Gills, Ripple, Flipper, Calm"
}

GearAssassinationPotion: {
	Title: "Assassination Potion"
	Contents: "[c/79BD84:Potion] Obtain Assassination Potion. Buff: Assassination, 12 min. Execute enemies below 10% health. How to get it: Craft at Placed Bottle from 1 Bottled Water, 10 Twilight Gel, 1 Fragment of Otherworld, 1 Fireblossom; Found in world-generated chests; Found in Gem Structures chests"
	Tooltip: "[c/79BD84:Potion] Assassination Potion: Buff: Assassination, 12 min"
}

GearBlazingTonic: {
	Title: "Blazing Tonic"
	Contents: "[c/79BD84:Potion] Obtain Blazing Tonic. Buffs: Bluefire, Inferno, Obsidian Skin, Magic Power. Randomly receive 2 of the following: Bluefire for 15 minutes. Inferno for 13 minutes. Obsidian Skin for 11 minutes. Magic Power for 9 minutes. 'Is this really safe to drink?'. How to get it: Craft by hand from 1 Dissolving Nether; Dropped by Void Treasure Slime"
	Tooltip: "[c/79BD84:Potion] Blazing Tonic: Buffs: Bluefire, Inferno, Obsidian Skin, Magic Power"
}

GearBlightfulTonic: {
	Title: "Blightful Tonic"
	Contents: "[c/79BD84:Potion] Obtain Blightful Tonic. Buffs: Ironskin, Swiftness, Regeneration. Randomly receive 2 of the following: Ironskin for 15 minutes. Good Vibes for 13 minutes. Swiftness for 11 minutes. Regeneration for 9 minutes. How to get it: Craft by hand from 1 Dissolving Nature; Found in world-generated chests"
	Tooltip: "[c/79BD84:Potion] Blightful Tonic: Buffs: Ironskin, Swiftness, Regeneration"
}

GearBluefirePotion: {
	Title: "Bluefire Potion"
	Contents: "[c/79BD84:Potion] Obtain Bluefire Potion. Buff: Bluefire, 4.1 min. Killed enemies explode into flames for 40% of the damage dealt to them on the killing blow. How to get it: Craft at Placed Bottle from 1 Bottled Water, 1 Fragment of Inferno, 1 Living Fire Block, 1 Fireblossom; Obtained by breaking Evostone Pot; Found in Gem Structures chests; Found in Sanctuary chests"
	Tooltip: "[c/79BD84:Potion] Bluefire Potion: Buff: Bluefire, 4.1 min"
}

GearBrittlePotion: {
	Title: "Brittle Potion"
	Contents: "[c/79BD84:Potion] Obtain Brittle Potion. Buff: Brittle, 4.1 min. Getting hit surrounds you with ice shards. How to get it: Craft at Placed Bottle from 1 Bottled Water, 1 Fragment of Permafrost, 1 Shiverthorn; Found in world-generated chests; Found in Gem Structures chests"
	Tooltip: "[c/79BD84:Potion] Brittle Potion: Buff: Brittle, 4.1 min"
}

GearDoubleVisionPotion: {
	Title: "Double Vision Potion"
	Contents: "[c/79BD84:Potion] Obtain Double Vision Potion. Buff: Double Vision. Adds additional lines to your fishing rod, stacks with itself. Maxes out at 6 additional lines. How to get it: Craft at Placed Bottle from 1 Bottled Water, 1 Curgeon, 1 Phantom Fish, 1 Water Snake, 1 Fragment of Tide, 1 Shiverthorn; Found in world-generated chests"
	Tooltip: "[c/79BD84:Potion] Double Vision Potion: Buff: Double Vision"
}

GearEtherealTonic: {
	Title: "Ethereal Tonic"
	Contents: "[c/79BD84:Potion] Obtain Ethereal Tonic. Buffs: Harmony, Lifeforce, Regeneration, Magic Power. Receive the following: Harmony for 15 minutes. Lifeforce for 13 minutes. Regeneration for 11 minutes. Magic Power for 9 minutes. How to get it: Craft by hand from 1 Dissolving Brilliance"
	Tooltip: "[c/79BD84:Potion] Ethereal Tonic: Buffs: Harmony, Lifeforce, Regeneration, Magic Power"
}

GearGlacialTonic: {
	Title: "Glacial Tonic"
	Contents: "[c/79BD84:Potion] Obtain Glacial Tonic. Buffs: Warmth, Titan, Mana Regeneration. Randomly receive 2 of the following: Warmth for 15 minutes. Brittle for 13 minutes. Titan for 11 minutes. Mana Regeneration for 9 minutes. How to get it: Craft by hand from 1 Dissolving Aurora; Found in world-generated chests"
	Tooltip: "[c/79BD84:Potion] Glacial Tonic: Buffs: Warmth, Titan, Mana Regeneration"
}

GearHarmonyPotion: {
	Title: "Harmony Potion"
	Contents: "[c/79BD84:Potion] Obtain Harmony Potion. Buff: Harmony, 6.1 min. Prevents other buffs from decaying while active. Doesn't work on most buffs with below 30 seconds remaining. How to get it: Craft at Placed Bottle from 1 Bottled Water, 1 Fragment of Chaos, 1 Princess Fish, 1 Soul of Light, 1 Unicorn Horn, 1 Daybloom"
	Tooltip: "[c/79BD84:Potion] Harmony Potion: Buff: Harmony, 6.1 min"
}

GearHereticTonic: {
	Title: "Heretic Tonic"
	Contents: "[c/79BD84:Potion] Obtain Heretic Tonic. Buffs: Nightmare, Rage, Wrath, Ammo Reservation. Randomly receive 2 of the following: Nightmare for 15 minutes. Wrath for 13 minutes. Rage for 13 minutes. Ammo Reservation for 9 minutes. 'The world around you follows your example'. How to get it: Craft by hand from 1 Dissolving Umbra; Dropped by Void Treasure Slime"
	Tooltip: "[c/79BD84:Potion] Heretic Tonic: Buffs: Nightmare, Rage, Wrath, Ammo Reservation"
}

GearNightmarePotion: {
	Title: "Nightmare Potion"
	Contents: "[c/79BD84:Potion] Obtain Nightmare Potion. Buff: Nightmare, 6.1 min. Critical strikes unleash Nightmare Arms that do 10% damage and pull enemies together. Has a 6 second cooldown. How to get it: Craft at Placed Bottle from 1 Bottled Water, 1 Fragment of Evil, 1 Planet Fish, 1 Soul of Night, 1 Deathweed; Obtained by breaking AV Pot; Found in Abandoned Village chests; Found in Gem Structures chests; and 1 more sources"
	Tooltip: "[c/79BD84:Potion] Nightmare Potion: Buff: Nightmare, 6.1 min"
}

GearRipplePotion: {
	Title: "Ripple Potion"
	Contents: "[c/79BD84:Potion] Obtain Ripple Potion. Buff: Ripple, 7.1 min. Release waves of damaging water periodically. Release more waves at lower health. Waves ignore up to 8 defense. How to get it: Craft at Placed Bottle from 1 Bottled Water, 1 Fragment of Tide, 1 Waterleaf, 1 Fireblossom; Found in Gem Structures chests; Found in Sanctuary chests"
	Tooltip: "[c/79BD84:Potion] Ripple Potion: Buff: Ripple, 7.1 min"
}

GearRoughskinPotion: {
	Title: "Roughskin Potion"
	Contents: "[c/79BD84:Potion] Obtain Roughskin Potion. Buff: Roughskin, 5.3 min. Increases defense by 4 and damage by 4%. How to get it: Craft at Placed Bottle from 1 Bottled Water, 1 Fragment of Earth, 8 Snakeskin, 1 Blinkroot (+1 alternative recipe); Found in Pyramid Crate; Obtained by breaking Pyramid Pot; Found in world-generated chests"
	Tooltip: "[c/79BD84:Potion] Roughskin Potion: Buff: Roughskin, 5.3 min"
}

GearSeismicTonic: {
	Title: "Seismic Tonic"
	Contents: "[c/79BD84:Potion] Obtain Seismic Tonic. Buffs: Ironskin, Endurance. Randomly receive 2 of the following: Ironskin for 15 minutes. Soul Access for 13 minutes. Endurance for 11 minutes. Roughskin for 9 minutes. How to get it: Craft by hand from 1 Dissolving Earth; Found in world-generated chests"
	Tooltip: "[c/79BD84:Potion] Seismic Tonic: Buffs: Ironskin, Endurance"
}

GearSoulAccessPotion: {
	Title: "Soul Access Potion"
	Contents: "[c/79BD84:Potion] Obtain Soul Access Potion. Buff: Soul Access, 6.1 min. Increases void regeneration speed by 10%. How to get it: Craft at Placed Bottle from 1 Bottled Water, 1 Phantom Fish, 1 Soul Residue, 1 Peanut, 1 Deathweed; Found in Pyramid Crate; Obtained by breaking Pyramid Pot; Found in world-generated chests; and 1 more sources"
	Tooltip: "[c/79BD84:Potion] Soul Access Potion: Buff: Soul Access, 6.1 min"
}

GearStabilizingTonic: {
	Title: "Stabilizing Tonic"
	Contents: "[c/79BD84:Potion] Obtain Stabilizing Tonic. Buff: Hyperphantasia, 20 min. 'Tastes like... water?'. How to get it: Craft by hand from 1 Essence of Emptiness"
	Tooltip: "[c/79BD84:Potion] Stabilizing Tonic: Buff: Hyperphantasia, 20 min"
}

GearStarlightTonic: {
	Title: "Starlight Tonic"
	Contents: "[c/79BD84:Potion] Obtain Starlight Tonic. Buffs: Magic Power, Heartreach, Mana Regeneration. Receive the following: Assassination for 15 minutes. Magic Power for 13 minutes. Heartreach for 11 minutes. Mana Regeneration for 9 minutes. How to get it: Craft by hand from 1 Dissolving Aether; Found in world-generated chests"
	Tooltip: "[c/79BD84:Potion] Starlight Tonic: Buffs: Magic Power, Heartreach, Mana Regeneration"
}

GearVibePotion: {
	Title: "Vibe Potion"
	Contents: "[c/79BD84:Potion] Obtain Vibe Potion. Buff: Good Vibes, 6 min. Increases attack speed by 20% while not moving and by 5% while moving. Increases life regeneration by 4 while not moving. How to get it: Craft at Placed Bottle from 1 Bottled Water, 1 Fragment of Nature, 1 Daybloom; Found in world-generated chests; Found in Gem Structures chests"
	Tooltip: "[c/79BD84:Potion] Vibe Potion: Buff: Good Vibes, 6 min"
}

GearVigorPotion: {
	Title: "Vigor Potion"
	Contents: "[c/79BD84:Potion] Obtain Vigor Potion. Buff: Vigor, 20 min. Grants the ability to dash 50 times. How to get it: Craft at Placed Bottle from 1 Bottled Water, 1 Pink Petal, 1 Shiverthorn, 1 Daybloom; Obtained by breaking Evostone Pot; Found in Sanctuary chests"
	Tooltip: "[c/79BD84:Potion] Vigor Potion: Buff: Vigor, 20 min"
}

GearPlagueSpitter: {
	Title: "Acid Belcher"
	Contents: "[c/E2735C:Weapon] Obtain Acid Belcher. 13 magic damage, use time 10, 5 mana. Charge up to 30 high-velocity acid balls that can be fired in quick succession. Struck enemies are temporarily coated in acid, increasing the damage they receive from all subsequent acid balls by 20%. Acid-coated enemies also take 10 damage per second per stack of acid. How to get it: Found in Abandoned Village chests"
	Tooltip: "[c/E2735C:Weapon] Acid Belcher: 13 magic damage, use time 10, 5 mana"
}

GearAcornBag: {
	Title: "Acorn Bag"
	Contents: "[c/E2735C:Weapon] Obtain Acorn Bag. 6 summon damage, use time 36, 9 mana. Summons a squirrel to fight for you. How to get it: Craft at Work Bench from 20 Any Wood, 4 Fragment of Nature, 10 Acorn"
	Tooltip: "[c/E2735C:Weapon] Acorn Bag: 6 summon damage, use time 36, 9 mana"
}

GearAncientSteelHalberd: {
	Title: "Ancient Steel Halberd"
	Contents: "[c/E2735C:Weapon] Obtain Ancient Steel Halberd. 6 melee damage, use time 20. Shatters enemies, making the next melee attack a guaranteed critical strike that ignores defense. The Halberd cannot make use of the shattered effect. How to get it: Craft at Anvil from 16 Ancient Steel Bar, 20 Charred Wood; Found in Abandoned Village chests"
	Tooltip: "[c/E2735C:Weapon] Ancient Steel Halberd: 6 melee damage, use time 20"
}

GearAncientSteelLantern: {
	Title: "Ancient Steel Lantern"
	Contents: "[c/E2735C:Weapon] Obtain Ancient Steel Lantern. 8 summon damage, use time 45, 10 mana. Summons a Steel Lantern on your cursor that releases flames at all nearby enemies. Range scales with summon damage. How to get it: Craft at Anvil from 12 Ancient Steel Bar, 12 Charred Wood, 1 Campfire; Found in Abandoned Village chests"
	Tooltip: "[c/E2735C:Weapon] Ancient Steel Lantern: 8 summon damage, use time 45, 10 mana"
}

GearAncientSteelLongbow: {
	Title: "Ancient Steel Longbow"
	Contents: "[c/E2735C:Weapon] Obtain Ancient Steel Longbow. 17 ranged damage, use time 44. Has to windup before firing. Arrows travel fast and explode into piercing shrapnel for 100% damage upon hitting enemies. How to get it: Craft at Anvil from 12 Ancient Steel Bar, 20 Charred Wood; Found in Abandoned Village chests"
	Tooltip: "[c/E2735C:Weapon] Ancient Steel Longbow: 17 ranged damage, use time 44"
}

GearAncientSteelSword: {
	Title: "Ancient Steel Sword"
	Contents: "[c/E2735C:Weapon] Obtain Ancient Steel Sword. 16 melee damage, use time 30. Does area damage on hit for 80% damage. Critical strikes deal 50% more damage and may also apply a stacking, permanent bleed for 5 damage per second. How to get it: Craft at Anvil from 18 Ancient Steel Bar; Found in Abandoned Village chests"
	Tooltip: "[c/E2735C:Weapon] Ancient Steel Sword: 16 melee damage, use time 30"
}

GearBerryBombs: {
	Title: "Berry Bombs"
	Contents: "[c/E2735C:Weapon] Obtain Berry Bombs. 4 ranged damage, use time 23. Throw a cluster of explosive berries. How to get it: Craft at Work Bench from 20 Any Wood, 4 Fragment of Nature, 1 Blue Berries"
	Tooltip: "[c/E2735C:Weapon] Berry Bombs: 4 ranged damage, use time 23"
}

GearBetrayersKnife: {
	Title: "Betrayer's Knife"
	Contents: "[c/E2735C:Weapon] Obtain Betrayer's Knife. 25 melee damage, use time 24. Strike with 2 slashes, which always bleed enemies on the first hit. The second slash does 150% damage. How to get it: Sold by Archaeologist; Found in Gem Structures chests"
	Tooltip: "[c/E2735C:Weapon] Betrayer's Knife: 25 melee damage, use time 24"
}

GearBlazingClub: {
	Title: "Blazing Club"
	Contents: "[c/E2735C:Weapon] Obtain Blazing Club. 19 melee damage, use time 40. Deploys spiked mines in the air. Right click to launch them instead. Mines linger and explode into shrapnel for 10% damage. Deploys and launches more mines when wearing climbing related accessories. How to get it: Craft at Anvil from 1 Spiked Club, 1 Spore Club, 1 Dissolving Nature, 6 Fragment of Inferno, 10 Any Evil Material"
	Tooltip: "[c/E2735C:Weapon] Blazing Club: 19 melee damage, use time 40"
}

GearBlinkBlade: {
	Title: "Blink Blade"
	Contents: "[c/E2735C:Weapon] Obtain Blink Blade. 15 melee damage, use time 12. Left click to slash, recovering void on hit and releasing a short-ranged burst of lightning. Right click to blink forward a short distance with a 300% damage slash at triple the void cost. Receives 25% more attack speed from attack speed boosts. How to get it: Craft at Anvil from 20 Skip Soul, 5 Skip Shard, 1 Gold Shortsword (+1 alternative recipe)"
	Tooltip: "[c/E2735C:Weapon] Blink Blade: 15 melee damage, use time 12"
}

GearBlongus: {
	Title: "Blongus"
	Contents: "[c/E2735C:Weapon] Obtain Blongus. 5 magic damage, use time 24, 10 mana. Unleash a swarm of hungry mosquitos that home and latch onto enemies before exploding, dealing increased damage based on the target's health and bleed status. How to get it: Found in Abandoned Village chests"
	Tooltip: "[c/E2735C:Weapon] Blongus: 5 magic damage, use time 24, 10 mana"
}

GearBlueJellyfishStaff: {
	Title: "Blue Jellyfish Staff"
	Contents: "[c/E2735C:Weapon] Obtain Blue Jellyfish Staff. 17 magic damage, use time 30, 15 mana. Fires an energy ball that detonates into blue lighting after traveling forward. How to get it: Craft at Anvil from 15 Sapphire, 4 Fragment of Tide; Dropped by Green Jellyfish; Caught while fishing"
	Tooltip: "[c/E2735C:Weapon] Blue Jellyfish Staff: 17 magic damage, use time 30, 15 mana"
}

GearBrassWhip: {
	Title: "Brass Whip"
	Contents: "[c/E2735C:Weapon] Obtain Brass Whip. 23 summon damage. Minions cause tagged enemies to explode into spiky balls that deal 50% of the minion's damage. Your summons will focus struck enemies. How to get it: Found in Abandoned Village chests"
	Tooltip: "[c/E2735C:Weapon] Brass Whip: 23 summon damage"
}

GearCardiacCollapse: {
	Title: "Cardiac Collapse"
	Contents: "[c/E2735C:Weapon] Obtain Cardiac Collapse. 23 melee damage, use time 30. Charge to increase damage up to 800%. Takes 3.5 seconds to reach max charge. Killed enemies regenerate health. How to get it: Craft at Anvil from 12 Crimtane Bar, 2 Fragment of Evil"
	Tooltip: "[c/E2735C:Weapon] Cardiac Collapse: 23 melee damage, use time 30"
}

GearCoconutGun: {
	Title: "Coconut Gun"
	Contents: "[c/E2735C:Weapon] Obtain Coconut Gun. 16 ranged damage, use time 50. Launches coconut cluster bombs with homing coconut milk shrapnel. 'It fires in spurts'. How to get it: Sold by Archaeologist; Found in world-generated chests"
	Tooltip: "[c/E2735C:Weapon] Coconut Gun: 16 ranged damage, use time 50"
}

GearCrabClaw: {
	Title: "Crab Claw"
	Contents: "[c/E2735C:Weapon] Obtain Crab Claw. 18 melee damage, use time 30. Charge to increase damage up to 800%. Takes 4 seconds to reach max charge. How to get it: Craft at Anvil from 15 Topaz, 4 Fragment of Tide; Dropped by Crab; Caught while fishing"
	Tooltip: "[c/E2735C:Weapon] Crab Claw: 18 melee damage, use time 30"
}

GearBaguette: {
	Title: "Crusty Baguette"
	Contents: "[c/E2735C:Weapon] Obtain Crusty Baguette. 20 melee damage, use time 14. Killing enemies will drop baguette crumbs. Pickup baguette crumbs to increase the range and damage of your baguette, and heal lost life. 'Surrender is not an option'. How to get it: Dropped by Skeletron Head; Sold by Archaeologist"
	Tooltip: "[c/E2735C:Weapon] Crusty Baguette: 20 melee damage, use time 14"
}

GearCryoCannon: {
	Title: "Cryo Cannon"
	Contents: "[c/E2735C:Weapon] Obtain Cryo Cannon. 10 ranged damage, use time 38. Uses snowballs as ammo. How to get it: Craft at Anvil from 8 Frigid Bar"
	Tooltip: "[c/E2735C:Weapon] Cryo Cannon: 10 ranged damage, use time 38"
}

GearCursedBlade: {
	Title: "Cursed Blade"
	Contents: "[c/E2735C:Weapon] Obtain Cursed Blade. 19 summon damage, use time 30. Summons a Cursed Blade to assist in combat. Hit enemies receive a storm of sword strikes, dealing 50% damage each, and ending in an explosion. The explosion deals 100% damage and always critical strikes. How to get it: Craft at Anvil from 8 Cursed Matter, 10 Keystone Shard"
	Tooltip: "[c/E2735C:Weapon] Cursed Blade: 19 summon damage, use time 30"
}

GearCursedImpale: {
	Title: "Cursed Impale"
	Contents: "[c/E2735C:Weapon] Obtain Cursed Impale. 30 melee damage, use time 20. Releases a short ranged burst of energy. How to get it: Craft at Anvil from 7 Cursed Matter, 10 Keystone Shard"
	Tooltip: "[c/E2735C:Weapon] Cursed Impale: 30 melee damage, use time 20"
}

GearEarthenSpiritStaff: {
	Title: "Earthen Spirit Staff"
	Contents: "[c/E2735C:Weapon] Obtain Earthen Spirit Staff. 13 summon damage, use time 20. Summons an Earthen Spirit to fight for you. How to get it: Craft at Anvil from 1 Dissolving Earth, 20 Meteorite Bar"
	Tooltip: "[c/E2735C:Weapon] Earthen Spirit Staff: 13 summon damage, use time 20"
}

GearEarthshaker: {
	Title: "Earthshaker"
	Contents: "[c/E2735C:Weapon] Obtain Earthshaker. 11 melee damage, use time 30. Launch a long ranged pickaxe which is capable of breaking many blocks at a time. How to get it: Dropped by Earthen Construct; Found in world-generated chests"
	Tooltip: "[c/E2735C:Weapon] Earthshaker: 11 melee damage, use time 30"
}

GearEchoDisk: {
	Title: "Echo Disc"
	Contents: "[c/E2735C:Weapon] Obtain Echo Disc. 12 ranged damage, use time 25. Strikes with an additional disc that mirrors the first. How to get it: Craft at Anvil from 6 Vibrant Alloy"
	Tooltip: "[c/E2735C:Weapon] Echo Disc: 12 ranged damage, use time 25"
}

GearExplosiveKnife: {
	Title: "Explosive Knife"
	Contents: "[c/E2735C:Weapon] Obtain Explosive Knife. 15 ranged damage, use time 17. 'Quite a deadly combination'. How to get it: Craft at Anvil from 15 Throwing Knife, 15 Grenade, 1 Ancient Steel Bar; Dropped by Corruption Treasure Slime; Dropped by Crimson Treasure Slime; Found in world-generated chests; and 1 more sources"
	Tooltip: "[c/E2735C:Weapon] Explosive Knife: 15 ranged damage, use time 17"
}

GearFireSpitter: {
	Title: "Fire Spitter"
	Contents: "[c/E2735C:Weapon] Obtain Fire Spitter. 5 ranged damage, use time 30. Uses gel for ammo. How to get it: Dropped by Blue Slime"
	Tooltip: "[c/E2735C:Weapon] Fire Spitter: 5 ranged damage, use time 30"
}

GearFizzleStar: {
	Title: "Fizzle Star"
	Contents: "[c/E2735C:Weapon] Obtain Fizzle Star. 15 magic damage, use time 17, 6 mana. Eject a fragile star that explodes into sparks. Has a chance of malfunctioning, launching just sparks for 200% damage or ejecting additional stars. How to get it: Found in Abandoned Village chests"
	Tooltip: "[c/E2735C:Weapon] Fizzle Star: 15 magic damage, use time 17, 6 mana"
}

GearNatureSpell: {
	Title: "Flower Spell"
	Contents: "[c/E2735C:Weapon] Obtain Flower Spell. 5 magic damage, use time 30, 5 mana. Launches a seed that latches onto enemies. When the seed blooms, it does 500% damage. How to get it: Craft at Work Bench from 20 Any Wood, 4 Fragment of Nature, 1 Yellow Marigold"
	Tooltip: "[c/E2735C:Weapon] Flower Spell: 5 magic damage, use time 30, 5 mana"
}

GearFortressCrasher: {
	Title: "Fortress Crasher"
	Contents: "[c/E2735C:Weapon] Obtain Fortress Crasher. 24 ranged damage, use time 30. Throw a drilling spear that repeatedly hits enemies, can travel through walls, and ignores 10 defense. How to get it: Found in Treasure Bag (The Excavator); Dropped by The Excavator"
	Tooltip: "[c/E2735C:Weapon] Fortress Crasher: 24 ranged damage, use time 30"
}

GearFrigidJavelin: {
	Title: "Frigid Javelin"
	Contents: "[c/E2735C:Weapon] Obtain Frigid Javelin. 42 magic damage, use time 44. Throw a powerful, fast traveling javelin that ricochets of surfaces. How to get it: Craft at Anvil from 12 Frigid Bar"
	Tooltip: "[c/E2735C:Weapon] Frigid Javelin: 42 magic damage, use time 44"
}

GearGelAxe: {
	Title: "Gel Throwing Axe"
	Contents: "[c/E2735C:Weapon] Obtain Gel Throwing Axe. 11 ranged damage. How to get it: Craft at Solidifier from 20 Gel, 1 Iron Bar; Dropped by Treasure Slime; Dropped by Frozen Treasure Slime"
	Tooltip: "[c/E2735C:Weapon] Gel Throwing Axe: 11 ranged damage"
}

GearGeostorm: {
	Title: "Geostorm"
	Contents: "[c/E2735C:Weapon] Obtain Geostorm. 20 magic damage, use time 50. Bombards your cursor with crystals. How to get it: Craft at Anvil from 8 Vibrant Alloy"
	Tooltip: "[c/E2735C:Weapon] Geostorm: 20 magic damage, use time 50"
}

GearGlazeBow: {
	Title: "Glaze Bow"
	Contents: "[c/E2735C:Weapon] Obtain Glaze Bow. 10 ranged damage, use time 22. Coalesces ice mist to power up your arrows. When briefly charged, arrows will travel faster and hit with an icy explosion that deals 200% damage. When fully charged, arrows bloom into wisps of ice, dealing 600% damage. How to get it: Sold by Archaeologist; Found in world-generated chests"
	Tooltip: "[c/E2735C:Weapon] Glaze Bow: 10 ranged damage, use time 22"
}

GearGlowWhip: {
	Title: "Glow Whip"
	Contents: "[c/E2735C:Weapon] Obtain Glow Whip. 16 summon damage. Minions cause tagged enemies to sparkle on hit for 4 damage. Your summons will focus struck enemies. How to get it: Craft at Anvil from 12 Any Silver Bar, 30 Glow Nylon"
	Tooltip: "[c/E2735C:Weapon] Glow Whip: 16 summon damage"
}

GearGoldArkStaff: {
	Title: "Gold Arc Staff"
	Contents: "[c/E2735C:Weapon] Obtain Gold Arc Staff. 34 magic damage, use time 30. Deal 150% damage to up to 2 enemies surrounding the initially hit enemy. How to get it: Craft at Anvil from 15 Gold Bar"
	Tooltip: "[c/E2735C:Weapon] Gold Arc Staff: 34 magic damage, use time 30"
}

GearGoldChakram: {
	Title: "Gold Chakram"
	Contents: "[c/E2735C:Weapon] Obtain Gold Chakram. 17 ranged damage, use time 36. Deals more damage at the peak of its trajectory. How to get it: Craft at Anvil from 15 Gold Bar"
	Tooltip: "[c/E2735C:Weapon] Gold Chakram: 17 ranged damage, use time 36"
}

GearGoldGlaive: {
	Title: "Gold Glaive"
	Contents: "[c/E2735C:Weapon] Obtain Gold Glaive. 20 melee damage, use time 31. Fires 3 bolts at your cursor, each dealing 75% damage. How to get it: Craft at Anvil from 15 Gold Bar"
	Tooltip: "[c/E2735C:Weapon] Gold Glaive: 20 melee damage, use time 31"
}

GearWormWoodHook: {
	Title: "Goopwood Hook"
	Contents: "[c/E2735C:Weapon] Obtain Goopwood Hook. 24 melee damage. Retracts upon hitting an enemy. How to get it: Craft at Anvil from 16 Corrosive Gel, 24 Goopwood; Found in Treasure Bag (Putrid Pinky)"
	Tooltip: "[c/E2735C:Weapon] Goopwood Hook: 24 melee damage"
}

GearWormWoodStaff: {
	Title: "Goopwood Staff"
	Contents: "[c/E2735C:Weapon] Obtain Goopwood Staff. 12 magic damage (pack-balanced, was 20), use time 8, 20 mana. Fires 3 bouncy, erratic, lingering pink projectiles. How to get it: Craft at Anvil from 32 Corrosive Gel, 16 Goopwood; Found in Treasure Bag (Putrid Pinky)"
	Tooltip: "[c/E2735C:Weapon] Goopwood Staff: 12 magic damage (pack-balanced, was 20), use time 8, 20 mana"
}

GearGuardianGreatsword: {
	Title: "Guardian Greatsword"
	Contents: "[c/E2735C:Weapon] Obtain Guardian Greatsword. 36 melee damage, use time 30. Strike with 3 slashes. The third slash unleashes a wave blades that deal 50% damage. How to get it: Found in Treasure Bag (The Excavator); Dropped by The Excavator"
	Tooltip: "[c/E2735C:Weapon] Guardian Greatsword: 36 melee damage, use time 30"
}

GearHandCannon: {
	Title: "Hand Cannon"
	Contents: "[c/E2735C:Weapon] Obtain Hand Cannon. 15 ranged damage, use time 20. Launches three bullets: the middle bullet deals 100% damage and side bullets deal 75% damage. Converts musket balls into explosive bullets. How to get it: Found in Abandoned Village chests"
	Tooltip: "[c/E2735C:Weapon] Hand Cannon: 15 ranged damage, use time 20"
}

GearHellbreaker: {
	Title: "Hellbreaker"
	Contents: "[c/E2735C:Weapon] Obtain Hellbreaker. 48 melee damage, use time 30. Charge to increase damage up to 600%. Takes 4.5 seconds to reach max charge. How to get it: Craft at Anvil from 12 Hellstone Bar, 2 Fragment of Inferno"
	Tooltip: "[c/E2735C:Weapon] Hellbreaker: 48 melee damage, use time 30"
}

GearIlluminantBow: {
	Title: "Illuminant Bow"
	Contents: "[c/E2735C:Weapon] Obtain Illuminant Bow. 16 ranged damage, use time 25. Launches illuminant moths, which drop four arrows onto enemies. How to get it: Found in Treasure Bag (Glowmoth); Dropped by Glowmoth"
	Tooltip: "[c/E2735C:Weapon] Illuminant Bow: 16 ranged damage, use time 25"
}

GearIlluminantStaff: {
	Title: "Illuminant Staff"
	Contents: "[c/E2735C:Weapon] Obtain Illuminant Staff. 12 magic damage, use time 23, 20 mana. Launch a cluster of Illuminant Orbs. Illuminant Orbs launch shards at nearby enemies after expiring. How to get it: Found in Treasure Bag (Glowmoth); Dropped by Glowmoth"
	Tooltip: "[c/E2735C:Weapon] Illuminant Staff: 12 magic damage, use time 23, 20 mana"
}

GearImperialPike: {
	Title: "Imperial Pike"
	Contents: "[c/E2735C:Weapon] Obtain Imperial Pike. 23 melee damage, use time 20. Leaves behind a trail that continues to damage enemies. How to get it: Found in Pyramid Crate; Found in world-generated chests"
	Tooltip: "[c/E2735C:Weapon] Imperial Pike: 23 melee damage, use time 20"
}

GearJarOfPineapple: {
	Title: "Jar of Pineapple"
	Contents: "[c/E2735C:Weapon] Obtain Jar of Pineapple. 16 summon damage, use time 36, 10 mana. Summons a Nature Slime to fight for you. How to get it: Found in Abandoned Village chests"
	Tooltip: "[c/E2735C:Weapon] Jar of Pineapple: 16 summon damage, use time 36, 10 mana"
}

GearKelpWhip: {
	Title: "Kelp Whip"
	Contents: "[c/E2735C:Weapon] Obtain Kelp Whip. 13 summon damage. Minions critically strike the tagged enemy, but with a 2 second cooldown between critical strikes. Your summons will focus struck enemies. How to get it: Sold by Archaeologist; Found in Gem Structures chests"
	Tooltip: "[c/E2735C:Weapon] Kelp Whip: 13 summon damage"
}

GearMagmaBeam: {
	Title: "Magma Concentrator"
	Contents: "[c/E2735C:Weapon] Obtain Magma Concentrator. 16 magic damage, use time 40. Concetrate a ball of hot magma on your cursor. How to get it: Found in Treasure Bag (The Excavator); Dropped by The Excavator"
	Tooltip: "[c/E2735C:Weapon] Magma Concentrator: 16 magic damage, use time 40"
}

GearMantisGrip: {
	Title: "Mantis Grip"
	Contents: "[c/E2735C:Weapon] Obtain Mantis Grip. 15 melee damage, use time 30. Charge to increase damage up to 500%. The initial charge consumes no void. Takes 4 seconds to reach max charge. How to get it: Dropped by Nature Construct"
	Tooltip: "[c/E2735C:Weapon] Mantis Grip: 15 melee damage, use time 30"
}

GearMinersPickaxe: {
	Title: "Miner's Pickaxe"
	Contents: "[c/E2735C:Weapon] Obtain Miner's Pickaxe. 12 melee damage, use time 16. 'Finally, throwing pickaxe'. How to get it: Dropped by Golden Treasure Slime; Dropped by Shadow Treasure Slime; Found in world-generated chests; and 2 more sources"
	Tooltip: "[c/E2735C:Weapon] Miner's Pickaxe: 12 melee damage, use time 16"
}

GearMinersSword: {
	Title: "Miner's Sword"
	Contents: "[c/E2735C:Weapon] Obtain Miner's Sword. 13 melee damage (pack-balanced, was 20), use time 16. Critically strikes while falling. How to get it: Dropped by Golden Treasure Slime"
	Tooltip: "[c/E2735C:Weapon] Miner's Sword: 13 melee damage (pack-balanced, was 20), use time 16"
}

GearNatureSpiritStaff: {
	Title: "Nature Spirit Staff"
	Contents: "[c/E2735C:Weapon] Obtain Nature Spirit Staff. 10 summon damage, use time 36. Summons a Nature Spirit to fight for you. Attacks the closest enemy visible to you. Heals health upon dealing damage. How to get it: Craft at Anvil from 1 Dissolving Nature, 12 Any Silver Bar, 4 Jungle Spores"
	Tooltip: "[c/E2735C:Weapon] Nature Spirit Staff: 10 summon damage, use time 36"
}

GearNightIlluminator: {
	Title: "Night Illuminator"
	Contents: "[c/E2735C:Weapon] Obtain Night Illuminator. 8 summon damage, use time 36, 10 mana. Summons two luminous moths to swarm your enemies. Right click to call the moths to your cursor. How to get it: Found in Treasure Bag (Glowmoth); Dropped by Glowmoth"
	Tooltip: "[c/E2735C:Weapon] Night Illuminator: 8 summon damage, use time 36, 10 mana"
}

GearObsidianEruption: {
	Title: "Obsidian Eruption"
	Contents: "[c/E2735C:Weapon] Obtain Obsidian Eruption. 24 melee damage, use time 21. How to get it: Craft at Anvil from 12 Meteorite Bar, 36 Obsidian, 3 Fragment of Inferno, 2 Fragment of Otherworld"
	Tooltip: "[c/E2735C:Weapon] Obsidian Eruption: 24 melee damage, use time 21"
}

GearOtherworldlySpiritStaff: {
	Title: "Otherworldly Spirit Staff"
	Contents: "[c/E2735C:Weapon] Obtain Otherworldly Spirit Staff. 21 summon damage, use time 30. Summons an Otherworldly Spirit to fight for you. Accumulates up to 4 thunder charges that are launched at enemies in quick succession. How to get it: Craft at Hardlight Fabricator from 1 Dissolving Aether, 1 Fragment of Otherworld, 10 Hardlight Alloy; Found in world-generated chests"
	Tooltip: "[c/E2735C:Weapon] Otherworldly Spirit Staff: 21 summon damage, use time 30"
}

GearPeanutRepeater: {
	Title: "Peanut Repeater"
	Contents: "[c/E2735C:Weapon] Obtain Peanut Repeater. 27 ranged damage, use time 26. Launches tasty peanuts that attract Pinky Air Raids. 20% chance to not consume ammo. How to get it: Craft at Anvil from 1 Dissolving Nature, 20 Corrosive Gel, 20 Goopwood, 40 Peanut"
	Tooltip: "[c/E2735C:Weapon] Peanut Repeater: 27 ranged damage, use time 26"
}

GearPerfectStar: {
	Title: "Perfect Star"
	Contents: "[c/E2735C:Weapon] Obtain Perfect Star. 24 magic damage, use time 30, 12 mana. 'The perfect weapon'. How to get it: Sold by Archaeologist; Found in world-generated chests"
	Tooltip: "[c/E2735C:Weapon] Perfect Star: 24 magic damage, use time 30, 12 mana"
}

GearPermafrostSpiritStaff: {
	Title: "Permafrost Spirit Staff"
	Contents: "[c/E2735C:Weapon] Obtain Permafrost Spirit Staff. 15 summon damage, use time 20. Summons a Permafrost Spirit to fight for you. Launches 3 permafrost spears downwards at enemies. How to get it: Craft at Anvil from 1 Dissolving Aurora, 12 Any Silver Bar, 8 Frigid Bar"
	Tooltip: "[c/E2735C:Weapon] Permafrost Spirit Staff: 15 summon damage, use time 20"
}

GearPharaohsCane: {
	Title: "Pharaoh's Cane"
	Contents: "[c/E2735C:Weapon] Obtain Pharaoh's Cane. 11 melee damage, use time 25. Terrible for combat, but makes enemies drop more gold. 'Who would ever want such a thing?'. How to get it: Found in Pyramid Crate; Found in world-generated chests"
	Tooltip: "[c/E2735C:Weapon] Pharaoh's Cane: 11 melee damage, use time 25"
}

GearPinkJellyfishStaff: {
	Title: "Pink Jellyfish Staff"
	Contents: "[c/E2735C:Weapon] Obtain Pink Jellyfish Staff. 14 magic damage, use time 20, 13 mana. Fires pink lightning which chains off enemies for 60% damage. How to get it: Craft at Anvil from 15 Amethyst, 4 Fragment of Tide; Dropped by Pink Jellyfish; Caught while fishing"
	Tooltip: "[c/E2735C:Weapon] Pink Jellyfish Staff: 14 magic damage, use time 20, 13 mana"
}

GearPintOPunch: {
	Title: "Pint O' Punch"
	Contents: "[c/E2735C:Weapon] Obtain Pint O' Punch. 20 ranged damage, use time 30. Deals 500% critical strike damage. Critical strikes spawn hearts. 'This pint packs a punch!'. How to get it: Dropped by Ball O' Guts; Dropped by Ball O' Worms; Dropped by Fistfull; and 2 more sources"
	Tooltip: "[c/E2735C:Weapon] Pint O' Punch: 20 ranged damage, use time 30"
}

GearPiscesPuncher: {
	Title: "Pisces Puncher"
	Contents: "[c/E2735C:Weapon] Obtain Pisces Puncher. 21 magic damage, use time 29, 12 mana. 'fish'. 'noun'. 'a limbless cold-blooded vertebrate animal with gills and fins and living wholly in water'. How to get it: Dropped by Tidal Construct"
	Tooltip: "[c/E2735C:Weapon] Pisces Puncher: 21 magic damage, use time 29, 12 mana"
}

GearPistolShrimp: {
	Title: "Pistol Shrimp"
	Contents: "[c/E2735C:Weapon] Obtain Pistol Shrimp. 7 magic damage (pack-balanced, was 11), use time 8, 4 mana. Fires hot, shrimpy plasma that homes on close enemies. 'Teamwork makes the dream work'. How to get it: Craft at Anvil from 10 Shrimp, 5 Topaz, 4 Fragment of Tide; Caught while fishing"
	Tooltip: "[c/E2735C:Weapon] Pistol Shrimp: 7 magic damage (pack-balanced, was 11), use time 8, 4 mana"
}

GearPitatiLongbow: {
	Title: "Pitati Longbow"
	Contents: "[c/E2735C:Weapon] Obtain Pitati Longbow. 18 ranged damage, use time 24. Fires an additional bouncing emerald bolt with each shot. How to get it: Found in Pyramid Crate; Found in world-generated chests"
	Tooltip: "[c/E2735C:Weapon] Pitati Longbow: 18 ranged damage, use time 24"
}

GearPixelBlaster: {
	Title: "Pixel Blaster"
	Contents: "[c/E2735C:Weapon] Obtain Pixel Blaster. 1 damage, use time 20. Fires a beam that melts through enemies, dealing damage 60 times per second. Receives lowered bonuses from critical strike chance boosts. How to get it: Found in Abandoned Village chests"
	Tooltip: "[c/E2735C:Weapon] Pixel Blaster: 1 damage, use time 20"
}

GearPlatinumDart: {
	Title: "Platinum Dart"
	Contents: "[c/E2735C:Weapon] Obtain Platinum Dart. 19 ranged damage, use time 15. A heavy dart that sticks to enemies, slowing them down drastically. How to get it: Craft at Anvil from 15 Platinum Bar"
	Tooltip: "[c/E2735C:Weapon] Platinum Dart: 19 ranged damage, use time 15"
}

GearPlatinumScythe: {
	Title: "Platinum Scythe"
	Contents: "[c/E2735C:Weapon] Obtain Platinum Scythe. 32 melee damage, use time 30. Attacks permanently curse enemies for 3 damage per second, stacking up to 10 times. How to get it: Craft at Anvil from 15 Platinum Bar"
	Tooltip: "[c/E2735C:Weapon] Platinum Scythe: 32 melee damage, use time 30"
}

GearPlatinumSoulStaff: {
	Title: "Platinum Soul Staff"
	Contents: "[c/E2735C:Weapon] Obtain Platinum Soul Staff. 8 magic damage, use time 30. Absorb life from up to 3 enemies at a time. How to get it: Craft at Anvil from 15 Platinum Bar"
	Tooltip: "[c/E2735C:Weapon] Platinum Soul Staff: 8 magic damage, use time 30"
}

GearSharkPog: {
	Title: "Pog Shark"
	Contents: "[c/E2735C:Weapon] Obtain Pog Shark. 8 ranged damage, use time 11. Launches bubbles that rise quickly. How to get it: Dropped by Phantaray; Convert Hydrokinetic Antennae by throwing it into a Wormhole Anomaly"
	Tooltip: "[c/E2735C:Weapon] Pog Shark: 8 ranged damage, use time 11"
}

GearRecursiveBow: {
	Title: "Recursive Bow"
	Contents: "[c/E2735C:Weapon] Obtain Recursive Bow. 14 ranged damage, use time 33. Has a 50% chance to fire an additional arrow. Additional arrows also activate this ability. How to get it: Sold by Traveling Merchant"
	Tooltip: "[c/E2735C:Weapon] Recursive Bow: 14 ranged damage, use time 33"
}

GearRoyalMagnum: {
	Title: "Royal Magnum"
	Contents: "[c/E2735C:Weapon] Obtain Royal Magnum. 14 ranged damage, use time 14. Releases golden light upon hitting the ground or an enemy. How to get it: Found in Pyramid Crate; Found in world-generated chests"
	Tooltip: "[c/E2735C:Weapon] Royal Magnum: 14 ranged damage, use time 14"
}

GearSandstoneEdge: {
	Title: "Sandstone Edge"
	Contents: "[c/E2735C:Weapon] Obtain Sandstone Edge. 30 melee damage, use time 22. Critical hits release a torrent of homing emerald bolts that do 50% damage. How to get it: Found in Pyramid Crate; Found in world-generated chests"
	Tooltip: "[c/E2735C:Weapon] Sandstone Edge: 30 melee damage, use time 22"
}

GearSandstoneWarhammer: {
	Title: "Sandstone Warhammer"
	Contents: "[c/E2735C:Weapon] Obtain Sandstone Warhammer. 23 melee damage, use time 18. Launches homing hammers. How to get it: Found in Pyramid Crate; Found in world-generated chests"
	Tooltip: "[c/E2735C:Weapon] Sandstone Warhammer: 23 melee damage, use time 18"
}

GearSandstormPouch: {
	Title: "Sandstorm Pouch"
	Contents: "[c/E2735C:Weapon] Obtain Sandstorm Pouch. 21 ranged damage, use time 30. Unleash a devastating sandstorm with unlimited pierce. How to get it: Found in Abandoned Village chests"
	Tooltip: "[c/E2735C:Weapon] Sandstorm Pouch: 21 ranged damage, use time 30"
}

GearScatterseed: {
	Title: "Scatterseed"
	Contents: "[c/E2735C:Weapon] Obtain Scatterseed. 10 magic damage, use time 39, 10 mana. Scatters seeds that latch onto enemies. When the seeds bloom, they do 125% damage. How to get it: Craft at Anvil from 1 Flower Spell, 8 Crimtane Bar, 6 Fragment of Nature (+1 alternative recipe)"
	Tooltip: "[c/E2735C:Weapon] Scatterseed: 10 magic damage, use time 39, 10 mana"
}

GearSharanga: {
	Title: "Sharanga"
	Contents: "[c/E2735C:Weapon] Obtain Sharanga. 25 ranged damage, use time 25. Fires supercharged hellfire arrows. How to get it: Craft at Anvil from 1 Hellwing Bow, 1 Molten Fury, 4 Fragment of Inferno"
	Tooltip: "[c/E2735C:Weapon] Sharanga: 25 ranged damage, use time 25"
}

GearShardStaff: {
	Title: "Shard Staff"
	Contents: "[c/E2735C:Weapon] Obtain Shard Staff. 13 magic damage, use time 20, 12 mana. Summons shards around the player. How to get it: Craft at Anvil from 12 Frigid Bar"
	Tooltip: "[c/E2735C:Weapon] Shard Staff: 13 magic damage, use time 20, 12 mana"
}

GearShatterBlade: {
	Title: "Shatter Blade"
	Contents: "[c/E2735C:Weapon] Obtain Shatter Blade. 15 melee damage, use time 15. Shatters on critical strike, surrounding you with 3 ice shards. Repairs itself after shattering. 'Don't worry, it's not a durability system'. How to get it: Craft at Anvil from 8 Frigid Bar"
	Tooltip: "[c/E2735C:Weapon] Shatter Blade: 15 melee damage, use time 15"
}

GearShattershine: {
	Title: "Shattershine"
	Contents: "[c/E2735C:Weapon] Obtain Shattershine. 16 melee damage, use time 30. Releases a cluster of sparkles upon hitting an enemy, each doing 60% damage. Doesn't release sparkles while charging. How to get it: Craft at Anvil from 8 Vibrant Alloy"
	Tooltip: "[c/E2735C:Weapon] Shattershine: 16 melee damage, use time 30"
}

GearSkipShot: {
	Title: "Skip Shot"
	Contents: "[c/E2735C:Weapon] Obtain Skip Shot. 20 ranged damage, use time 35. Fires 3 arrows. Converts wooden arrows into Wormhole Arrows. How to get it: Craft at Anvil from 20 Skip Soul, 5 Skip Shard, 1 Gold Bow (+1 alternative recipe)"
	Tooltip: "[c/E2735C:Weapon] Skip Shot: 20 ranged damage, use time 35"
}

GearSnakeBow: {
	Title: "Snake Bow"
	Contents: "[c/E2735C:Weapon] Obtain Snake Bow. 19 ranged damage, use time 22. Launches snakes that latch on to enemies. How to get it: Craft at Anvil from 18 Snakeskin, 4 Leather, 1 Wooden Bow"
	Tooltip: "[c/E2735C:Weapon] Snake Bow: 19 ranged damage, use time 22"
}

GearMineralSpewer: {
	Title: "Soot Spewer"
	Contents: "[c/E2735C:Weapon] Obtain Soot Spewer. 12 ranged damage, use time 20. Covers enemies with combustible powder. Enemies covered in powder combust when set aflame, taking all the damage that would've been dealt by the fire debuff instantly. How to get it: Found in Abandoned Village chests"
	Tooltip: "[c/E2735C:Weapon] Soot Spewer: 12 ranged damage, use time 20"
}

GearSoulEater: {
	Title: "Soul Eater"
	Contents: "[c/E2735C:Weapon] Obtain Soul Eater. 17 melee damage, use time 24. Charge to increase damage up to 1000%. Takes 2.5 seconds to reach max charge. Killed enemies regenerate mana and void. How to get it: Craft at Anvil from 12 Demonite Bar, 2 Fragment of Evil"
	Tooltip: "[c/E2735C:Weapon] Soul Eater: 17 melee damage, use time 24"
}

GearSpikedClub: {
	Title: "Spiked Club"
	Contents: "[c/E2735C:Weapon] Obtain Spiked Club. 12 melee damage, use time 38. Lays down spike traps. Lays down more traps when wearing climbing related accessories. How to get it: Found in world-generated chests"
	Tooltip: "[c/E2735C:Weapon] Spiked Club: 12 melee damage, use time 38"
}

GearSpiritTracer: {
	Title: "Spirit Tracer"
	Contents: "[c/E2735C:Weapon] Obtain Spirit Tracer. 22 ranged damage (pack-balanced, was 33), use time 18. Fires phantom arrows that travel instantly to up to 3 enemies at a time. How to get it: Craft at Anvil from 10 Cursed Matter, 8 Amethyst"
	Tooltip: "[c/E2735C:Weapon] Spirit Tracer: 22 ranged damage (pack-balanced, was 33), use time 18"
}

GearSporeBombs: {
	Title: "Spore Bombs"
	Contents: "[c/E2735C:Weapon] Obtain Spore Bombs. 13 ranged damage, use time 29. Throw a cluster of explosive spore sacks. Released spores deal 50% damage. 'The toxic grenades look almost edible'. How to get it: Craft at Anvil from 6 Fragment of Nature, 1 Berry Bombs, 12 Jungle Spores, 12 Stinger"
	Tooltip: "[c/E2735C:Weapon] Spore Bombs: 13 ranged damage, use time 29"
}

GearSporeClub: {
	Title: "Spore Club"
	Contents: "[c/E2735C:Weapon] Obtain Spore Club. 11 melee damage, use time 30. Launch a spore that may confuse enemies. How to get it: Craft at Work Bench from 20 Any Wood, 4 Fragment of Nature, 10 Mushroom"
	Tooltip: "[c/E2735C:Weapon] Spore Club: 11 melee damage, use time 30"
}

GearSporeSprayer: {
	Title: "Spore Sprayer"
	Contents: "[c/E2735C:Weapon] Obtain Spore Sprayer. 10 ranged damage, use time 19. Fires a burst of Spore Clouds that do 66% damage whenever an arrow is launched. How to get it: Dropped by Sitting Mushroom"
	Tooltip: "[c/E2735C:Weapon] Spore Sprayer: 10 ranged damage, use time 19"
}

GearStarshardSaber: {
	Title: "Starshard Saber"
	Contents: "[c/E2735C:Weapon] Obtain Starshard Saber. 19 melee damage, use time 24. Strike with 4 slashes that launch Starshards for 20% damage. Starshards apply a stacking, permanent curse. Right click to strike with a 150% damage slash that detonates the curse, dealing more damage the more stacks applied. Enemies with at least 4 stacks of the curse will end the detonation more... How to get it: Found in Abandoned Village chests"
	Tooltip: "[c/E2735C:Weapon] Starshard Saber: 19 melee damage, use time 24"
}

GearStormSpell: {
	Title: "Storm Spell"
	Contents: "[c/E2735C:Weapon] Obtain Storm Spell. 14 magic damage, use time 36, 15 mana. Create an arctic storm targeted on your cursor. How to get it: Craft at Anvil from 1 Diamond, 8 Frigid Bar"
	Tooltip: "[c/E2735C:Weapon] Storm Spell: 14 magic damage, use time 36, 15 mana"
}

GearToothAche: {
	Title: "Tooth Ache"
	Contents: "[c/E2735C:Weapon] Obtain Tooth Ache. 27 melee damage, use time 30. Strike with 3 slashes, then toss a spinning blade for 80% damage. How to get it: Dropped by Eater of Worlds Tail"
	Tooltip: "[c/E2735C:Weapon] Tooth Ache: 27 melee damage, use time 30"
}

GearTorchGun: {
	Title: "Torch Gun"
	Contents: "[c/E2735C:Weapon] Obtain Torch Gun. 14 ranged damage, use time 8. Right click to launch a torch bomb. Uses gel for ammo. How to get it: Craft at Anvil from 1 Fire Spitter, 1 Flare Gun, 10 Any Silver Bar, 50 Glow Nylon; Sold by Archaeologist"
	Tooltip: "[c/E2735C:Weapon] Torch Gun: 14 ranged damage, use time 8"
}

GearVertebraeker: {
	Title: "Vertebraeker"
	Contents: "[c/E2735C:Weapon] Obtain Vertebraeker. 21 melee damage, use time 20. Strike with a flurry of slashes, then toss a spinning blade for 120% damage. How to get it: Dropped by Brain of Cthulhu"
	Tooltip: "[c/E2735C:Weapon] Vertebraeker: 21 melee damage, use time 20"
}

GearVesperaLongbow: {
	Title: "Vespera Longbow"
	Contents: "[c/E2735C:Weapon] Obtain Vespera Longbow. 15 ranged damage, use time 30. Has to windup before firing. Arrows travel fast and scatter into rock shrapnel for 70% damage. How to get it: Craft at Furnace from 20 Evostone, 50 Stone Block, 1 Fragment of Earth"
	Tooltip: "[c/E2735C:Weapon] Vespera Longbow: 15 ranged damage, use time 30"
}

GearVesperaNanDao: {
	Title: "Vespera NanDao"
	Contents: "[c/E2735C:Weapon] Obtain Vespera NanDao. 16 melee damage, use time 22. Strike with 2 slashes. The second slash scatters rocks for 70% damage. How to get it: Craft at Furnace from 20 Evostone, 50 Stone Block, 1 Fragment of Earth"
	Tooltip: "[c/E2735C:Weapon] Vespera NanDao: 16 melee damage, use time 22"
}

GearVibrantBlade: {
	Title: "Vibrant Blade"
	Contents: "[c/E2735C:Weapon] Obtain Vibrant Blade. 21 melee damage, use time 24. How to get it: Craft at Anvil from 6 Vibrant Alloy"
	Tooltip: "[c/E2735C:Weapon] Vibrant Blade: 21 melee damage, use time 24"
}

GearVibrantCannon: {
	Title: "Vibrant Cannon"
	Contents: "[c/E2735C:Weapon] Obtain Vibrant Cannon. 18 ranged damage, use time 50. How to get it: Craft at Anvil from 10 Vibrant Alloy"
	Tooltip: "[c/E2735C:Weapon] Vibrant Cannon: 18 ranged damage, use time 50"
}

GearVibrantPistol: {
	Title: "Vibrant Pistol"
	Contents: "[c/E2735C:Weapon] Obtain Vibrant Pistol. 14 ranged damage, use time 14. Rapidly fires Vibrant Bolts. How to get it: Craft at Anvil from 4 Vibrant Alloy"
	Tooltip: "[c/E2735C:Weapon] Vibrant Pistol: 14 ranged damage, use time 14"
}

GearVibrantStaff: {
	Title: "Vibrant Staff"
	Contents: "[c/E2735C:Weapon] Obtain Vibrant Staff. 16 magic damage, use time 23, 8 mana. Fires a homing bolt. How to get it: Craft at Anvil from 6 Vibrant Alloy"
	Tooltip: "[c/E2735C:Weapon] Vibrant Staff: 16 magic damage, use time 23, 8 mana"
}

GearWingedKnife: {
	Title: "Winged Knife"
	Contents: "[c/E2735C:Weapon] Obtain Winged Knife. 12 ranged damage, use time 24. How to get it: Found in world-generated chests"
	Tooltip: "[c/E2735C:Weapon] Winged Knife: 12 ranged damage, use time 24"
}

GearAccretionDisc: {
	Title: "Accretion Disc"
	Contents: "[c/E2735C:Weapon] Obtain Accretion Disc. 48 ranged damage, use time 48. Deals more damage at the peak of its trajectory, creating a short-lived singularity that ignores defense. Scatters homing particles after the singularity collapses. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Cataclysm Disc, 1 Echo Disc, 1 Coconut Gun, 30 Skip Soul, 15 Skip Shard, 5 Soul of Plight, 5 Ectoplasm"
	Tooltip: "[c/E2735C:Weapon] Accretion Disc: 48 ranged damage, use time 48"
}

GearArcStaffMk2: {
	Title: "Arc Staff Mk2"
	Contents: "[c/E2735C:Weapon] Obtain Arc Staff Mk2. 100 magic damage, use time 60. Launch a massive sphere of lightning. Detonates at the end of its lifespan, doing 200% damage to low health, non-boss enemies, but only 100% to bosses. How to get it: Craft at Hardlight Fabricator from 1 Gold Arc Staff, 16 Twilight Alloy"
	Tooltip: "[c/E2735C:Weapon] Arc Staff Mk2: 100 magic damage, use time 60"
}

GearArclightOrbs: {
	Title: "Arclight Orbs"
	Contents: "[c/E2735C:Weapon] Obtain Arclight Orbs. 20 ranged damage, use time 26. Throw a cluster of thunder orbs that explode into chain lightning for 80% damage. How to get it: Craft at Hardlight Fabricator from 1 Spore Bombs, 12 Hardlight Alloy"
	Tooltip: "[c/E2735C:Weapon] Arclight Orbs: 20 ranged damage, use time 26"
}

GearAten: {
	Title: "Aten"
	Contents: "[c/E2735C:Weapon] Obtain Aten. 21 melee damage, use time 30. Conjures stars that do 70% damage and explode for 140% damage. 'The defunct god... now in flail form'. How to get it: Found in Pyramid Crate; Found in world-generated chests"
	Tooltip: "[c/E2735C:Weapon] Aten: 21 melee damage, use time 30"
}

GearBiomassBlast: {
	Title: "Biomass Blast"
	Contents: "[c/E2735C:Weapon] Obtain Biomass Blast. 13 magic damage, use time 39, 15 mana. Launches an acorn that rapidly accelerates its growth upon hitting an enemy or tile. How to get it: Craft at Anvil from 1 Scatterseed, 12 Snakeskin, 1 Dissolving Nature, 1 Vilethorn, 20 Acorn (+1 alternative recipe)"
	Tooltip: "[c/E2735C:Weapon] Biomass Blast: 13 magic damage, use time 39, 15 mana"
}

GearBiomassBarrage: {
	Title: "Biomass Bloom"
	Contents: "[c/E2735C:Weapon] Obtain Biomass Bloom. 24 magic damage, use time 30, 11 mana. Launches a cluster of acorns. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Biomass Blast, 1 Item Type <Cursed Matter>(, 12 Orichalcum Bar, 12 Soul of Light, 12 Soul of Night, 1 Emerald (+1 alternative recipe)"
	Tooltip: "[c/E2735C:Weapon] Biomass Bloom: 24 magic damage, use time 30, 11 mana"
}

GearTheBlaspha: {
	Title: "Blaspha"
	Contents: "[c/E2735C:Weapon] Obtain Blaspha. 45 ranged damage, use time 33. Launch a scatter of inferno-infused bullets which release homing embers for 50% damage. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Sniper Rifle, 1 Tactical Shotgun, 1 Doomstick, 1 Dissolving Nether"
	Tooltip: "[c/E2735C:Weapon] Blaspha: 45 ranged damage, use time 33"
}

GearBoneClapper: {
	Title: "Bone Clapper"
	Contents: "[c/E2735C:Weapon] Obtain Bone Clapper. 26 melee damage, use time 30. Charge to increase damage up to 450%. Takes 2 seconds to reach max charge. How to get it: Sold by Archaeologist; Found in world-generated chests"
	Tooltip: "[c/E2735C:Weapon] Bone Clapper: 26 melee damage, use time 30"
}

GearBookOfVirtues: {
	Title: "Book of Virtues"
	Contents: "[c/E2735C:Weapon] Obtain Book of Virtues. 21 summon damage, use time 18. Summons a Spectral Wisp that defends you from nearby enemies. The wisp does 75% damage on contact with enemies, and 100% with its laser. How to get it: Dropped by Lesser Wisp"
	Tooltip: "[c/E2735C:Weapon] Book of Virtues: 21 summon damage, use time 18"
}

GearCataclysmDisc: {
	Title: "Cataclysm Disc"
	Contents: "[c/E2735C:Weapon] Obtain Cataclysm Disc. 32 ranged damage, use time 34. Deals more damage at the peak of its trajectory and explodes for 300% damage. How to get it: Craft at Hardlight Fabricator from 1 Gold Chakram, 12 Twilight Alloy"
	Tooltip: "[c/E2735C:Weapon] Cataclysm Disc: 32 ranged damage, use time 34"
}

GearChainedPlasma: {
	Title: "Chained Plasma"
	Contents: "[c/E2735C:Weapon] Obtain Chained Plasma. 30 melee damage, use time 30. Chains between enemies for 70% damage. Tries to move towards your cursor. How to get it: Craft at Hardlight Fabricator from 1 Dissolving Aether, 12 Hardlight Alloy; Found in world-generated chests"
	Tooltip: "[c/E2735C:Weapon] Chained Plasma: 30 melee damage, use time 30"
}

GearCodeCorrupter: {
	Title: "Code Corrupter"
	Contents: "[c/E2735C:Weapon] Obtain Code Corrupter. 36 magic damage, use time 24, 14 mana. Fires a short ranged and a long ranged blast. The short ranged blast has a 70% chance to destabilize enemies while the long ranged blast has a 30% chance to destabilize enemies. Destabilized enemies gain a 5% flat chance to be critically struck. Destabilization is permanent and can stack, but the... How to get it: Craft at Hardlight Fabricator from 16 Hardlight Alloy; Found in world-generated chests"
	Tooltip: "[c/E2735C:Weapon] Code Corrupter: 36 magic damage, use time 24, 14 mana"
}

GearColossus: {
	Title: "Colossus"
	Contents: "[c/E2735C:Weapon] Obtain Colossus. 80 melee damage, use time 32. Strike with 3 slashes. The final slash deals 120%. All slashes deal triple damage to healthy foes. How to get it: Obtained in-world (source not found) [c/9AA0A6:(source unconfirmed)]"
	Tooltip: "[c/E2735C:Weapon] Colossus: 80 melee damage, use time 32"
}

GearCrescentStaff: {
	Title: "Crescent Staff"
	Contents: "[c/E2735C:Weapon] Obtain Crescent Staff. 20 magic damage (pack-balanced, was 36), use time 10. Cast a wave of Crescents that each lock onto an enemy, and then steal life and mana from them. How to get it: Craft at Hardlight Fabricator from 1 Illuminant Staff, 1 Platinum Soul Staff, 8 Starlight Alloy"
	Tooltip: "[c/E2735C:Weapon] Crescent Staff: 20 magic damage (pack-balanced, was 36), use time 10"
}

GearJeweledGauntlet: {
	Title: "Cursed Gauntlet"
	Contents: "[c/E2735C:Weapon] Obtain Cursed Gauntlet. 38 melee damage (pack-balanced, was 54), use time 12. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Sandstone Warhammer, 1 Spirit Glove, 4 Cursed Matter, 8 Keystone Shard, 15 Soul of Night"
	Tooltip: "[c/E2735C:Weapon] Cursed Gauntlet: 38 melee damage (pack-balanced, was 54), use time 12"
}

GearCurseballTome: {
	Title: "Cursed Spear Storm"
	Contents: "[c/E2735C:Weapon] Obtain Cursed Spear Storm. 20 magic damage, use time 6, 17 mana. Unleashes a flurry of highly potent but inaccurate Cursed Spears. How to get it: Craft at Anvil from 6 Cursed Matter, 10 Keystone Shard"
	Tooltip: "[c/E2735C:Weapon] Cursed Spear Storm: 20 magic damage, use time 6, 17 mana"
}

GearDeathSpiral: {
	Title: "Death Spiral"
	Contents: "[c/E2735C:Weapon] Obtain Death Spiral. 50 melee damage, use time 36. Surrounds you with lightning tentacles. Has a chance to apply a stacking, permanent bleed to hit enemies for 5 damage per second. How to get it: Dropped by Evil Construct"
	Tooltip: "[c/E2735C:Weapon] Death Spiral: 50 melee damage, use time 36"
}

GearDoomstick: {
	Title: "Doomstick"
	Contents: "[c/E2735C:Weapon] Obtain Doomstick. 27 ranged damage, use time 10. Fires two shotgun blasts in quick succession. Right click to launch a 250% damage hook that pulls in enemies. Pulls you toward bosses instead. Killed enemies drop packs of health and mana. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Boomstick, 4 Fragment of Inferno, 20 Soul of Flight, 1 Illegal Gun Parts"
	Tooltip: "[c/E2735C:Weapon] Doomstick: 27 ranged damage, use time 10"
}

GearAquaticEclipse: {
	Title: "Eclipse"
	Contents: "[c/E2735C:Weapon] Obtain Eclipse. 92 melee damage, use time 30. Charge to increase damage up to 700%. Takes 3 seconds to reach max charge. Can strike through walls. Releases bubbles that do 10% damage. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Hellbreaker, 1 Goopwood Collapse, 1 Crab Claw, 5 Cursed Matter, 10 Soul of Night, 10 Soul of Light, 1 Amethyst"
	Tooltip: "[c/E2735C:Weapon] Eclipse: 92 melee damage, use time 30"
}

GearEvilSpiritStaff: {
	Title: "Evil Spirit Staff"
	Contents: "[c/E2735C:Weapon] Obtain Evil Spirit Staff. 60 summon damage, use time 30. Summons an Evil Spirit to fight for you. Attacks with a flurry of Evil Bolts, dealing 50% damage each. Ends in an explosion that deals 100% damage, always critical strikes. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Dissolving Umbra, 1 Cursed Blade, 10 Spectre Bar, 10 Any Evil Bar, 5 Soul of Sight"
	Tooltip: "[c/E2735C:Weapon] Evil Spirit Staff: 60 summon damage, use time 30"
}

GearFlareDetonator: {
	Title: "Flare Detonator"
	Contents: "[c/E2735C:Weapon] Obtain Flare Detonator. 23 ranged damage, use time 10. Fire an explosive flare that detonates upon releasing the trigger. How to get it: Craft at Hardlight Fabricator from 1 Flare Gun, 12 Twilight Alloy; Sold by Merchant; Found in world-generated chests"
	Tooltip: "[c/E2735C:Weapon] Flare Detonator: 23 ranged damage, use time 10"
}

GearSpiderCrusher: {
	Title: "Fly Catcher"
	Contents: "[c/E2735C:Weapon] Obtain Fly Catcher. 42 melee damage, use time 30. Charge to increase damage up to 180%. Releases spider webs that slow hit enemies. Releases more when charged. Takes 2.5 seconds to reach max charge. 'That's really clever actually'. How to get it: Craft at Anvil from 18 Spider Fang, 1 Dissolving Earth"
	Tooltip: "[c/E2735C:Weapon] Fly Catcher: 42 melee damage, use time 30"
}

GearGhoulBlaster: {
	Title: "Ghoul Blaster"
	Contents: "[c/E2735C:Weapon] Obtain Ghoul Blaster. 18 ranged damage (pack-balanced, was 28), use time 6. Unloads almost as fast as the trigger is pulled. Transforms bullets into cursed singularities every 6th shot. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Phoenix Blaster, 1 Royal Magnum, 4 Cursed Matter, 8 Keystone Shard, 12 Soul Residue, 15 Soul of Night"
	Tooltip: "[c/E2735C:Weapon] Ghoul Blaster: 18 ranged damage (pack-balanced, was 28), use time 6"
}

GearWormWoodCollapse: {
	Title: "Goopwood Collapse"
	Contents: "[c/E2735C:Weapon] Obtain Goopwood Collapse. 34 melee damage, use time 30. Charge to increase damage up to 500%. Takes 3 seconds to reach max charge. How to get it: Craft at Anvil from 20 Corrosive Gel, 32 Goopwood; Found in Treasure Bag (Putrid Pinky)"
	Tooltip: "[c/E2735C:Weapon] Goopwood Collapse: 34 melee damage, use time 30"
}

GearWormWoodHelix: {
	Title: "Goopwood Helix"
	Contents: "[c/E2735C:Weapon] Obtain Goopwood Helix. 20 ranged damage, use time 24. Converts musket balls into helix shots. How to get it: Craft at Anvil from 24 Corrosive Gel, 24 Goopwood; Found in Treasure Bag (Putrid Pinky)"
	Tooltip: "[c/E2735C:Weapon] Goopwood Helix: 20 ranged damage, use time 24"
}

GearWormWoodScepter: {
	Title: "Goopwood Scepter"
	Contents: "[c/E2735C:Weapon] Obtain Goopwood Scepter. 21 summon damage, use time 45, 20 mana. Summons a Wormwood Turret to fire upon up to 4 enemies at a time. How to get it: Craft at Anvil from 32 Corrosive Gel, 28 Goopwood; Found in Treasure Bag (Putrid Pinky)"
	Tooltip: "[c/E2735C:Weapon] Goopwood Scepter: 21 summon damage, use time 45, 20 mana"
}

GearHardlightGlaive: {
	Title: "Hardlight Glaive"
	Contents: "[c/E2735C:Weapon] Obtain Hardlight Glaive. 40 melee damage, use time 37. Unleash a burst of lightning that deals 160% damage. How to get it: Craft at Hardlight Fabricator from 1 Cursed Impale, 1 Imperial Pike, 1 Gold Glaive, 12 Hardlight Alloy"
	Tooltip: "[c/E2735C:Weapon] Hardlight Glaive: 40 melee damage, use time 37"
}

GearIncineratorGlove: {
	Title: "Incinerator Glove"
	Contents: "[c/E2735C:Weapon] Obtain Incinerator Glove. 33 magic damage, use time 40. Charge up a short-ranged ball of hot plasma. Gains 40% additional damage each charge. Maxes out at 80 charges. Only does half damage prior to firing. How to get it: Dropped by Inferno Construct"
	Tooltip: "[c/E2735C:Weapon] Incinerator Glove: 33 magic damage, use time 40"
}

GearInfernoHook: {
	Title: "Inferno Hook"
	Contents: "[c/E2735C:Weapon] Obtain Inferno Hook. 33 melee damage. A very fast hook that strikes enemies as it travels. How to get it: Craft at Hardlight Fabricator from 1 Goopwood Hook, 2 Fragment of Inferno, 10 Twilight Alloy; Found in world-generated chests"
	Tooltip: "[c/E2735C:Weapon] Inferno Hook: 33 melee damage"
}

GearInfernoSpiritStaff: {
	Title: "Inferno Spirit Staff"
	Contents: "[c/E2735C:Weapon] Obtain Inferno Spirit Staff. 47 summon damage, use time 30. Summons an Inferno Spirit to fight for you. Attacks up to 7 enemies at a time. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Dissolving Nether, 10 Hellstone Bar, 5 Soul of Fright"
	Tooltip: "[c/E2735C:Weapon] Inferno Spirit Staff: 47 summon damage, use time 30"
}

GearLashesOfLightning: {
	Title: "Lashes of Lightning"
	Contents: "[c/E2735C:Weapon] Obtain Lashes of Lightning. 26 magic damage, use time 8, 20 mana. Unleash rapid strikes of lightning in a small area in front of you. Deals slightly more damage and can hit through walls at the tip. How to get it: Craft at Hardlight Fabricator from 16 Starlight Alloy; Found in world-generated chests"
	Tooltip: "[c/E2735C:Weapon] Lashes of Lightning: 26 magic damage, use time 8, 20 mana"
}

GearPhaseCannon: {
	Title: "Phase Cannon"
	Contents: "[c/E2735C:Weapon] Obtain Phase Cannon. 27 ranged damage, use time 90. Fires a supercharged ball of plasma that can travel through walls. How to get it: Dropped by Otherworldly Construct"
	Tooltip: "[c/E2735C:Weapon] Phase Cannon: 27 ranged damage, use time 90"
}

GearPhotonGeyser: {
	Title: "Photon Geyser"
	Contents: "[c/E2735C:Weapon] Obtain Photon Geyser. 33 magic damage, use time 30, 60 mana. Unleash a helix of homing rainbow light. How to get it: Sold by Archaeologist"
	Tooltip: "[c/E2735C:Weapon] Photon Geyser: 33 magic damage, use time 30, 60 mana"
}

GearPoyoyo: {
	Title: "Poyo-yo"
	Contents: "[c/E2735C:Weapon] Obtain Poyo-yo. 30 melee damage, use time 25. Leaves behind a rainbow trail that does 60% damage. How to get it: Craft at Hardlight Fabricator from 8 Starlight Alloy; Found in world-generated chests"
	Tooltip: "[c/E2735C:Weapon] Poyo-yo: 30 melee damage, use time 25"
}

GearPulverizer: {
	Title: "Pulverizer"
	Contents: "[c/E2735C:Weapon] Obtain Pulverizer. 35 melee damage, use time 30. Charge to increase damage up to 500%. The initial charge consumes no void. Takes 3 seconds to reach max charge. Laser deals 60% of the total damage. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Bone Clapper, 1 Mantis Grip, 10 Hallowed Bar, 10 Soul of Fright"
	Tooltip: "[c/E2735C:Weapon] Pulverizer: 35 melee damage, use time 30"
}

GearPurpleJellyfishStaff: {
	Title: "Purple Jellyfish Staff"
	Contents: "[c/E2735C:Weapon] Obtain Purple Jellyfish Staff. 32 magic damage, use time 20. Fires 2 purple orbs that, upon detonation, release purple thunder towards your cursor. Purple thunder chains off enemies for 70% damage. Provides a light source while favorited in the inventory. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Pink Jellyfish Staff, 1 Blue Jellyfish Staff, 1 Dissolving Aether, 5 Cursed Matter, 12 Soul of Night, 1 Amethyst"
	Tooltip: "[c/E2735C:Weapon] Purple Jellyfish Staff: 32 magic damage, use time 20"
}

GearPutridEye: {
	Title: "Putrid Eye"
	Contents: "[c/E2735C:Weapon] Obtain Putrid Eye. 50 magic damage, use time 40. 'You want deathray? We have deathray'. How to get it: Found in Treasure Bag (Putrid Pinky)"
	Tooltip: "[c/E2735C:Weapon] Putrid Eye: 50 magic damage, use time 40"
}

GearSectionChiefsScythe: {
	Title: "Section Chief's Scythe"
	Contents: "[c/E2735C:Weapon] Obtain Section Chief's Scythe. 48 melee damage, use time 24. Critical hits summon a Soul of Retaliation into the air. Every 10th void attack will release the soul in the form of a powerful laser. Direct melee hits permanently curse enemies for 3 damage per second, stacking up to 10 times. How to get it: Craft at Hardlight Fabricator from 1 Platinum Scythe, 12 Hardlight Alloy"
	Tooltip: "[c/E2735C:Weapon] Section Chief's Scythe: 48 melee damage, use time 24"
}

GearSkywardBlades: {
	Title: "Skyward Blades"
	Contents: "[c/E2735C:Weapon] Obtain Skyward Blades. 22 ranged damage (pack-balanced, was 33), use time 10. Arm yourself with several deadly throwing knives. Scoring a hit restores a dagger. 'Watch this!'. How to get it: Craft at Hardlight Fabricator from 1 Platinum Dart, 12 Hardlight Alloy"
	Tooltip: "[c/E2735C:Weapon] Skyward Blades: 22 ranged damage (pack-balanced, was 33), use time 10"
}

GearStarcoreAssaultRifle: {
	Title: "Starcore Assault Rifle"
	Contents: "[c/E2735C:Weapon] Obtain Starcore Assault Rifle. 13 ranged damage (pack-balanced, was 23), use time 5. Fires a stream of bouncy, colorful projectiles. How to get it: Craft at Hardlight Fabricator from 1 Vibrant Pistol, 1 Vibrancy Module, 12 Starlight Alloy"
	Tooltip: "[c/E2735C:Weapon] Starcore Assault Rifle: 13 ranged damage (pack-balanced, was 23), use time 5"
}

GearStarshotCrossbow: {
	Title: "Starshot Crossbow"
	Contents: "[c/E2735C:Weapon] Obtain Starshot Crossbow. 32 ranged damage, use time 20. Fire a star that scatters arrows in every direction. How to get it: Craft at Hardlight Fabricator from 12 Starlight Alloy; Found in world-generated chests"
	Tooltip: "[c/E2735C:Weapon] Starshot Crossbow: 32 ranged damage, use time 20"
}

GearStreetCleaner: {
	Title: "Street Cleaner"
	Contents: "[c/E2735C:Weapon] Obtain Street Cleaner. 15 ranged damage (pack-balanced, was 24), use time 3. Ignores enemy defense. How to get it: Dropped by Evil Construct"
	Tooltip: "[c/E2735C:Weapon] Street Cleaner: 15 ranged damage (pack-balanced, was 24), use time 3"
}

GearSupernovaHammer: {
	Title: "Supernova Hammer"
	Contents: "[c/E2735C:Weapon] Obtain Supernova Hammer. 30 melee damage, use time 30. Critical strikes release 3 seekers that do 100% damage. Killing enemies releases 3 seekers that do 70% damage. Enemies killed by seekers release 2 more seekers, each doing 75% damage. Seekers home onto enemies, but do not attack the enemies they are released from. How to get it: Craft at Hardlight Fabricator from 5 Diamond, 15 Starlight Alloy; Found in world-generated chests"
	Tooltip: "[c/E2735C:Weapon] Supernova Hammer: 30 melee damage, use time 30"
}

GearTerminatorAcorns: {
	Title: "Terminator Acorns"
	Contents: "[c/E2735C:Weapon] Obtain Terminator Acorns. 20 summon damage, use time 30, 12 mana. Summons a Mechanically Modified Squirrel to fight for you. How to get it: Craft at Hardlight Fabricator from 1 Dissolving Nature, 3 Fragment of Inferno, 1 Acorn Bag, 10 Twilight Alloy; Found in world-generated chests"
	Tooltip: "[c/E2735C:Weapon] Terminator Acorns: 20 summon damage, use time 30, 12 mana"
}

GearTesseractSword: {
	Title: "Tesseract Sword"
	Contents: "[c/E2735C:Weapon] Obtain Tesseract Sword. 100 melee damage, use time 45. Stop snooping around! How to get it: Obtained in-world (source not found) [c/9AA0A6:(source unconfirmed)]"
	Tooltip: "[c/E2735C:Weapon] Tesseract Sword: 100 melee damage, use time 45"
}

GearThundershockShortbow: {
	Title: "Thundershock Shortbow"
	Contents: "[c/E2735C:Weapon] Obtain Thundershock Shortbow. 30 ranged damage, use time 30. Fires powerful bolts of lightning instead of arrows. How to get it: Dropped by Twilight Scouter"
	Tooltip: "[c/E2735C:Weapon] Thundershock Shortbow: 30 ranged damage, use time 30"
}

GearTidalSpiritStaff: {
	Title: "Tidal Spirit Staff"
	Contents: "[c/E2735C:Weapon] Obtain Tidal Spirit Staff. 30 summon damage, use time 30. Summons a Tidal Spirit to fight for you. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Dissolving Deluge, 10 Any Iron Bar, 5 Soul of Might"
	Tooltip: "[c/E2735C:Weapon] Tidal Spirit Staff: 30 summon damage, use time 30"
}

GearTomeOfTheReaper: {
	Title: "Tome of the Reaper"
	Contents: "[c/E2735C:Weapon] Obtain Tome of the Reaper. 48 magic damage, use time 18, 14 mana. Cast three scythes that move towards your cursor. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Demon Scythe, 10 Soul of Fright, 1 Dissolving Umbra"
	Tooltip: "[c/E2735C:Weapon] Tome of the Reaper: 48 magic damage, use time 18, 14 mana"
}

GearTorchGunMk2: {
	Title: "Torch Gun Mk2"
	Contents: "[c/E2735C:Weapon] Obtain Torch Gun Mk2. 30 ranged damage, use time 60. Launches a torch cluster bomb that explodes into homing torches. Right click to launch smaller torch bombs, consuming neither ammo nor void. Uses torch bombs for ammo. How to get it: Craft at Hardlight Fabricator from 1 Phase Cannon, 1 Coconut Gun, 1 Torch Gun, 1 Dissolving Nether, 20 Twilight Alloy"
	Tooltip: "[c/E2735C:Weapon] Torch Gun Mk2: 30 ranged damage, use time 60"
}

GearVorpalKnife: {
	Title: "Vorpal Knife"
	Contents: "[c/E2735C:Weapon] Obtain Vorpal Knife. 21 melee damage, use time 33. Toss a blade that lingers in the air. Detonate with left click, dealing 300% damage. Teleport with right click, slashing for 200% damage. Drains more void to detonate or teleport the farther away the blade is. How to get it: Sold by Archaeologist; Found in Gem Structures chests"
	Tooltip: "[c/E2735C:Weapon] Vorpal Knife: 21 melee damage, use time 33"
}

GearZephyrousZeppelin: {
	Title: "Zephyrous Zeppelin"
	Contents: "[c/E2735C:Weapon] Obtain Zephyrous Zeppelin. 22 melee damage, use time 25. Surrounded by a ring of razorwater that deals 75% damage. How to get it: Caught while fishing"
	Tooltip: "[c/E2735C:Weapon] Zephyrous Zeppelin: 22 melee damage, use time 25"
}

GearAbyssalFury: {
	Title: "Abyssal Fury"
	Contents: "[c/E2735C:Weapon] Obtain Abyssal Fury. 41 melee damage, use time 12. Summons Shadow Blades from the sky to your cursor. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Vibrant Blade, 1 Obsidian Eruption, 1 Starfury, 1 Enchanted Sword, 1 Dissolving Umbra"
	Tooltip: "[c/E2735C:Weapon] Abyssal Fury: 41 melee damage, use time 12"
}

GearApocalypse: {
	Title: "Apocalypse"
	Contents: "[c/E2735C:Weapon] Obtain Apocalypse. 75 magic damage (pack-balanced, was 330), use time 15. Release green thunder towards your cursor. Green thunder chains off enemies for 90% damage. Provides a light source while favorited in the inventory. 'Power straight from the underworld'. How to get it: Craft at Mythril/Orichalcum Anvil from 15 Sanguite Scales, 1 Green Jellyfish Staff, 8 Astral Bar"
	Tooltip: "[c/E2735C:Weapon] Apocalypse: 75 magic damage (pack-balanced, was 330), use time 15"
}

GearArmaggedon: {
	Title: "Armageddon"
	Contents: "[c/E2735C:Weapon] Obtain Armageddon. 65 melee damage (pack-balanced, was 190), use time 10. Unleash a flurry of punches. Provides a light source while favorited in the inventory. 'Power from the heavens'. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Cursed Gauntlet, 20 Phase Bar"
	Tooltip: "[c/E2735C:Weapon] Armageddon: 65 melee damage (pack-balanced, was 190), use time 10"
}

GearShardstormSpell: {
	Title: "Azure Bombardment"
	Contents: "[c/E2735C:Weapon] Obtain Azure Bombardment. 40 magic damage, use time 48, 20 mana. Create an area of arctic obliteration targeted on your cursor. How to get it: Craft at Mythril/Orichalcum Anvil from 10 Absolute Alloy, 1 Shard Staff, 1 Storm Spell"
	Tooltip: "[c/E2735C:Weapon] Azure Bombardment: 40 magic damage, use time 48, 20 mana"
}

GearBrachialLance: {
	Title: "Brachial Lance"
	Contents: "[c/E2735C:Weapon] Obtain Brachial Lance. 68 magic damage, use time 36. Throw a powerful, fast traveling lance that unleashes cursed spears for 3x50% damage. Charge to increase damage up to 160% and the number of spears unleashed upon hitting an enemy. Guaranteed to critically strike at full charge. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Frigid Javelin, 1 Cursed Spear Storm, 1 Geostorm, 1 Ruby Keystone, 5 Cursed Matter, 5 Soul of Night, 5 Soul of Might"
	Tooltip: "[c/E2735C:Weapon] Brachial Lance: 68 magic damage, use time 36"
}

GearCataclysmSpheres: {
	Title: "Cataclysm Spheres"
	Contents: "[c/E2735C:Weapon] Obtain Cataclysm Spheres. 50 ranged damage, use time 26. Throw a cluster of charged bombs that explodes into homing cataclysm lightning for 100% damage. How to get it: Craft at Mythril/Orichalcum Anvil from 10 Sanguite Scales, 1 Arclight Orbs"
	Tooltip: "[c/E2735C:Weapon] Cataclysm Spheres: 50 ranged damage, use time 26"
}

GearChaosChamber: {
	Title: "Chaos Chamber"
	Contents: "[c/E2735C:Weapon] Obtain Chaos Chamber. 45 ranged damage (pack-balanced, was 70), use time 8. Unloads almost as fast as the trigger is pulled. Bullets gain homing capabilities. Transforms bullets into laser balls every 6th shot. How to get it: Craft at Mythril/Orichalcum Anvil from 15 Phase Bar, 1 Venus Magnum, 1 Ghoul Blaster"
	Tooltip: "[c/E2735C:Weapon] Chaos Chamber: 45 ranged damage (pack-balanced, was 70), use time 8"
}

GearChaosSpiritStaff: {
	Title: "Chaos Spirit Staff"
	Contents: "[c/E2735C:Weapon] Obtain Chaos Spirit Staff. 50 summon damage, use time 36. Summons a Chaos Spirit to fight for you. Locks onto one enemy at a time. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Dissolving Brilliance, 1 Phase Bar, 5 Soul of Light"
	Tooltip: "[c/E2735C:Weapon] Chaos Spirit Staff: 50 summon damage, use time 36"
}

GearPBow: {
	Title: "Compound Bow"
	Contents: "[c/E2735C:Weapon] Obtain Compound Bow. 44 ranged damage, use time 41. Fire a Compound Arrow that splits into bouncing Energy Bolts and other arrows. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Pitati Longbow, 1 Ancient Steel Longbow, 1 Spore Sprayer, 12 Absolute Alloy"
	Tooltip: "[c/E2735C:Weapon] Compound Bow: 44 ranged damage, use time 41"
}

GearCruiseCaller: {
	Title: "Cruise Caller"
	Contents: "[c/E2735C:Weapon] Obtain Cruise Caller. 47 summon damage, use time 32, 20 mana. Summons a fleet of Penguin Copters to fight for you. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Dissolving Aurora, 12 Absolute Alloy, 2 Helicopter Parts"
	Tooltip: "[c/E2735C:Weapon] Cruise Caller: 47 summon damage, use time 32, 20 mana"
}

GearDanceOfDeath: {
	Title: "Dance of Death"
	Contents: "[c/E2735C:Weapon] Obtain Dance of Death. 110 magic damage, use time 30, 12 mana. Cast many demon scythes around you. How to get it: Craft at Mythril/Orichalcum Anvil from 15 Sanguite Scales, 1 Tome of the Reaper, 1 Shifting Sands"
	Tooltip: "[c/E2735C:Weapon] Dance of Death: 110 magic damage, use time 30, 12 mana"
}

GearDigitalDaito: {
	Title: "Digital Daito"
	Contents: "[c/E2735C:Weapon] Obtain Digital Daito. 40 melee damage, use time 20. How to get it: Craft at Hardlight Fabricator from 1 Terragrim, 20 Hardlight Alloy, 1 Primordial Cluster, 1 Tainted Keystone"
	Tooltip: "[c/E2735C:Weapon] Digital Daito: 40 melee damage, use time 20"
}

GearDuneSplicer: {
	Title: "Dune Splicer"
	Contents: "[c/E2735C:Weapon] Obtain Dune Splicer. 54 melee damage, use time 30. Launches out a swarm of short-range, homing spikes. Charge to increase damage up to 350%. Takes 4 seconds to reach max charge. How to get it: Found in world-generated chests"
	Tooltip: "[c/E2735C:Weapon] Dune Splicer: 54 melee damage, use time 30"
}

GearEtherealScepter: {
	Title: "Ethereal Scepter"
	Contents: "[c/E2735C:Weapon] Obtain Ethereal Scepter. 66 summon damage, use time 30, 16 mana. Summons an Ethereal Flame to fight for you. Ethereal Flames attack enemies by rapidly dashing through them. How to get it: Craft at Mythril/Orichalcum Anvil from 18 Phase Bar"
	Tooltip: "[c/E2735C:Weapon] Ethereal Scepter: 66 summon damage, use time 30, 16 mana"
}

GearGreenJellyfishStaff: {
	Title: "Green Jellyfish Staff"
	Contents: "[c/E2735C:Weapon] Obtain Green Jellyfish Staff. 70 magic damage, use time 18. Fires 2 green orbs that, upon detonation, release green thunder towards your cursor. Green thunder chains off enemies for 90% damage. Provides a light source while favorited in the inventory. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Purple Jellyfish Staff, 15 Soul of Light, 15 Soul of Sight"
	Tooltip: "[c/E2735C:Weapon] Green Jellyfish Staff: 70 magic damage, use time 18"
}

GearHelios: {
	Title: "Helios"
	Contents: "[c/E2735C:Weapon] Obtain Helios. 70 melee damage, use time 33. Attacks scorch with each hit, increasing damage done by 3% permanently. Stacks up to 5 times. Launches waves that deal 40% damage. How to get it: Craft at Mythril/Orichalcum Anvil from 20 Lunar Tablet Fragment, 1 Lihzahrd Power Cell; Found in world-generated chests"
	Tooltip: "[c/E2735C:Weapon] Helios: 70 melee damage, use time 33"
}

GearHypericeClusterCannon: {
	Title: "Hyperice Cluster Cannon"
	Contents: "[c/E2735C:Weapon] Obtain Hyperice Cluster Cannon. 38 ranged damage, use time 26. How to get it: Craft at Mythril/Orichalcum Anvil from 16 Absolute Alloy, 1 Cryo Cannon, 1 Snowball Cannon"
	Tooltip: "[c/E2735C:Weapon] Hyperice Cluster Cannon: 38 ranged damage, use time 26"
}

GearHyperlightGeyser: {
	Title: "Hyperlight Geyser"
	Contents: "[c/E2735C:Weapon] Obtain Hyperlight Geyser. 48 magic damage, use time 30, 40 mana. Launches 4 beams of light which each home at up to 10 enemies. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Photon Geyser, 24 Phase Bar, 1 Dissolving Brilliance (+1 alternative recipe)"
	Tooltip: "[c/E2735C:Weapon] Hyperlight Geyser: 48 magic damage, use time 30, 40 mana"
}

GearIcicleImpale: {
	Title: "Icicle Impale"
	Contents: "[c/E2735C:Weapon] Obtain Icicle Impale. 75 ranged damage, use time 17. Launches large icicles. Regenerates void upon hit. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Hyperice Cluster Cannon, 1 Helicopter Parts, 1 Dissolving Aurora"
	Tooltip: "[c/E2735C:Weapon] Icicle Impale: 75 ranged damage, use time 17"
}

GearIrradiatedChainReactor: {
	Title: "Irradiated Chain-Reactor"
	Contents: "[c/E2735C:Weapon] Obtain Irradiated Chain-Reactor. 40 melee damage, use time 30. Charge to increase damage up to 500%. Launches out spores that deal 50% damage. Takes 1.66 seconds to reach max charge. How to get it: Craft at Mythril/Orichalcum Anvil from 16 Chlorophyte Bar, 6 Soul of Night, 6 Fragment of Evil"
	Tooltip: "[c/E2735C:Weapon] Irradiated Chain-Reactor: 40 melee damage, use time 30"
}

GearKingBlade: {
	Title: "King Blade"
	Contents: "[c/E2735C:Weapon] Obtain King Blade. 61 melee damage, use time 14. Strike with 6 slashes, then toss a spinning blade for 80% damage. Each slash will additionally call down a blade from the sky. How to get it: Craft at Mythril/Orichalcum Anvil from 20 Absolute Alloy, 1 Abyssal Fury, 1 Shatter Blade, 1 Tooth Ache, 1 Broken Hero Sword, 6 Essence of Eleum (+1 alternative recipe)"
	Tooltip: "[c/E2735C:Weapon] King Blade: 61 melee damage, use time 14"
}

GearLemegeton: {
	Title: "Lemegeton"
	Contents: "[c/E2735C:Weapon] Obtain Lemegeton. 62 summon damage, use time 16. Summons a horde of Wisps to defend you from nearby enemies. Red wisps will attack closer enemies and steal life for 100% damage. Green wisps will fire short-ranged blasts for 200% damage. Purple wisps launch a cluster of homing bolts for 75% damage each. How to get it: Craft at Mythril/Orichalcum Anvil from 10 Sanguite Scales, 1 Book of Virtues"
	Tooltip: "[c/E2735C:Weapon] Lemegeton: 62 summon damage, use time 16"
}

GearMetalmalgamation: {
	Title: "Metalmalgamation"
	Contents: "[c/E2735C:Weapon] Obtain Metalmalgamation. 47 melee damage, use time 22. Rapidly sprays out bullets in a radius around it that deal 50% damage. 'Guns on MY children's toy!?'. How to get it: Craft at Mythril/Orichalcum Anvil from 11 Absolute Alloy, 4 Cryonic Bar"
	Tooltip: "[c/E2735C:Weapon] Metalmalgamation: 47 melee damage, use time 22"
}

GearNorthStar: {
	Title: "North Star"
	Contents: "[c/E2735C:Weapon] Obtain North Star. 45 melee damage, use time 30. Conjures polar stars that do 70% damage and explode for 210% damage. How to get it: Craft at Mythril/Orichalcum Anvil from 12 Absolute Alloy, 1 Aten, 1 Shattershine"
	Tooltip: "[c/E2735C:Weapon] North Star: 45 melee damage, use time 30"
}

GearPathogenRegurgitator: {
	Title: "Pathogen Regurgitator"
	Contents: "[c/E2735C:Weapon] Obtain Pathogen Regurgitator. 45 ranged damage, use time 24. Fire pathogen balls. Hits may infect enemies for 12 damage per second. When an infected enemy is killed, it releases more pathogen balls. How to get it: Found in world-generated chests"
	Tooltip: "[c/E2735C:Weapon] Pathogen Regurgitator: 45 ranged damage, use time 24"
}

GearPlasmaAccelerator: {
	Title: "Plasma Accelerator"
	Contents: "[c/E2735C:Weapon] Obtain Plasma Accelerator. 44 ranged damage, use time 12. Fires supercharged plasma arrows. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Sharanga, 1 Dissolving Aether, 1 Dissolving Nether, 5 Ectoplasm"
	Tooltip: "[c/E2735C:Weapon] Plasma Accelerator: 44 ranged damage, use time 12"
}

GearPyrocide: {
	Title: "Pyrocide"
	Contents: "[c/E2735C:Weapon] Obtain Pyrocide. 84 melee damage, use time 30. Strike with 5 slashes. The final slash does 150% damage. How to get it: Craft at Mythril/Orichalcum Anvil from 20 Lunar Tablet Fragment, 1 Lihzahrd Power Cell; Found in world-generated chests"
	Tooltip: "[c/E2735C:Weapon] Pyrocide: 84 melee damage, use time 30"
}

GearRealityShatter: {
	Title: "Reality Shatter"
	Contents: "[c/E2735C:Weapon] Obtain Reality Shatter. 75 melee damage, use time 20. Enemies receive an additional flurry of slashes that do 4x50% damage. How to get it: Craft at Mythril/Orichalcum Anvil from 21 Phase Bar, 1 Sandstone Edge, 6 Plague Cell Canister"
	Tooltip: "[c/E2735C:Weapon] Reality Shatter: 75 melee damage, use time 20"
}

GearRebarRifle: {
	Title: "Rebar Rifle"
	Contents: "[c/E2735C:Weapon] Obtain Rebar Rifle. 85 ranged damage (pack-balanced, was 135), use time 21. Shoots a powerful, high velocity rebar that applies a stacking, permanent bleed to hit enemies for 5 damage per second. How to get it: Found in world-generated chests"
	Tooltip: "[c/E2735C:Weapon] Rebar Rifle: 85 ranged damage (pack-balanced, was 135), use time 21"
}

GearRevolution: {
	Title: "Revolution"
	Contents: "[c/E2735C:Weapon] Obtain Revolution. 48 magic damage, use time 15. Does not consume void during the night. How to get it: Craft at Mythril/Orichalcum Anvil from 20 Lunar Tablet Fragment, 1 Lihzahrd Power Cell; Found in world-generated chests"
	Tooltip: "[c/E2735C:Weapon] Revolution: 48 magic damage, use time 15"
}

GearRoseBow: {
	Title: "Rose Bow"
	Contents: "[c/E2735C:Weapon] Obtain Rose Bow. 92 ranged damage, use time 24. Transforms arrows into spears of light that can travel through walls. When briefly charged, arrows explode for 600% damage. When fully charged, arrows bloom for 1500% damage. Charging will also conjure thorns, which are launched for 2x100% damage each. Only consumes void when charged. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Terminal Cluster, 1 Primordial Cluster, 1 Glaze Bow, 1 Spectre Spirit Storm, 1 Starshot Crossbow, 1 Chlorophyte Shotbow, 6 Phase Bar"
	Tooltip: "[c/E2735C:Weapon] Rose Bow: 92 ranged damage, use time 24"
}

GearSawflake: {
	Title: "Sawflake"
	Contents: "[c/E2735C:Weapon] Obtain Sawflake. 70 melee damage, use time 16. Throw a Sawflake that exudes a spiral of razor ice mist in every direction. How to get it: Found in world-generated chests"
	Tooltip: "[c/E2735C:Weapon] Sawflake: 70 melee damage, use time 16"
}

GearSkipScythe: {
	Title: "Selene"
	Contents: "[c/E2735C:Weapon] Obtain Selene. 105 melee damage, use time 20. Applies a stacking, permanent curse that deals 2 damage per second and increases damage done by 0.5%. Launches waves that deal 50% damage and have a 20% chance to apply the curse. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Helios, 1 Death Sickle, 1 Section Chief's Scythe, 1 Betrayer's Knife, 30 Skip Soul, 15 Skip Shard, 1 Dissolving Umbra"
	Tooltip: "[c/E2735C:Weapon] Selene: 105 melee damage, use time 20"
}

GearSpectreSpiritStorm: {
	Title: "Spectre Spirit Storm"
	Contents: "[c/E2735C:Weapon] Obtain Spectre Spirit Storm. 62 ranged damage, use time 18. Fires 3 phantom arrows that each travel instantly to up to 4 enemies at a time. How to get it: Craft at Mythril/Orichalcum Anvil from 1 Spirit Tracer, 1 Daedalus Stormbow, 10 Spectre Bar, 1 Dissolving Deluge"
	Tooltip: "[c/E2735C:Weapon] Spectre Spirit Storm: 62 ranged damage, use time 18"
}

GearSubspaceScissors: {
	Title: "Spirit Scissors"
	Contents: "[c/E2735C:Weapon] Obtain Spirit Scissors. 190 melee damage, use time 30. 'Assistance from purgatory'. How to get it: Craft at Mythril/Orichalcum Anvil from 15 Sanguite Scales"
	Tooltip: "[c/E2735C:Weapon] Spirit Scissors: 190 melee damage, use time 30"
}

GearStarcallerStaff: {
	Title: "Starcaller Staff"
	Contents: "[c/E2735C:Weapon] Obtain Starcaller Staff. 64 summon damage, use time 36, 10 mana. Summons a Crystal Serpent to fight for you. The Crystal Serpent circles around enemies and fires stars at them. How to get it: Found in world-generated chests"
	Tooltip: "[c/E2735C:Weapon] Starcaller Staff: 64 summon damage, use time 36, 10 mana"
}

GearStellarSerpentLauncher: {
	Title: "Stellar Serpent Launcher"
	Contents: "[c/E2735C:Weapon] Obtain Stellar Serpent Launcher. 55 ranged damage, use time 24. Launches a Starlight Serpent which homes on enemies and attacks them repeatedly. How to get it: Craft at Mythril/Orichalcum Anvil from 24 Phase Bar, 1 Piranha Gun, 1 Snake Bow"
	Tooltip: "[c/E2735C:Weapon] Stellar Serpent Launcher: 55 ranged damage, use time 24"
}

GearStellarShot: {
	Title: "Stellar Shot"
	Contents: "[c/E2735C:Weapon] Obtain Stellar Shot. 35 magic damage (pack-balanced, was 50), use time 6, 4 mana. Rapidly fires piercing lasers. How to get it: Craft at Mythril/Orichalcum Anvil from 24 Phase Bar, 1 Perfect Star, 1 Laser Machinegun, 1 Razorpine"
	Tooltip: "[c/E2735C:Weapon] Stellar Shot: 35 magic damage (pack-balanced, was 50), use time 6, 4 mana"
}

GearSupernovaScatter: {
	Title: "Supernova Scatter"
	Contents: "[c/E2735C:Weapon] Obtain Supernova Scatter. 47 ranged damage, use time 60. Launches small stars that explode into bullets. How to get it: Craft at Mythril/Orichalcum Anvil from 20 Lunar Tablet Fragment, 1 Lihzahrd Power Cell; Found in world-generated chests"
	Tooltip: "[c/E2735C:Weapon] Supernova Scatter: 47 ranged damage, use time 60"
}

GearSupernovaStorm: {
	Title: "Supernova Storm"
	Contents: "[c/E2735C:Weapon] Obtain Supernova Storm. 60 magic damage, use time 14, 10 mana. Calls down a Supernova Beam from the sky. Causes enemies to rupture into homing bolts for 3x140% damage. How to get it: Craft at Mythril/Orichalcum Anvil from 18 Phase Bar, 1 Azure Bombardment"
	Tooltip: "[c/E2735C:Weapon] Supernova Storm: 60 magic damage, use time 14, 10 mana"
}

GearTangleStaff: {
	Title: "Tangle Staff"
	Contents: "[c/E2735C:Weapon] Obtain Tangle Staff. 80 magic damage, use time 36, 22 mana. Fire a flower that ensnares enemies. Ensnared enemies are slowed and have their life drained. Increases life regeneration for each ensnared enemy. How to get it: Found in world-generated chests"
	Tooltip: "[c/E2735C:Weapon] Tangle Staff: 80 magic damage, use time 36, 22 mana"
}

GearTraingun: {
	Title: "Train Gun"
	Contents: "[c/E2735C:Weapon] Obtain Train Gun. 75 ranged damage, use time 24. How to get it: Sold by Traveling Merchant"
	Tooltip: "[c/E2735C:Weapon] Train Gun: 75 ranged damage, use time 24"
}

GearVoidspaceAuraStaff: {
	Title: "Voidspace Aura Staff"
	Contents: "[c/E2735C:Weapon] Obtain Voidspace Aura Staff. 54 summon damage, use time 45, 12 mana. Summons a Voidspace Cell on your cursor that releases flames at all nearby enemies. Grants stat boosts while in the radius of the cell. Void regeneration speed increases by 4%, life regeneration by 4, defense by 4, and reduces damage taken by 4%. Range scales with summon damage. How to get it: Craft at Mythril/Orichalcum Anvil from 15 Sanguite Scales, 1 Ancient Steel Lantern"
	Tooltip: "[c/E2735C:Weapon] Voidspace Aura Staff: 54 summon damage, use time 45, 12 mana"
}

GearContinuumCollapse: {
	Title: "Continuum Collapse"
	Contents: "[c/E2735C:Weapon] Obtain Continuum Collapse. 120 magic damage, use time 20. 'Devour all that is infinite, including your system's memory'. Can hit up to 15 enemies at a time. Will not hurt players. How to get it: Obtained in-world (source not found) [c/9AA0A6:(source unconfirmed)]"
	Tooltip: "[c/E2735C:Weapon] Continuum Collapse: 120 magic damage, use time 20"
}

GearTesseract: {
	Title: "Tesseract"
	Contents: "[c/E2735C:Weapon] Obtain Tesseract. 1000000 summon damage, use time 30. Summons a Void Clone that uses items to attack enemies. Starting with the item in the bottom-left inventory slot and ending with the bottom-right slot, each Clone uses a different item. When first summoned, the Clone will await a command for how it should use the item (left or right click) and fo... How to get it: Craft at Ancient Manipulator from 1 Chaos Spirit Staff, 1 Evil Spirit Staff, 1 Inferno Spirit Staff, 1 Tidal Spirit Staff, 1 Otherworldly Spirit Staff, 1 Permafrost Spirit Staff, 1 Earthen Spirit Staff, 1 Nature Spirit Staff"
	Tooltip: "[c/E2735C:Weapon] Tesseract: 1000000 summon damage, use time 30"
}

GearFeralClaws: {
	Title: "Feral Claws"
	Contents: "[c/6CC4E8:Accessory] Equip Feral Claws. Accessory. Increases melee speed and enables autoswing. How to get it: Found in Underground Jungle chests"
	Tooltip: "[c/6CC4E8:Accessory] Feral Claws: Accessory"
}

GearSharkToothNecklace: {
	Title: "Shark Tooth Necklace"
	Contents: "[c/6CC4E8:Accessory] Equip Shark Tooth Necklace. Accessory. Increases armor penetration. How to get it: Dropped by Blood Moon enemies [c/9AA0A6:(source unconfirmed)]"
	Tooltip: "[c/6CC4E8:Accessory] Shark Tooth Necklace: Accessory"
}

GearTitanGlove: {
	Title: "Titan Glove"
	Contents: "[c/6CC4E8:Accessory] Equip Titan Glove. Accessory. Increases melee knockback and size. How to get it: Dropped by Mimics"
	Tooltip: "[c/6CC4E8:Accessory] Titan Glove: Accessory"
}

GearPowerGlove: {
	Title: "Power Glove"
	Contents: "[c/6CC4E8:Accessory] Equip Power Glove. Accessory. Increases melee knockback, speed and size; autoswing. How to get it: Combine at a Tinkerer's Workshop from Feral Claws and Titan Glove"
	Tooltip: "[c/6CC4E8:Accessory] Power Glove: Accessory"
}

GearFleshKnuckles: {
	Title: "Flesh Knuckles"
	Contents: "[c/6CC4E8:Accessory] Equip Flesh Knuckles. Accessory. Increases defense; enemies are more likely to target you. How to get it: Dropped by Crimson Mimics"
	Tooltip: "[c/6CC4E8:Accessory] Flesh Knuckles: Accessory"
}

GearBerserkerGlove: {
	Title: "Berserker's Glove"
	Contents: "[c/6CC4E8:Accessory] Equip Berserker's Glove. Accessory. Melee speed, knockback, size and defense; enemies more likely to target you. How to get it: Combine at a Tinkerer's Workshop from Power Glove and Flesh Knuckles"
	Tooltip: "[c/6CC4E8:Accessory] Berserker's Glove: Accessory"
}

GearMechanicalGlove: {
	Title: "Mechanical Glove"
	Contents: "[c/6CC4E8:Accessory] Equip Mechanical Glove. Accessory. Increases melee damage, speed and knockback. How to get it: Combine at a Tinkerer's Workshop from Power Glove and Avenger Emblem"
	Tooltip: "[c/6CC4E8:Accessory] Mechanical Glove: Accessory"
}

GearMagmaStone: {
	Title: "Magma Stone"
	Contents: "[c/6CC4E8:Accessory] Equip Magma Stone. Accessory. Melee attacks set enemies on fire. How to get it: Rare drop from Underworld enemies [c/9AA0A6:(source unconfirmed)]"
	Tooltip: "[c/6CC4E8:Accessory] Magma Stone: Accessory"
}

GearFireGauntlet: {
	Title: "Fire Gauntlet"
	Contents: "[c/6CC4E8:Accessory] Equip Fire Gauntlet. Accessory. Melee damage, speed and knockback; melee attacks inflict fire. How to get it: Combine at a Tinkerer's Workshop from Mechanical Glove and Magma Stone"
	Tooltip: "[c/6CC4E8:Accessory] Fire Gauntlet: Accessory"
}

GearWarriorEmblem: {
	Title: "Warrior Emblem"
	Contents: "[c/6CC4E8:Accessory] Equip Warrior Emblem. Accessory. Increases melee damage by 15%. How to get it: Dropped by the Wall of Flesh"
	Tooltip: "[c/6CC4E8:Accessory] Warrior Emblem: Accessory"
}

GearStingerNecklace: {
	Title: "Stinger Necklace"
	Contents: "[c/6CC4E8:Accessory] Equip Stinger Necklace. Accessory. Armor penetration; releases bees when damaged. How to get it: Combine at a Tinkerer's Workshop from Shark Tooth Necklace and Honey Comb [c/9AA0A6:(source unconfirmed)]"
	Tooltip: "[c/6CC4E8:Accessory] Stinger Necklace: Accessory"
}

GearFrozenTurtleShell: {
	Title: "Frozen Turtle Shell"
	Contents: "[c/6CC4E8:Accessory] Equip Frozen Turtle Shell. Accessory. Puts a damage-reducing shell around you when below half health. How to get it: Dropped by Ice Tortoises"
	Tooltip: "[c/6CC4E8:Accessory] Frozen Turtle Shell: Accessory"
}

GearPaladinsShield: {
	Title: "Paladin's Shield"
	Contents: "[c/6CC4E8:Accessory] Equip Paladin's Shield. Accessory. Absorbs part of the damage dealt to teammates; knockback immunity. How to get it: Dropped by Paladins in the post-Plantera Dungeon"
	Tooltip: "[c/6CC4E8:Accessory] Paladin's Shield: Accessory"
}

GearFrozenShield: {
	Title: "Frozen Shield"
	Contents: "[c/6CC4E8:Accessory] Equip Frozen Shield. Accessory. Combines Paladin's Shield and Frozen Turtle Shell. How to get it: Combine at a Tinkerer's Workshop from Paladin's Shield and Frozen Turtle Shell"
	Tooltip: "[c/6CC4E8:Accessory] Frozen Shield: Accessory"
}

GearHeroShield: {
	Title: "Hero Shield"
	Contents: "[c/6CC4E8:Accessory] Equip Hero Shield. Accessory. Combines Paladin's Shield and Flesh Knuckles. How to get it: Combine at a Tinkerer's Workshop from Paladin's Shield and Flesh Knuckles"
	Tooltip: "[c/6CC4E8:Accessory] Hero Shield: Accessory"
}

GearBlackBelt: {
	Title: "Black Belt"
	Contents: "[c/6CC4E8:Accessory] Equip Black Belt. Accessory. Gives a chance to dodge attacks. How to get it: Dropped by Bone Lee in the post-Plantera Dungeon"
	Tooltip: "[c/6CC4E8:Accessory] Black Belt: Accessory"
}

GearTabi: {
	Title: "Tabi"
	Contents: "[c/6CC4E8:Accessory] Equip Tabi. Accessory. Allows the ability to dash. How to get it: Dropped by Bone Lee in the post-Plantera Dungeon"
	Tooltip: "[c/6CC4E8:Accessory] Tabi: Accessory"
}

GearMasterNinjaGear: {
	Title: "Master Ninja Gear"
	Contents: "[c/6CC4E8:Accessory] Equip Master Ninja Gear. Accessory. Wall climbing, dash and dodge in one. How to get it: Combine at a Tinkerer's Workshop from Tiger Climbing Gear, Tabi and Black Belt"
	Tooltip: "[c/6CC4E8:Accessory] Master Ninja Gear: Accessory"
}

GearMagicQuiver: {
	Title: "Magic Quiver"
	Contents: "[c/6CC4E8:Accessory] Equip Magic Quiver. Accessory. Increases arrow damage and speed; chance not to consume arrows. How to get it: Dropped by hardmode cavern skeletons [c/9AA0A6:(source unconfirmed)]"
	Tooltip: "[c/6CC4E8:Accessory] Magic Quiver: Accessory"
}

GearMoltenQuiver: {
	Title: "Molten Quiver"
	Contents: "[c/6CC4E8:Accessory] Equip Molten Quiver. Accessory. Magic Quiver effects plus flaming wooden arrows. How to get it: Combine at a Tinkerer's Workshop from Magic Quiver, Hellstone Bars and Hellfire Arrows [c/9AA0A6:(source unconfirmed)]"
	Tooltip: "[c/6CC4E8:Accessory] Molten Quiver: Accessory"
}

GearStalkersQuiver: {
	Title: "Stalker's Quiver"
	Contents: "[c/6CC4E8:Accessory] Equip Stalker's Quiver. Accessory. Magic Quiver effects plus extra ranged damage and lower aggro. How to get it: Combine at a Tinkerer's Workshop from Magic Quiver and Putrid Scent"
	Tooltip: "[c/6CC4E8:Accessory] Stalker's Quiver: Accessory"
}

GearRangerEmblem: {
	Title: "Ranger Emblem"
	Contents: "[c/6CC4E8:Accessory] Equip Ranger Emblem. Accessory. Increases ranged damage by 15%. How to get it: Dropped by the Wall of Flesh"
	Tooltip: "[c/6CC4E8:Accessory] Ranger Emblem: Accessory"
}

GearSniperScope: {
	Title: "Sniper Scope"
	Contents: "[c/6CC4E8:Accessory] Equip Sniper Scope. Accessory. Extends view range for guns; increases ranged damage and crit. How to get it: Dropped by Skeleton Snipers and Tactical Skeletons in the post-Plantera Dungeon [c/9AA0A6:(source unconfirmed)]"
	Tooltip: "[c/6CC4E8:Accessory] Sniper Scope: Accessory"
}

GearRifleScope: {
	Title: "Rifle Scope"
	Contents: "[c/6CC4E8:Accessory] Equip Rifle Scope. Accessory. Extends view range for guns. How to get it: Dropped by Skeleton Snipers in the post-Plantera Dungeon [c/9AA0A6:(source unconfirmed)]"
	Tooltip: "[c/6CC4E8:Accessory] Rifle Scope: Accessory"
}

GearReconScope: {
	Title: "Recon Scope"
	Contents: "[c/6CC4E8:Accessory] Equip Recon Scope. Accessory. Sniper Scope effects plus lower aggro and extra ranged stats. How to get it: Combine at a Tinkerer's Workshop from Sniper Scope and Putrid Scent"
	Tooltip: "[c/6CC4E8:Accessory] Recon Scope: Accessory"
}

GearPutridScent: {
	Title: "Putrid Scent"
	Contents: "[c/6CC4E8:Accessory] Equip Putrid Scent. Accessory. Enemies less likely to target you; increases damage and crit. How to get it: Dropped by Corrupt Mimics"
	Tooltip: "[c/6CC4E8:Accessory] Putrid Scent: Accessory"
}

GearBandofStarpower: {
	Title: "Band of Starpower"
	Contents: "[c/6CC4E8:Accessory] Equip Band of Starpower. Accessory. Increases maximum mana. How to get it: Dropped from Shadow Orbs"
	Tooltip: "[c/6CC4E8:Accessory] Band of Starpower: Accessory"
}

GearNaturesGift: {
	Title: "Nature's Gift"
	Contents: "[c/6CC4E8:Accessory] Equip Nature's Gift. Accessory. Reduces mana usage. How to get it: Found growing in the Underground Jungle"
	Tooltip: "[c/6CC4E8:Accessory] Nature's Gift: Accessory"
}

GearManaFlower: {
	Title: "Mana Flower"
	Contents: "[c/6CC4E8:Accessory] Equip Mana Flower. Accessory. Reduces mana usage; auto-uses mana potions. How to get it: Combine at a Tinkerer's Workshop from Nature's Gift and a Mana Potion"
	Tooltip: "[c/6CC4E8:Accessory] Mana Flower: Accessory"
}

GearManaRegenerationBand: {
	Title: "Mana Regeneration Band"
	Contents: "[c/6CC4E8:Accessory] Equip Mana Regeneration Band. Accessory. Increases maximum mana and mana regeneration. How to get it: Combine at a Tinkerer's Workshop from Band of Regeneration and Band of Starpower [c/9AA0A6:(source unconfirmed)]"
	Tooltip: "[c/6CC4E8:Accessory] Mana Regeneration Band: Accessory"
}

GearCelestialMagnet: {
	Title: "Celestial Magnet"
	Contents: "[c/6CC4E8:Accessory] Equip Celestial Magnet. Accessory. Increases pickup range for mana stars. How to get it: Sold by the Traveling Merchant [c/9AA0A6:(source unconfirmed)]"
	Tooltip: "[c/6CC4E8:Accessory] Celestial Magnet: Accessory"
}

GearMagicCuffs: {
	Title: "Magic Cuffs"
	Contents: "[c/6CC4E8:Accessory] Equip Magic Cuffs. Accessory. Increases maximum mana; restores mana when damaged. How to get it: Combine at a Tinkerer's Workshop from Band of Starpower and Shackle [c/9AA0A6:(source unconfirmed)]"
	Tooltip: "[c/6CC4E8:Accessory] Magic Cuffs: Accessory"
}

GearCelestialCuffs: {
	Title: "Celestial Cuffs"
	Contents: "[c/6CC4E8:Accessory] Equip Celestial Cuffs. Accessory. Magic Cuffs plus extended mana star pickup range. How to get it: Combine at a Tinkerer's Workshop from Magic Cuffs and Celestial Magnet"
	Tooltip: "[c/6CC4E8:Accessory] Celestial Cuffs: Accessory"
}

GearMagnetFlower: {
	Title: "Magnet Flower"
	Contents: "[c/6CC4E8:Accessory] Equip Magnet Flower. Accessory. Mana Flower plus extended mana star pickup range. How to get it: Combine at a Tinkerer's Workshop from Mana Flower and Celestial Magnet"
	Tooltip: "[c/6CC4E8:Accessory] Magnet Flower: Accessory"
}

GearSorcererEmblem: {
	Title: "Sorcerer Emblem"
	Contents: "[c/6CC4E8:Accessory] Equip Sorcerer Emblem. Accessory. Increases magic damage by 15%. How to get it: Dropped by the Wall of Flesh"
	Tooltip: "[c/6CC4E8:Accessory] Sorcerer Emblem: Accessory"
}

GearCelestialEmblem: {
	Title: "Celestial Emblem"
	Contents: "[c/6CC4E8:Accessory] Equip Celestial Emblem. Accessory. Increases magic damage and mana star pickup range. How to get it: Combine at a Tinkerer's Workshop from Celestial Magnet and Sorcerer Emblem"
	Tooltip: "[c/6CC4E8:Accessory] Celestial Emblem: Accessory"
}

GearArcaneFlower: {
	Title: "Arcane Flower"
	Contents: "[c/6CC4E8:Accessory] Equip Arcane Flower. Accessory. Mana Flower plus lower aggro. How to get it: Combine at a Tinkerer's Workshop from Mana Flower and Putrid Scent"
	Tooltip: "[c/6CC4E8:Accessory] Arcane Flower: Accessory"
}

GearManaCloak: {
	Title: "Mana Cloak"
	Contents: "[c/6CC4E8:Accessory] Equip Mana Cloak. Accessory. Mana Flower plus falling stars when hurt. How to get it: Combine at a Tinkerer's Workshop from Mana Flower and Star Cloak [c/9AA0A6:(source unconfirmed)]"
	Tooltip: "[c/6CC4E8:Accessory] Mana Cloak: Accessory"
}

GearPygmyNecklace: {
	Title: "Pygmy Necklace"
	Contents: "[c/6CC4E8:Accessory] Equip Pygmy Necklace. Accessory. Increases your max number of minions. How to get it: Sold by the Witch Doctor in Hardmode [c/9AA0A6:(source unconfirmed)]"
	Tooltip: "[c/6CC4E8:Accessory] Pygmy Necklace: Accessory"
}

GearSummonerEmblem: {
	Title: "Summoner Emblem"
	Contents: "[c/6CC4E8:Accessory] Equip Summoner Emblem. Accessory. Increases summon damage by 15%. How to get it: Dropped by the Wall of Flesh"
	Tooltip: "[c/6CC4E8:Accessory] Summoner Emblem: Accessory"
}

GearHerculesBeetle: {
	Title: "Hercules Beetle"
	Contents: "[c/6CC4E8:Accessory] Equip Hercules Beetle. Accessory. Increases summon damage and knockback. How to get it: Sold by the Witch Doctor after Plantera [c/9AA0A6:(source unconfirmed)]"
	Tooltip: "[c/6CC4E8:Accessory] Hercules Beetle: Accessory"
}

GearNecromanticScroll: {
	Title: "Necromantic Scroll"
