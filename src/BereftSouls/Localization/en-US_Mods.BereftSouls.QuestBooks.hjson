	Contents: "[c/79BD84:Potion] Obtain Flask of Nanites. Weapon imbue. Melee and whip attacks confuse enemies. How to get it: Craft at an Imbuing Station from Bottled Water and Nanites [c/9AA0A6:(source unconfirmed)]"
	Tooltip: "[c/79BD84:Potion] Flask of Nanites: Weapon imbue"
}

GearRocketBoots: {
	Title: "Rocket Boots"
	Contents: "[c/6CC4E8:Accessory] Equip Rocket Boots. Accessory. Allows flight for a short time. How to get it: Sold by the Goblin Tinkerer"
	Tooltip: "[c/6CC4E8:Accessory] Rocket Boots: Accessory"
}

GearAnkletoftheWind: {
	Title: "Anklet of the Wind"
	Contents: "[c/6CC4E8:Accessory] Equip Anklet of the Wind. Accessory. 10% increased movement speed. How to get it: Found in Underground Jungle chests [c/9AA0A6:(source unconfirmed)]"
	Tooltip: "[c/6CC4E8:Accessory] Anklet of the Wind: Accessory"
}

GearAglet: {
	Title: "Aglet"
	Contents: "[c/6CC4E8:Accessory] Equip Aglet. Accessory. 5% increased movement speed. How to get it: Found in surface and underground chests"
	Tooltip: "[c/6CC4E8:Accessory] Aglet: Accessory"
}

GearIceSkates: {
	Title: "Ice Skates"
	Contents: "[c/6CC4E8:Accessory] Equip Ice Skates. Accessory. Extra mobility on ice; ice will not break when you fall on it. How to get it: Found in Ice biome chests"
	Tooltip: "[c/6CC4E8:Accessory] Ice Skates: Accessory"
}

GearLavaWaders: {
	Title: "Lava Waders"
	Contents: "[c/6CC4E8:Accessory] Equip Lava Waders. Accessory. Walk on water and lava; immunity to fire blocks and some lava damage. How to get it: Combine at a Tinkerer's Workshop from Obsidian Water Walking Boots and a Lava Charm"
	Tooltip: "[c/6CC4E8:Accessory] Lava Waders: Accessory"
}

GearTigerClimbingGear: {
	Title: "Tiger Climbing Gear"
	Contents: "[c/6CC4E8:Accessory] Equip Tiger Climbing Gear. Accessory. Allows the ability to climb walls. How to get it: Combine at a Tinkerer's Workshop from Climbing Claws and Shoe Spikes"
	Tooltip: "[c/6CC4E8:Accessory] Tiger Climbing Gear: Accessory"
}

GearClimbingClaws: {
	Title: "Climbing Claws"
	Contents: "[c/6CC4E8:Accessory] Equip Climbing Claws. Accessory. Allows the ability to slide down walls. How to get it: Found in underground chests"
	Tooltip: "[c/6CC4E8:Accessory] Climbing Claws: Accessory"
}

GearShoeSpikes: {
	Title: "Shoe Spikes"
	Contents: "[c/6CC4E8:Accessory] Equip Shoe Spikes. Accessory. Allows the ability to slide down walls. How to get it: Found in underground chests"
	Tooltip: "[c/6CC4E8:Accessory] Shoe Spikes: Accessory"
}

GearShackle: {
	Title: "Shackle"
	Contents: "[c/6CC4E8:Accessory] Equip Shackle. Accessory, 1 defense. Increases defense by 1. How to get it: Dropped by Zombies"
	Tooltip: "[c/6CC4E8:Accessory] Shackle: Accessory, 1 defense"
}

GearMoonStone: {
	Title: "Moon Stone"
	Contents: "[c/6CC4E8:Accessory] Equip Moon Stone. Accessory. Increases all stats at night. How to get it: Dropped by Hardmode Eclipse enemies (Vampires) [c/9AA0A6:(source unconfirmed)]"
	Tooltip: "[c/6CC4E8:Accessory] Moon Stone: Accessory"
}

GearMoonShell: {
	Title: "Moon Shell"
	Contents: "[c/6CC4E8:Accessory] Equip Moon Shell. Accessory. Turns the holder into a werewolf at night and a merfolk in water. How to get it: Combine at a Tinkerer's Workshop from Moon Charm and Neptune's Shell"
	Tooltip: "[c/6CC4E8:Accessory] Moon Shell: Accessory"
}

GearFishingBobber: {
	Title: "Fishing Bobber"
	Contents: "[c/6CC4E8:Accessory] Equip Fishing Bobber. Accessory. Your fishing bobber glows. How to get it: Reward from the Angler [c/9AA0A6:(source unconfirmed)]"
	Tooltip: "[c/6CC4E8:Accessory] Fishing Bobber: Accessory"
}

GearLavaproofTackleBag: {
	Title: "Lavaproof Tackle Bag"
	Contents: "[c/6CC4E8:Accessory] Equip Lavaproof Tackle Bag. Accessory. Fishing line never breaks, fishing in lava, bait is used less. How to get it: Combine at a Tinkerer's Workshop from the Angler's fishing accessories [c/9AA0A6:(source unconfirmed)]"
	Tooltip: "[c/6CC4E8:Accessory] Lavaproof Tackle Bag: Accessory"
}

GearArcticDivingGear: {
	Title: "Arctic Diving Gear"
	Contents: "[c/6CC4E8:Accessory] Equip Arctic Diving Gear. Accessory. Swim, breathe underwater, extra ice mobility and light underwater. How to get it: Combine at a Tinkerer's Workshop from Jellyfish Diving Gear and Ice Skates"
	Tooltip: "[c/6CC4E8:Accessory] Arctic Diving Gear: Accessory"
}

GearSweetheartNecklace: {
	Title: "Sweetheart Necklace"
	Contents: "[c/6CC4E8:Accessory] Equip Sweetheart Necklace. Accessory. Releases bees and increases movement speed when damaged. How to get it: Combine at a Tinkerer's Workshop from Honey Comb and Panic Necklace"
	Tooltip: "[c/6CC4E8:Accessory] Sweetheart Necklace: Accessory"
}

GearFrogLeg: {
	Title: "Frog Leg"
	Contents: "[c/6CC4E8:Accessory] Equip Frog Leg. Accessory. Increases jump speed and allows auto-jump. How to get it: Caught while fishing (crate or catch) [c/9AA0A6:(source unconfirmed)]"
	Tooltip: "[c/6CC4E8:Accessory] Frog Leg: Accessory"
}

GearFrogFlipper: {
	Title: "Frog Flipper"
	Contents: "[c/6CC4E8:Accessory] Equip Frog Flipper. Accessory. Frog Leg and Flipper effects. How to get it: Combine at a Tinkerer's Workshop from Frog Leg and Flipper"
	Tooltip: "[c/6CC4E8:Accessory] Frog Flipper: Accessory"
}

GearShinyStone: {
	Title: "Shiny Stone"
	Contents: "[c/6CC4E8:Accessory] Equip Shiny Stone. Accessory. Greatly increases life regeneration when not moving. How to get it: Found in Underground Jungle after Plantera (Chlorophyte/Life Fruit areas) [c/9AA0A6:(source unconfirmed)]"
	Tooltip: "[c/6CC4E8:Accessory] Shiny Stone: Accessory"
}

GearGreedyRing: {
	Title: "Greedy Ring"
	Contents: "[c/6CC4E8:Accessory] Equip Greedy Ring. Accessory. Increases coin pickup range and shops have lower prices. How to get it: Sold by the Goblin Tinkerer during Hardmode [c/9AA0A6:(source unconfirmed)]"
	Tooltip: "[c/6CC4E8:Accessory] Greedy Ring: Accessory"
}

GearMedicatedBandage: {
	Title: "Medicated Bandage"
	Contents: "[c/6CC4E8:Accessory] Equip Medicated Bandage. Accessory. Immunity to Poisoned and Bleeding. How to get it: Combine at a Tinkerer's Workshop from Adhesive Bandage and Bezoar"
	Tooltip: "[c/6CC4E8:Accessory] Medicated Bandage: Accessory"
}

GearArmorPolish: {
	Title: "Armor Polish"
	Contents: "[c/6CC4E8:Accessory] Equip Armor Polish. Accessory. Immunity to Broken Armor. How to get it: Dropped by Armored Skeletons and Blue Armored Bones"
	Tooltip: "[c/6CC4E8:Accessory] Armor Polish: Accessory"
}

GearSetcalamitymodaerospecmagic: {
	Title: "Aerospec Armor (Magic)"
	Contents: "[c/E0B14A:Armor set] Wear the full Aerospec Armor (Magic). 16 defense (3 / 7 / 6). 8% reduced mana cost. 5% increased movement speed and magic critical strike chance. Taking over 25 damage in one hit will cause a spread of homing feathers to fall. Allows you to fall more quickly and disables fall damage. How to get it: Aerospec Hat: Craft at Anvil from 10 Aerialite Bar, 1 Feather; Aerospec Breastplate: Craft at Anvil from 20 Aerialite Bar, 2 Feather; Aerospec Leggings: Craft at Anvil from 15 Aerialite Bar, 2 Feather"
	Tooltip: "[c/E0B14A:Armor set] Aerospec Armor (Magic): 16 defense (3 / 7 / 6)"
}

GearSetcalamitymodaerospecmelee: {
	Title: "Aerospec Armor (Melee)"
	Contents: "[c/E0B14A:Armor set] Wear the full Aerospec Armor (Melee). 20 defense (7 / 7 / 6). 5% increased movement speed and melee critical strike chance. Enemies are more likely to target you. Taking over 25 damage in one hit will cause a spread of homing feathers to fall. Allows you to fall more quickly and disables fall damage. How to get it: Aerospec Helm: Craft at Anvil from 10 Aerialite Bar, 1 Feather; Aerospec Breastplate: Craft at Anvil from 20 Aerialite Bar, 2 Feather; Aerospec Leggings: Craft at Anvil from 15 Aerialite Bar, 2 Feather"
	Tooltip: "[c/E0B14A:Armor set] Aerospec Armor (Melee): 20 defense (7 / 7 / 6)"
}

GearSetcalamitymodaerospecranged: {
	Title: "Aerospec Armor (Ranged)"
	Contents: "[c/E0B14A:Armor set] Wear the full Aerospec Armor (Ranged). 18 defense (5 / 7 / 6). 5% increased movement speed and ranged critical strike chance. Taking over 25 damage in one hit will cause a spread of homing feathers to fall. Allows you to fall more quickly and disables fall damage. How to get it: Aerospec Hood: Craft at Anvil from 10 Aerialite Bar, 1 Feather; Aerospec Breastplate: Craft at Anvil from 20 Aerialite Bar, 2 Feather; Aerospec Leggings: Craft at Anvil from 15 Aerialite Bar, 2 Feather"
	Tooltip: "[c/E0B14A:Armor set] Aerospec Armor (Ranged): 18 defense (5 / 7 / 6)"
}

GearSetcalamitymodaerospecrogue: {
	Title: "Aerospec Armor (Rogue)"
	Contents: "[c/E0B14A:Armor set] Wear the full Aerospec Armor (Rogue). 17 defense (4 / 7 / 6). +X maximum stealth. 5% increased movement speed and rogue critical strike chance. Taking over 25 damage in one hit will cause a spread of homing feathers to fall. Allows you to fall more quickly and disables fall damage. How to get it: Aerospec Headgear: Craft at Anvil from 10 Aerialite Bar, 1 Feather; Aerospec Breastplate: Craft at Anvil from 20 Aerialite Bar, 2 Feather; Aerospec Leggings: Craft at Anvil from 15 Aerialite Bar, 2 Feather"
	Tooltip: "[c/E0B14A:Armor set] Aerospec Armor (Rogue): 17 defense (4 / 7 / 6)"
}

GearSetcalamitymodaerospecsummon: {
	Title: "Aerospec Armor (Summon)"
	Contents: "[c/E0B14A:Armor set] Wear the full Aerospec Armor (Summon). 15 defense (2 / 7 / 6). Increases your max number of minions by 1. 11% increased summon damage. Summons a valkyrie to protect you. Taking over 25 damage in one hit will cause a spread of homing feathers to fall. Allows you to fall more quickly and disables fall damage. How to get it: Aerospec Helmet: Craft at Anvil from 10 Aerialite Bar, 1 Feather; Aerospec Breastplate: Craft at Anvil from 20 Aerialite Bar, 2 Feather; Aerospec Leggings: Craft at Anvil from 15 Aerialite Bar, 2 Feather"
	Tooltip: "[c/E0B14A:Armor set] Aerospec Armor (Summon): 15 defense (2 / 7 / 6)"
}

GearSetcalamitymoddesertprowler: {
	Title: "Desert Prowler Armor"
	Contents: "[c/E0B14A:Armor set] Wear the full Desert Prowler Armor. 9 defense (2 / 4 / 3). +X maximum stealth. Sandsmoke Bomb - X to shroud yourself in a small cloud of sand. While the sand cloud is active, gain increased mobility but heavily reduced defense. Using a rogue weapon instantly dispels the sand cloak, but guarantees a supercrit for 200% damage. The supercrit applies only as long as the resulting hit wouldn't exceed 200 damage. Landing the killing blow on an enemy with thi... How to get it: Desert Prowler Hat: Craft at Loom from 2 Stormlion Mandible, 8 Silk; Desert Prowler Shirt: Craft at Loom from 3 Stormlion Mandible, 10 Silk; Desert Prowler Pants: Craft at Loom from 1 Stormlion Mandible, 5 Silk"
	Tooltip: "[c/E0B14A:Armor set] Desert Prowler Armor: 9 defense (2 / 4 / 3)"
}

GearSetcalamitymodmarnitearchitect: {
	Title: "Marnite Architect Armor"
	Contents: "[c/E0B14A:Armor set] Wear the full Marnite Architect Armor. 9 defense (4 / 5). Marnite Lift - You can summon a lift under your feet to reach higher up. The lift gets summoned when the mount hotkey gets pressed without any mounts equipped. Press and to change the lift's height, reaching up to X tiles above ground. How to get it: Marnite Architect Headgear: Craft at Anvil from 1 Any Gold Crown, 5 Granite, 5 Marble; Marnite Architect Toga: Craft at Anvil from 2 Any Gold Bar, 15 Silk, 15 Granite, 15 Marble"
	Tooltip: "[c/E0B14A:Armor set] Marnite Architect Armor: 9 defense (4 / 5)"
}

GearSetcalamitymodsnowruffian: {
	Title: "Snow Ruffian Armor"
	Contents: "[c/E0B14A:Armor set] Wear the full Snow Ruffian Armor. 9 defense (2 / 4 / 3). You can glide to negate fall damage. Ranged critical strikes inflict Frostburn for 2 seconds. How to get it: Snow Ruffian Mask: Craft at Anvil from 10 Boreal Wood, 4 Silk, 1 Flinx Fur; Snow Ruffian Chestplate: Craft at Anvil from 20 Boreal Wood, 6 Silk, 2 Flinx Fur; Snow Ruffian Greaves: Craft at Anvil from 15 Boreal Wood, 5 Silk, 1 Flinx Fur"
	Tooltip: "[c/E0B14A:Armor set] Snow Ruffian Armor: 9 defense (2 / 4 / 3)"
}

GearSetcalamitymodsulphurous: {
	Title: "Sulphurous Armor"
	Contents: "[c/E0B14A:Armor set] Wear the full Sulphurous Armor. 16 defense (5 / 6 / 5). +X maximum stealth. Attacking and being attacked by enemies inflicts Poisoned for 1 second. Grants an additional jump that summons a sulphurous bubble. Reduces the severity of the sulphuric waters. How to get it: Sulphurous Helmet: Craft at Anvil from 10 Acidwood, 10 Sulphuric Scale; Sulphurous Breastplate: Craft at Anvil from 20 Acidwood, 20 Sulphuric Scale; Sulphurous Leggings: Craft at Anvil from 15 Acidwood, 15 Sulphuric Scale"
	Tooltip: "[c/E0B14A:Armor set] Sulphurous Armor: 16 defense (5 / 6 / 5)"
}

GearSetcalamitymodvictidemagic: {
	Title: "Victide Armor (Magic)"
	Contents: "[c/E0B14A:Armor set] Wear the full Victide Armor (Magic). 11 defense (2 / 5 / 4). +1.5 HP/s life regen and 10% increased magic damage while submerged in liquid. When using any weapon you have a 10% chance to throw a returning seashell projectile. This seashell does true damage and does not benefit from any damage class. Provides increased underwater mobility and slightly reduces breath loss in the abyss. How to get it: Victide Hermit Helmet: Craft at Anvil from 3 Sea Remains; Victide Breastplate: Craft at Anvil from 5 Sea Remains, 4 Fragment of Tide; Victide Greaves: Craft at Anvil from 4 Sea Remains, 3 Fragment of Tide"
	Tooltip: "[c/E0B14A:Armor set] Victide Armor (Magic): 11 defense (2 / 5 / 4)"
}

GearSetcalamitymodvictidemelee: {
	Title: "Victide Armor (Melee)"
	Contents: "[c/E0B14A:Armor set] Wear the full Victide Armor (Melee). 13 defense (4 / 5 / 4). Enemies are more likely to target you. +1.5 HP/s life regen and 10% increased melee damage while submerged in liquid. When using any weapon you have a 10% chance to throw a returning seashell projectile. This seashell does true damage and does not benefit from any damage class. Provides increased underwater mobility and slightly reduces breath loss in the abyss. How to get it: Victide Shellmet: Craft at Anvil from 3 Sea Remains; Victide Breastplate: Craft at Anvil from 5 Sea Remains, 4 Fragment of Tide; Victide Greaves: Craft at Anvil from 4 Sea Remains, 3 Fragment of Tide"
	Tooltip: "[c/E0B14A:Armor set] Victide Armor (Melee): 13 defense (4 / 5 / 4)"
}

GearSetcalamitymodvictideranged: {
	Title: "Victide Armor (Ranged)"
	Contents: "[c/E0B14A:Armor set] Wear the full Victide Armor (Ranged). 12 defense (3 / 5 / 4). +1.5 HP/s life regen and 10% increased ranged damage while submerged in liquid. When using any weapon you have a 10% chance to throw a returning seashell projectile. This seashell does true damage and does not benefit from any damage class. Provides increased underwater mobility and slightly reduces breath loss in the abyss. How to get it: Victide Coral Turban: Craft at Anvil from 3 Sea Remains; Victide Breastplate: Craft at Anvil from 5 Sea Remains, 4 Fragment of Tide; Victide Greaves: Craft at Anvil from 4 Sea Remains, 3 Fragment of Tide"
	Tooltip: "[c/E0B14A:Armor set] Victide Armor (Ranged): 12 defense (3 / 5 / 4)"
}

GearSetcalamitymodvictiderogue: {
	Title: "Victide Armor (Rogue)"
	Contents: "[c/E0B14A:Armor set] Wear the full Victide Armor (Rogue). 12 defense (3 / 5 / 4). +60 maximum stealth. +1.5 HP/s life regen and 10% increased rogue damage while submerged in liquid. When using any weapon you have a 10% chance to throw a returning seashell projectile. This seashell does true damage and does not benefit from any damage class. Provides increased underwater mobility and slightly reduces breath loss in the abyss. How to get it: Victide Headcrab: Craft at Anvil from 3 Sea Remains; Victide Breastplate: Craft at Anvil from 5 Sea Remains, 4 Fragment of Tide; Victide Greaves: Craft at Anvil from 4 Sea Remains, 3 Fragment of Tide"
	Tooltip: "[c/E0B14A:Armor set] Victide Armor (Rogue): 12 defense (3 / 5 / 4)"
}

GearSetcalamitymodvictidesummon: {
	Title: "Victide Armor (Summon)"
	Contents: "[c/E0B14A:Armor set] Wear the full Victide Armor (Summon). 10 defense (1 / 5 / 4). +1 max minion. Summons a sea snail to protect you. +1.5 HP/s life regen and 10% increased summon damage while submerged in liquid. When using any weapon you have a 10% chance to throw a returning seashell projectile. This seashell does true damage and does not benefit from any damage class. Provides increased underwater mobility and slightly reduces breath loss in the abyss. How to get it: Victide Mask: Craft at Anvil from 3 Sea Remains; Victide Breastplate: Craft at Anvil from 5 Sea Remains, 4 Fragment of Tide; Victide Greaves: Craft at Anvil from 4 Sea Remains, 3 Fragment of Tide"
	Tooltip: "[c/E0B14A:Armor set] Victide Armor (Summon): 10 defense (1 / 5 / 4)"
}

GearSetcalamitymodwulfrum: {
	Title: "Wulfrum Armor"
	Contents: "[c/E0B14A:Armor set] Wear the full Wulfrum Armor. 4 defense (1 / 2 / 1). Wulfrum Bastion - X to equip a power armor, costing one Wulfrum Metal Scrap. While active, you can only use the integrated fusion cannon, but your defensive stats are increased. The armor lasts up to 30 seconds, but each hit loses 2 seconds of duration. Hold Shift to see the stats of the fusion cannon. How to get it: Wulfrum Hat & Goggles: Craft at Anvil from 10 Wulfrum Metal Scrap, 1 Energy Core; Wulfrum Jacket: Craft at Anvil from 20 Wulfrum Metal Scrap, 1 Energy Core; Wulfrum Overalls: Craft at Anvil from 15 Wulfrum Metal Scrap, 1 Energy Core"
	Tooltip: "[c/E0B14A:Armor set] Wulfrum Armor: 4 defense (1 / 2 / 1)"
}

GearSetcalamitymoddaedalusmagic: {
	Title: "Daedalus Armor (Magic)"
	Contents: "[c/E0B14A:Armor set] Wear the full Daedalus Armor (Magic). 42 defense (8 / 19 / 15). You have a X% chance to heal back 50% of taken damage. How to get it: Daedalus Hood: Craft at Mythril/Orichalcum Anvil from 12 Cryonic Bar; Daedalus Breastplate: Craft at Mythril/Orichalcum Anvil from 24 Cryonic Bar, 6 Frigid Bar; Daedalus Leggings: Craft at Mythril/Orichalcum Anvil from 18 Cryonic Bar, 4 Frigid Bar"
	Tooltip: "[c/E0B14A:Armor set] Daedalus Armor (Magic): 42 defense (8 / 19 / 15)"
}

GearSetcalamitymoddaedalusmelee: {
	Title: "Daedalus Armor (Melee)"
	Contents: "[c/E0B14A:Armor set] Wear the full Daedalus Armor (Melee). 56 defense (22 / 19 / 15). Enemies are more likely to target you. You reflect projectiles back at enemies, negating their damage. Projectiles that deal less than 5% of your max life in damage will not be reflected. The reflect has a cooldown that ranges between 20 and 90 seconds depending on the reflected projectile's damage. This cooldown is shared with all other dodges and reflects. How to get it: Daedalus Helm: Craft at Mythril/Orichalcum Anvil from 12 Cryonic Bar; Daedalus Breastplate: Craft at Mythril/Orichalcum Anvil from 24 Cryonic Bar, 6 Frigid Bar; Daedalus Leggings: Craft at Mythril/Orichalcum Anvil from 18 Cryonic Bar, 4 Frigid Bar"
	Tooltip: "[c/E0B14A:Armor set] Daedalus Armor (Melee): 56 defense (22 / 19 / 15)"
}

